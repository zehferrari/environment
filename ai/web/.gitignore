# dependencies
# No trailing slash: agents run the suites in a PM worktree by SYMLINKING
# node_modules at the shared install, and `node_modules/` matches directories
# only, so the symlink showed up untracked and was one `git add -A` away from
# landing in a submission commit. The bare pattern matches both.
node_modules
.pnp
.pnp.*
.yarn/*

# next.js
.next/
out/
build/
dist/

# production
*.tsbuildinfo
next-env.d.ts

# env
.env*.local
.env

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# misc
.DS_Store
*.pem
.antigravitycli/

# local sqlite
prisma/*.db
prisma/*.db-journal
*.db
*.db-journal
# runtime DB dir — owned/locked to the monitor (karen 0700); git must not
# descend into it (it can't read it) and must never track the live DB.
prisma/prisma/

# coverage
coverage/
*.lcov
