// PM walking skeleton — Stage 1 schema (HOMELAB-43)
// SQLite for v1; same schema portable to Postgres in v1.1+.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------
// Auth + identity
// ------------------------------------------------------------------

model User {
  id                 String          @id @default(cuid())
  username           String          @unique
  email              String          @unique
  kind               String // "human" | "agent"
  passwordHash       String?
  passwordSetAt      DateTime?
  mustRotatePassword Boolean         @default(true)
  status             String          @default("active") // "active" | "deactivated"
  rolePermissionId   String?
  rolePermission     RolePermission? @relation(fields: [rolePermissionId], references: [id])
  agentId            String?         @unique
  agent              Agent?          @relation(fields: [agentId], references: [id])
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  passwordResetTokens PasswordResetToken[]
  projectMembers      ProjectMember[]
  assignedTasks       Task[]               @relation("TaskAssignee")
  comments            Comment[]
  activity            ActivityLog[]

  @@index([kind])
  @@index([status])
}

model RolePermission {
  id          String   @id @default(cuid())
  name        String   @unique // e.g. "developer", "manager", "admin"
  description String?
  // Stage 2 (HOMELAB-44) will hang permission JSON / policy here.
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ------------------------------------------------------------------
// Agent registry mirror (system-managed; sourced from /srv/agents/index.json)
// ------------------------------------------------------------------

model Agent {
  id            String    @id @default(cuid())
  // slug from index.json (e.g. "asdrubal", "barekbaal", "karen")
  slug          String    @unique
  name          String
  email         String?
  role          String // "coding" | "monitor" | ...
  codeOwner     String? // codeOwner from index.json
  gatewayPort   Int? // listeners[?owner=='openclaw-gateway'].port
  avatar        String?
  rawJson       String? // last-seen JSON entry (for debugging)
  deactivatedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User?

  @@index([role])
  @@index([deactivatedAt])
}

// ------------------------------------------------------------------
// Projects + boards
// ------------------------------------------------------------------

model Project {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  // On-disk README for the project (zeh decision in HOMELAB-44 / Stage 2):
  // points at /srv/Data/projects/<id>/README.md (deploy/runtime path,
  // outside the app source tree). Server renders via lib/markdown.
  readmePath  String?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  members  ProjectMember[]
  epics    Epic[]
  tasks    Task[]
  activity ActivityLog[]
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("member")
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

model Epic {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      String   @default("open") // "open" | "done" | "archived"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks Task[]

  @@index([projectId])
  @@index([status])
}

model Task {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  epicId       String?
  epic         Epic?    @relation(fields: [epicId], references: [id])
  // Sub-task hierarchy: a sub-task is a Task with parentTaskId set. Stage 2
  // keeps a single self-referential Task model (no parallel SubTask) per
  // HOMELAB-44 manager guardrail. epic > task > subtask is expressed as
  // epicId + parentTaskId.
  parentTaskId String?
  parent       Task?    @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks     Task[]   @relation("TaskSubtasks")
  title        String
  description  String?
  // Status uses the verbatim Stage 0 labels — no Jira aliases.
  // Backlog | To Do | In Progress | Review | Done
  status       String   @default("Backlog")
  assigneeId   String?
  assignee     User?    @relation("TaskAssignee", fields: [assigneeId], references: [id])
  // Lexorank-style ordering within column; simple Int for v1.
  rank         Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  comments Comment[]
  activity ActivityLog[]

  @@index([projectId])
  @@index([status])
  @@index([epicId])
  @@index([assigneeId])
  @@index([parentTaskId])
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([taskId])
  @@index([userId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  kind      String // "task.move" | "project.create" | "agent.sync" | ...
  payload   String? // JSON string
  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([taskId])
  @@index([userId])
  @@index([createdAt])
}
