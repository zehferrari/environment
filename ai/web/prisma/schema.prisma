// PM walking skeleton — Stage 1 schema (HOMELAB-43)
// SQLite for v1; same schema portable to Postgres in v1.1+.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------
// Auth + identity
// ------------------------------------------------------------------

model User {
  id                 String          @id @default(cuid())
  username           String          @unique
  email              String          @unique
  kind               String // "human" | "agent"
  // Human profile (admin-editable). Display name + uploaded avatar (a
  // resized PNG stored inline; small, few human users). Agents take their
  // name/avatar from the Agent registry instead, so these stay null for them.
  name               String?
  avatar             Bytes?
  avatarUpdatedAt    DateTime?
  passwordHash       String?
  passwordSetAt      DateTime?
  // Retained for backwards-compatible database reads. No account is forced
  // through a password-rotation flow.
  mustRotatePassword Boolean         @default(false)
  status             String          @default("active") // "invited" | "active" | "deactivated"
  // The first human account owns Mission Control. This is an explicit,
  // immutable capability rather than a username convention.
  isOwner            Boolean         @default(false) @map("is_owner")
  // Access-policy epoch (ENV-168): bumped in-transaction by every
  // access-management mutation. Viewer-scoped streams compare it against the
  // durable database value to detect missed policy changes — the in-process
  // access-change hub is only an accelerator (see
  // lib/users/access-change-hub.ts).
  policyVersion      Int             @default(0)
  // Canonical human role. Owner authority still comes exclusively from
  // isOwner; the relation makes owner/admin/customer explicit for policy and
  // presentation without allowing a role row to manufacture ownership.
  rolePermissionId   String?
  rolePermission     RolePermission? @relation(fields: [rolePermissionId], references: [id])
  agentId            String?         @unique
  agent              Agent?          @relation(fields: [agentId], references: [id])
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  passwordResetTokens            PasswordResetToken[]
  projectMembers                 ProjectMember[]
  assignedTasks                  Task[]                          @relation("TaskAssignee")
  actingManagerOf                Task[]                          @relation("TaskActingManager")
  reportedTasks                  Task[]                          @relation("TaskReporter")
  approvedTasks                  Task[]                          @relation("TaskApprovedBy")
  archivedTasks                  Task[]                          @relation("TaskArchivedBy")
  deletedTasks                   Task[]                          @relation("TaskDeletedBy")
  actingManagerOfEpic            Epic[]                          @relation("EpicActingManager")
  deployReviewerOfEpics          Epic[]                          @relation("EpicDeployReviewer")
  reportedEpics                  Epic[]                          @relation("EpicReporter")
  approvedEpics                  Epic[]                          @relation("EpicApprovedBy")
  archivedEpics                  Epic[]                          @relation("EpicArchivedBy")
  deletedEpics                   Epic[]                          @relation("EpicDeletedBy")
  epicWorkerAssignments          EpicWorker[]
  comments                       Comment[]
  deletedComments                Comment[]                       @relation("CommentDeletedBy")
  activity                       ActivityLog[]
  accessAuditsAsActor            AccessAuditLog[]                @relation("AccessAuditActor")
  accessAuditsAsAffected         AccessAuditLog[]                @relation("AccessAuditAffected")
  uploadedAttachments            Attachment[]
  agentChatMessages              AgentChatMessage[]              @relation("AgentChatSender")
  deletedAgentChatMessages       AgentChatMessage[]              @relation("AgentChatMessageDeletedBy")
  archivedAgentChatRooms         AgentChatRoomArchive[]          @relation("AgentChatRoomArchivedBy")
  deletedAgentChatRoomArchives   AgentChatRoomArchive[]          @relation("AgentChatRoomArchiveDeletedBy")
  directAgentChatMessages        DirectAgentChatMessage[]        @relation("DirectAgentChatSender")
  deletedDirectAgentChatMessages DirectAgentChatMessage[]        @relation("DirectAgentChatMessageDeletedBy")
  archivedDirectAgentChats       DirectAgentChatArchive[]        @relation("DirectAgentChatArchivedBy")
  deletedDirectAgentChatArchives DirectAgentChatArchive[]        @relation("DirectAgentChatArchiveDeletedBy")
  defaultAssigneeForProjects     Project[]                       @relation("ProjectDefaultAssignee")
  defaultReviewerForProjects     Project[]                       @relation("ProjectDefaultReviewer")
  managerAssignableProjects      ProjectManagerAssignableAgent[]
  deletedProjects                Project[]                       @relation("ProjectDeletedBy")
  workItemProposalsProposed      WorkItemProposal[]              @relation("WorkItemProposalProposedBy")
  workItemProposalsApplied       WorkItemProposal[]              @relation("WorkItemProposalAppliedBy")
  workItemProposalsRejected      WorkItemProposal[]              @relation("WorkItemProposalRejectedBy")
  archivedWorkspaces             Workspace[]                     @relation("WorkspaceArchivedBy")
  actionPlans                    ActionPlan[]                    @relation("ActionPlanApprovedBy")
  authoredActionPlans            ActionPlan[]                    @relation("ActionPlanAuthor")
  authoredActionPlanRevisions    ActionPlanRevision[]            @relation("ActionPlanRevisionAuthor")
  approvedActionPlanRevisions    ActionPlanRevision[]            @relation("ActionPlanRevisionApprovedBy")
  actionPlanStepAssignees        ActionPlanStep[]                @relation("ActionPlanStepAssignee")
  actionPlanRevisionAssignees    ActionPlanRevisionStep[]        @relation("ActionPlanRevisionStepAssignee")
  workflowTransitions            WorkflowTransition[]            @relation("WorkflowTransitionActor")

  @@index([kind])
  @@index([status])
  @@index([isOwner])
  @@index([rolePermissionId])
}

model RolePermission {
  id          String   @id @default(cuid())
  name        String   @unique // canonical human role: "owner" | "admin" | "customer"
  description String?
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ------------------------------------------------------------------
// Agent registry mirror (system-managed; sourced from /srv/agents/index.json)
// ------------------------------------------------------------------

model Agent {
  id            String    @id @default(cuid())
  // slug from index.json (for example, "coding-agent-a")
  slug          String    @unique
  name          String
  email         String?
  role          String // "coding" | "monitor" | ...
  codeOwner     String? // codeOwner from index.json
  gatewayPort   Int? // listeners[?owner=='openclaw-gateway'].port
  avatar        String?
  rawJson       String? // last-seen JSON entry (for debugging)
  deactivatedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user           User?
  workspacePools WorkspaceAgentPool[]

  @@index([role])
  @@index([deactivatedAt])
}

// ------------------------------------------------------------------
// Projects + boards
// ------------------------------------------------------------------

model Project {
  id                                  String                          @id @default(cuid())
  slug                                String                          @unique
  name                                String
  description                         String?
  // On-disk README for the project (Stage 2 design decision):
  // points at /srv/Data/projects/<id>/README.md (deploy/runtime path,
  // outside the app source tree). Server renders via lib/markdown.
  readmePath                          String?
  archivedAt                          DateTime?
  // Project settings tab fields. Repo + git identity drive agent
  // commits; defaults seed Task pickers; doneTtlDays controls automatic
  // archiving of aged Done tasks.
  repositoryPath                      String?
  // Project-wide execution contract. "repository" provisions/revalidates a
  // Git worktree; "general" is artifact/research work with no Git contract.
  workMode                            String                          @default("repository") @map("work_mode")
  defaultGitUserName                  String?
  defaultGitUserEmail                 String?
  workItemKeyPrefix                   String?                         @unique @map("work_item_key_prefix")
  nextWorkItemNumber                  Int                             @default(1) @map("next_work_item_number")
  onlyReportersCanApproveActionPlans  Boolean                         @default(false) @map("only_reporters_can_approve_action_plans")
  onlyReportersCanSetTasksDone        Boolean                         @default(false) @map("only_reporters_can_set_tasks_done")
  onlyReportersCanApprovePullRequests Boolean                         @default(false) @map("only_reporters_can_approve_pull_requests")
  deployReviewPrompt                  String?                         @map("deploy_review_prompt")
  billingPrompt                       String?                         @map("billing_prompt")
  // Overrides the workspace rate. Null inherits; there is no system default.
  hourlyRateCents                     Int?                            @map("hourly_rate_cents")
  defaultAssigneeId                   String?
  defaultAssignee                     User?                           @relation("ProjectDefaultAssignee", fields: [defaultAssigneeId], references: [id])
  defaultReviewerId                   String?
  defaultReviewer                     User?                           @relation("ProjectDefaultReviewer", fields: [defaultReviewerId], references: [id])
  managerAssignableAgents             ProjectManagerAssignableAgent[]
  // Null inherits the system default (SystemSettings.doneTtlDays → 5).
  doneTtlDays                         Int?
  deploymentProvider                  String                          @default("bitbucket") @map("deployment_provider")
  deploymentProductionBranch          String?                         @map("deployment_production_branch")
  deploymentPrTargetBranch            String?                         @map("deployment_pr_target_branch")
  deploymentMode                      String                          @default("pr-only") @map("deployment_mode")
  deploymentOnMerge                   String?                         @map("deployment_on_merge")
  deploymentPipelineName              String?                         @map("deployment_pipeline_name")
  deploymentHost                      String?                         @map("deployment_host")
  deploymentEnvironment               String?                         @map("deployment_environment")
  deploymentBitbucketWorkspace        String?                         @map("deployment_bitbucket_workspace")
  deploymentBitbucketRepoSlug         String?                         @map("deployment_bitbucket_repo_slug")
  // JSON string array of branch names where agents must not submit code-changing work.
  agentChangeBlockedBranches          String?                         @map("agent_change_blocked_branches")
  // Provider-agnostic, non-secret integration defaults. Overrides workspace and system defaults.
  integrationDefaults                 String?                         @map("integration_defaults")
  // Translucent background tint for this project's group on the unified
  // workspaces board. Random default at creation; editable in settings.
  backgroundColor                     String?                         @map("background_color")
  // Soft-delete: project bin with 30-day TTL (hard-purge via the
  // hourly job in instrumentation.node.ts).
  deletedAt                           DateTime?
  deletedById                         String?
  deletedBy                           User?                           @relation("ProjectDeletedBy", fields: [deletedById], references: [id])
  createdAt                           DateTime                        @default(now())
  updatedAt                           DateTime                        @updatedAt

  members                ProjectMember[]
  workspaces             WorkspaceProject[]
  billingRateSchedule    BillingRateSchedule[]
  epics                  Epic[]
  tasks                  Task[]
  activity               ActivityLog[]
  attachments            Attachment[]
  chatMessages           AgentChatMessage[]
  chatRoomArchives       AgentChatRoomArchive[]
  directChatMessages     DirectAgentChatMessage[]        @relation("DirectChatProject")
  directChatProjectLinks DirectAgentChatMessageProject[]
  workItemProposals      WorkItemProposal[]
  deploymentPullRequests DeploymentPullRequest[]
  validationProfile      ProjectValidationProfile?
  validationCheckRuns    ValidationCheckRun[]
  billingReports         BillingReport[]

  @@index([deletedAt])
}

model Workspace {
  id                           String    @id @default(cuid())
  slug                         String    @unique
  name                         String
  description                  String?
  type                         String    @default("internal")
  archivedAt                   DateTime? @map("archived_at")
  archivedById                 String?   @map("archived_by")
  archivedBy                   User?     @relation("WorkspaceArchivedBy", fields: [archivedById], references: [id])
  logoPath                     String?   @map("logo_path")
  logoMimeType                 String?   @map("logo_mime_type")
  logoSizeBytes                Int?      @map("logo_size_bytes")
  logoUpdatedAt                DateTime? @map("logo_updated_at")
  // Border colour for this workspace's group on the unified board.
  // Random default at creation; editable in workspace settings.
  borderColor                  String?   @map("border_color")
  // Nullable workspace defaults sit between project-specific settings and
  // SystemSettings. Existing project rows keep precedence; blank fields inherit.
  defaultGitUserName           String?   @map("default_git_user_name")
  defaultGitUserEmail          String?   @map("default_git_user_email")
  doneTtlDays                  Int?      @map("done_ttl_days")
  deploymentProvider           String?   @map("deployment_provider")
  deploymentProductionBranch   String?   @map("deployment_production_branch")
  deploymentPrTargetBranch     String?   @map("deployment_pr_target_branch")
  deploymentMode               String?   @map("deployment_mode")
  deploymentOnMerge            String?   @map("deployment_on_merge")
  deploymentPipelineName       String?   @map("deployment_pipeline_name")
  deploymentHost               String?   @map("deployment_host")
  deploymentEnvironment        String?   @map("deployment_environment")
  deploymentBitbucketWorkspace String?   @map("deployment_bitbucket_workspace")
  deploymentBitbucketRepoSlug  String?   @map("deployment_bitbucket_repo_slug")
  // Provider-agnostic integration defaults. Stored as JSON text and exposed
  // only as non-secret configuration; secrets stay in their existing stores.
  integrationDefaults          String?   @map("integration_defaults")
  // Client rate for every project in this workspace unless the project overrides it.
  hourlyRateCents              Int?      @map("hourly_rate_cents")
  billingCurrency              String?   @map("billing_currency")
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  projects  WorkspaceProject[]
  agentPool WorkspaceAgentPool[]
  billingRateSchedule BillingRateSchedule[]

  @@index([archivedAt])
  @@index([type])
}

model WorkspaceProject {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, projectId])
  @@index([projectId])
}

model WorkspaceAgentPool {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agentId     String
  agent       Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, agentId])
  @@index([agentId])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("member")
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

model Epic {
  id                           String    @id @default(cuid())
  projectId                    String
  project                      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title                        String
  workItemKey                  String?   @unique @map("work_item_key")
  description                  String?
  private                      Boolean   @default(false)
  // "Backlog" | "To Do" | "In Progress" | "Review" | "Done" — deployment readiness is
  // NOT a status: Ready-to-Deploy lives on the separate deploymentStatus lane.
  status                       String    @default("Backlog")
  statusChangedAt              DateTime?
  // Whole-Epic acceptance is distinct from both child-Task review and the
  // optional post-Done deployment review. The last accepted child moves the
  // Epic to Review while the repository runner freezes the combined candidate.
  // "Not Required" | "Preparing" | "Pending" | "Approval Pending" |
  // "Approved" | "Changes Requested" | "Operational Error"
  completionReviewStatus       String    @default("Not Required") @map("completion_review_status")
  completionReviewCandidateSha String?   @map("completion_review_candidate_sha")
  completionReviewRequestedAt  DateTime? @map("completion_review_requested_at")
  completionReviewCompletedAt  DateTime? @map("completion_review_completed_at")
  completionReviewLastError    String?   @map("completion_review_last_error")
  // Epic-level acting manager plus a multi-agent worker pool. Task
  // assignee stays single; Epic workers define which coding agents the
  // manager may pick from for child Tasks.
  actingManagerId              String?
  actingManager                User?     @relation("EpicActingManager", fields: [actingManagerId], references: [id])
  deployReviewerId             String?
  deployReviewer               User?     @relation("EpicDeployReviewer", fields: [deployReviewerId], references: [id])
  reporterId                   String?
  reporter                     User?     @relation("EpicReporter", fields: [reporterId], references: [id])
  approvedOn                   DateTime? @map("approved_on")
  approvedById                 String?   @map("approved_by")
  approvedBy                   User?     @relation("EpicApprovedBy", fields: [approvedById], references: [id])
  archivedAt                   DateTime? @map("archived_at")
  archivedById                 String?   @map("archived_by")
  archivedBy                   User?     @relation("EpicArchivedBy", fields: [archivedById], references: [id])
  // Epic-level git overrides inherited dynamically by child Tasks while their
  // own fields are null. A blank Epic falls back to its human work-item key.
  branchName                   String?
  commitPrefix                 String?
  // Soft delete (HOMELAB-48). deletedAt != null means the row is in the
  // bin; active reads filter deletedAt: null. Hard purge happens after
  // 7 days via the instrumentation interval. deletedById captures the
  // actor (User row, kind tells human vs agent).
  deploymentStatus             String    @default("Not Required") @map("deployment_status")
  deletedAt                    DateTime?
  deletedById                  String?
  deletedBy                    User?     @relation("EpicDeletedBy", fields: [deletedById], references: [id])
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  tasks                  Task[]
  workers                EpicWorker[]
  attachments            Attachment[]
  comments               Comment[]
  deploymentPullRequests DeploymentPullRequest[]
  chats                  AgentChatMessage[]      @relation("EpicChat")
  chatRoomArchives       AgentChatRoomArchive[]  @relation("EpicChatRoomArchive")

  @@index([projectId])
  @@index([workItemKey])
  @@index([status])
  @@index([private])
  @@index([statusChangedAt])
  @@index([actingManagerId])
  @@index([deployReviewerId])
  @@index([reporterId])
  @@index([approvedById])
  @@index([archivedAt])
  @@index([archivedById])
  @@index([deletedAt])
}

model EpicWorker {
  id        String   @id @default(cuid())
  epicId    String
  epic      Epic     @relation(fields: [epicId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([epicId, userId])
  @@index([userId])
}

model ProjectManagerAssignableAgent {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

model Task {
  id                     String           @id @default(cuid())
  projectId              String
  project                Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  epicId                 String?
  epic                   Epic?            @relation(fields: [epicId], references: [id])
  // DEPRECATED (ENV-60): the former self-referential child-Task "sub-task"
  // hierarchy. Sub-tasks are now lightweight checklist rows (see model SubTask
  // / Task.checklist), not child Tasks. This column + self-relation are kept
  // dormant — no live row sets parentTaskId and no code path writes it — to
  // avoid a SQLite table rebuild on the production DB. Drop in a later
  // maintenance migration once a downtime window is acceptable.
  parentTaskId           String?
  parent                 Task?            @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks               Task[]           @relation("TaskSubtasks")
  // Legacy primary hard dependency (ENV-62). New workflow code stores the full
  // dependency graph in TaskDependency and reads the union of both shapes so
  // old rows and the human single-prerequisite editor remain compatible.
  blockedById            String?
  blockedBy              Task?            @relation("TaskBlockedBy", fields: [blockedById], references: [id], onDelete: SetNull)
  blocking               Task[]           @relation("TaskBlockedBy")
  dependencies           TaskDependency[] @relation("TaskDependencies")
  dependents             TaskDependency[] @relation("TaskDependents")
  title                  String
  workItemKey            String?          @unique @map("work_item_key")
  description            String?
  private                Boolean          @default(false)
  // Status uses the verbatim Stage 0 labels — no Jira aliases.
  // Backlog | To Do | In Progress | Review | Done
  status                 String           @default("Backlog")
  assigneeId             String?
  assignee               User?            @relation("TaskAssignee", fields: [assigneeId], references: [id])
  // Acting manager: the User who is reviewing/owning the workflow for
  // this task. Pulled from the same users/agents table as assignee per
  // HOMELAB-44 description. Optional; agents may not set themselves as
  // acting manager (see lib/workflow.ts checkActingManager).
  actingManagerId        String?
  actingManager          User?            @relation("TaskActingManager", fields: [actingManagerId], references: [id])
  reporterId             String?
  reporter               User?            @relation("TaskReporter", fields: [reporterId], references: [id])
  approvedOn             DateTime?        @map("approved_on")
  approvedById           String?          @map("approved_by")
  approvedBy             User?            @relation("TaskApprovedBy", fields: [approvedById], references: [id])
  archivedAt             DateTime?        @map("archived_at")
  archivedById           String?          @map("archived_by")
  archivedBy             User?            @relation("TaskArchivedBy", fields: [archivedById], references: [id])
  // Lexorank-style ordering within column; simple Int for v1.
  rank                   Int              @default(0)
  // Set on every status transition; drives automatic archiving of Done
  // tasks after project.doneTtlDays so plain updates to title/description
  // don't reset the clock.
  statusChangedAt        DateTime?
  // Monotonic compare-and-set revision for workflow transitions. Every
  // authoritative board status mutation increments this value and writes the
  // matching immutable WorkflowTransition row in the same transaction.
  workflowVersion        Int              @default(0) @map("workflow_version")
  // When enabled, at least one task attachment must exist before the
  // assignee can submit the task for review.
  reviewAttachmentRequired Boolean        @default(false) @map("review_attachment_required")
  // Optional free-text override. Null inherits the Epic's effective branch
  // (explicit or human-key fallback), then uses this Task's human key.
  branchName             String?
  // Optional commit-message override. Null inherits an explicit Epic prefix,
  // then falls back to this Task's human work-item key.
  commitPrefix           String?
  // Agents set this when human/reporter intervention is required.
  alertReporter          Boolean          @default(false) @map("alert_reporter")
  // Soft delete (HOMELAB-48). See Epic.deletedAt for semantics. Sub-tasks
  // cascade with their parent task; an Epic delete cascades to its
  // non-deleted Tasks (and through them to sub-tasks). Active read
  // queries filter deletedAt: null.
  deploymentStatus       String           @default("Not Required") @map("deployment_status")
  activeWorkflowCycleId  String?          @map("active_workflow_cycle_id")
  // Phase E §5.1 — Durable engine ownership. Determines which workflow engine
  // (legacy or orchestrator_v2) owns this task's mutation path. Ownership is
  // durable state, not a per-request environment-variable decision.
  workflowEngine         String           @default("orchestrator_v2") @map("workflow_engine")
  workflowEnginePinnedAt DateTime?        @default(now()) @map("workflow_engine_pinned_at")
  deletedAt              DateTime?
  deletedById            String?
  deletedBy              User?            @relation("TaskDeletedBy", fields: [deletedById], references: [id])
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  comments               Comment[]
  activity               ActivityLog[]
  deploymentPullRequests DeploymentPullRequest[]
  attachments            Attachment[]
  chats                  AgentChatMessage[]           @relation("TaskChat")
  chatRoomArchives       AgentChatRoomArchive[]       @relation("TaskChatRoomArchive")
  // Lightweight sub-task checklist (ENV-60). NOT the legacy self-referential
  // child-Task hierarchy above (parentTaskId) — that is now dormant. See SubTask.
  actionPlan             ActionPlan?
  actionPlanRevisions    ActionPlanRevision[]
  checklist              SubTask[]                    @relation("TaskChecklist")
  repositoryRun          TaskRepositoryRun?
  executionEpisodes      TaskExecutionEpisode[]
  executionState         TaskExecutionState?
  reviewRuns             ReviewRun[]
  workflowTransitions    WorkflowTransition[]
  workflowOutbox         WorkflowOutbox[]
  workflowCycles         TaskWorkflowCycle[]
  procedureRuns          TaskProcedureRun[]
  commandReceipts        TaskWorkflowCommandReceipt[]

  @@index([projectId])
  @@index([workItemKey])
  @@index([status])
  @@index([private])
  @@index([epicId])
  @@index([assigneeId])
  @@index([parentTaskId])
  @@index([blockedById])
  @@index([actingManagerId])
  @@index([reporterId])
  @@index([approvedById])
  @@index([archivedAt])
  @@index([archivedById])
  @@index([deletedAt])
  @@index([alertReporter])
  @@index([workflowEngine])
}

// A Task can require multiple prerequisite Tasks. Dependencies are scheduling
// gates: every prerequisite must be Done before assignment or start. The
// manager workflow may link public Tasks in projects that share an active
// Workspace, allowing an Epic queue to model controlled cross-project work.
model TaskDependency {
  id                 String   @id @default(cuid())
  taskId             String   @map("task_id")
  task               Task     @relation("TaskDependencies", fields: [taskId], references: [id], onDelete: Cascade)
  prerequisiteTaskId String   @map("prerequisite_task_id")
  prerequisite       Task     @relation("TaskDependents", fields: [prerequisiteTaskId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now()) @map("created_at")

  @@unique([taskId, prerequisiteTaskId])
  @@index([prerequisiteTaskId])
  @@map("task_dependencies")
}

// One implementation attempt from `start` through validation and review.
// Review feedback or validation failure closes the cycle; the next `start`
// opens a new one. The same candidate SHA may legitimately appear in multiple
// cycles — candidate identity is evidence, not a unique review attempt.
model TaskWorkflowCycle {
  id                    String                       @id @default(cuid())
  taskId                String                       @map("task_id")
  task                  Task                         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  sequence              Int
  status                String                       @default("open")
  outcome               String?
  openedWorkflowVersion Int                          @map("opened_workflow_version")
  closedWorkflowVersion Int?                         @map("closed_workflow_version")
  openedByTransitionId  String?                      @map("opened_by_transition_id")
  closedByTransitionId  String?                      @map("closed_by_transition_id")
  baseSha               String?                      @map("base_sha")
  candidateSha          String?                      @map("candidate_sha")
  openedAt              DateTime                     @default(now()) @map("opened_at")
  closedAt              DateTime?                    @map("closed_at")
  // Phase E §5.1 — An open cycle is permanently pinned to its engine.
  // Copied from Task.workflowEngine when the cycle is opened.
  workflowEngine        String                       @default("orchestrator_v2") @map("workflow_engine")
  createdAt             DateTime                     @default(now()) @map("created_at")
  updatedAt             DateTime                     @updatedAt @map("updated_at")
  transitions           WorkflowTransition[]
  outbox                WorkflowOutbox[]
  reviewRun             ReviewRun?
  repositoryRun         TaskRepositoryRun?
  procedureRuns         TaskProcedureRun[]
  commandReceipts       TaskWorkflowCommandReceipt[]

  @@unique([taskId, sequence])
  @@index([taskId, status])
  @@index([status, updatedAt])
  @@index([workflowEngine])
  @@map("task_workflow_cycles")
}

// Phase E §6.1 — Durable command receipt: the single replay authority for
// workflow commands. Replaces the ActivityLog substring scan as the
// idempotency arbiter. Created atomically inside the workflow transaction
// after transition + intent writes succeed, before commit. Rejected commands
// are NOT stored here; operational failures that roll back leave no receipt.
model TaskWorkflowCommandReceipt {
  id                       String             @id @default(cuid())
  taskId                   String             @map("task_id")
  task                     Task               @relation(fields: [taskId], references: [id], onDelete: Cascade)
  workflowCycleId          String?            @map("workflow_cycle_id")
  workflowCycle            TaskWorkflowCycle? @relation(fields: [workflowCycleId], references: [id], onDelete: SetNull)
  idempotencyKey           String             @map("idempotency_key")
  requestFingerprint       String             @map("request_fingerprint")
  intent                   String
  source                   String
  actorUserId              String?            @map("actor_user_id")
  decisionActorId          String?            @map("decision_actor_id")
  executorActorId          String?            @map("executor_actor_id")
  expectedWorkflowVersion  Int                @map("expected_workflow_version")
  resultingWorkflowVersion Int                @map("resulting_workflow_version")
  transitionId             String?            @map("transition_id")
  procedureRunId           String?            @map("procedure_run_id")
  // Milliseconds from transaction-client entry through durable receipt
  // creation. This excludes the driver's final COMMIT round trip but captures
  // fencing, aggregate refresh, domain writes, and receipt settlement.
  executionDurationMs      Int?               @map("execution_duration_ms")
  status                   String // accepted | completed | rejected_operational
  result                   String // bounded canonical JSON response projection
  createdAt                DateTime           @default(now()) @map("created_at")
  updatedAt                DateTime           @updatedAt @map("updated_at")

  @@unique([taskId, idempotencyKey])
  @@index([workflowCycleId, createdAt])
  @@index([intent, createdAt])
  @@index([procedureRunId])
  @@map("task_workflow_command_receipts")
}

// Durable procedure run: an ordered, replay-safe sequence of steps that
// executes the mechanical consequences of a workflow decision (ORCH-03).
// One run per (trigger transition, procedure type). Steps are claimed with
// leases, executed by a closed handler registry, and retried with backoff.
// A step may wait for an asynchronous callback (repository validation/
// finalization) by entering `waiting_callback` with the job id stored in
// output. Handlers may not change task status directly; they enqueue outbox
// effects or invoke the orchestrator for mechanical transitions.
model TaskProcedureRun {
  id                  String              @id @default(cuid())
  taskId              String              @map("task_id")
  task                Task                @relation(fields: [taskId], references: [id], onDelete: Cascade)
  workflowCycleId     String?             @map("workflow_cycle_id")
  workflowCycle       TaskWorkflowCycle?  @relation(fields: [workflowCycleId], references: [id], onDelete: SetNull)
  triggerTransitionId String              @map("trigger_transition_id")
  type                String
  // Phase E §6 — Procedure definition versioning. Both default to 1 so
  // existing rows backfill automatically. PHASEE-06 (ENV-148).
  definitionVersion   Int                 @default(1) @map("definition_version")
  inputSchemaVersion  Int                 @default(1) @map("input_schema_version")
  status              String              @default("queued")
  currentStep         String?             @map("current_step")
  input               String?
  output              String?
  lastError           String?             @map("last_error")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  completedAt         DateTime?           @map("completed_at")
  steps               TaskProcedureStep[]

  @@unique([triggerTransitionId, type])
  @@index([status, updatedAt])
  @@index([taskId, status])
  @@index([workflowCycleId])
  @@map("task_procedure_runs")
}

model TaskProcedureStep {
  id             String           @id @default(cuid())
  procedureRunId String           @map("procedure_run_id")
  procedureRun   TaskProcedureRun @relation(fields: [procedureRunId], references: [id], onDelete: Cascade)
  name           String
  ordinal        Int
  status         String           @default("pending")
  attempts       Int              @default(0)
  availableAt    DateTime         @default(now()) @map("available_at")
  leaseOwner     String?          @map("lease_owner")
  leaseExpiresAt DateTime?        @map("lease_expires_at")
  input          String?
  output         String?
  lastError      String?          @map("last_error")
  startedAt      DateTime?        @map("started_at")
  completedAt    DateTime?        @map("completed_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@unique([procedureRunId, name])
  @@unique([procedureRunId, ordinal])
  @@index([status, availableAt])
  @@index([leaseExpiresAt])
  @@map("task_procedure_steps")
}

// PM-owned repository lifecycle for one Task. Board status remains the
// human-facing workflow; this row records the asynchronous Git phase so
// provisioning, validation, review and finalization can be retried safely.
model TaskRepositoryRun {
  id                String             @id @default(cuid())
  taskId            String             @unique @map("task_id")
  task              Task               @relation(fields: [taskId], references: [id], onDelete: Cascade)
  workflowCycleId   String?            @unique @map("workflow_cycle_id")
  workflowCycle     TaskWorkflowCycle? @relation(fields: [workflowCycleId], references: [id], onDelete: SetNull)
  repositoryPath    String?            @map("repository_path")
  branchName        String?            @map("branch_name")
  worktreePath      String?            @map("worktree_path")
  epicBranch        String?            @map("epic_branch")
  baseSha           String?            @map("base_sha")
  candidateSha      String?            @map("candidate_sha")
  reviewedSha       String?            @map("reviewed_sha")
  phase             String             @default("reserved")
  validationOutcome String?            @map("validation_outcome")
  repoTouched       Boolean?           @map("repo_touched")
  lastError         String?            @map("last_error")
  attempt           Int                @default(0)
  version           Int                @default(0)
  // PHASEE-07: durable publication and replay state.
  // Tracks publication state per job so crash-replay can re-publish
  // deterministically without creating duplicate spool files.
  // The original physical names were lost when the later-added ENV-159
  // lifecycle migration rebuilt this table on databases that had already
  // applied PHASEE-07. Use fresh physical names so a forward-only repair
  // migration works both for those drifted databases and clean installs.
  publicationState  String?            @map("publication_state_v2")
  replayCount       Int                @default(0) @map("replay_count_v2")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  @@index([phase])
  @@index([validationOutcome])
  @@index([publicationState])
  @@map("task_repository_runs")
}

// One immutable review lease per validated repository candidate. Reviewers
// approve this row's candidateSha, never a moving branch name. A new candidate
// creates a new ReviewRun and invalidates any older awaiting-review row.
model ReviewRun {
  id                String               @id @default(cuid())
  taskId            String               @map("task_id")
  task              Task                 @relation(fields: [taskId], references: [id], onDelete: Cascade)
  workflowCycleId   String?              @unique @map("workflow_cycle_id")
  workflowCycle     TaskWorkflowCycle?   @relation(fields: [workflowCycleId], references: [id], onDelete: SetNull)
  candidateSha      String               @map("candidate_sha")
  baseSha           String?              @map("base_sha")
  repoTouched       Boolean              @map("repo_touched")
  validationOutcome String               @map("validation_outcome")
  // Immutable JSON snapshot of task attachments present when review began.
  attachmentSnapshot String?             @map("attachment_snapshot")
  status            String               @default("awaiting_review")
  reviewerId        String?              @map("reviewer_id")
  reviewedAt        DateTime?            @map("reviewed_at")
  invalidatedAt     DateTime?            @map("invalidated_at")
  invalidatedReason String?              @map("invalidated_reason")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  validationChecks  ValidationCheckRun[]

  @@index([taskId, status])
  @@index([taskId, candidateSha])
  @@index([status, createdAt])
  @@map("review_runs")
}

// Immutable ledger written by the task transition kernel. `idempotencyKey`
// identifies the caller's intent; workflowVersion is the Task CAS revision
// produced by that intent.
model WorkflowTransition {
  id              String             @id @default(cuid())
  taskId          String             @map("task_id")
  task            Task               @relation(fields: [taskId], references: [id], onDelete: Cascade)
  workflowCycleId String?            @map("workflow_cycle_id")
  workflowCycle   TaskWorkflowCycle? @relation(fields: [workflowCycleId], references: [id], onDelete: SetNull)
  workflowVersion Int                @map("workflow_version")
  intent          String
  fromStatus      String             @map("from_status")
  toStatus        String             @map("to_status")
  actorUserId     String?            @map("actor_user_id")
  actor           User?              @relation("WorkflowTransitionActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  source          String
  idempotencyKey  String             @map("idempotency_key")
  evidence        String?
  createdAt       DateTime           @default(now()) @map("created_at")
  outbox          WorkflowOutbox[]

  @@unique([taskId, workflowVersion])
  @@unique([taskId, idempotencyKey])
  @@index([intent, createdAt])
  @@index([actorUserId])
  @@index([workflowCycleId])
  @@map("workflow_transitions")
}

// Durable projection queue for every external consequence of a committed
// workflow decision. Workers lease these rows and project them to PM-channel
// jobs, repository spools, and board events. The database row—not a spool
// filename—is the source of truth.
model WorkflowOutbox {
  id               String              @id @default(cuid())
  taskId           String              @map("task_id")
  task             Task                @relation(fields: [taskId], references: [id], onDelete: Cascade)
  projectId        String              @map("project_id")
  transitionId     String?             @map("transition_id")
  transition       WorkflowTransition? @relation(fields: [transitionId], references: [id], onDelete: Cascade)
  workflowCycleId  String?             @map("workflow_cycle_id")
  workflowCycle    TaskWorkflowCycle?  @relation(fields: [workflowCycleId], references: [id], onDelete: SetNull)
  aggregateVersion Int                 @map("aggregate_version")
  effectType       String              @map("effect_type")
  payload          String
  dedupeKey        String              @unique @map("dedupe_key")
  status           String              @default("queued")
  attempts         Int                 @default(0)
  availableAt      DateTime            @default(now()) @map("available_at")
  leaseOwner       String?             @map("lease_owner")
  leaseExpiresAt   DateTime?           @map("lease_expires_at")
  completedAt      DateTime?           @map("completed_at")
  lastError        String?             @map("last_error")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  @@index([status, availableAt])
  @@index([leaseExpiresAt])
  @@index([taskId, aggregateVersion])
  @@index([transitionId])
  @@index([workflowCycleId])
  @@map("workflow_outbox")
}

model ProjectValidationProfile {
  id        String   @id @default(cuid())
  projectId String   @unique @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version   Int      @default(1)
  enabled   Boolean  @default(true)
  // JSON array of {name, executable, args[], timeoutSeconds, required}.
  // Executed with execFile in the registered candidate worktree; never a shell.
  commands  String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("project_validation_profiles")
}

model ValidationCheckRun {
  id             String     @id @default(cuid())
  projectId      String     @map("project_id")
  project        Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId         String     @map("task_id")
  reviewRunId    String?    @map("review_run_id")
  reviewRun      ReviewRun? @relation(fields: [reviewRunId], references: [id], onDelete: Cascade)
  candidateSha   String     @map("candidate_sha")
  jobId          String     @map("job_id")
  profileId      String?    @map("profile_id")
  profileVersion Int        @default(0) @map("profile_version")
  checkName      String     @map("check_name")
  executable     String
  arguments      String
  required       Boolean    @default(true)
  status         String     @default("running")
  exitCode       Int?       @map("exit_code")
  output         String?
  startedAt      DateTime   @default(now()) @map("started_at")
  finishedAt     DateTime?  @map("finished_at")

  @@unique([jobId, checkName])
  @@index([taskId, candidateSha])
  @@index([reviewRunId])
  @@index([status, startedAt])
  @@map("validation_check_runs")
}

// ENV-121 — one bounded execution episode for one (Task, agent).
//
// The problem this replaces: a single OpenClaw session carried the whole task
// — description, every comment, every browser trace, every continuation — and
// grew until compaction was the only memory strategy left. Compaction is lossy
// and unobservable; a structured checkpoint is neither.
//
// An episode is opened when PM dispatches an execution turn, accrues one
// `cycleCount` per continuation-required workflow action, and is CLOSED with a
// structured checkpoint when the budget is spent or the turn reaches an
// episode-terminal action. The next episode starts from that checkpoint in a
// fresh model session instead of inheriting the transcript.
//
// Duplicate-episode safety (the property the reviewer asked for): `episodeNo`
// is allocated inside the same transaction that closes the previous episode,
// and @@unique([taskId, agentSlug, episodeNo]) makes a retried or concurrent
// rollover fail loudly instead of minting a second episode 3.
model TaskExecutionEpisode {
  id                        String    @id @default(cuid())
  taskId                    String    @map("task_id")
  task                      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  projectId                 String?   @map("project_id")
  agentSlug                 String    @map("agent_slug")
  // Monotonic per (task, agent). Allocated as max+1 under the unique index.
  episodeNo                 Int       @map("episode_no")
  // The OpenClaw session this episode ran in, and the PM turn that opened it.
  sessionKey                String?   @map("session_key")
  messageId                 String?   @map("message_id")
  runId                     String?   @map("run_id")
  // Observable server-side cycle accounting. `cycleBudget` is snapshotted at
  // open time so changing the env default mid-flight cannot retroactively
  // exhaust (or revive) an episode that is already running.
  cycleCount                Int       @default(0) @map("cycle_count")
  cycleBudget               Int       @map("cycle_budget")
  // Finer-grained observable budget: PM-visible `tool:call` stream events seen
  // while this episode was open. Workflow actions are the coarse unit; tool
  // calls are the unit that actually grows a turn's context.
  toolCycleCount            Int       @default(0) @map("tool_cycle_count")
  toolCycleBudget           Int       @default(0) @map("tool_cycle_budget")
  // The rollover barrier. When a budget is exhausted PM records WHICH PM turn
  // spent it; that message is then fenced out of the successor episode and may
  // only write one final checkpoint, which sets `barrierReleasedAt`.
  exhaustedByMessageId      String?   @map("exhausted_by_message_id")
  barrierReleasedAt         DateTime? @map("barrier_released_at")
  // The successor half of the seal, kept as durable outbox state. Consuming
  // the barrier and arming the successor's continuation happen in one
  // transaction, so `barrier_released_at IS NOT NULL AND
  // successor_scheduled_at IS NULL` means the seal committed but the
  // continuation could not be armed (no run row to hang it on yet). That is a
  // recoverable state, not a stall: the sweeper retries the scheduling half
  // without ever touching the stored checkpoint.
  successorScheduledAt      DateTime? @map("successor_scheduled_at")
  successorScheduleAttempts Int       @default(0) @map("successor_schedule_attempts")
  // open | closed
  status                    String    @default("open")
  // Structured checkpoint. JSON-encoded string arrays, kept as TEXT because
  // the deployment target is SQLite. Written on every cycle (derived) and
  // overwritable verbatim by the agent through action=checkpoint.
  completedWork             String?   @map("completed_work")
  evidence                  String?
  openChecklist             String?   @map("open_checklist")
  nextAction                String?   @map("next_action")
  risks                     String?
  checkpointAt              DateTime? @map("checkpoint_at")
  closeReason               String?   @map("close_reason")
  startedAt                 DateTime  @default(now()) @map("started_at")
  closedAt                  DateTime? @map("closed_at")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  @@unique([taskId, agentSlug, episodeNo])
  @@index([taskId, status])
  @@index([agentSlug])
  @@index([runId])
  @@index([exhaustedByMessageId])
  @@index([successorScheduledAt])
  @@map("task_execution_episodes")
}

// ENV-123 — the operator-visible execution state of a task.
//
// One row per Task. Everything an operator previously had to infer by reading
// comments ("is this agent actually working, or did its turn die twenty
// minutes ago?") is a column here, written by the watchdog pass and by ordinary
// workflow transitions. The task detail page renders it verbatim:
//
//   Execution: stalled
//   Reason: no active run
//   Last durable action: started at 09:24
//   Recovery: new run queued
//
// `recoveryCount` and `breakerOpenUntil` are the circuit breaker. A detector
// whose repair does not stick would otherwise re-fire forever, so the watchdog
// stops repairing a task after a bounded number of auto-recoveries per window
// and escalates instead. That is what keeps the watchdog from becoming the
// runaway loop it exists to catch.
model TaskExecutionState {
  id                  String    @id @default(cuid())
  taskId              String    @unique @map("task_id")
  task                Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  projectId           String?   @map("project_id")
  // running | idle | stalled | blocked | waiting_review
  state               String
  // Stable machine identity for the reason, e.g. "no_active_run".
  reasonCode          String?   @map("reason_code")
  // One human sentence rendered under "Reason:".
  reasonDetail        String?   @map("reason_detail")
  // The last workflow action PM durably recorded for this task, and when.
  lastDurableAction   String?   @map("last_durable_action")
  lastDurableActionAt DateTime? @map("last_durable_action_at")
  // What the watchdog did about it, and when. Null = nothing was needed.
  recoveryAction      String?   @map("recovery_action")
  recoveryAt          DateTime? @map("recovery_at")
  // Which detector produced the current state.
  detectorId          String?   @map("detector_id")
  // Circuit breaker accounting.
  recoveryCount       Int       @default(0) @map("recovery_count")
  recoveryWindowAt    DateTime? @map("recovery_window_at")
  breakerOpenUntil    DateTime? @map("breaker_open_until")
  // Set when the breaker tripped or an escalate-only detector fired, so the
  // reporter/acting manager is notified exactly once per episode of trouble.
  escalatedAt         DateTime? @map("escalated_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([state])
  @@index([projectId])
  @@map("task_execution_states")
}

// Lightweight sub-task checklist (ENV-60). A SubTask is NOT a Task: it has no
// assignee, reviewer, status, work-item key, or board presence. It is a single
// goal line plus an optional completion timestamp. The point is progress: a
// task broken into checklist items shows "done/total" on its board card so you
// can see how close an in-flight task is to finished. Replaces the former
// self-referential child-Task hierarchy (Task.parentTaskId, now dormant).
// Humans tick items in the task editor; the assignee agent ticks them through
// the native workflow endpoint (action=add_subtask / complete_subtask).
model SubTask {
  id               String          @id @default(cuid())
  taskId           String
  task             Task            @relation("TaskChecklist", fields: [taskId], references: [id], onDelete: Cascade)
  actionPlanStepId String?         @unique @map("action_plan_step_id")
  actionPlanStep   ActionPlanStep? @relation(fields: [actionPlanStepId], references: [id], onDelete: SetNull)
  text             String
  // Which phase this checklist item belongs to: "implementation" items are
  // the assignee's In Progress breakdown; "review" items are the reviewer's
  // topics-to-address list created when the task reaches Review. The board
  // card shows the progress of whichever kind matches the task's column.
  kind             String          @default("implementation")
  // null = open; a timestamp = done. This is the "hidden field with the
  // timestamp when it was complete" — surfaced only as a checkbox + progress.
  completedAt      DateTime?
  // Self-reported effort for this step, captured when the assignee ticks it
  // done (ENV-61). Summed across a task's checklist for a rough cost view.
  minutesSpent     Int?
  // Ordering within the task's checklist.
  rank             Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([taskId, kind, text])
  @@index([taskId])
  @@index([taskId, kind])
}

// ------------------------------------------------------------------
// ENV-119: Structured Action Plans. Replaces parsing Markdown from
// AgentChatMessage.body. The ActionPlan is a 1:1 row per Task; each
// ActionPlanStep is a structured step with acceptance criteria, kind,
// and optional assignee. Markdown body remains in AgentChatMessage as
// presentation only.
// ------------------------------------------------------------------

model ActionPlan {
  reviewedAt      DateTime?
  reviewedById    String?
  delegatedApproverId String?
  delegatedById   String?
  id              String               @id @default(cuid())
  taskId          String               @unique
  task            Task                 @relation(fields: [taskId], references: [id], onDelete: Cascade)
  summary         String
  version         Int                  @default(1)
  status          String               @default("draft")
  authorId        String?
  author          User?                @relation("ActionPlanAuthor", fields: [authorId], references: [id])
  sourceRunId     String?
  sourceMessageId String?
  contentHash     String               @default("")
  approvedOn      DateTime?
  approvedById    String?
  approvedBy      User?                @relation("ActionPlanApprovedBy", fields: [approvedById], references: [id])
  steps           ActionPlanStep[]
  revisions       ActionPlanRevision[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([approvedById])
  @@index([authorId])
  @@index([sourceRunId])
}

model ActionPlanRevision {
  id              String                   @id @default(cuid())
  actionPlanId    String
  actionPlan      ActionPlan               @relation(fields: [actionPlanId], references: [id], onDelete: Cascade)
  taskId          String
  task            Task                     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  version         Int
  summary         String
  status          String                   @default("draft")
  authorId        String?
  author          User?                    @relation("ActionPlanRevisionAuthor", fields: [authorId], references: [id])
  sourceRunId     String?
  sourceMessageId String?
  contentHash     String
  approvedOn      DateTime?
  approvedById    String?
  approvedBy      User?                    @relation("ActionPlanRevisionApprovedBy", fields: [approvedById], references: [id])
  steps           ActionPlanRevisionStep[]
  createdAt       DateTime                 @default(now())

  @@unique([taskId, version])
  @@unique([actionPlanId, version])
  @@index([authorId])
  @@index([approvedById])
  @@index([sourceRunId])
}

model ActionPlanRevisionStep {
  id                 String             @id @default(cuid())
  revisionId         String
  revision           ActionPlanRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  stepId             String
  title              String
  acceptanceCriteria String
  kind               StepKind           @default(sequential)
  assigneeId         String?
  assignee           User?              @relation("ActionPlanRevisionStepAssignee", fields: [assigneeId], references: [id])
  rank               Int                @default(0)
  createdAt          DateTime           @default(now())

  @@unique([revisionId, stepId])
  @@index([revisionId, rank])
  @@index([assigneeId])
}

enum StepKind {
  sequential
  parallel
}

model ActionPlanStep {
  id                 String     @id @default(cuid())
  actionPlanId       String
  actionPlan         ActionPlan @relation(fields: [actionPlanId], references: [id], onDelete: Cascade)
  stepId             String
  title              String
  acceptanceCriteria String // JSON-encoded string[]
  kind               StepKind   @default(sequential)
  assigneeId         String?
  assignee           User?      @relation("ActionPlanStepAssignee", fields: [assigneeId], references: [id])
  rank               Int        @default(0)
  createdAt          DateTime   @default(now())
  checklistItem      SubTask?

  @@unique([actionPlanId, stepId])
  @@index([actionPlanId, rank])
  @@index([assigneeId])
}

// ------------------------------------------------------------------
// HOMELAB-47 attachments — file metadata; bytes live on disk under
// /srv/Data/projects/<projectId>/attachments/<sha256> (deploy host) or
// ./.data/attachments/<projectId>/<sha256> (local-dev fallback). A row may
// belong directly to the project or to one task/epic; taskId + epicId
// together is rejected server-side since SQLite has no portable check.
// ------------------------------------------------------------------

model Attachment {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId      String?
  task        Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  epicId      String?
  epic        Epic?    @relation(fields: [epicId], references: [id], onDelete: Cascade)
  uploaderId  String
  uploader    User     @relation(fields: [uploaderId], references: [id])
  filename    String
  storagePath String // path relative to the project's attachments dir
  mimeType    String
  sizeBytes   Int
  sha256      String
  createdAt   DateTime @default(now())

  @@index([projectId])
  @@index([taskId])
  @@index([epicId])
  @@index([sha256])
}

// Cached, bounded text extraction for agent context. This is keyed by
// content hash rather than Attachment.id so duplicate uploads reuse the
// same extraction result.
model AttachmentExtract {
  id                 String   @id @default(cuid())
  sourceAttachmentId String?
  sha256             String
  extractorVersion   String
  status             String // "ready" | "unsupported" | "failed"
  text               String?
  summary            String?
  error              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([sha256, extractorVersion])
  @@index([sourceAttachmentId])
  @@index([status])
}

model Comment {
  id              String        @id @default(cuid())
  // A comment belongs to a Task XOR an Epic (mirrors Attachment). Both FKs
  // are nullable; exactly one is set, enforced in the server actions.
  taskId          String?
  task            Task?         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  epicId          String?
  epic            Epic?         @relation(fields: [epicId], references: [id], onDelete: Cascade)
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  body            String
  createdAt       DateTime      @default(now())
  // Soft delete (HOMELAB-41 / item 2). Active reads filter
  // deletedAt: null; agent-context builders ALWAYS filter deleted rows
  // out so deleted content never reaches an agent. The frontend renders
  // deleted rows as a collapsed dotted divider with a [+] toggle so a
  // human reviewer can expand them on demand.
  deletedAt       DateTime?
  deletedById     String?
  deletedBy       User?         @relation("CommentDeletedBy", fields: [deletedById], references: [id])
  // ENV-122 — comment metadata for identity-normalized rendering.
  // authorAgentSlug: agent slug if author is an agent, null for humans.
  // provider/model: LLM provenance when produced via a PM-channel run.
  // runId: FK to PmChannelRun.id when produced via a PM-channel run.
  // commentKind: agent_reply | workflow_action | blocker_notice | runtime_error | human
  // isGenerated: true if PM/system generated this comment (not authored by a human/agent).
  authorAgentSlug String?       @map("author_agent_slug")
  provider        String?
  model           String?
  runId           String?       @map("run_id")
  run             PmChannelRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  commentKind     String?       @map("comment_kind")
  isGenerated     Boolean       @default(false) @map("is_generated")

  @@index([taskId])
  @@index([epicId])
  @@index([userId])
  @@index([deletedAt])
  @@index([deletedById])
  @@index([authorAgentSlug])
  @@index([commentKind])
}

model ActivityLog {
  id          String   @id @default(cuid())
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  taskId      String?
  task        Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  kind        String // "task.move" | "project.create" | "agent.sync" | ...
  payload     String? // JSON string
  // Optional denormalized target for cross-cutting audit events such as
  // agent.profile.update (HOMELAB-52). Project/task/user relations stay
  // nullable so agent-control-surface audit rows survive independently of
  // PM project data.
  targetAgent String?
  targetFile  String?
  // PHASEE-10 — Optional dedup key for structured deduplicated activities.
  // When set, the partial unique index ensures replaying the same failure
  // produces exactly one row. NULL keys are not constrained (multiple rows
  // without dedupe keys remain valid). Shared-schema change: additive and
  // NULL-tolerant so it sequences cleanly against PHASEE-08/09 migrations.
  dedupeKey   String?  @map("dedupe_key")
  createdAt   DateTime @default(now())

  // PHASEE-10 — Unique index on dedupeKey. SQLite UNIQUE constraints treat
  // NULL values as distinct, so rows without a dedupe key remain valid.
  @@unique([dedupeKey])
  @@index([projectId])
  @@index([taskId])
  @@index([userId])
  @@index([targetAgent])
  @@index([targetFile])
  @@index([createdAt])
  // PHASEE-10 — Composite index for legacy boundary invocation queries
  // (kind + createdAt range scans in getLegacyInvocationSummary).
  @@index([kind, createdAt])
}

// ENV-164 — Owner-visible audit trail for every scoped access/role change:
// the invitation grant, each project grant/revoke, and each promote/demote.
// Required relations keep the history intact: an account with audit entries
// is not removable (see lib/users/removal.ts).
model AccessAuditLog {
  id             String   @id @default(cuid())
  actorUserId    String
  actor          User     @relation("AccessAuditActor", fields: [actorUserId], references: [id])
  affectedUserId String
  affectedUser   User     @relation("AccessAuditAffected", fields: [affectedUserId], references: [id])
  action         String // "grant" | "revoke" | "promote" | "demote"
  oldRole        String?
  newRole        String?
  oldProjectIds  String   @default("[]") // JSON string array
  newProjectIds  String   @default("[]")
  createdAt      DateTime @default(now())

  @@index([actorUserId])
  @@index([affectedUserId])
  @@index([createdAt])
}

model DeploymentPullRequest {
  id                      String    @id @default(cuid())
  projectId               String
  project                 Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId                  String?
  task                    Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  epicId                  String?
  epic                    Epic?     @relation(fields: [epicId], references: [id], onDelete: Cascade)
  provider                String
  providerPrId            String    @map("provider_pr_id")
  url                     String
  sourceBranch            String    @map("source_branch")
  targetBranch            String    @map("target_branch")
  latestCommitSha         String    @map("latest_commit_sha")
  reporterUserId          String    @map("reporter_user_id")
  reporterName            String    @map("reporter_name")
  reporterEmail           String    @map("reporter_email")
  status                  String    @default("open")
  mergeSha                String?   @map("merge_sha")
  localChangeSummary      String?   @map("local_change_summary")
  localChangeApprovedAt   DateTime? @map("local_change_approved_at")
  localChangeApprovedById String?   @map("local_change_approved_by")
  deploymentExitCode      Int?      @map("deployment_exit_code")
  deploymentStdout        String?   @map("deployment_stdout")
  deploymentStderr        String?   @map("deployment_stderr")
  deploymentReportedAt    DateTime? @map("deployment_reported_at")
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@unique([provider, providerPrId])
  @@index([projectId])
  @@index([taskId])
  @@index([epicId])
  @@index([status])
}

// ------------------------------------------------------------------
// HOMELAB-46 Slice 4: consumer-side delivery log.
// UNIQUE(dedupeKey) drives the replay-test acceptance criterion —
// re-firing the same envelope hits the unique index and the
// downstream wake is suppressed. Truncating this table is safe;
// HOMELAB-51 audit rows live on ActivityLog and survive separately.
// ------------------------------------------------------------------

model PmEventDelivery {
  id                String    @id @default(cuid())
  dedupeKey         String    @unique
  eventId           String
  kind              String
  taskId            String
  taskKey           String
  projectKey        String
  actorId           String
  targetAgentSlug   String?
  targetGatewayPort Int?
  envelope          String // JSON-stringified PmEvent for audit
  receivedAt        DateTime  @default(now())
  deliveredAt       DateTime?
  deliveryStatus    String? // "delivered" | "failed" | "unmatched" | "skipped"
  gatewayStatus     Int?
  error             String?

  @@index([eventId])
  @@index([taskId])
  @@index([targetAgentSlug])
  @@index([deliveryStatus])
  @@index([receivedAt])
}

// PM-owned binding between a PM conversation scope and OpenClaw session
// routing. `openclawSessionKey` is what `/hooks/wake` and
// `openclaw system event --session-key` use; `openclawSessionId` is
// currently kept equal to the key for `openclaw agent --session-id`
// callers until OpenClaw exposes a distinct persisted session id in the
// reply metadata.
model AgentSessionBinding {
  id                      String    @id @default(cuid())
  scopeType               String // "task" | "epic" | "direct" | "billing"
  scopeId                 String
  agentSlug               String
  openclawSessionKey      String    @unique
  openclawSessionId       String?
  lastDispatchedMessageId String?
  lastDispatchedAt        DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@unique([scopeType, scopeId, agentSlug])
  @@index([agentSlug])
  @@index([openclawSessionId])
}

// Native OpenClaw PM-channel delivery/run state. This is the durable
// counterpart to the in-process SSE stream cache: PM can tell whether a
// local handoff was accepted, is streaming, completed, or failed even if
// the browser leaves and later reconnects. For Task/Epic Discussion
// work-item grants, this row is also the per-addressed-agent single-use
// stamp, so All Coders messages can grant each coder independently.
model PmChannelRun {
  id                         String                  @id @default(cuid())
  targetKey                  String                  @unique
  kind                       String
  agentSlug                  String
  messageId                  String
  projectId                  String?
  taskId                     String?
  epicId                     String?
  sessionKey                 String?
  driver                     String                  @default("openclaw-pm-channel")
  gatewayPort                Int?
  httpStatus                 Int?
  status                     String                  @default("queued") // queued | accepted | streaming | completed | failed | timed_out | cancelled | superseded
  error                      String?
  // Leased state machine fields (ENV-117)
  leaseExpiresAt             DateTime?
  heartbeatAt                DateTime?
  finishedAt                 DateTime?
  finishedReason             String?
  supersededByRunId          String?
  // Process-level execution fencing. A replacement run may reserve the lane,
  // but it is not dispatched until every superseded gateway session records a
  // cancellation acknowledgement (or is confirmed absent).
  cancellationRequestedAt    DateTime?               @map("cancellation_requested_at")
  cancellationAcknowledgedAt DateTime?               @map("cancellation_acknowledged_at")
  cancellationError          String?                 @map("cancellation_error")
  // Late error evidence on an already-settled run (PH-124): a workflow action
  // settles the run complete, then the gateway aborts the post-action phase.
  // The abort must not flip the legitimate settle, but it must not vanish
  // either — it lands here (plus a pm.channel.completion_anomaly ActivityLog).
  completionAnomaly          String?
  completionAnomalyAt        DateTime?
  // ENV-118. `disposition` is the explicit end-of-turn outcome from the closed
  // enum in lib/workflow-invariants.ts (continue | waiting_external |
  // ready_for_review | completed | failed); every terminal write records one.
  // `settledByAction` names the workflow action that settled the run, and is
  // written ONLY when a workflow action was the thing that settled it — a run
  // ended by a stream event leaves it null. Together they replace the
  // ActivityLog-scraping derivations the ENV-116 adapter had to guess with.
  disposition                String?
  settledByAction            String?
  // The most recent workflow action recorded against this run, whatever its
  // effect. A continuation-required action lands here without settling.
  lastAction                 String?
  lastActionAt               DateTime?
  // ENV-159: Lifecycle separation — `admittedAt` replaces `acceptedAt` to
  // represent actual model execution admission, not merely gateway receipt.
  // `acceptedAt` is kept as a compatibility read path during the migration;
  // new code writes `admittedAt`. The delivery→capacity→admission chain is:
  //   queued → claimed → delivered → waiting_capacity → admitted → streaming → terminal
  admittedAt                 DateTime?
  // ENV-159: Capacity-blocked run metadata. When an agent's execution lane is
  // occupied, the run enters waiting_capacity instead of being delivered.
  blockedReason              String?
  blockedByRunId             String?
  blockedByTaskId            String?
  capacityBlockedAt          DateTime?
  gatewayDispatchId          String?
  // Legacy field retained for compatibility — new code uses admittedAt.
  acceptedAt                 DateTime?
  streamingAt                DateTime?
  completedAt                DateTime?
  failedAt                   DateTime?
  lastEventAt                DateTime?
  // ENV-122: LLM provenance — the provider and model that handled this run.
  // Captured at dispatch time so comment metadata can copy them without
  // the comment creation sites needing their own model identity source.
  provider                   String?
  model                      String?
  streamSeq                  Int                     @default(0)
  workItemGrantUsedAt        DateTime?
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt
  jobs                       PmChannelJob[]
  thinking                   TaskThinkingSnapshot?
  streamEvents               PmChannelStreamEvent[]
  contextGrants              ContextGrant[]
  continuations              PmChannelContinuation[]
  comments                   Comment[]
  toolCalls                  PmChannelToolCall[]

  @@index([agentSlug])
  @@index([messageId])
  @@index([messageId, agentSlug])
  @@index([projectId])
  @@index([taskId])
  @@index([epicId])
  @@index([status])
  @@index([lastEventAt])
  @@index([supersededByRunId])
  @@index([blockedByRunId])
}

// ENV-118 continuation outbox. A continuation-required workflow action (start,
// add_subtask, complete_subtask, remove_subtask, clear_blocker,
// publish_checkpoint) is a step INSIDE an execution episode, not the end of
// one. Recording the intent to continue in the SAME transaction as the run/job
// write is what makes it crash-safe: a process death between "start task" and
// "queue the next turn" leaves an `armed` row the drain still honours, instead
// of a task that PM believes is finished.
//
// armed      — a continue action happened; the turn is still running.
// queued     — the turn ended without an episode-terminal action; drain it.
// dispatched — a fresh execution turn was enqueued for the agent.
// superseded — an episode-terminal action (or cancellation) closed the episode.
// failed     — the drain could not enqueue a turn and gave up.
model PmChannelContinuation {
  id                  String       @id @default(cuid())
  runId               String
  run                 PmChannelRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  agentSlug           String
  projectId           String?
  taskId              String?
  epicId              String?
  // The source turn's message id: the turn whose episode must continue.
  messageId           String
  // The continuation-required action that armed this row.
  action              String
  status              String       @default("armed")
  availableAt         DateTime     @default(now())
  attempts            Int          @default(0)
  lastError           String?
  // Message id of the continuation turn the drain enqueued.
  dispatchedMessageId String?
  dispatchedAt        DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  // Idempotency: one row per (run, source turn, action). Re-running the same
  // action inside one episode renews the row instead of queueing a second turn.
  @@unique([runId, messageId, action])
  @@index([status, availableAt])
  @@index([agentSlug])
  @@index([taskId])
  @@index([runId])
}

// Durable PM-channel dispatch queue. Server actions enqueue one job per
// addressed run and return after local persistence; a worker claims and
// delivers jobs to the local OpenClaw gateway.
model PmChannelJob {
  id           String       @id @default(cuid())
  runId        String
  run          PmChannelRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  agentSlug    String
  kind         String // direct | task-chat | task-comment | epic-chat | wake
  payload      String // JSON-stringified dispatch payload
  status       String       @default("queued") // queued | claimed | accepted | retryable | failed | complete
  attemptCount Int          @default(0)
  availableAt  DateTime     @default(now())
  claimedBy    String?
  claimedAt    DateTime?
  acceptedAt   DateTime?
  completedAt  DateTime?
  lastError    String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([runId])
  @@index([agentSlug])
  @@index([status, availableAt])
  @@index([claimedAt])
  @@index([createdAt])
}

// Append-only stream ledger for native PM-channel runs. Browser SSE replays
// from this table via Last-Event-ID; the in-memory stream store is only a fanout
// cache.
model PmChannelStreamEvent {
  id        String       @id @default(cuid())
  runId     String
  run       PmChannelRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  seq       Int
  kind      String // status | partial | reasoning | final | error | done
  payload   String // JSON-stringified event payload
  createdAt DateTime     @default(now())

  @@unique([runId, seq])
  @@index([runId, createdAt])
  @@index([kind])
  @@index([createdAt])
}

// ENV-159: Durable tool-call correlation table. Each logical tool call gets
// exactly one row per run, keyed by the stable toolCallId. This is what makes
// tool accounting idempotent: duplicate callbacks/retries for the same
// toolCallId find the existing row and do not increment the episode count.
model PmChannelToolCall {
  id          String       @id @default(cuid())
  runId       String
  run         PmChannelRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  toolCallId  String
  toolName    String
  provider    String?
  model       String?
  startedAt   DateTime     @default(now())
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([runId, toolCallId])
  @@index([runId])
  @@index([toolCallId])
}

// ENV-159: Durable per-agent execution lane. Ensures only one run per agent
// is reserved/admitted/running at a time. The partial unique index on
// (agentSlug) WHERE status IN (reserved, admitted, running) is the constraint
// that makes the lane exclusive. Queue priority is enforced by the job
// scheduler: continuation > review feedback > reviewer/manager decisions >
// newly approved To Do > informational.
model AgentExecutionLease {
  id          String    @id @default(cuid())
  agentSlug   String
  runId       String?   @unique
  taskId      String?
  status      String    @default("reserved") // reserved | admitted | running | released
  leaseToken  String    @unique @default(cuid())
  acquiredAt  DateTime  @default(now())
  heartbeatAt DateTime?
  expiresAt   DateTime?
  releasedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([agentSlug])
  @@index([status])
  @@index([taskId])
}

// Opaque, short-lived read capability handed to agents instead of putting a
// long-lived PM-channel bearer token in model-visible prompts.
model ContextGrant {
  id         String        @id @default(cuid())
  tokenHash  String        @unique
  runId      String?
  run        PmChannelRun? @relation(fields: [runId], references: [id], onDelete: Cascade)
  agentSlug  String
  scopeType  String // task | epic | project
  scopeId    String
  turnId     String
  includes   String // JSON-stringified include allow-list
  maxBytes   Int
  maxUses    Int           @default(1)
  usedCount  Int           @default(0)
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime      @default(now())

  @@index([agentSlug])
  @@index([scopeType, scopeId])
  @@index([runId])
  @@index([expiresAt])
}

// ------------------------------------------------------------------
// HOMELAB-48 agent chat — sidebar conversations between humans and a
// specific agent, scoped to a Task XOR an Epic. The "allow description
// edit" grant is per-message: when true, the targeted agent gets a
// one-shot permission to overwrite the parent Task/Epic description via
// POST /api/{tasks,epics}/[id]/description; editGrantUsedAt records the
// moment that grant was consumed, so a single message can never grant
// twice. XOR(taskId, epicId) is server-enforced — SQLite has no
// portable check constraint.
// ------------------------------------------------------------------

model AgentChatMessage {
  id                      String                @id @default(cuid())
  projectId               String
  project                 Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId                  String?
  task                    Task?                 @relation("TaskChat", fields: [taskId], references: [id], onDelete: Cascade)
  epicId                  String?
  epic                    Epic?                 @relation("EpicChat", fields: [epicId], references: [id], onDelete: Cascade)
  // The agent this conversation is with (Agent.slug). Stored as a slug
  // rather than agentId so chat history survives an Agent row being
  // soft-deactivated and the index.json deciding to re-issue.
  agentSlug               String
  archiveId               String?
  archive                 AgentChatRoomArchive? @relation(fields: [archiveId], references: [id], onDelete: SetNull)
  baseArchiveId           String?
  targetType              String?
  targetValue             String?
  targetLabel             String?
  // The sender — a User row (humans send via their own row, agents
  // reply via their own seeded User row).
  senderUserId            String
  sender                  User                  @relation("AgentChatSender", fields: [senderUserId], references: [id])
  body                    String
  allowDescriptionEdit    Boolean               @default(false)
  editGrantUsedAt         DateTime?
  // Human-authored Discussion messages grant work-item proposal capability
  // by default. Consumption is tracked per addressed agent in PmChannelRun;
  // this legacy message-level stamp is retained for compatibility.
  allowWorkItemManagement Boolean               @default(false)
  workItemGrantUsedAt     DateTime?
  // Where an agent reply should be posted. "chat" means the message
  // originated in the task/epic chat sidebar; "comment" means it was
  // mirrored from a task comment so the reply should return to comments.
  originChannel           String                @default("chat")
  originCommentId         String?
  // Stable key used by WorkflowOutbox notification effects. If a dispatcher
  // dies after creating the message but before acknowledging the outbox row,
  // its retry reuses this message and therefore the same PM-channel target.
  workflowDedupeKey       String?               @unique @map("workflow_dedupe_key")
  createdAt               DateTime              @default(now())
  // Soft delete (HOMELAB-41 / item 2). See Comment.deletedAt for the
  // same convention. Active reads filter deletedAt: null; agent context
  // builders ALWAYS filter deleted out.
  deletedAt               DateTime?
  deletedById             String?
  deletedBy               User?                 @relation("AgentChatMessageDeletedBy", fields: [deletedById], references: [id])

  @@index([taskId, createdAt])
  @@index([epicId, createdAt])
  @@index([taskId, archiveId, createdAt])
  @@index([epicId, archiveId, createdAt])
  @@index([archiveId, createdAt])
  @@index([baseArchiveId, createdAt])
  @@index([agentSlug])
  @@index([originCommentId])
  @@index([deletedAt])
  @@index([deletedById])
}

model AgentChatRoomArchive {
  id              String             @id @default(cuid())
  projectId       String
  project         Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId          String?
  task            Task?              @relation("TaskChatRoomArchive", fields: [taskId], references: [id], onDelete: Cascade)
  epicId          String?
  epic            Epic?              @relation("EpicChatRoomArchive", fields: [epicId], references: [id], onDelete: Cascade)
  archivedById    String
  archivedBy      User               @relation("AgentChatRoomArchivedBy", fields: [archivedById], references: [id])
  deletedById     String?
  deletedBy       User?              @relation("AgentChatRoomArchiveDeletedBy", fields: [deletedById], references: [id])
  parentArchiveId String?
  summary         String
  startedAt       DateTime
  endedAt         DateTime
  messageCount    Int                @default(0)
  deletedAt       DateTime?
  createdAt       DateTime           @default(now())
  messages        AgentChatMessage[]

  @@index([projectId, taskId, deletedAt, createdAt])
  @@index([projectId, epicId, deletedAt, createdAt])
  @@index([taskId, createdAt])
  @@index([epicId, createdAt])
  @@index([parentArchiveId])
  @@index([archivedById])
  @@index([deletedById])
}

// ------------------------------------------------------------------
// Direct agent chat — conversations opened from the global sidebar CHAT
// section. Unlike AgentChatMessage, these are not tied to a Task/Epic
// and carry no description-edit grant.
// ------------------------------------------------------------------

model DirectAgentChatMessage {
  id                      String                          @id @default(cuid())
  agentSlug               String
  senderUserId            String
  sender                  User                            @relation("DirectAgentChatSender", fields: [senderUserId], references: [id])
  archiveId               String?
  archive                 DirectAgentChatArchive?         @relation(fields: [archiveId], references: [id], onDelete: SetNull)
  // Active child continuations keep the parent archive immutable while
  // still using it as context for the new conversation.
  baseArchiveId           String?
  body                    String
  // A direct chat can be attached to a project (agent planning): the agent
  // then gets that project's environment + board as context and may propose
  // work-item changes scoped to it. allowWorkItemManagement is the per-message
  // grant — generalises AgentChatMessage.allowDescriptionEdit; workItemGrantUsedAt
  // stamps it single-use once a proposal is stored.
  projectId               String?
  project                 Project?                        @relation("DirectChatProject", fields: [projectId], references: [id], onDelete: SetNull)
  projects                DirectAgentChatMessageProject[]
  allowWorkItemManagement Boolean                         @default(false)
  workItemGrantUsedAt     DateTime?
  createdAt               DateTime                        @default(now())
  // Soft delete (HOMELAB-41 / item 2). See Comment.deletedAt for the
  // same convention. The archive-level deletedAt on
  // DirectAgentChatArchive remains separate — that one bins an entire
  // archived conversation; this one bins an individual bubble inside
  // the active or archived chat.
  deletedAt               DateTime?
  deletedById             String?
  deletedBy               User?                           @relation("DirectAgentChatMessageDeletedBy", fields: [deletedById], references: [id])
  // Internal workflow turns reuse the durable PM-channel transport without
  // becoming part of the human-facing direct-chat transcript. Billing output
  // is rendered on the Billing tab from the related run instead.
  billingRunId            String?                         @map("billing_run_id")
  billingRun              BillingRun?                     @relation(fields: [billingRunId], references: [id], onDelete: Cascade)

  @@index([agentSlug, createdAt])
  @@index([agentSlug, archiveId, createdAt])
  @@index([agentSlug, baseArchiveId, createdAt])
  @@index([archiveId, createdAt])
  @@index([senderUserId])
  @@index([projectId])
  @@index([deletedAt])
  @@index([deletedById])
  @@index([billingRunId])
}

// Multi-project context attached to one direct-chat turn. projectId on the
// message remains the primary/backward-compatible project; these rows are the
// authoritative selected set and carry independent one-shot proposal grants.
model DirectAgentChatMessageProject {
  messageId               String
  message                 DirectAgentChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  projectId               String
  project                 Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  allowWorkItemManagement Boolean                @default(false)
  workItemGrantUsedAt     DateTime?
  createdAt               DateTime               @default(now())

  @@id([messageId, projectId])
  @@index([projectId])
}

model DirectAgentChatArchive {
  id              String                   @id @default(cuid())
  agentSlug       String
  archivedById    String
  archivedBy      User                     @relation("DirectAgentChatArchivedBy", fields: [archivedById], references: [id])
  deletedById     String?
  deletedBy       User?                    @relation("DirectAgentChatArchiveDeletedBy", fields: [deletedById], references: [id])
  // If this archived conversation was a continuation, parentArchiveId
  // points to the frozen archive it used as its base.
  parentArchiveId String?
  summary         String
  startedAt       DateTime
  endedAt         DateTime
  messageCount    Int                      @default(0)
  deletedAt       DateTime?
  createdAt       DateTime                 @default(now())
  messages        DirectAgentChatMessage[]

  @@index([agentSlug, createdAt])
  @@index([agentSlug, deletedAt, createdAt])
  @@index([parentArchiveId])
  @@index([archivedById])
  @@index([deletedById])
}

// ------------------------------------------------------------------
// Agent work-item proposals (propose → approve). An agent granted
// "manage work items" on a direct chat message submits a change-set of
// typed operations (create/update epics, tasks, sub-tasks; comment)
// against one project via POST /api/agent/projects/[id]/proposals. PM
// stores it pending; a human applies or rejects it. Nothing touches the
// board until approval. `operations` is the JSON change-set; `validation`
// is the per-op dry-run snapshot taken at submit time. `planId` is unique
// so a retried agent turn is idempotent (mirrors PmEventDelivery.dedupeKey).
// `grantMessageId` is a plain pointer (no FK) so the proposal survives the
// originating chat message being deleted.
// ------------------------------------------------------------------

model WorkItemProposal {
  id               String    @id @default(cuid())
  planId           String    @unique
  projectId        String
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agentSlug        String
  grantMessageId   String?
  proposedByUserId String
  proposedBy       User      @relation("WorkItemProposalProposedBy", fields: [proposedByUserId], references: [id])
  status           String    @default("pending") // pending | applied | rejected | superseded
  summary          String?
  operations       String // JSON change-set (ProposalOp[])
  validation       String? // JSON ProposalValidation snapshot at submit time
  appliedById      String?
  appliedBy        User?     @relation("WorkItemProposalAppliedBy", fields: [appliedById], references: [id])
  appliedAt        DateTime?
  rejectedById     String?
  rejectedBy       User?     @relation("WorkItemProposalRejectedBy", fields: [rejectedById], references: [id])
  rejectedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([projectId, status])
  @@index([agentSlug])
  @@index([grantMessageId])
}

// ------------------------------------------------------------------
// System-wide settings — a single row (id "system") holding the global
// fallbacks used when a project leaves the matching field blank:
//   - defaultGitUserName / defaultGitUserEmail → project git identity
//   - doneTtlDays → automatic archive days (a null project value inherits)
//   - binTtlDays → days before ANY soft-delete bin (Task/Epic, Project,
//     direct-chat) is auto-emptied; overrides the PM_*_BIN_TTL_DAYS env
//     defaults when set.
//   - theme → system UI theme ("light" | "dark").
// Edited at /system/settings. Singleton enforced by the fixed id default.
// ------------------------------------------------------------------

model SystemSettings {
  id                  String   @id @default("system")
  defaultGitUserName  String?
  defaultGitUserEmail String?
  doneTtlDays         Int?
  binTtlDays          Int?
  theme               String   @default("light")
  openRouterApiKey    String?
  openRouterReferer   String?
  openRouterTitle     String?
  profileImagePrompt  String?
  deployReviewPrompt  String?  @map("deploy_review_prompt")
  billingPrompt       String?  @map("billing_prompt")
  // Global Billing fallback. Workspaces and projects may override the rate;
  // workspaces may also override the display currency.
  hourlyRateCents     Int?     @map("hourly_rate_cents")
  billingCurrency    String?  @map("billing_currency")
  integrationDefaults String?  @map("integration_defaults")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// ------------------------------------------------------------------
// DescriptionDraft (HOMELAB-41 / item 4):
// Replaces the filesystem-based draft store at .data/drafts. An agent's
// description proposal lands in this table tagged with the human who
// requested it (requesterUserId = the senderUserId on the grant message,
// i.e. whoever clicked "Ask AI to update description"). Only that user
// sees the draft on the task/epic page; a heartbeat from the open page
// bumps lastSeenAt, and a reaper purges rows whose lastSeenAt has gone
// stale (page closed before the agent answered) or whose expiresAt has
// passed.
// ------------------------------------------------------------------

model DescriptionDraft {
  id              String   @id @default(cuid())
  scope           String // "task" | "epic"
  targetId        String
  requesterUserId String
  agentSlug       String
  body            String
  createdAt       DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  expiresAt       DateTime

  @@unique([scope, targetId, requesterUserId])
  @@index([expiresAt])
  @@index([lastSeenAt])
}

// ------------------------------------------------------------------
// ChatReadCursor — per-user, per-chat-scope "last time I looked at this"
// marker. agentSlug stores either a direct agent slug or a scope-prefixed
// work-item room key (task:<id>, epic:<id>). Direct chats drive sidebar
// unread dots; task/epic action-plan rooms drive tab badges and the first
// unread divider. userId is a plain string (no FK) so the cursor survives
// independently of user lifecycle; active chat pages upsert lastReadAt on
// open.
// ------------------------------------------------------------------

model ChatReadCursor {
  id         String   @id @default(cuid())
  userId     String
  agentSlug  String
  lastReadAt DateTime @default(now())

  @@unique([userId, agentSlug])
  @@index([agentSlug])
}

// ------------------------------------------------------------------
// WebPushSubscription — a browser Push API subscription owned by a human
// user, used to deliver agent-reply notifications when the PM tab/app is
// closed (the in-page Notification API only fires with a tab open). One
// row per device/browser; `endpoint` is the unique push endpoint URL and
// p256dh/auth are the client public key + auth secret used to encrypt the
// payload. userId is a plain string (no FK) so a subscription survives
// independent of user lifecycle; dead endpoints are pruned on 404/410.
// ------------------------------------------------------------------

model WebPushSubscription {
  id         String    @id @default(cuid())
  userId     String
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
}

// ------------------------------------------------------------------
// ENV-166 — Customer-safe publishing of internally produced results
// ------------------------------------------------------------------

// A PublishedItem is the deliberate route from internal-only content to
// Customer-visible project content. Rows are created exclusively by the
// publishing service: title/body are redacted *before* persist (real agent
// slugs/usernames/display names never reach the row), the author is always
// the publishing human, and source references are plain string columns (no
// relations) so internal sources can be pruned without cascading published
// history. Serialization is a strict whitelist; the internal-only source
// columns are never exposed to any viewer role.
model PublishedItem {
  id                 String    @id @default(cuid())
  projectId          String
  // Optional task scope: a published update can also be project-level.
  taskId             String?
  // Publishing human (User.id); enforced server-side by the publishing
  // service — only owner/admin humans may publish.
  authorId           String
  title              String
  // Redacted snapshot at publish time. Never the live internal source.
  body               String
  publishedAt        DateTime  @default(now())
  // Non-null = private again. Active reads filter this to null.
  unpublishedAt      DateTime?
  // Internal-only provenance (never serialized): originating comment row.
  sourceCommentId    String?   @map("source_comment_id")
  // Internal-only provenance (never serialized): originating attachment row.
  sourceAttachmentId String?   @map("source_attachment_id")
  // JSON string array of re-hosted Attachment ids (human-uploader copies).
  attachmentIds      String?   @map("attachment_ids")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([projectId, unpublishedAt])
  @@index([taskId, unpublishedAt])
  @@index([authorId])
}

// ------------------------------------------------------------------
// Billing: a repository's commit history for a date range, summarised
// per day with an estimated time to perform the work.
//
// The split matters. `ledger` holds the DETERMINISTIC git facts PM read
// itself — commits, spans, insertions, deletions, files. The agent only
// writes the per-day summary and the estimate, so two runs of the same
// period can never disagree about what was committed, and every estimate
// can be checked against the evidence it was derived from.
//
// The rate is SNAPSHOT here at run time and never re-resolved: raising the
// workspace rate in October must not silently rewrite September's invoice.
// ------------------------------------------------------------------

model BillingReport {
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // The workspace the rate came from, when it came from one.
  workspaceId   String?   @map("workspace_id")
  fromDate      String    @map("from_date")
  toDate        String    @map("to_date")
  authorEmails  String    @map("author_emails")
  branchFilter  String?   @map("branch_filter")
  agentSlug     String    @map("agent_slug")
  // queued | running | ready | failed | final
  status        String    @default("queued")
  // The DirectAgentChatMessage the run was dispatched on, for the audit trail.
  runMessageId  String?   @map("run_message_id")
  error         String?
  ledger        String
  notes         String?
  rateCents     Int?      @map("rate_cents")
  currency      String?
  // "project" | "workspace" — shown in the UI so an override is never invisible.
  rateSource    String?   @map("rate_source")
  requestedById String    @map("requested_by_id")
  finalizedAt   DateTime? @map("finalized_at")
  acceptedRunId String?   @map("accepted_run_id")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  days BillingReportDay[]
  runs BillingRun[]

  @@unique([projectId, fromDate, toDate, agentSlug, requestedById])
  @@index([projectId, fromDate, toDate])
  @@index([workspaceId])
  @@index([status])
}

// One immutable attempt at generating a report. The accepted BillingReportDay
// rows remain the invoice draft; a regeneration lands here as a candidate until
// the operator accepts or discards it.
model BillingRun {
  id            String        @id @default(cuid())
  reportId      String        @map("report_id")
  report        BillingReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  generation    Int
  // queued | running | ready | accepted | superseded | discarded | failed
  status        String        @default("queued")
  messageId     String?       @unique @map("message_id")
  authorEmails  String        @map("author_emails")
  branchFilter  String?       @map("branch_filter")
  ledger        String
  notes         String?
  response      String?
  error         String?
  workspaceId   String?       @map("workspace_id")
  rateCents     Int?          @map("rate_cents")
  currency      String?
  rateSource    String?       @map("rate_source")
  completedAt   DateTime?     @map("completed_at")
  acceptedAt    DateTime?     @map("accepted_at")
  discardedAt   DateTime?     @map("discarded_at")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  days     BillingRunDay[]
  events   BillingRunEvent[]
  messages DirectAgentChatMessage[]

  @@unique([reportId, generation])
  @@index([reportId, status, createdAt])
  @@index([workspaceId])
}

model BillingRunDay {
  id               String     @id @default(cuid())
  runId            String     @map("run_id")
  run              BillingRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  day              String
  summary          String
  estimatedMinutes Int        @map("estimated_minutes")
  rationale        String?
  commitCount      Int        @map("commit_count")
  insertions       Int
  deletions        Int
  filesTouched     Int        @map("files_touched")
  firstCommitAt    String?    @map("first_commit_at")
  lastCommitAt     String?    @map("last_commit_at")

  @@unique([runId, day])
  @@index([runId])
}

// Visible PM-channel frames for this Billing run. This deliberately stores
// emitted progress/reasoning text, never model-private chain-of-thought.
model BillingRunEvent {
  id        String     @id @default(cuid())
  runId     String     @map("run_id")
  run       BillingRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  seq       Int
  kind      String
  payload   String
  createdAt DateTime   @default(now())

  @@unique([runId, seq])
  @@index([runId, createdAt])
}

// Effective-dated hourly rates. Reports still snapshot the selected rate, so
// later schedule edits cannot re-price an accepted historical summary.
model BillingRateSchedule {
  id          String     @id @default(cuid())
  scopeKey    String     @map("scope_key") // global | workspace:<id> | project:<id>
  scopeType   String     @map("scope_type") // global | workspace | project
  workspaceId String?    @map("workspace_id")
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId   String?    @map("project_id")
  project     Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  startOn     String     @map("start_on") // YYYY-MM-DD
  amountCents Int        @map("amount_cents")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([scopeKey, startOn])
  @@index([scopeType, startOn])
  @@index([workspaceId, startOn])
  @@index([projectId, startOn])
}

model BillingReportDay {
  id               String        @id @default(cuid())
  reportId         String        @map("report_id")
  report           BillingReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  day              String
  summary          String
  // The agent's proposal. Never overwritten by an operator edit.
  estimatedMinutes Int           @map("estimated_minutes")
  // What is actually billed, when it differs from the estimate.
  overrideMinutes  Int?          @map("override_minutes")
  excluded         Boolean       @default(false)
  rationale        String?
  commitCount      Int           @map("commit_count")
  insertions       Int
  deletions        Int
  filesTouched     Int           @map("files_touched")
  firstCommitAt    String?       @map("first_commit_at")
  lastCommitAt     String?       @map("last_commit_at")

  @@unique([reportId, day])
  @@index([reportId])
}

// Bounded, display-only execution history. Never included in agent prompts.
model TaskThinkingSnapshot {
  runId           String       @id
  run             PmChannelRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  progress        String       @default("")
  reasoning       String       @default("")
  tools           String       @default("[]")
  role            String       @default("agent")
  truncated       Boolean      @default(false)
  lastSeq         Int          @default(0)
  finalReceivedAt DateTime?
  updatedAt       DateTime     @updatedAt
}
