{
  "id": "pm",
  "name": "PM Channel",
  "description": "Native local PM chat and task-comment channel for OpenClaw.",
  "version": "0.1.7",
  "channels": ["pm"],
  "contracts": {
    "tools": [
      "pm_context",
      "pm_submit_plan",
      "pm_approve_plan",
      "pm_request_plan_changes",
      "pm_review_feedback",
      "pm_start",
      "pm_checkpoint",
      "pm_complete_subtask",
      "pm_add_subtask",
      "pm_ready_for_review",
      "pm_review_done",
      "pm_flag_blocker",
      "pm_clear_blocker",
      "pm_assign_task",
      "pm_publish_checkpoint"
    ]
  },
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "channelConfigs": {
    "pm": {
      "label": "PM",
      "description": "Local Mission Control channel.",
      "schema": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "enabled": { "type": "boolean" },
          "token": { "type": "string" },
          "callbackToken": { "type": "string" },
          "callbackUrl": { "type": "string" },
          "agentId": { "type": "string" },
          "defaultTo": { "type": "string" },
          "accounts": { "type": "object" },
          "defaultAccount": { "type": "string" }
        }
      },
      "uiHints": {
        "token": {
          "label": "Ingress token",
          "sensitive": true
        },
        "callbackToken": {
          "label": "PM callback token",
          "sensitive": true
        },
        "callbackUrl": {
          "label": "PM callback URL",
          "placeholder": "http://127.0.0.1:3000/api/openclaw/pm-channel/reply"
        },
        "agentId": {
          "label": "OpenClaw agent id",
          "placeholder": "main"
        }
      }
    }
  }
}
