# Database — Prisma resolves file: URLs relative to the schema, so this
# lands at prisma/pm.db (NOT prisma/prisma/pm.db).
DATABASE_URL="file:./pm.db"

# NextAuth
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-in-prod"
AUTH_TRUST_HOST=true

# Initial Mission Control owner for a fresh database. Set all three values
# before the first start; once an owner exists, the bootstrap is a no-op.
# PM_BOOTSTRAP_OWNER_USERNAME=owner
# PM_BOOTSTRAP_OWNER_EMAIL=owner@example.com
# PM_BOOTSTRAP_OWNER_PASSWORD=replace-with-a-strong-password

# Public app URL — used for cookies + reset links
APP_URL="https://mission-control.example.com"

# Agent registry — host-level descriptor read at boot + every sync interval
AGENT_INDEX_PATH="/srv/agents/index.json"

# Per-agent credential seed dir — files mode 0600, owned by codeOwner
AGENT_CREDENTIALS_DIR="/etc/openclaw/pm-agent-credentials"

# Sync cadence (minutes)
AGENT_SYNC_INTERVAL_MIN=5

# Agent context: max bytes read from text-like attachments for inline prompt context
PM_AGENT_CONTEXT_ATTACHMENT_TEXT_MAX_BYTES=98304

# Native OpenClaw PM channel. PM posts chat/comment turns to each
# agent's loopback gateway at /pm-channel/ingest and accepts final
# channel replies at /api/openclaw/pm-channel/reply. Per-agent tokens
# from PM_OPENCLAW_CHANNEL_TOKEN_FILE take precedence over this shared
# fallback token.
PM_OPENCLAW_CHANNEL_TOKEN="change-me-shared-local-secret"
PM_OPENCLAW_CHANNEL_TOKEN_FILE="/etc/openclaw/pm-channel-tokens.json"
PM_OPENCLAW_CHANNEL_INGRESS_PATH="/pm-channel/ingest"
PM_OPENCLAW_CHANNEL_TIMEOUT_MS=5000
PM_INTERNAL_APP_URL="http://127.0.0.1:3000"

# Opt-in compact coding-task turns. Install compatible PM channel plugins first.
# PM_TASK_RUNTIME_V2=1

# Phase E orchestrator rollout. The first two flags remain compute-only
# comparison probes; they never admit mutation ownership. Effectful admission
# is empty by default and must contain explicit project slugs. During E2 use
# exactly one synthetic/private project slug and never "*".
# PM_ORCHESTRATOR_V2_SHADOW=1
# PM_ORCHESTRATOR_V2_PROJECTS=comparison-project
# PM_ORCHESTRATOR_V2_MUTATION_PROJECTS=synthetic-private-canary

# Web Push contact used by VAPID when push keys are configured.
# PM_WEB_PUSH_CONTACT=mailto:admin@example.com

# Optional profile-image generator. Leave unset to disable generated agent
# images; manual image uploads remain available.
# PM_PROFILE_IMAGE_CONFY_URL="http://127.0.0.1:8188"

# Optional worktree live-preview registry. Production deployments should keep
# project paths and runner settings in a host-private environment file.
# PM_WORKTREE_PREVIEW_REGISTRY='[{"key":"app","repoKey":"/path/to/repository","worktreesRoot":"/path/to/repository.worktrees","spoolDir":"/var/lib/mission-control/switch","driver":"node-service","appSubdir":"","offFreesResources":true,"branchDatabases":true,"lifecycleControl":true}]'

# Agent Samba drive root path (use [agent] as placeholder for agent slug)
PM_AGENT_SAMBA_ROOT="/srv/samba/shared/[agent]"
