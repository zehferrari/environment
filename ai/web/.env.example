# Database — Prisma resolves file: URLs relative to the schema, so this
# lands at prisma/pm.db (NOT prisma/prisma/pm.db).
DATABASE_URL="file:./pm.db"

# NextAuth
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-in-prod"
AUTH_TRUST_HOST=true

# Public app URL — used for cookies + reset links
APP_URL="https://agents.vixi.au"

# Agent registry — host-level descriptor read at boot + every sync interval
AGENT_INDEX_PATH="/srv/agents/index.json"

# Per-agent credential seed dir — files mode 0600, owned by codeOwner
AGENT_CREDENTIALS_DIR="/etc/openclaw/pm-agent-credentials"

# Sync cadence (minutes)
AGENT_SYNC_INTERVAL_MIN=5

# Agent context: max bytes read from text-like attachments for inline prompt context
PM_AGENT_CONTEXT_ATTACHMENT_TEXT_MAX_BYTES=98304

# Native OpenClaw PM channel. PM posts chat/comment turns to each
# agent's loopback gateway at /pm-channel/ingest and accepts final
# channel replies at /api/openclaw/pm-channel/reply. Per-agent tokens
# from PM_OPENCLAW_CHANNEL_TOKEN_FILE take precedence over this shared
# fallback token.
PM_OPENCLAW_CHANNEL_TOKEN="change-me-shared-local-secret"
PM_OPENCLAW_CHANNEL_TOKEN_FILE="/etc/openclaw/pm-channel-tokens.json"
PM_OPENCLAW_CHANNEL_INGRESS_PATH="/pm-channel/ingest"
PM_OPENCLAW_CHANNEL_TIMEOUT_MS=5000
PM_INTERNAL_APP_URL="http://127.0.0.1:3000"
