[Unit]
Description=PM consumer (agent dispatch wake bridge)
Documentation=https://zeh-ferrari.atlassian.net/browse/HOMELAB-46
After=network-online.target pm.service
Wants=network-online.target

[Service]
Type=simple
User=karen
Group=karen
WorkingDirectory=/srv/Code/environment.worktrees/feature_HOMELAB-41-local-project-manager-webapp-/ai/web

Environment=NODE_ENV=production
EnvironmentFile=/etc/default/pm
Environment=PM_CONSUMER_DROP_DIR=/var/lib/pm/drop
Environment=PM_CONSUMER_HOOK_TOKEN_FILE=/etc/openclaw/pm-consumer-tokens.json
Environment=HOME=/var/lib/pm/pnpm-home
Environment=XDG_CONFIG_HOME=/var/lib/pm/pnpm-config
Environment=XDG_CACHE_HOME=/var/lib/pm/pnpm-cache
Environment=PNPM_HOME=/var/lib/pm/pnpm-home
Environment=NPM_CONFIG_USERCONFIG=/var/lib/pm/pnpm-home/.npmrc
Environment=npm_config_userconfig=/var/lib/pm/pnpm-home/.npmrc

ExecStart=/usr/local/bin/pnpm pm-consumer

Restart=on-failure
RestartSec=3s

# Monitor fallback uses a tightly-scoped passwordless sudo helper when a
# target gateway hook is unavailable, so this service cannot set
# NoNewPrivileges=true.
NoNewPrivileges=false
ProtectSystem=strict
# Deployment approval runs git as the monitor user. SSH reads that user's
# known_hosts/key from its login home even though pnpm HOME is redirected
# below, so keep home directories read-only rather than fully hidden.
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/srv/Code/environment.worktrees/feature_HOMELAB-41-local-project-manager-webapp-/ai/web/prisma /var/lib/pm/drop /var/lib/pm/pnpm-home /var/lib/pm/pnpm-config /var/lib/pm/pnpm-cache
ReadOnlyPaths=/srv/agents /etc/openclaw/pm-consumer-tokens.json

[Install]
WantedBy=multi-user.target
