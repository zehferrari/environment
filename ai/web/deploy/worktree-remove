#!/usr/bin/env python3
"""Safely remove one linked local worktree and its local branch.

This helper is run by the monitor-owned worktree runners and the
pm-epic-merge-runner, never by the web process. It refuses dirty, live,
protected, or unsafe worktrees, but an unmerged local branch may be discarded
explicitly. The --discard-branch mode is reserved for a confirmed Task hard
reset; --discard-worktree is used only after the owner confirms the UI's dirty
worktree warning. Both may discard local changes. It never contacts a remote;
callers supply only a worktree name
from the runner inventory (default mode) or a local branch name (--branch
mode, used by the Epic-Done cleanup for P6 local-only child branches — the
caller verifies each branch is merged into the pushed Epic branch first).
"""
import fcntl
import json
import os
import stat
import subprocess
import sys


PROTECTED_BRANCHES = frozenset({
    "main",
    "master",
    "production",
    "prod",
    "staging",
    "stage",
    "develop",
    "dev",
})

GENERATED_REMOVAL_CHANGES = frozenset({
    " M public/version.json",
})

PERMISSION_REPAIR_HINT = (
    "reconcile the shared code-tree ACLs with code-tree-perms and retry"
)


class RemovalError(RuntimeError):
    pass


def git(repo, args, *, check=True):
    # A monitor-owned runner may remove a worktree owned by another member of
    # the shared code group. Trust only this exact path for this process; do
    # not weaken the monitor account's persistent Git configuration.
    safe_repo = os.path.realpath(repo)
    proc = subprocess.run(
        ["git", "-c", f"safe.directory={safe_repo}", "-C", safe_repo, *args],
        capture_output=True,
        text=True,
        timeout=30,
    )
    if check and proc.returncode:
        detail = (proc.stderr or proc.stdout or "git command failed").strip()
        raise RemovalError(detail)
    return proc


def worktrees(repo):
    out = git(repo, ["worktree", "list", "--porcelain"]).stdout
    records = []
    current = None

    def flush():
        nonlocal current
        if current:
            records.append(current)
        current = None

    for line in out.splitlines():
        if line.startswith("worktree "):
            flush()
            current = {"path": line.removeprefix("worktree ")}
        elif current is not None and line.startswith("branch "):
            current["branch"] = line[len("branch "):]
        elif current is not None and line.startswith("detached"):
            current["detached"] = True
        elif current is not None and line.startswith("locked"):
            current["locked"] = True
        elif line == "":
            flush()
    flush()
    return records


def is_descendant(root, candidate):
    try:
        return os.path.commonpath([root, candidate]) == root and candidate != root
    except ValueError:
        return False


def branch_name(record):
    ref = record.get("branch")
    if not ref or not ref.startswith("refs/heads/"):
        return None
    return ref[len("refs/heads/"):]


def clean_or_discard_generated_changes(worktree_path):
    status_lines = [
        line
        for line in git(worktree_path, ["status", "--porcelain=v1", "--untracked-files=all"]).stdout.splitlines()
        if line.strip()
    ]
    if not status_lines:
        return
    unexpected = [line for line in status_lines if line not in GENERATED_REMOVAL_CHANGES]
    if unexpected:
        raise RemovalError("worktree has local changes; commit, stash, or clean it before removal")
    git(worktree_path, ["restore", "--", "public/version.json"])


def assert_tree_removable(worktree_path):
    """Refuse before Git mutates metadata when a runtime-owned directory
    cannot be traversed or emptied by this runner.

    `git worktree remove` is not atomic: it can delete the `.git` marker and
    tracked files before encountering an inaccessible ignored directory. That
    leaves an ordinary-looking residual folder which is no longer a worktree.
    """
    def inspection_error(exc):
        location = getattr(exc, "filename", None) or worktree_path
        raise RemovalError(
            f"permission denied while preflighting worktree removal: {location}; "
            f"{PERMISSION_REPAIR_HINT}"
        ) from exc

    for current, directories, files in os.walk(
        worktree_path,
        topdown=True,
        followlinks=False,
        onerror=inspection_error,
    ):
        if not os.access(current, os.R_OK | os.X_OK):
            raise RemovalError(
                f"permission denied while preflighting worktree removal: {current}; "
                f"{PERMISSION_REPAIR_HINT}"
            )
        if (directories or files) and not os.access(current, os.W_OK | os.X_OK):
            raise RemovalError(
                f"permission denied while preflighting worktree removal: {current}; "
                f"{PERMISSION_REPAIR_HINT}"
            )


def remove_registered_worktree(repo, worktree_path, *, discard=False):
    assert_tree_removable(worktree_path)
    try:
        args = ["worktree", "remove"]
        if discard:
            args.append("--force")
        args.append(worktree_path)
        git(repo, args)
    except RemovalError as exc:
        marker = os.path.join(worktree_path, ".git")
        if os.path.lexists(worktree_path) and not os.path.isfile(marker):
            raise RemovalError(
                f"Git partially removed worktree metadata at {worktree_path}; "
                f"preserved the residual directory and local branch for recovery: {exc}"
            ) from exc
        raise
    if os.path.lexists(worktree_path):
        raise RemovalError(
            f"Git reported success but the worktree path remains at {worktree_path}; "
            "preserved the local branch for recovery"
        )


def acquire_operation_lock(lock_path):
    if not os.path.isabs(lock_path) or os.path.islink(lock_path):
        raise RemovalError("invalid worktree operation lock")
    flags = os.O_RDWR | getattr(os, "O_NOFOLLOW", 0)
    fd = os.open(lock_path, flags)
    if not stat.S_ISREG(os.fstat(fd).st_mode):
        os.close(fd)
        raise RemovalError("worktree operation lock is not a regular file")
    fcntl.flock(fd, fcntl.LOCK_EX)
    return fd


def active_served_root(driver, reference, app_subdir):
    if driver == "node-service":
        proc = subprocess.run(
            ["systemctl", "show", "-p", "WorkingDirectory", "--value", reference],
            capture_output=True,
            text=True,
            timeout=10,
        )
        if proc.returncode:
            detail = (proc.stderr or proc.stdout or "could not inspect served worktree").strip()
            raise RemovalError(detail)
        root = proc.stdout.strip()
        suffix = f"/{app_subdir.strip('/')}" if app_subdir else ""
        if suffix:
            if not root.endswith(suffix):
                return None
            root = root[: -len(suffix)]
        return os.path.realpath(root) if root and os.path.isdir(root) else None
    if driver == "nginx-docroot":
        return os.path.realpath(reference) if reference and os.path.islink(reference) else None
    if driver == "path":
        return os.path.realpath(reference) if reference else None
    if driver == "none":
        return None
    raise RemovalError(f"unknown serve driver: {driver}")


def remove_local_worktree(repo, worktrees_root, target, driver, served_reference, app_subdir, lock_path, protected_branches, *, discard=False):
    repo_real = os.path.realpath(repo)
    root_real = os.path.realpath(worktrees_root)
    if not os.path.isdir(repo_real):
        raise RemovalError(f"repository does not exist: {repo}")
    if not os.path.isdir(root_real):
        raise RemovalError(f"worktree root does not exist: {worktrees_root}")
    if not target or target in {".", ".."} or os.path.basename(target) != target:
        raise RemovalError("invalid worktree name")

    lock_fd = acquire_operation_lock(lock_path)
    try:
        served_root = active_served_root(driver, served_reference, app_subdir) or ""
        inventory = worktrees(repo_real)
        matches = [record for record in inventory if os.path.basename(record["path"].rstrip(os.sep)) == target]
        if len(matches) != 1:
            raise RemovalError(f"unknown or ambiguous worktree: {target}")
        selected = matches[0]
        selected_path = os.path.abspath(selected["path"])
        selected_real = os.path.realpath(selected_path)
        if selected_path != selected_real:
            raise RemovalError("refused worktree path that resolves through a symlink")
        if not is_descendant(root_real, selected_path):
            raise RemovalError("refused to remove the primary checkout or a worktree outside the managed root")
        if not os.path.isdir(selected_path):
            raise RemovalError("worktree directory is missing; run git worktree prune manually")
        if served_root and selected_real == os.path.realpath(served_root):
            raise RemovalError("refused to remove the currently served worktree")
        if selected.get("locked"):
            raise RemovalError("worktree is locked")

        if not discard:
            clean_or_discard_generated_changes(selected_path)

        branch = branch_name(selected)
        if branch:
            if branch.lower() in PROTECTED_BRANCHES | {item.lower() for item in protected_branches}:
                raise RemovalError(f"refused to remove protected local branch: {branch}")
            ref = selected["branch"]
            for record in inventory:
                if record is selected:
                    continue
                if record.get("branch") == ref:
                    raise RemovalError(f"branch {branch} is still checked out by another worktree")
        else:
            # A detached worktree has no local branch to delete. Its commit
            # may be unreachable from the primary checkout; the clean/live/
            # path checks above are the protections that matter here.
            pass

        if os.path.realpath(selected_path) != selected_path:
            raise RemovalError("worktree path changed while removal was pending")
        remove_registered_worktree(repo_real, selected_path, discard=discard)
        if branch:
            try:
                # Removal is explicitly requested by the admin. Delete the
                # local ref even when it is not merged; the remote ref is
                # never touched.
                git(repo_real, ["branch", "-D", "--", branch])
            except RemovalError as exc:
                raise RemovalError(f"worktree was removed but local branch {branch} remains: {exc}")
        git(repo_real, ["worktree", "prune"])

        if branch:
            return f"Removed local worktree {target} and local branch {branch}. Remote branches were not changed."
        return f"Removed detached local worktree {target}. Remote branches were not changed."
    finally:
        fcntl.flock(lock_fd, fcntl.LOCK_UN)
        os.close(lock_fd)


def remove_local_branch(repo, worktrees_root, branch, protected_branches, *, discard=False):
    """Branch-first removal (Epic-Done cleanup): delete refs/heads/<branch>
    and, when one exists, the linked worktree checked out on it. Unlike the
    name-based mode there is no operation lock and no served-worktree driver —
    the caller (pm-epic-merge-runner) only names branches it has verified as
    ancestors of the pushed Epic branch, and protected/live/primary/dirty
    guards below still refuse anything unsafe. Remote refs are never touched.
    """
    repo_real = os.path.realpath(repo)
    root_real = os.path.realpath(worktrees_root)
    if not os.path.isdir(repo_real):
        raise RemovalError(f"repository does not exist: {repo}")
    # A task may be reset before its first worktree claim. A missing managed
    # root is safe only when Git reports no linked holder below; any holder is
    # rejected by the descendant check just like an out-of-root worktree.
    if not branch or branch.startswith("-"):
        raise RemovalError("invalid branch name")
    if git(repo_real, ["check-ref-format", "--branch", branch], check=False).returncode:
        raise RemovalError(f"invalid branch name: {branch}")
    if branch.lower() in PROTECTED_BRANCHES | {item.lower() for item in protected_branches}:
        raise RemovalError(f"refused to remove protected local branch: {branch}")

    ref = f"refs/heads/{branch}"
    branch_exists = git(repo_real, ["rev-parse", "--verify", "--quiet", ref], check=False).returncode == 0

    inventory = worktrees(repo_real)
    holders = [record for record in inventory if record.get("branch") == ref]
    removed_worktree = None
    for record in holders:
        holder_path = os.path.abspath(record["path"])
        holder_real = os.path.realpath(holder_path)
        if holder_path != holder_real:
            raise RemovalError("refused worktree path that resolves through a symlink")
        if not is_descendant(root_real, holder_path):
            raise RemovalError(
                f"branch {branch} is checked out outside the managed worktree root: {holder_path}"
            )
        if record.get("locked"):
            raise RemovalError(f"worktree for branch {branch} is locked")
        if not os.path.isdir(holder_path):
            git(repo_real, ["worktree", "prune"])
            continue
        if not discard:
            clean_or_discard_generated_changes(holder_path)
        remove_registered_worktree(repo_real, holder_path, discard=discard)
        removed_worktree = holder_path

    if branch_exists:
        try:
            git(repo_real, ["branch", "-D", "--", branch])
        except RemovalError as exc:
            raise RemovalError(f"local branch {branch} could not be deleted: {exc}")
    git(repo_real, ["worktree", "prune"])

    if not branch_exists and not removed_worktree:
        return f"Local branch {branch} is already absent. Remote branches were not changed."
    if removed_worktree:
        return f"Removed local branch {branch} and its worktree {removed_worktree}. Remote branches were not changed."
    return f"Removed local branch {branch} (no worktree was attached). Remote branches were not changed."


def parse_protected_branches(raw):
    try:
        protected_branches = json.loads(raw)
    except json.JSONDecodeError as exc:
        raise RemovalError(f"invalid protected branch list: {exc}")
    if not isinstance(protected_branches, list) or not all(isinstance(item, str) for item in protected_branches):
        raise RemovalError("invalid protected branch list")
    return protected_branches


def main(argv):
    if len(argv) == 6 and argv[1] == "--branch":
        print(remove_local_branch(argv[2], argv[3], argv[4], parse_protected_branches(argv[5])))
        return
    if len(argv) == 6 and argv[1] == "--discard-branch":
        print(remove_local_branch(
            argv[2], argv[3], argv[4], parse_protected_branches(argv[5]), discard=True
        ))
        return
    if len(argv) == 10 and argv[1] == "--discard-worktree":
        protected_branches = parse_protected_branches(argv[9])
        print(remove_local_worktree(
            argv[2], argv[3], argv[4], argv[5], argv[6], argv[7], argv[8],
            protected_branches, discard=True
        ))
        return
    if len(argv) == 9:
        protected_branches = parse_protected_branches(argv[8])
        print(remove_local_worktree(argv[1], argv[2], argv[3], argv[4], argv[5], argv[6], argv[7], protected_branches))
        return
    raise RemovalError(
        "usage: worktree-remove <repo> <worktrees-root> <worktree-name> <driver> <served-reference> <app-subdir> <lock-file> <protected-branches-json>\n"
        "       worktree-remove --branch <repo> <worktrees-root> <branch> <protected-branches-json>\n"
        "       worktree-remove --discard-branch <repo> <worktrees-root> <branch> <protected-branches-json>\n"
        "       worktree-remove --discard-worktree <repo> <worktrees-root> <worktree-name> <driver> <served-reference> <app-subdir> <lock-file> <protected-branches-json>"
    )


if __name__ == "__main__":
    try:
        main(sys.argv)
    except (RemovalError, OSError, subprocess.TimeoutExpired) as exc:
        print(f"worktree-remove: {exc}", file=sys.stderr)
        raise SystemExit(1)
