[Unit]
Description=PM (agents.vixi.au) — Next.js project workspace
Documentation=https://zeh-ferrari.atlassian.net/browse/HOMELAB-43
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Run as the host's main Linux user (x1 → zeh; no dedicated pm user per spec).
User=zeh
Group=zeh
WorkingDirectory=/srv/Code/environment/ai/web

# Env file is host-private (mode 0600, owner zeh) — contains AUTH_SECRET, etc.
EnvironmentFile=/etc/default/pm
# DATABASE_URL points at a writable per-host SQLite file (see pm.env.example).

# Standalone Next.js output is built at ai/web/.next/standalone/server.js.
# Static + public assets are copied alongside by the post-build deploy step.
ExecStart=/usr/bin/node /srv/Code/environment/ai/web/.next/standalone/server.js

Restart=on-failure
RestartSec=3s

# Reasonable hardening — relax only if a feature breaks.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/srv/Code/environment/ai/web/prisma /etc/openclaw/pm-agent-credentials
ReadOnlyPaths=/srv/agents

[Install]
WantedBy=multi-user.target
