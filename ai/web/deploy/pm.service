[Unit]
Description=PM (agents.vixi.au) - Next.js project workspace
Documentation=https://zeh-ferrari.atlassian.net/browse/HOMELAB-43
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The checkout is built by the code owner, but runtime secrets are owned by
# the PM app user on x1.
User=karen
Group=karen
WorkingDirectory=/srv/Code/environment.worktrees/feature_HOMELAB-41-local-project-manager-webapp-/ai/web/.next/standalone

EnvironmentFile=/etc/default/pm
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3000
Environment=PM_OPENCLAW_CHANNEL_TOKEN_FILE=/etc/openclaw/pm-channel-tokens.json

ExecStart=/usr/bin/node24 server.js

Restart=on-failure
RestartSec=3s

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/srv/Code/environment.worktrees/feature_HOMELAB-41-local-project-manager-webapp-/ai/web/prisma /srv/Code/environment.worktrees/feature_HOMELAB-41-local-project-manager-webapp-/ai/web/.data /etc/openclaw/pm-agent-credentials /var/lib/pm/drop -/srv/Data/projects
ReadOnlyPaths=/srv/agents /etc/openclaw/pm-channel-tokens.json

[Install]
WantedBy=multi-user.target
