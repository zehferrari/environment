# worktree-preview env contract — the per-project "how to switch" declaration.
#
# This is the host-side mirror of ai/web/lib/deploy/switch-registry.ts. One file
# per switchable project, installed to /etc/worktree-preview/<key>.env. The
# generic runner (worktree-switch-runner) and the templated systemd served unit
# (worktree-preview@<key>.service) read these values, so adding a project is:
#   1. add a SwitchProject entry to switch-registry.ts (web side)
#   2. drop a /etc/worktree-preview/<key>.env (this file, host side)
#   3. `systemctl enable --now worktree-switch-runner@<key>` (node-service)
# with no bespoke per-project scripts.
#
# KEY must match the registry entry's `key`. It names the spool dir and, for
# node-service projects, the worktree-preview@<key> served unit instance.

# ---- common (all drivers) -------------------------------------------------
KEY=wdt
# node-service | nginx-docroot
DRIVER=node-service
REPO=/srv/Code/whitsunday-discovery-trail
WORKTREES_ROOT=/srv/Code/whitsunday-discovery-trail.worktrees
# Uniform spool layout for new projects. PM stays on its legacy /var/lib/pm/switch
# until the supervised migration; everything else uses /var/lib/worktree-switch/<key>.
SPOOL_DIR=/var/lib/worktree-switch/wdt
# Sub-path from the worktree root to the built/served app. "" = repo root.
# PM is the only project with a non-empty value (ai/web); kept here so the
# generic scripts never assume ai/web.
APP_SUBDIR=

# ---- node-service driver (Next.js + SQLite: environment, wdt) --------------
# The served systemd unit instance that gets its WorkingDirectory flipped + is
# restarted on a switch, and stopped/started on off/on.
SERVED_UNIT=worktree-preview@wdt.service
# Port the served unit listens on (must match nginx upstream).
PORT=3001
HOST=127.0.0.1
# Build + start recipes, run inside <worktree>/<APP_SUBDIR>.
BUILD_CMD='pnpm build'
START_CMD='pnpm start'
# Build output directory (Next.js distDir). Defaults to .next when omitted; set
# it when the project configures a custom distDir. WDT uses dist (distDir:'dist'
# in next.config.js). Used by worktree-switch.sh + worktree-preview-apply to
# locate and validate the build output.
BUILD_OUTPUT_DIR=dist
# Per-branch DB fork engine: sqlite | none. environment + wdt fork SQLite so the
# Prisma schema switches with the code; a project with no DB sets none.
DB_ENGINE=sqlite
# Canonical DB the per-branch forks are seeded from (sqlite only).
CANONICAL_DB=/srv/Data/wdt/wdt.db
DB_ROOT=/srv/Data/wdt

# ---- nginx-docroot driver (PHP/Joomla: patricia) --------------------------
# Only used when DRIVER=nginx-docroot; ignored for node-service. Example values:
#   DRIVER=nginx-docroot
#   CURRENT_SYMLINK=/srv/Code/patricia.current   # nginx `root`; repointed per switch
#   RELOAD_CMD='nginx -s reload'
#   DB_ENGINE=none                               # shared MySQL, NOT forked per worktree
#   OFF_MODE=maintenance                         # "off" = maintenance/deny gate, not a
#                                                #  resource stop (PHP-FPM is a shared pool)
