#!/usr/bin/env python3
"""pm-switch-runner — monitor-driven worktree switch runner.

Runs as the monitor agent as a systemd service, DECOUPLED from
pm.service so the restart at the end of a switch can't kill the switch itself.
The PM web app (also the monitor) only drops a request.json into the spool dir;
this runner picks it up, runs pm-switch.sh (build + privileged flip via
pm-apply-worktree), and publishes state.json for the browser to poll.

Spool (PM_SWITCH_DIR, default /var/lib/pm/switch):
  request.json  — written by the web app: {id, target, databaseSelection, requestedBy, requestedAt}
  state.json    — written here: {served, servedBranch, worktrees[], job{}, updatedAt}

Config via env (set in the systemd unit):
  PM_SWITCH_DIR, PM_SWITCH_SCRIPT, ENV_REPO, PM_WORKTREES_ROOT, PM_SWITCH_POLL_SECONDS
"""
import datetime
import json
import os
import re
import subprocess
import time

SWITCH_DIR = os.environ.get("PM_SWITCH_DIR", os.environ.get("PM_DEPLOY_SWITCH_DIR", "/var/lib/pm/switch"))
SWITCH_SCRIPT = os.environ.get("PM_SWITCH_SCRIPT", "/usr/local/sbin/pm-switch")
REPO = os.environ.get("ENV_REPO", os.environ.get("PM_DEPLOY_REPO_ROOT", "/srv/Code/environment"))
WORKTREES_ROOT = os.environ.get(
    "PM_WORKTREES_ROOT", os.environ.get("PM_DEPLOY_WORKTREES_ROOT", "/srv/Code/environment.worktrees")
)
LOCK_FILE = os.environ.get(
    "PM_WORKTREE_LOCK", os.environ.get("PM_DEPLOY_WORKTREE_LOCK", "/var/lib/worktree-locks/environment.lock")
)
REMOVE_SCRIPT = os.environ.get("PM_WORKTREE_REMOVE_SCRIPT", "/usr/local/sbin/worktree-remove")
POLL = float(os.environ.get("PM_SWITCH_POLL_SECONDS", "2"))
REQUEST = os.path.join(SWITCH_DIR, "request.json")
STATE = os.path.join(SWITCH_DIR, "state.json")
MAINTENANCE = os.path.join(SWITCH_DIR, ".maintenance")
ANSI = re.compile(r"\x1b\[[0-9;]*m")


def now():
    return datetime.datetime.now(datetime.timezone.utc).isoformat()


def read_json(path):
    try:
        with open(path) as f:
            return json.load(f)
    except Exception:
        return None


def git(repo, args, *, timeout=20):
    """Run Git while trusting only this exact managed repository/worktree."""
    safe_repo = os.path.realpath(repo)
    return subprocess.run(
        ["git", "-c", f"safe.directory={safe_repo}", "-C", safe_repo, *args],
        capture_output=True, text=True, timeout=timeout,
    )


def served():
    """(worktree_root, branch) pm.service is serving, from its WorkingDirectory."""
    try:
        wd = subprocess.run(
            ["systemctl", "show", "-p", "WorkingDirectory", "--value", "pm.service"],
            capture_output=True, text=True, timeout=10,
        ).stdout.strip()
        suffix = "/ai/web/.next/standalone"
        if wd.endswith(suffix):
            root = wd[: -len(suffix)]
            br = git(root, ["rev-parse", "--abbrev-ref", "HEAD"], timeout=10).stdout.strip()
            return root, br
    except Exception:
        pass
    return None, None


def service_active(name):
    try:
        return subprocess.run(
            ["systemctl", "is-active", name],
            capture_output=True, text=True, timeout=10,
        ).stdout.strip() == "active"
    except Exception:
        return False


def worktrees(served_root):
    out = git(REPO, ["worktree", "list", "--porcelain"], timeout=20).stdout
    res, cur = [], {}
    for line in out.splitlines():
        if line.startswith("worktree "):
            cur = {"path": line[9:]}
        elif line.startswith("HEAD "):
            cur["head"] = line[5:][:10]
        elif line.startswith("branch "):
            cur["branch"] = line[7:].replace("refs/heads/", "")
        elif line.startswith("detached"):
            cur["branch"] = "(detached)"
        elif line == "" and cur:
            res.append(cur); cur = {}
    if cur:
        res.append(cur)
    for w in res:
        w["name"] = os.path.basename(w["path"])
        w["ready"] = os.path.isdir(os.path.join(w["path"], "ai/web/node_modules"))
        w["served"] = (w["path"] == served_root)
        w.setdefault("branch", "?")
    return res


def write_state(job):
    root, br = served()
    tree_list = worktrees(root)
    if (
        job.get("state") == "error"
        and job.get("action") != "remove"
        and root
        and service_active("pm.service")
        and service_active("pm-consumer.service")
        and job.get("target") in {root, os.path.basename(root)}
    ):
        job = {
            "id": job.get("id"),
            "state": "done",
            "target": job.get("target"),
            "message": f"Now serving {job.get('target')}.",
            "startedAt": job.get("startedAt"),
            "updatedAt": now(),
            "log": job.get("log", ""),
        }
    if (
        job.get("state") == "error"
        and job.get("action") == "remove"
        and "is not merged into the primary checkout" in str(job.get("log", ""))
        and job.get("target")
        and job.get("target") not in {w["name"] for w in tree_list}
    ):
        target = job.get("target")
        job = {
            "id": job.get("id"),
            "state": "done",
            "action": "remove",
            "target": target,
            "message": f"Removed local worktree {target}.",
            "startedAt": job.get("startedAt"),
            "updatedAt": now(),
            "log": "Local worktree and local branch removed after explicit discard; remote branch unchanged.",
        }
    state = {
        "served": root,
        "servedBranch": br,
        "worktrees": tree_list,
        "job": job,
        "updatedAt": now(),
    }
    tmp = STATE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(state, f, indent=2)
    os.replace(tmp, STATE)
    try:
        os.chmod(STATE, 0o600)
    except OSError:
        pass


def run_switch(req):
    target = str(req.get("target", "")).strip()
    database_selection = str(req.get("databaseSelection", "")).strip()
    if database_selection not in {"", "worktree", "main"}:
        return {"id": req["id"], "state": "error", "action": "serve", "target": target,
                "message": "Invalid database selection.", "startedAt": now(),
                "updatedAt": now(), "log": "Browser switches may select only a named worktree database."}
    valid = {w["name"] for w in worktrees(None)} | {w["path"] for w in worktrees(None)}
    if target not in valid:
        return {"id": req["id"], "state": "error", "action": "serve", "target": target,
                "message": f"Unknown worktree: {target}", "startedAt": now(),
                "updatedAt": now(), "log": ""}

    started = now()
    write_state({"id": req["id"], "state": "building", "action": "serve", "target": target,
                 "message": f"Building & switching to {target}…", "startedAt": started,
                 "updatedAt": now(), "log": ""})
    command = [SWITCH_SCRIPT]
    if database_selection:
        command.append(f"--database={database_selection}")
    command.append(target)
    proc = subprocess.run(command, capture_output=True, text=True)
    log = ANSI.sub("", (proc.stdout or "") + (proc.stderr or ""))
    tail = "\n".join(log.splitlines()[-40:])
    if proc.returncode == 0:
        return {"id": req["id"], "state": "done", "action": "serve", "target": target,
                "message": f"Now serving {target}.", "startedAt": started,
                "updatedAt": now(), "log": tail}
    return {"id": req["id"], "state": "error", "action": "serve", "target": target,
            "message": f"Switch failed (exit {proc.returncode}).", "startedAt": started,
            "updatedAt": now(), "log": tail}


def run_remove(req):
    target = str(req.get("target", "")).strip()
    valid = {w["name"] for w in worktrees(None)}
    if target not in valid:
        return {"id": req["id"], "state": "error", "action": "remove", "target": target,
                "message": f"Unknown worktree: {target}", "startedAt": now(),
                "updatedAt": now(), "log": ""}

    started = now()
    write_state({"id": req["id"], "state": "working", "action": "remove", "target": target,
                 "message": f"Removing local worktree {target}…", "startedAt": started,
                 "updatedAt": now(), "log": ""})
    try:
        protected = req.get("protectedBranches", [])
        if not isinstance(protected, list) or not all(isinstance(branch, str) for branch in protected):
            protected = []
        discard_changes = req.get("discardChanges", False)
        if not isinstance(discard_changes, bool):
            return {"id": req["id"], "state": "error", "action": "remove", "target": target,
                    "message": "Invalid local removal request.", "startedAt": started,
                    "updatedAt": now(), "log": "discardChanges must be a boolean"}
        command = [REMOVE_SCRIPT]
        if discard_changes:
            command.append("--discard-worktree")
        command.extend([REPO, WORKTREES_ROOT, target, "node-service", "pm.service", "ai/web/.next/standalone", LOCK_FILE, json.dumps(protected)])
        proc = subprocess.run(
            command,
            capture_output=True,
            text=True,
        )
    except OSError as exc:
        return {"id": req["id"], "state": "error", "action": "remove", "target": target,
                "message": "Local removal helper could not start.", "startedAt": started,
                "updatedAt": now(), "log": str(exc)}
    tail = "\n".join(ANSI.sub("", (proc.stdout or "") + (proc.stderr or "")).splitlines()[-40:])
    if proc.returncode == 0:
        return {"id": req["id"], "state": "done", "action": "remove", "target": target,
                "message": f"Removed local worktree {target}.", "startedAt": started,
                "updatedAt": now(), "log": tail}
    message = (f"Worktree {target} was removed, but its local branch remains."
               if "worktree was removed but local branch" in tail
               else f"Could not remove local worktree {target}.")
    return {"id": req["id"], "state": "error", "action": "remove", "target": target,
            "message": message, "startedAt": started,
            "updatedAt": now(), "log": tail}


def run_action(req):
    action = str(req.get("action", "serve")).strip() or "serve"
    if action == "remove":
        return run_remove(req)
    if action != "serve":
        return {"id": req["id"], "state": "error", "action": action, "target": req.get("target"),
                "message": f"Unsupported action: {action}", "startedAt": now(),
                "updatedAt": now(), "log": ""}
    return run_switch(req)


def main():
    st = read_json(STATE)
    job = (st or {}).get("job") or {
        "id": None, "state": "idle", "target": None, "message": "",
        "startedAt": None, "updatedAt": now(), "log": "",
    }
    last_id = job.get("id")
    write_state(job)
    while True:
        # Root-owned deploy/install work pauses request consumption before it
        # takes the shared operation lock. Requests remain in request.json and
        # are picked up after the marker is removed.
        if os.path.exists(MAINTENANCE):
            write_state(job)
            time.sleep(POLL)
            continue
        req = read_json(REQUEST)
        if req and req.get("id") and req["id"] != last_id:
            last_id = req["id"]
            job = run_action(req)
            write_state(job)
        else:
            write_state(job)  # refresh inventory/served (catches CLI switches, new worktrees)
        time.sleep(POLL)


if __name__ == "__main__":
    main()
