# /etc/default/pm-deploy
#
# Non-secret host layout used by the managed Mission Control release helpers.
# install-pm-switch.sh renders this contract from its PM_* environment options;
# this file documents the complete portable shape for a new host. Keep runtime
# credentials in /etc/default/pm instead — never add them here or commit them.

PM_DEPLOY_MONITOR_USER=karen
PM_DEPLOY_MONITOR_HOME=/home/karen
PM_DEPLOY_MONITOR_GROUP=karen
PM_DEPLOY_CODE_GROUP=code-agents
PM_DEPLOY_REPO_ROOT=/srv/Code/environment
PM_DEPLOY_WORKTREES_ROOT=/srv/Code/environment.worktrees
PM_DEPLOY_SWITCH_DIR=/var/lib/pm/switch
PM_DEPLOY_WORKTREE_LOCK=/var/lib/worktree-locks/environment.lock
PM_DEPLOY_DB_ROOT=/srv/Data/pm
PM_DEPLOY_CANONICAL_DB=/srv/Data/pm/pm.db
PM_DEPLOY_PNPM_BIN=/usr/local/bin/pnpm
PM_DEPLOY_SYSTEM_ENV_FILE=/etc/default/pm
PM_DEPLOY_ACTIVE_ENV_FILE=/etc/default/pm-active-worktree
PM_DEPLOY_DROP_DIR=/var/lib/pm/drop
