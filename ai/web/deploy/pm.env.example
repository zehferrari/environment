# /etc/default/pm - host-private (chown root:<pm-service-group>, chmod 0640).
# AUTH_SECRET is the single most important value — generate with
#   openssl rand -base64 48
# Rotating it logs everyone out (cookies invalidate).

NODE_ENV=production
PORT=3000
HOSTNAME=127.0.0.1

# Canonical/integration DB. Live worktree previews override DATABASE_URL in
# /etc/systemd/system/pm.service.d/20-active-worktree.conf with
# file:/srv/Data/pm/wt-<branch-slug>.db.
DATABASE_URL=file:///srv/Data/pm/pm.db

AUTH_SECRET=__REPLACE_WITH_LONG_RANDOM__
AUTH_TRUST_HOST=true

APP_URL=https://pm.example.internal
# Base URL used by local OpenClaw callbacks. PM derives both native
# /api/openclaw/pm-channel/reply and /api/openclaw/pm-channel/stream
# callback URLs from this value unless PM_AGENT_CALLBACK_URL is set.
PM_INTERNAL_APP_URL=http://127.0.0.1:3000

# Bitbucket PR deployment approval. The monitor account still needs SSH
# repository write access for git fetch/push; these credentials are for the
# Bitbucket REST API used to create, approve/merge, and poll pull requests.
# The API credential needs pull-request write permission.
# BITBUCKET_USERNAME=automation@example.com
# BITBUCKET_APP_PASSWORD=__REPLACE_WITH_BITBUCKET_APP_PASSWORD__

AGENT_INDEX_PATH=/srv/agents/index.json
AGENT_CREDENTIALS_DIR=/etc/openclaw/pm-agent-credentials
AGENT_SYNC_INTERVAL_MIN=5

# ---- Dispatch (HOMELAB-46 + HOMELAB-48) ------------------------------
# At least ONE of PM_DISPATCH_SOCKET or PM_DISPATCH_DROP_DIR must be set,
# otherwise notifyDispatch short-circuits with skipped="disabled" and no
# agent wakes fire. The agent chat sidebar surfaces this state.
#
# unix-socket (primary, per HOMELAB-45). OpenClaw-side AF_UNIX listener
# must be bound to this path BEFORE PM starts emitting; until then use
# file-drop as the fallback.
# PM_DISPATCH_DRIVER=unix-socket
# PM_DISPATCH_SOCKET=/run/pm/events.sock
#
# file-drop (fallback). One JSON file per envelope; consumer reads in
# order. Safe to enable in non-prod even without a live listener — the
# scripts/pm-dispatch-receiver.ts harness can stand in.
PM_DISPATCH_DRIVER=file-drop
PM_DISPATCH_DROP_DIR=/var/lib/pm/drop

# ---- Native OpenClaw PM channel -------------------------------------
# Direct chat, task chat, task-comment, and Epic chat replies go through
# the local OpenClaw pm channel. Per-agent tokens are generated by
# deploy/install-openclaw-pm-channel.mjs and must be readable by the PM
# service user group. Final replies persist through /reply; partial
# chunks stream through /stream for the live browser projection.
PM_OPENCLAW_CHANNEL_TOKEN_FILE=/etc/openclaw/pm-channel-tokens.json
PM_OPENCLAW_CHANNEL_INGRESS_PATH=/pm-channel/ingest
PM_OPENCLAW_CHANNEL_TIMEOUT_MS=5000
PM_ASYNC_DISPATCH=1
PM_ASYNC_DISPATCH_INLINE_NUDGE=1
PM_CHANNEL_JOB_MAX_ATTEMPTS=3
PM_CHANNEL_WORKER_POLL_MS=1000
PM_CONTEXT_GRANTS_REQUIRED=0
PM_CONTEXT_GRANT_TTL_MS=900000
PM_CONTEXT_GRANT_MAX_USES=20

# ---- Attachments (HOMELAB-47) ----------------------------------------
# Override the on-disk root. Defaults to /srv/Data/projects in prod and
# <cwd>/.data/attachments in dev. The directory must be writable by the
# pm service user. Per-file size cap (bytes) defaults to 25 MiB.
# PM_ATTACHMENT_ROOT=/srv/Data/projects
# PM_ATTACHMENT_MAX_BYTES=26214400

# Direct agent chat uploads are copied into the target agent's Samba
# share. The PM service user must be able to create
# /srv/samba/shared/<agent>/chats/<chatId>/ and the systemd sandbox must
# allow writes to /srv/samba/shared.
# PM_AGENT_SAMBA_ROOT=/srv/samba/shared/[agent]

# ---- Bin / soft delete (HOMELAB-48) ----------------------------------
# Soft-deleted Tasks and Epics are hard-deleted after PM_BIN_TTL_DAYS,
# checked every PM_BIN_PURGE_INTERVAL_MIN minutes.
# PM_BIN_TTL_DAYS=7
# PM_BIN_PURGE_INTERVAL_MIN=60

# Stage 1 seed for the zeh human user — temporary, must rotate on first login.
# Leave commented to use the description's default of "password1".
# PM_SEED_ZEH_PASSWORD=password1
