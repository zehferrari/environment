[Unit]
Description=PM worktree switch runner (monitor-driven build + serve flip)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Runs as the monitor agent. Decoupled from pm.service on purpose: the switch
# ends by restarting pm.service, so it must not live in pm.service's cgroup.
# Installer (install-pm-switch.sh) substitutes __PM_MONITOR_USER__.
User=__PM_MONITOR_USER__
Group=__PM_CODE_GROUP__
# Keep access to the monitor-owned active environment and private spool.
SupplementaryGroups=__PM_MONITOR_GROUP__
Environment=HOME=__PM_MONITOR_HOME__
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PM_SWITCH_DIR=__PM_SWITCH_DIR__
Environment=PM_SWITCH_SCRIPT=/usr/local/sbin/pm-switch
Environment=ENV_REPO=__PM_REPO_ROOT__
Environment=PM_WORKTREES_ROOT=__PM_WORKTREES_ROOT__
Environment=PM_WORKTREE_LOCK=__PM_LOCK_FILE__
# Non-secret, root-owned host path defaults rendered by install-pm-switch.sh.
# Explicit Environment= values above remain backwards-compatible; the
# PM_DEPLOY_* names in this file are used when a host overrides them.
EnvironmentFile=-/etc/default/pm-deploy
ExecStart=/usr/local/sbin/pm-switch-runner
Restart=on-failure
RestartSec=5s

# NOTE: deliberately NOT NoNewPrivileges — the runner must `sudo -n
# pm-apply-worktree` (the one privileged step), allowed by /etc/sudoers.d/pm-switch.

[Install]
WantedBy=multi-user.target
