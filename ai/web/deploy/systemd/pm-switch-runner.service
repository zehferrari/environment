[Unit]
Description=PM worktree switch runner (monitor-driven build + serve flip)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Runs as the monitor agent. Decoupled from pm.service on purpose: the switch
# ends by restarting pm.service, so it must not live in pm.service's cgroup.
# Installer (install-pm-switch.sh) substitutes __PM_MONITOR_USER__.
User=__PM_MONITOR_USER__
Group=code-agents
Environment=HOME=/home/__PM_MONITOR_USER__
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PM_SWITCH_DIR=/var/lib/pm/switch
Environment=PM_SWITCH_SCRIPT=/usr/local/sbin/pm-switch
Environment=ENV_REPO=/srv/Code/environment
Environment=PM_WORKTREES_ROOT=/srv/Code/environment.worktrees
Environment=PM_WORKTREE_LOCK=/var/lib/worktree-locks/environment.lock
ExecStart=/usr/local/sbin/pm-switch-runner
Restart=on-failure
RestartSec=5s

# NOTE: deliberately NOT NoNewPrivileges — the runner must `sudo -n
# pm-apply-worktree` (the one privileged step), allowed by /etc/sudoers.d/pm-switch.

[Install]
WantedBy=multi-user.target
