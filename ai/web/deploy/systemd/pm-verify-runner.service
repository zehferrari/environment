[Unit]
Description=PM repository submission and validation runner
After=network-online.target pm.service
Wants=network-online.target

[Service]
Type=simple
# Runs as the repo-fetch user so `git fetch` can use that account's SSH
# credentials. The application resolves the comment author from the active
# agent whose registry role is monitor; it does not use this OS username as
# workflow authority.
# Decoupled from pm.service: a worktree switch during a Review must not kill
# the verifier (and vice versa).
User=__PM_VERIFY_RUN_USER__
Group=code-agents
Environment=HOME=/home/__PM_VERIFY_RUN_USER__
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PM_BRANCH_VERIFY_DIR=/var/lib/pm/branch-verify
EnvironmentFile=/etc/default/pm-active-worktree
ExecStart=/usr/local/sbin/pm-verify-runner
Restart=on-failure
RestartSec=5s

# Read-only on the filesystem outside the spool and the DB dir; no sudo needed.

[Install]
WantedBy=multi-user.target
