[Unit]
Description=PM branch-verify runner (Karen post-Review push check)
Documentation=https://zeh-ferrari.atlassian.net/browse/HOMELAB-41
After=network-online.target pm.service
Wants=network-online.target

[Service]
Type=simple
# Runs as the monitor agent — same user that runs pm.service so it can read
# DATABASE_URL from /etc/default/pm and write into the SQLite DB without sudo.
# Decoupled from pm.service: a worktree switch during a Review must not kill
# the verifier (and vice versa).
User=__PM_MONITOR_USER__
Group=code-agents
Environment=HOME=/home/__PM_MONITOR_USER__
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PM_BRANCH_VERIFY_DIR=/var/lib/pm/branch-verify
EnvironmentFile=/etc/default/pm
ExecStart=/usr/local/sbin/pm-verify-runner
Restart=on-failure
RestartSec=5s

# Read-only on the filesystem outside the spool and the DB dir; no sudo needed.

[Install]
WantedBy=multi-user.target
