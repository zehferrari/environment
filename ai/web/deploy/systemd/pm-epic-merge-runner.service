[Unit]
Description=PM Epic-branch merge/cleanup runner (local-only task branch integration)
After=network-online.target pm.service
Wants=network-online.target

[Service]
Type=simple
# Runs as the repo-push user so `git fetch`/`git push` of the Epic integration
# branch use that account's SSH credentials. PM_MONITOR_USER controls which PM
# user authors merge/cleanup comments. Deliberately NOT sandboxed: it needs
# git worktree add + ref writes across /srv/Code, which pm.service's
# ProtectSystem=strict sandbox forbids (same split as pm-verify-runner).
# Decoupled from pm.service: a worktree switch must not kill a merge in flight.
User=__PM_MERGE_RUN_USER__
Group=code-agents
Environment=HOME=/home/__PM_MERGE_RUN_USER__
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PM_EPIC_MERGE_DIR=/var/lib/pm/epic-merge
Environment=PM_MONITOR_USER=__PM_MONITOR_USER__
EnvironmentFile=/etc/default/pm-active-worktree
ExecStart=/usr/local/sbin/pm-epic-merge-runner
Restart=on-failure
RestartSec=5s

# No sudo needed: git runs with this user's credentials, DB writes go through
# DATABASE_URL from the active env file.

[Install]
WantedBy=multi-user.target
