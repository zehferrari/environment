[Unit]
Description=AI judgment layer over openclaw-integrity-check
After=network-online.target ollama.service openclaw-integrity.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/ai-monitor
Nice=10
StandardOutput=journal
StandardError=journal
SuccessExitStatus=0 1
# A full tick may include bounded external probes, a 180-second monitor-agent
# decision window, and a recovery confirmation. Keep a hard ceiling above that
# internal budget—including the configured fallback-model chain—so systemd
# does not kill a healthy in-flight handoff.
TimeoutStartSec=12min
