#!/usr/bin/env python3
import base64
import json
import os
import re
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path
from urllib.error import HTTPError, URLError
from urllib.request import Request, urlopen

WEBHOOK_PORT_FALLBACKS = {"karen": 3010, "asdrubal": 3011, "barekbaal": 3012}
AGENT_REGISTRY_PATH = Path("/etc/openclaw/agents.json")
AGENT_DEFAULTS_PATH = Path("/etc/openclaw/agent-defaults.json")


def load_agent_defaults():
    try:
        return json.loads(AGENT_DEFAULTS_PATH.read_text())
    except Exception:
        return {"core": {"services": [], "capabilities": {}},
                "byRole": {}, "byIntegration": {}}


def derive_effective_agent(agent, defaults, all_agents=None):
    """Merge defaults (core, byRole[role], byIntegration[k]) into agent.
    Per-agent services append (dedup); capabilities override key-by-key.
    Returns shallow copy with derived services/capabilities."""
    eff = dict(agent)
    core = defaults.get("core") or {}
    services = list(core.get("services") or [])
    caps = dict(core.get("capabilities") or {})

    role = agent.get("role")
    by_role = ((defaults.get("byRole") or {}).get(role) or {}) if role else {}
    for s in (by_role.get("services") or []):
        if s not in services:
            services.append(s)
    caps.update(by_role.get("capabilities") or {})

    by_int = defaults.get("byIntegration") or {}
    for k, on in (agent.get("integrations") or {}).items():
        if not on:
            continue
        block = by_int.get(k) or {}
        for s in (block.get("services") or []):
            if s not in services:
                services.append(s)
        caps.update(block.get("capabilities") or {})

    for s in (agent.get("services") or []):
        if s not in services:
            services.append(s)
    caps.update(agent.get("capabilities") or {})

    # Per-agent monitor.json: project resources the agent has installed
    # in ~/.local/openclaw/monitor.json. Each enabled resource contributes
    # its services + listeners on top of the central registry.
    home = agent.get("home") or f"/home/{agent.get('user')}"
    mpath = Path(home) / ".local" / "openclaw" / "monitor.json"
    if mpath.exists():
        try:
            mdoc = json.loads(mpath.read_text())
            eff_listeners = list(agent.get("listeners") or [])
            seen_listeners = {(L.get("host"), L.get("port")) for L in eff_listeners}
            for r in (mdoc.get("resources") or []):
                if not r.get("enabled"):
                    continue
                for s in (r.get("services") or []):
                    if s not in services:
                        services.append(s)
                for L in (r.get("listeners") or []):
                    key = (L.get("host"), L.get("port"))
                    if key not in seen_listeners:
                        eff_listeners.append(L)
                        seen_listeners.add(key)
            eff["listeners"] = eff_listeners
        except Exception:
            pass

    # Receiver-gating: openclaw-<X>-receiver.service is gated at script
    # startup by integrations.<X> (see webhooks/common.js KNOWN_RECEIVERS).
    # Drop gated-off receivers from derived services so integrity-check
    # doesn't flag intentionally-inactive units as failing.
    import re as _re_recv
    _integ = agent.get("integrations") or {}
    _recv_re = _re_recv.compile(r"^openclaw-([a-z0-9-]+)-receiver\.service$")

    # Check if there is any coding agent with this integration
    has_active_integration = {}
    if all_agents:
        for a in all_agents:
            if a.get("enabled", True) and a.get("role") == "coding":
                a_integ = a.get("integrations") or {}
                for k, v in a_integ.items():
                    if v:
                        has_active_integration[k] = True

    services_filtered = []
    for s in services:
        m = _recv_re.match(s)
        if m:
            gate = m.group(1)
            # If the agent itself doesn't have the monitor integration or the specific gate enabled, drop it.
            # Additionally, if role == "monitor", only keep the receiver if at least one coding agent uses it.
            if not _integ.get("monitor") or not _integ.get(gate):
                continue
            if agent.get("role") == "monitor" and not has_active_integration.get(gate):
                continue
        services_filtered.append(s)
    services = services_filtered

    eff["services"] = services
    eff["capabilities"] = caps
    return eff
TELEGRAM_LOG_WINDOW = "-10min"
PUBLIC_DEV_HEALTH_URL = "https://dev.vixi.au/webhooks/health"
PUBLIC_DEV_HEALTH_UA = "Mozilla/5.0"
WATCH_EXPIRY_WARN_HOURS = 24
MODEL_AUTH_REFRESH_WARN_SECONDS = 7 * 24 * 60 * 60
OPENCLAW_BINARY = "/usr/local/bin/openclaw"
RUNUSER_BINARY = "/usr/sbin/runuser"
REMEDIATION_ENABLED = True  # Auto-restart failed services
REMEDIATION_COOLDOWN_SECONDS = 120  # Don't restart same service within 2 minutes
REMEDIATION_LOG_FILE = Path("/var/log/openclaw-remediation.log")


ok_count = 0
warn_count = 0
fail_count = 0


def emit(level, message):
    global ok_count, warn_count, fail_count
    if level == "OK":
        ok_count += 1
    elif level == "WARN":
        warn_count += 1
    elif level == "FAIL":
        fail_count += 1
    print(f"[{level}] {message}")


def trim(text, limit=200):
    text = (text or "").strip().replace("\n", " ")
    return text[:limit] + ("..." if len(text) > limit else "")


def run(cmd, timeout=20, cwd=None, env=None):
    merged_env = os.environ.copy()
    if env:
        merged_env.update(env)
    try:
        cp = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, cwd=cwd, env=merged_env)
        return cp.returncode, cp.stdout, cp.stderr
    except subprocess.TimeoutExpired as exc:
        return 124, exc.stdout or "", exc.stderr or "timeout"
    except Exception as exc:
        return 1, "", str(exc)


def load_json_file(path):
    with open(path) as fh:
        return json.load(fh)


def load_agent_registry():
    if not AGENT_REGISTRY_PATH.exists():
        return None
    try:
        registry = load_json_file(AGENT_REGISTRY_PATH)
    except Exception as exc:
        emit("FAIL", f"unable to parse {AGENT_REGISTRY_PATH} ({trim(str(exc))})")
        return None
    defaults = load_agent_defaults()
    raw_agents = registry.get("agents") or []
    registry["agents"] = [
        derive_effective_agent(a, defaults, raw_agents)
        for a in raw_agents
    ]
    agents = [
        a for a in registry["agents"]
        if a.get("enabled", True) and a.get("user")
    ]
    if agents:
        emit("OK", f"agent monitoring registry loaded ({AGENT_REGISTRY_PATH}, agents={','.join(a['user'] for a in agents)})")
        return registry
    emit("FAIL", f"agent monitoring registry has no enabled monitored agents ({AGENT_REGISTRY_PATH})")
    return None


def fallback_agent_registry(users_cfg):
    """Degraded-mode registry when /etc/openclaw/agents.json is unreadable.
    Treats every legacy webhook user config entry as a generic coding
    agent — neutral defaults, no host-specific identity baked in. The
    real registry should always be reachable in production; this just
    keeps the integrity check from crashing during transient outages."""
    defaults = load_agent_defaults()
    agents = []
    raw_agents = []
    for user in sorted((users_cfg.get("users") or {}).keys()):
        raw_agents.append({
            "user": user,
            "enabled": True,
            "role": "coding",
            "telegram": {"enabled": True},
            "integrations": {
                "webhook": True,
                "gmail": True,
                "jira": True,
                "bitbucket": True,
                "openaiAuth": True,
            },
        })
    for a in raw_agents:
        agents.append(derive_effective_agent(a, defaults, raw_agents))
    return {"version": 0, "agents": agents}


def parse_env_file(path):
    data = {}
    p = Path(path)
    if not p.exists():
        return data
    for raw in p.read_text().splitlines():
        if not raw or raw.lstrip().startswith("#") or "=" not in raw:
            continue
        key, value = raw.split("=", 1)
        data[key] = value.strip().strip('"').strip("'")
    return data


def parse_systemd_show_environment(text):
    text = (text or "").strip()
    if not text.startswith("Environment="):
        return {}
    payload = text[len("Environment="):].strip()
    if not payload:
        return {}
    env = {}
    for item in payload.split():
        if "=" not in item:
            continue
        key, value = item.split("=", 1)
        env[key] = value
    return env


def http_json(url, headers=None, timeout=15):
    req = Request(url, headers=headers or {})
    try:
        with urlopen(req, timeout=timeout) as resp:
            body = resp.read().decode("utf-8", "replace")
            return resp.getcode(), json.loads(body), body
    except HTTPError as exc:
        body = exc.read().decode("utf-8", "replace")
        try:
            data = json.loads(body)
        except Exception:
            data = None
        return exc.code, data, body
    except URLError as exc:
        raise RuntimeError(str(exc.reason))


def user_systemctl_cmd(user, uid, *args):
    return [
        "sudo", "-n", "-u", user, "env",
        f"XDG_RUNTIME_DIR=/run/user/{uid}",
        f"DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/{uid}/bus",
        "systemctl", "--user", *args,
    ]


def user_uid(user):
    try:
        return int(__import__("pwd").getpwnam(user).pw_uid)
    except Exception:
        return None


def check_user_service(user, service):
    uid = user_uid(user)
    if uid is None:
        emit("FAIL", f"{user}: no passwd entry for service {service}")
        return False
    rc, out, err = run(user_systemctl_cmd(user, uid, "is-active", service), timeout=10)
    if rc == 0 and out.strip() == "active":
        emit("OK", f"{user}: service {service} is active")
        return True
    emit("FAIL", f"{user}: service {service} is not active ({trim(out or err)})")
    return False


def check_webhook_health(name, port, expected_users=None):
    try:
        status, data, body = http_json(f"http://127.0.0.1:{port}/health", timeout=5)
    except Exception as exc:
        emit("FAIL", f"{name}: webhook health probe failed on port {port} ({trim(str(exc))})")
        return
    if status != 200:
        emit("FAIL", f"{name}: webhook health probe returned HTTP {status} on port {port}")
        return
    if isinstance(data, dict) and data.get("status") == "ok":
        if expected_users:
            users = sorted(data.get("users") or [])
            want = sorted(expected_users)
            if users == want:
                emit("OK", f"{name}: webhook health is ok on port {port} with users {','.join(users)}")
            else:
                emit("FAIL", f"{name}: webhook health users mismatch on port {port} (got {users}, expected {want})")
        else:
            emit("OK", f"{name}: webhook health is ok on port {port}")
        return
    if "ok" in body.lower():
        emit("OK", f"{name}: webhook health is ok on port {port}")
    else:
        emit("FAIL", f"{name}: unexpected webhook health payload on port {port} ({trim(body)})")


def detect_webhook_port(user):
    env_path = Path(f"/home/{user}/.config/openclaw/openclaw-webhook.env")
    env = parse_env_file(env_path)
    try:
        if env.get("PORT"):
            return int(env["PORT"])
    except ValueError:
        pass
    return WEBHOOK_PORT_FALLBACKS.get(user)


def check_recent_telegram_logs(user):
    # Check 10m window for reporting
    rc, out, err = run(
        ["su", "-", user, "-c", f"journalctl --user -u openclaw-gateway --since={TELEGRAM_LOG_WINDOW} --no-pager"],
        timeout=20,
    )
    text_10m = (out or "") + (err or "")
    send_failures = text_10m.count("sendMessage failed")
    action_failures = text_10m.count("sendChatAction failed")
    final_failures = text_10m.count("final reply failed")
    polling_stalls_10m = text_10m.count("Polling stall detected")
    
    # Check 3m window for auto-remediation (more recent, avoids re-triggering on old errors)
    rc2, out2, err2 = run(
        ["su", "-", user, "-c", "journalctl --user -u openclaw-gateway --since=-3min --no-pager"],
        timeout=20,
    )
    text_3m = (out2 or "") + (err2 or "")
    polling_stalls_3m = text_3m.count("Polling stall detected")
    
    # Only auto-restart if there are RECENT stalls (within 3m), not just any in 10m window
    # AND the service isn't already restarting frequently
    if polling_stalls_10m or final_failures or send_failures >= 3:
        # Attempt remediation only for recent issues
        remediated = False
        remediation_msg = ""
        if polling_stalls_3m >= 1:  # Only restart if RECENT stalls
            # First check if service is actually active
            rc_active, out_active, _ = run(
                ["systemctl", "--user", "-M", f"{user}@", "is-active", "openclaw-gateway"],
                timeout=5,
            )
            if rc_active == 0 and out_active.strip() == "active":
                # Service is active but has polling stalls - restart it
                remediated, remediation_msg = remediate_service(user, "openclaw-gateway")
                if remediated:
                    log_remediation("AUTO_RESTART", user, "openclaw-gateway", "success")
            else:
                # Service is not active - don't restart, let systemd handle it
                remediation_msg = f"service not active ({out_active.strip()})"
        
        status_msg = f"(polling_stalls={polling_stalls_10m}, final_reply_failures={final_failures}, send_failures={send_failures}, action_failures={action_failures})"
        if remediated:
            emit("WARN", f"{user}: Recent Telegram errors detected, auto-restart triggered {status_msg}")
        else:
            emit(
                "FAIL",
                f"{user}: recent Telegram gateway errors detected in last 10m {status_msg}"
                + (f" [remediation: {remediation_msg}]" if remediation_msg else ""),
            )
    else:
        emit("OK", f"{user}: no recent Telegram gateway errors in last 10m")


def check_gmail_watch_state(user, google_dir):
    state_path = google_dir / "watch-state.json"
    if not state_path.exists():
        emit("FAIL", f"{user}: missing Gmail watch state file {state_path}")
        return
    try:
        state = load_json_file(state_path)
    except Exception as exc:
        emit("FAIL", f"{user}: unable to parse Gmail watch state ({trim(str(exc))})")
        return

    expiration_raw = state.get("expiration")
    if not expiration_raw:
        emit("FAIL", f"{user}: Gmail watch state missing expiration")
        return

    try:
        expiration_dt = datetime.fromtimestamp(int(expiration_raw) / 1000, timezone.utc)
    except Exception as exc:
        emit("FAIL", f"{user}: invalid Gmail watch expiration ({trim(str(exc))})")
        return

    remaining_seconds = (expiration_dt - datetime.now(timezone.utc)).total_seconds()
    if remaining_seconds <= 0:
        emit("FAIL", f"{user}: Gmail watch expired at {expiration_dt.isoformat()} (renew required)")
        return

    if remaining_seconds < WATCH_EXPIRY_WARN_HOURS * 3600:
        emit("WARN", f"{user}: Gmail watch expires soon at {expiration_dt.isoformat()} (<{WATCH_EXPIRY_WARN_HOURS}h)")
    else:
        emit("OK", f"{user}: Gmail watch valid until {expiration_dt.isoformat()}")


def check_google(user, openclaw_cfg):
    skill_enabled = bool(openclaw_cfg.get("skills", {}).get("entries", {}).get("google-workspace", {}).get("enabled"))
    if skill_enabled:
        emit("OK", f"{user}: google-workspace skill enabled")
    else:
        emit("FAIL", f"{user}: google-workspace skill not enabled")
    google_dir = Path(f"/home/{user}/.openclaw/workspace/google")
    check_gmail_watch_state(user, google_dir)
    sa_path = google_dir / "secrets/gcp-sa.json"
    if not sa_path.exists():
        emit("FAIL", f"{user}: missing Google service account file {sa_path}")
        return
    try:
        sa = load_json_file(sa_path)
    except Exception as exc:
        emit("FAIL", f"{user}: unable to parse Google service account file ({trim(str(exc))})")
        return
    project_id = sa.get("project_id")
    client_email = sa.get("client_email")
    if project_id and client_email:
        emit("OK", f"{user}: Google service account metadata present ({project_id}, {client_email})")
    else:
        emit("FAIL", f"{user}: Google service account metadata incomplete")
        return
    unit_path = Path(f"/home/{user}/.config/systemd/user/openclaw-gmail-listener.service")
    sub_name = "gmail-inbox-watch-sub"
    if unit_path.exists():
        match = re.search(r"gmail-push-worker\.js\s+(\S+)", unit_path.read_text())
        if match:
            sub_name = match.group(1)
    node_script = (
        "const {PubSub}=require('@google-cloud/pubsub');"
        "const projectId=process.argv[1];"
        "const subName=process.argv[2];"
        "const sub=new PubSub({projectId}).subscription(subName);"
        "sub.getMetadata().then(([m])=>{console.log(m.name||'ok');}).catch((err)=>{"
        "console.error(err && err.message ? err.message : String(err)); process.exit(1);});"
    )
    rc, out, err = run(
        ["node", "-e", node_script, project_id, sub_name],
        cwd=str(google_dir),
        env={"GOOGLE_APPLICATION_CREDENTIALS": str(sa_path)},
        timeout=25,
    )
    if rc == 0:
        emit("OK", f"{user}: Google Pub/Sub probe succeeded ({trim(out)})")
    else:
        emit("FAIL", f"{user}: Google Pub/Sub probe failed ({trim(err or out)})")


def check_telegram(user, openclaw_cfg):
    telegram_cfg = openclaw_cfg.get("channels", {}).get("telegram", {})
    if not telegram_cfg.get("enabled"):
        emit("FAIL", f"{user}: Telegram channel not enabled")
        return
    bot_token = (telegram_cfg.get("botToken") or "").strip()
    if not bot_token:
        token_file = (telegram_cfg.get("tokenFile") or "").strip()
        if token_file:
            try:
                bot_token = Path(token_file).read_text().strip()
            except Exception as exc:
                emit("FAIL", f"{user}: Telegram tokenFile unreadable ({trim(str(exc))})")
                return
        else:
            env_path = Path(f"/home/{user}/.config/openclaw/openclaw-secrets.env")
            if env_path.exists():
                try:
                    for line in env_path.read_text().splitlines():
                        if line.startswith("TELEGRAM_BOT_TOKEN="):
                            bot_token = line.split("=", 1)[1].strip()
                            break
                except Exception as exc:
                    emit("FAIL", f"{user}: secrets.env unreadable ({trim(str(exc))})")
                    return
    if not bot_token:
        emit("FAIL", f"{user}: Telegram bot token missing (no botToken, tokenFile, or TELEGRAM_BOT_TOKEN in secrets.env)")
        return
    emit("OK", f"{user}: Telegram channel enabled")
    try:
        status, data, body = http_json(
            f"https://api.telegram.org/bot{bot_token}/getMe",
            headers={"User-Agent": PUBLIC_DEV_HEALTH_UA},
            timeout=15,
        )
    except Exception as exc:
        emit("FAIL", f"{user}: Telegram getMe probe failed ({trim(str(exc))})")
        return
    if status == 200 and isinstance(data, dict) and data.get("ok") is True:
        username = ((data.get("result") or {}).get("username") or "").strip()
        label = f"@{username}" if username else "Telegram bot"
        emit("OK", f"{user}: Telegram API probe succeeded ({label})")
    else:
        emit("FAIL", f"{user}: Telegram API probe returned HTTP {status} ({trim(body)})")
    check_recent_telegram_logs(user)


def json_object_with_key(text, required_key):
    """Extract one JSON object from CLI output that may include plugin notices.

    OpenClaw can print ANSI-coloured plugin discovery warnings before its JSON
    document. Never log the raw output here: model-status JSON may include
    credential-bearing provider metadata.
    """
    decoder = json.JSONDecoder()
    for pos, char in enumerate(text or ""):
        if char != "{":
            continue
        try:
            value, _end = decoder.raw_decode(text[pos:])
        except json.JSONDecodeError:
            continue
        if isinstance(value, dict) and required_key in value:
            return value
    return None


def run_as_user(user, home, argv, timeout=20):
    return run(
        [RUNUSER_BINARY, "-u", user, "--", "env", f"HOME={home}", *argv],
        timeout=timeout,
    )


def model_providers_in_use(status):
    models = [status.get("defaultModel"), *(status.get("fallbacks") or [])]
    return {
        model.split("/", 1)[0]
        for model in models
        if isinstance(model, str) and "/" in model
    }


def check_native_claude_auth(user, home):
    claude_binary = Path(home) / ".local" / "bin" / "claude"
    if not claude_binary.exists():
        emit("FAIL", f"{user}: claude-cli is in the active model chain but {claude_binary} is missing")
        return False

    rc, out, _err = run_as_user(
        user,
        home,
        [str(claude_binary), "auth", "status"],
        timeout=20,
    )
    native_status = json_object_with_key(out, "loggedIn") if rc == 0 else None
    if not native_status or native_status.get("loggedIn") is not True:
        emit(
            "FAIL",
            f"{user}: Claude CLI login is unavailable — run `claude auth login`, then "
            "`openclaw models auth login --provider anthropic --method cli --force`",
        )
        return False

    credential_path = Path(home) / ".claude" / ".credentials.json"
    try:
        oauth = (load_json_file(credential_path) or {}).get("claudeAiOauth") or {}
    except Exception as exc:
        emit("FAIL", f"{user}: unable to inspect Claude renewal metadata ({trim(str(exc))})")
        return False

    if not (oauth.get("refreshToken") or "").strip():
        emit("FAIL", f"{user}: Claude CLI is logged in but has no renewable refresh token")
        return False

    refresh_expires_ms = oauth.get("refreshTokenExpiresAt")
    if not refresh_expires_ms:
        emit("WARN", f"{user}: Claude CLI refresh token has no recorded expiry")
        return True
    try:
        refresh_expires = datetime.fromtimestamp(
            int(refresh_expires_ms) / 1000,
            timezone.utc,
        )
    except Exception:
        emit("FAIL", f"{user}: Claude CLI refresh-token expiry is invalid")
        return False

    remaining = (refresh_expires - datetime.now(timezone.utc)).total_seconds()
    if remaining <= 0:
        emit("FAIL", f"{user}: Claude CLI refresh token expired — browser re-authentication is required")
        return False
    if remaining <= MODEL_AUTH_REFRESH_WARN_SECONDS:
        emit(
            "WARN",
            f"{user}: Claude CLI refresh token expires in {remaining / 86400:.1f}d "
            f"({refresh_expires.isoformat()}) — renew before it lapses",
        )
        return True

    emit(
        "OK",
        f"{user}: Claude CLI login is renewable; refresh credential valid for "
        f"{remaining / 86400:.1f}d ({refresh_expires.isoformat()})",
    )
    return True


def check_model_auth(user, home):
    """Inspect the current SQLite-backed auth store and native CLI routes.

    The former check read only `auth.json`, which OpenClaw no longer uses. It
    therefore reported a healthy-looking "no auth file" while an active
    claude-cli profile had been expired for weeks.
    """
    rc, out, _err = run_as_user(
        user,
        home,
        [OPENCLAW_BINARY, "models", "status", "--json"],
        timeout=30,
    )
    status = json_object_with_key(out, "configPath") if rc == 0 else None
    if not status:
        emit("FAIL", f"{user}: unable to inspect active OpenClaw model authentication")
        return

    auth = status.get("auth") or {}
    active_providers = model_providers_in_use(status)
    missing = set(auth.get("missingProvidersInUse") or [])
    for provider in sorted(active_providers & missing):
        emit("FAIL", f"{user}: active model provider {provider} has no usable credential")

    provider_status = {
        item.get("provider"): item
        for item in ((auth.get("oauth") or {}).get("providers") or [])
        if isinstance(item, dict) and item.get("provider")
    }

    for provider in sorted(active_providers - missing):
        if provider == "claude-cli":
            check_native_claude_auth(user, home)
            continue

        item = provider_status.get(provider)
        if not item:
            # Providers with environment/plugin-owned credentials need not
            # appear in oauth.providers; missingProvidersInUse is authoritative.
            emit("OK", f"{user}: active model provider {provider} has usable runtime auth")
            continue
        state = item.get("status") or "unknown"
        expires_ms = item.get("expiresAt")
        expiry = ""
        if expires_ms:
            try:
                expiry = datetime.fromtimestamp(int(expires_ms) / 1000, timezone.utc).isoformat()
            except Exception:
                expiry = "invalid expiry"
        if state == "expired":
            emit("FAIL", f"{user}: active model provider {provider} OAuth expired ({expiry or 'unknown expiry'})")
        elif state == "expiring":
            emit("WARN", f"{user}: active model provider {provider} OAuth is expiring ({expiry or 'unknown expiry'})")
        elif state in {"ok", "static"}:
            emit("OK", f"{user}: active model provider {provider} auth is {state}")
        else:
            emit("WARN", f"{user}: active model provider {provider} auth status is {state}")


def check_bitbucket(user, user_cfg, workspace, repo):
    token_file = user_cfg.get("bitbucketTokenFile")
    email = (user_cfg.get("bitbucketEmail") or "").strip()
    if not token_file:
        emit("FAIL", f"{user}: Bitbucket token file not configured")
        return
    token_path = Path(token_file)
    if not token_path.exists():
        emit("FAIL", f"{user}: missing Bitbucket token file {token_path}")
        return
    token = token_path.read_text().strip()
    if not token or not email:
        emit("FAIL", f"{user}: Bitbucket credentials incomplete")
        return
    emit("OK", f"{user}: Bitbucket token file present")
    # Atlassian API tokens expire and cannot be renewed automatically — the
    # operator records the expiry date (shown once at creation) in a sidecar
    # `<tokenFile>.expiry` (ISO YYYY-MM-DD) so this check can warn BEFORE the
    # 401s start instead of after.
    expiry_path = Path(str(token_path) + ".expiry")
    if expiry_path.exists():
        raw_expiry = expiry_path.read_text().strip()
        try:
            expiry = datetime.fromisoformat(raw_expiry).date()
            days_left = (expiry - datetime.now(timezone.utc).date()).days
            if days_left < 0:
                emit("FAIL", f"{user}: Bitbucket token expiry date passed ({raw_expiry}) — mint a new Atlassian API token")
            elif days_left <= 14:
                emit("WARN", f"{user}: Bitbucket token expires in {days_left}d ({raw_expiry}) — renew soon")
            else:
                emit("OK", f"{user}: Bitbucket token expiry {raw_expiry} ({days_left}d left)")
        except ValueError:
            emit("WARN", f"{user}: Bitbucket token expiry sidecar unreadable ({trim(raw_expiry)}) — expected ISO YYYY-MM-DD")
    auth = base64.b64encode(f"{email}:{token}".encode("utf-8")).decode("ascii")
    try:
        status, data, body = http_json(
            f"https://api.bitbucket.org/2.0/repositories/{workspace}/{repo}",
            headers={"Authorization": f"Basic {auth}", "Accept": "application/json", "User-Agent": PUBLIC_DEV_HEALTH_UA},
            timeout=15,
        )
    except Exception as exc:
        emit("FAIL", f"{user}: Bitbucket probe failed ({trim(str(exc))})")
        return
    expected_name = f"{workspace}/{repo}"
    if status == 200 and isinstance(data, dict) and data.get("full_name") == expected_name:
        emit("OK", f"{user}: Bitbucket API probe succeeded ({expected_name})")
    else:
        emit("FAIL", f"{user}: Bitbucket probe returned HTTP {status} ({trim(body)})")


def check_jira(user, user_cfg):
    token_file = user_cfg.get("jiraTokenFile")
    if not token_file:
        emit("FAIL", f"{user}: Jira token file not configured")
        return
    token_path = Path(token_file)
    if not token_path.exists():
        emit("FAIL", f"{user}: missing Jira token file {token_path}")
        return
    token = token_path.read_text().strip()
    if token:
        emit("OK", f"{user}: Jira token file present")
    else:
        emit("FAIL", f"{user}: Jira token file is empty")


def check_dev_public_ingress(expected_users, monitor_user="monitor"):
    # Skip if the host can't even resolve `moonlight` — hosts that don't
    # ingress through moonlight (yoga510, future stand-alone deployments)
    # have no reason to probe it. Resolution is the cheap proxy for
    # "this host is wired into the moonlight ingress path".
    rc, _out, _err = run(["getent", "hosts", "moonlight"], timeout=5)
    if rc != 0:
        emit("OK", f"{monitor_user}: skipping public moonlight ingress probe (moonlight not in /etc/hosts or DNS)")
        return
    rc, out, err = run(
        ["ssh", "moonlight", "curl", "-fsS", "-A", PUBLIC_DEV_HEALTH_UA, PUBLIC_DEV_HEALTH_URL],
        timeout=25,
    )
    if rc != 0:
        emit("FAIL", f"{monitor_user}: public moonlight ingress probe failed ({trim(err or out)})")
        return
    body = (out or "").strip()
    try:
        data = json.loads(body)
    except Exception:
        emit("FAIL", f"{monitor_user}: public moonlight ingress returned non-JSON payload ({trim(body)})")
        return
    users = sorted(data.get("users") or [])
    want = sorted(expected_users)
    if data.get("status") == "ok" and users == want:
        emit("OK", f"{monitor_user}: public moonlight ingress health is ok with users {','.join(users)}")
    else:
        emit("FAIL", f"{monitor_user}: public moonlight ingress payload mismatch ({trim(body)})")


def find_monitor_user(agent_registry):
    """Find the monitor agent in the registry (role=monitor). Returns
    (user, home, uid) or (None, None, None) if no monitor agent."""
    for a in ((agent_registry or {}).get("agents") or []):
        if a.get("role") == "monitor" and a.get("enabled", True):
            user = a.get("user")
            home = a.get("home") or (f"/home/{user}" if user else None)
            return user, home, a.get("uid")
    return None, None, None


def routed_agents(agent_registry, integration):
    out = []
    for agent in ((agent_registry or {}).get("agents") or []):
        integrations = agent.get("integrations") or {}
        if (
            agent.get("enabled", True)
            and agent.get("role") == "coding"
            and integrations.get(integration)
        ):
            out.append(agent)
    return out


def routed_usernames(agent_registry, integration):
    return [a.get("user") for a in routed_agents(agent_registry, integration) if a.get("user")]


def derived_user_cfg(agent):
    user = agent.get("user")
    home = Path(agent.get("home") or (f"/home/{user}" if user else ""))
    return {
        "home": str(home),
        "tasksFile": str(home / "tasks" / "current.md"),
        "logFile": str(home / "tasks" / "log.md"),
        "jiraTokenFile": str(home / ".ssh" / "jiraToken.txt"),
        "bitbucketTokenFile": str(home / ".ssh" / "bitbucketToken.txt"),
        "bitbucketEmail": agent.get("bitbucket_email") or agent.get("bitbucketEmail") or agent.get("email") or "",
        "jiraDisplayName": agent.get("jira_display_name") or agent.get("jiraDisplayName") or agent.get("name") or user,
        "jiraAccountId": agent.get("jira_account_id") or agent.get("jiraAccountId"),
    }


def registry_value(agent_registry, camel_name, snake_name=None):
    value = (agent_registry or {}).get(camel_name)
    if value is None and snake_name:
        value = (agent_registry or {}).get(snake_name)
    return str(value or "").strip()


def check_dev_shared_files(agent_registry=None, monitor_user=None, monitor_home=None):
    if not monitor_user or not monitor_home:
        emit("WARN", "no monitor agent (role=monitor) in registry — skipping monitor-receiver file checks")
        return
    dev_paths = [
        Path(f"{monitor_home}/webhooks/common.js"),
        Path(f"{monitor_home}/webhooks/jira-receiver.js"),
        Path(f"{monitor_home}/webhooks/bitbucket-receiver.js"),
        Path(f"{monitor_home}/.config/openclaw/openclaw-webhook.env"),
    ]
    for path in dev_paths:
        if path.exists():
            emit("OK", f"{monitor_user}: required file present ({path})")
        else:
            emit("FAIL", f"{monitor_user}: required file missing ({path})")

    route_agents = {
        a.get("user"): a
        for a in (
            routed_agents(agent_registry, "jira") +
            routed_agents(agent_registry, "bitbucket")
        )
        if a.get("user")
    }
    if not route_agents:
        emit("OK", f"{monitor_user}: no registry-routed webhook users")
        return

    for user, agent in sorted(route_agents.items()):
        cfg = derived_user_cfg(agent)
        integrations = agent.get("integrations") or {}
        checks = {
            "home": cfg.get("home"),
            "tasksFile": cfg.get("tasksFile"),
            "logFile": cfg.get("logFile"),
        }
        # Token files are gated on the corresponding integration being enabled.
        # Otherwise an agent that opts out (e.g. integrations.jira=false) still
        # gets FAILs about missing token files they have no reason to have.
        if integrations.get("jira"):
            checks["jiraTokenFile"] = cfg.get("jiraTokenFile")
        if integrations.get("bitbucket"):
            checks["bitbucketTokenFile"] = cfg.get("bitbucketTokenFile")
        for label, raw_path in checks.items():
            if raw_path and Path(raw_path).exists():
                emit("OK", f"{monitor_user}: registry route for {user} has existing {label}")
            else:
                emit("FAIL", f"{monitor_user}: registry route for {user} missing {label} ({raw_path})")
        if integrations.get("jira") and cfg.get("jiraAccountId"):
            emit("OK", f"{monitor_user}: registry route for {user} has Jira account id")
        elif integrations.get("jira"):
            emit("FAIL", f"{monitor_user}: registry route for {user} missing Jira account id")
        if not integrations.get("jira"):
            emit("OK", f"{monitor_user}: registry route for {user} skips jiraTokenFile (Jira integration disabled)")
        if not integrations.get("bitbucket"):
            emit("OK", f"{monitor_user}: registry route for {user} skips bitbucketTokenFile (Bitbucket integration disabled)")


def check_dev_env_drift(monitor_user=None, monitor_home=None, monitor_uid=None):
    if not monitor_user or not monitor_home:
        return
    env_file_path = Path(f"{monitor_home}/.config/openclaw/openclaw-webhook.env")
    file_env = parse_env_file(env_file_path)
    uid = monitor_uid or user_uid(monitor_user) or 1003
    # Use jira-receiver as the representative — same env file is loaded by
    # both receivers, so checking one is sufficient.
    rc, out, err = run(
        user_systemctl_cmd(monitor_user, uid, "show", "openclaw-jira-receiver", "-p", "Environment"),
        timeout=10,
    )
    if rc != 0:
        emit("FAIL", f"{monitor_user}: unable to inspect effective systemd environment ({trim(err or out)})")
        return
    effective_env = parse_systemd_show_environment(out)

    unit_text = ""
    unit_candidates = [
        Path("/etc/systemd/user/openclaw-jira-receiver.service"),
        Path(f"{monitor_home}/.config/systemd/user/openclaw-jira-receiver.service"),
        Path("/usr/lib/systemd/user/openclaw-jira-receiver.service"),
    ]
    for candidate in unit_candidates:
        if candidate.exists():
            try:
                unit_text = candidate.read_text()
                break
            except Exception:
                pass
    if not unit_text:
        emit("WARN", f"{monitor_user}: unable to inspect unit file for EnvironmentFile wiring")
    # Match either the literal path or the systemd specifier form (%h/...)
    # — user units commonly use %h so the same unit file works for any
    # user without per-host substitution.
    envfile_specifier = str(env_file_path).replace(monitor_home, "%h", 1)
    envfile_wired = (
        str(env_file_path) in unit_text
        or envfile_specifier in unit_text
    )

    fallback_port = WEBHOOK_PORT_FALLBACKS.get(monitor_user, "?")
    for key in ("PORT", "JIRA_WEBHOOK_SECRET", "BITBUCKET_WEBHOOK_SECRET"):
        file_value = file_env.get(key, "")
        effective_value = effective_env.get(key, "")
        if key == "PORT":
            if file_value and effective_value and file_value != effective_value:
                emit("WARN", f"{monitor_user}: env file PORT={file_value} differs from effective PORT={effective_value}")
            else:
                emit("OK", f"{monitor_user}: effective {key} is {effective_value or file_value or fallback_port}")
            continue

        if file_value and envfile_wired:
            emit("OK", f"{monitor_user}: {key} supplied via EnvironmentFile ({env_file_path})")
            continue

        if file_value == effective_value:
            emit("OK", f"{monitor_user}: {key} env file matches effective service environment")
        else:
            if file_value and not effective_value:
                emit("WARN", f"{monitor_user}: {key} is set in env file but blank in effective service environment")
            else:
                emit("WARN", f"{monitor_user}: {key} env file/effective service mismatch")



# Remediation tracking with persistent state file
RESTART_STATE_FILE = Path("/var/lib/openclaw/remediation-state.json")

def load_restart_state():
    """Load persistent restart timestamps"""
    try:
        if RESTART_STATE_FILE.exists():
            return json.loads(RESTART_STATE_FILE.read_text())
    except Exception:
        pass
    return {}

def save_restart_state(state):
    """Save persistent restart timestamps"""
    try:
        RESTART_STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
        RESTART_STATE_FILE.write_text(json.dumps(state, indent=2))
    except Exception:
        pass

def log_remediation(action, user, service, result):
    """Log remediation actions to file"""
    from datetime import datetime
    ts = datetime.now().isoformat()
    line = f"{ts} {action}: {user}/{service} -> {result}\n"
    try:
        with open(REMEDIATION_LOG_FILE, 'a') as f:
            f.write(line)
    except Exception:
        pass

def should_remediate(user, service):
    """Check if enough time has passed since last remediation AND service wasn't just restarted"""
    from datetime import datetime, timezone
    
    # Check persistent state
    state = load_restart_state()
    key = f"{user}:{service}"
    now = datetime.now(timezone.utc)
    
    # Check if we recently restarted this service
    last_restart = state.get(key)
    if last_restart:
        try:
            last_dt = datetime.fromisoformat(last_restart.replace('Z', '+00:00'))
            elapsed = (now - last_dt).total_seconds()
            if elapsed < REMEDIATION_COOLDOWN_SECONDS:
                return False, f"service restarted {int(elapsed)}s ago"
        except Exception:
            pass
    
    return True, None

def mark_remediated(user, service):
    """Mark that we just remediated this service - persist to disk"""
    from datetime import datetime, timezone
    state = load_restart_state()
    state[f"{user}:{service}"] = datetime.now(timezone.utc).isoformat()
    save_restart_state(state)

def remediate_service(user, service):
    """Attempt to restart a failed service"""
    if not REMEDIATION_ENABLED:
        return False, "remediation disabled"
    
    can_remediate, reason = should_remediate(user, service)
    if not can_remediate:
        return False, reason
    
    rc, out, err = run(
        ["systemctl", "--user", "-M", f"{user}@", "restart", service],
        timeout=30,
    )
    
    if rc == 0:
        mark_remediated(user, service)
        return True, "restart successful"
    else:
        return False, f"restart failed: {trim(err or out)}"


def main():
    print(f"[INFO] openclaw integrity check started at {datetime.now(timezone.utc).isoformat()}")

    # Load registry first to locate the monitor agent (role=monitor). Webhook
    # routing is derived from this same registry; there is no separate users
    # routing file.
    agent_registry_early = load_agent_registry() or {}
    monitor_user, monitor_home, monitor_uid = find_monitor_user(agent_registry_early)
    if not monitor_user:
        emit("WARN", "no monitor agent (role=monitor) in registry — webhook checks will be limited")

    agent_registry = agent_registry_early
    monitor_agents = [
        a for a in agent_registry.get("agents", [])
        if a.get("enabled", True) and a.get("user")
    ]

    jira_host = registry_value(agent_registry, "jiraHost", "jira_host")
    bitbucket_workspace = registry_value(agent_registry, "bitbucketWorkspace", "bitbucket_workspace")
    bitbucket_repo = registry_value(agent_registry, "bitbucketRepo", "bitbucket_repo")
    jira_users = routed_usernames(agent_registry, "jira")
    bitbucket_users = routed_usernames(agent_registry, "bitbucket")

    if jira_host:
        emit("OK", f"shared Jira host configured ({jira_host})")
    elif not jira_users:
        emit("OK", "shared Jira host not required (no Jira-routed coding agents)")
    else:
        emit("FAIL", "shared Jira host missing from registry")
    if bitbucket_workspace and bitbucket_repo:
        emit("OK", f"shared Bitbucket target configured ({bitbucket_workspace}/{bitbucket_repo})")
    elif not bitbucket_users:
        emit("OK", "shared Bitbucket target not required (no Bitbucket-routed coding agents)")
    else:
        emit("FAIL", "shared Bitbucket target missing from registry")

    check_dev_shared_files(agent_registry, monitor_user, monitor_home)
    check_dev_env_drift(monitor_user, monitor_home, monitor_uid)
    public_users = sorted(set(jira_users))
    check_dev_public_ingress(public_users, monitor_user=monitor_user or "monitor")

    for agent in monitor_agents:
        user = agent["user"]
        user_cfg = derived_user_cfg(agent)
        integrations = agent.get("integrations") or {}

        for service in agent.get("services") or []:
            check_user_service(user, service)

        # Monitor integration: the agent CAN run jira-receiver:3014 and
        # bitbucket-receiver:3015. Each receiver is gated independently
        # by integrations.<X> (see webhooks/common.js KNOWN_RECEIVERS) —
        # only probe the ones whose gate is on.
        if integrations.get("monitor"):
            receiver_ports = [
                ("jira-receiver", 3014, "jira"),
                ("bitbucket-receiver", 3015, "bitbucket"),
            ]
            for label, port, gate in receiver_ports:
                if not integrations.get(gate):
                    emit("OK", f"{user}/{label}: gated off (integrations.{gate}=false); not probed")
                    continue
                expected = routed_usernames(agent_registry, gate)
                if user == monitor_user and not expected:
                    emit("OK", f"{user}/{label}: no registry-routed users; not probed")
                    continue
                check_webhook_health(f"{user}/{label}", port,
                                     expected_users=expected if user == monitor_user else None)

        openclaw_cfg_path = Path(f"/home/{user}/.openclaw/openclaw.json")
        if not openclaw_cfg_path.exists():
            emit("FAIL", f"{user}: missing OpenClaw config {openclaw_cfg_path}")
            continue
        try:
            openclaw_cfg = load_json_file(openclaw_cfg_path)
        except Exception as exc:
            emit("FAIL", f"{user}: unable to parse OpenClaw config ({trim(str(exc))})")
            continue
        emit("OK", f"{user}: OpenClaw config loaded")
        if (agent.get("telegram") or {}).get("enabled"):
            check_telegram(user, openclaw_cfg)
        if integrations.get("gmail"):
            check_google(user, openclaw_cfg)
        # Inspect the providers the configured default/fallback chain can
        # actually select. This covers SQLite-backed OpenAI OAuth and native
        # claude-cli renewal state regardless of legacy integration flags.
        check_model_auth(user, user_cfg["home"])
        # Outbound API token checks are only meaningful for coding agents
        # (who actually call Jira/Bitbucket). The monitor agent may have
        # integrations.jira/bitbucket=true to gate its inbound RECEIVERS
        # and historically had no token file — but the deployment-PR flow
        # runs as the monitor, so when a Bitbucket token file exists for a
        # monitor-role agent it is probed (and its expiry tracked) too.
        if integrations.get("jira") and agent.get("role") == "coding":
            check_jira(user, user_cfg)
        if bitbucket_workspace and bitbucket_repo:
            if integrations.get("bitbucket") and agent.get("role") == "coding":
                check_bitbucket(user, user_cfg, bitbucket_workspace, bitbucket_repo)
            elif agent.get("role") == "monitor" and Path(user_cfg.get("bitbucketTokenFile") or "/nonexistent").exists():
                check_bitbucket(user, user_cfg, bitbucket_workspace, bitbucket_repo)

    print(f"[SUMMARY] ok={ok_count} warn={warn_count} fail={fail_count}")
    return 1 if fail_count else 0


if __name__ == "__main__":
    sys.exit(main())
