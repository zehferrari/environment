#!/usr/bin/env python3
"""
ai-monitor: AI judgment layer for an OpenClaw agent host.

Wraps /usr/local/bin/openclaw-integrity-check, augments with resource sensors
and a functional ollama probe, asks a locally-hosted ollama model to reason
over the combined signal, and sends deduplicated Telegram alerts via
asdrubal's bot. Observe-only with respect to remediation: openclaw-integrity-check
already restarts services with a 120s cooldown.

Usage:
  ai-monitor                   one tick (alerts on failure)
  ai-monitor --observe-only    probe + judge + log, never alert or remediate
  ai-monitor --dry-run         probe + judge, no alerts, prints full JSON
  ai-monitor --test-notify     send one Telegram test message and exit
"""

import argparse
import fcntl
import hashlib
import json
import os
import pwd
import re
import shlex
import sqlite3
import socket
import stat
import subprocess
import sys
import time
import urllib.request
import urllib.error
from pathlib import Path

CONFIG_PATH = "/etc/ai-monitor/config.json"
STATE_PATH = "/var/lib/ai-monitor/state.json"
RUN_LOCK_PATH = "/var/lib/ai-monitor/run.lock"
MODE_PATH = "/var/lib/ai-monitor/mode.json"
RUNUSER_BIN = "/usr/sbin/runuser"
MIB = 1024 ** 2
GIB = 1024 ** 3
DEFAULT_GATEWAY_WARN_BYTES = 8 * GIB
DEFAULT_GATEWAY_CRITICAL_BYTES = 10 * GIB


def operating_mode(cli_observe_only=False):
    """Resolve the persistent/CLI operating mode without changing it."""
    if cli_observe_only:
        return "observe-only"
    configured = os.environ.get("AI_MONITOR_MODE", "").strip().lower()
    if configured in ("active", "observe-only"):
        return configured
    path = Path(os.environ.get("AI_MONITOR_MODE_PATH", MODE_PATH))
    try:
        raw = path.read_text().strip()
        if raw.startswith("{"):
            raw = str(json.loads(raw).get("mode", ""))
        normalized = raw.strip().lower()
        if normalized in ("active", "observe-only"):
            return normalized
    except (OSError, ValueError, TypeError):
        pass
    return "active"


def acquire_run_lock():
    for path in (RUN_LOCK_PATH, "/tmp/ai-monitor.run.lock"):
        try:
            Path(path).parent.mkdir(parents=True, exist_ok=True)
            fh = open(path, "a")
            fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return fh
        except BlockingIOError:
            return None
        except Exception:
            continue
    return True


def run_cmd(argv, timeout=30, input_text=None):
    try:
        res = subprocess.run(
            argv, capture_output=True, text=True, timeout=timeout, input=input_text
        )
        return res.returncode, res.stdout, res.stderr
    except subprocess.TimeoutExpired:
        return 124, "", f"timeout after {timeout}s"
    except FileNotFoundError as e:
        return 127, "", str(e)
    except Exception as e:
        return 1, "", str(e)


def http_post_json(url, payload, timeout=10):
    data = json.dumps(payload).encode("utf-8")
    req = urllib.request.Request(
        url, data=data, headers={"Content-Type": "application/json"}
    )
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return resp.status, resp.read().decode("utf-8", errors="replace")


def probe_listener(host, port, timeout=2):
    last_error = None
    try:
        infos = socket.getaddrinfo(host, port, type=socket.SOCK_STREAM)
    except Exception as e:
        return {"open": False, "error": str(e)[:120]}
    for family, socktype, proto, _canonname, sockaddr in infos:
        s = socket.socket(family, socktype, proto)
        s.settimeout(timeout)
        try:
            s.connect(sockaddr)
            s.close()
            return {"open": True}
        except Exception as e:
            last_error = e
        finally:
            try:
                s.close()
            except Exception:
                pass
    return {"open": False, "error": str(last_error)[:120]}


def probe_systemd_system(unit):
    rc, out, _ = run_cmd(["systemctl", "is-active", unit], timeout=5)
    return {"is_active": out.strip(), "rc": rc}


def probe_systemd_user(user, uid, unit):
    argv = [
        "sudo", "-n", "-u", user, "env",
        f"XDG_RUNTIME_DIR=/run/user/{uid}",
        f"DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/{uid}/bus",
        "systemctl", "--user", "is-active", unit,
    ]
    rc, out, err = run_cmd(argv, timeout=5)
    return {"is_active": out.strip() or "unknown", "rc": rc, "err": err.strip()[:160]}


def systemd_user_bus_broken(state):
    err = state.get("err", "") or ""
    return any(
        marker in err
        for marker in (
            "Transport endpoint is not connected",
            "Bad message",
            "Failed to connect to bus",
        )
    )


def probe_resources(thresholds):
    res = {"ts": int(time.time())}
    try:
        with open("/proc/loadavg") as f:
            parts = f.read().split()
            res["load1"] = float(parts[0])
            res["load5"] = float(parts[1])
            res["load15"] = float(parts[2])
    except Exception:
        pass
    try:
        meminfo = {}
        with open("/proc/meminfo") as f:
            for line in f:
                k, v = line.split(":", 1)
                meminfo[k] = int(v.strip().split()[0]) * 1024
        res["mem_total"] = meminfo.get("MemTotal", 0)
        res["mem_avail"] = meminfo.get("MemAvailable", 0)
        res["swap_total"] = meminfo.get("SwapTotal", 0)
        res["swap_free"] = meminfo.get("SwapFree", 0)
        if res["mem_total"]:
            res["mem_used_pct"] = round(
                100 * (1 - res["mem_avail"] / res["mem_total"]), 1
            )
        if res["swap_total"]:
            res["swap_used_pct"] = round(
                100 * (1 - res["swap_free"] / res["swap_total"]), 1
            )
        else:
            res["swap_used_pct"] = 0
    except Exception:
        pass
    res["cpu_count"] = os.cpu_count() or 1

    temps = []
    for p in Path("/sys/class/thermal").glob("thermal_zone*/temp"):
        try:
            t = int(p.read_text().strip()) / 1000.0
            kind = (p.parent / "type").read_text().strip()
            temps.append({"zone": p.parent.name, "type": kind, "celsius": round(t, 1)})
        except Exception:
            pass
    res["thermal"] = temps
    res["temp_max_c"] = max((t["celsius"] for t in temps), default=0)

    batt = []
    for p in sorted(Path("/sys/class/power_supply").glob("BAT*")):
        try:
            cap = int((p / "capacity").read_text().strip())
            stat = (p / "status").read_text().strip()
            batt.append({"name": p.name, "capacity": cap, "status": stat})
        except Exception:
            pass
    res["battery"] = batt

    res["ac_online"] = None
    for p in Path("/sys/class/power_supply").glob("A*"):
        if (p / "online").exists():
            try:
                res["ac_online"] = int((p / "online").read_text().strip())
                break
            except Exception:
                pass

    fans = []
    for p in Path("/sys/class/hwmon").glob("hwmon*"):
        try:
            name = (p / "name").read_text().strip()
            for f in p.glob("fan*_input"):
                try:
                    rpm = int(f.read_text().strip())
                    fans.append({"hwmon": name, "input": f.name, "rpm": rpm})
                except Exception:
                    pass
        except Exception:
            pass
    res["fans"] = fans
    res["fan_rpm_max"] = max((f["rpm"] for f in fans), default=0)

    try:
        st = os.statvfs("/")
        res["rootfs_used_pct"] = round(100 * (1 - st.f_bavail / st.f_blocks), 1)
    except Exception:
        pass

    try:
        ifaces = {}
        with open("/proc/net/dev") as f:
            for line in f.readlines()[2:]:
                name, rest = line.split(":", 1)
                fields = rest.split()
                ifaces[name.strip()] = {
                    "rx_bytes": int(fields[0]),
                    "tx_bytes": int(fields[8]),
                    "rx_errs": int(fields[2]),
                    "tx_errs": int(fields[10]),
                }
        res["net"] = ifaces
    except Exception:
        pass

    breaches = []
    if res.get("load1", 0) / res["cpu_count"] > thresholds["load1_per_core"]:
        breaches.append(f"load1/core={round(res['load1']/res['cpu_count'],2)}")
    if res.get("mem_used_pct", 0) > thresholds["mem_used_pct"]:
        breaches.append(f"mem_used={res['mem_used_pct']}%")
    if res.get("swap_used_pct", 0) > thresholds["swap_used_pct"]:
        breaches.append(f"swap_used={res['swap_used_pct']}%")
    if res.get("temp_max_c", 0) > thresholds["temp_c"]:
        breaches.append(f"temp={res['temp_max_c']}C")
    if res.get("fan_rpm_max", 0) > thresholds["fan_rpm_max"]:
        breaches.append(f"fan={res['fan_rpm_max']}rpm")
    if res.get("rootfs_used_pct", 0) > thresholds["rootfs_used_pct"]:
        breaches.append(f"rootfs={res['rootfs_used_pct']}%")
    for b in res.get("battery", []):
        if (
            b["capacity"] < thresholds["battery_low_pct"]
            and b["status"] != "Charging"
            and not res.get("ac_online")
        ):
            breaches.append(f"battery={b['capacity']}%")
    res["threshold_breaches"] = breaches
    return res


def _parse_systemd_properties(blob):
    properties = {}
    for line in (blob or "").splitlines():
        key, sep, value = line.partition("=")
        if sep:
            properties[key] = value.strip()
    return properties


def _parse_byte_count(value):
    value = str(value or "").strip()
    if not value or value in {"[not set]", "infinity", "max"}:
        return None
    try:
        parsed = int(value)
        return parsed if parsed >= 0 else None
    except (TypeError, ValueError):
        return None


def _read_cgroup_memory(control_group):
    """Return memory.current for a systemd cgroup, when delegated."""
    parts = Path(str(control_group or "")).parts
    if not control_group or ".." in parts:
        return None
    path = Path("/sys/fs/cgroup") / str(control_group).lstrip("/")
    try:
        return _parse_byte_count((path / "memory.current").read_text())
    except (OSError, ValueError):
        return None


def _read_process_rss(pid):
    """Best-effort fallback when cgroup memory accounting is unavailable."""
    try:
        pid = int(pid)
        if pid <= 0:
            return None
        for line in Path(f"/proc/{pid}/status").read_text().splitlines():
            if line.startswith("VmRSS:"):
                return int(line.split()[1]) * 1024
    except (OSError, TypeError, ValueError, IndexError):
        pass
    return None


def probe_gateway_memory(cfg, registry):
    """Measure each enabled agent's OpenClaw gateway cgroup.

    MemoryCurrent is preferred because it includes gateway child processes.
    Direct cgroup and main-process RSS reads keep the probe useful on older
    systemd releases, while identifying the less-complete fallback source.
    Unless explicitly overridden, alert thresholds follow the unit's
    MemoryHigh and MemoryMax policy. The 8/10 GiB host policy is the fallback
    when systemd does not expose those limits.
    """
    check = cfg.get("gateway_memory_check", {}) or {}
    enabled = check.get("enabled", True)
    unit = check.get("unit", "openclaw-gateway.service")
    warn_override = check.get("warn_mib")
    critical_override = check.get("critical_mib")
    warn_override_bytes = (
        int(warn_override) * MIB if warn_override is not None else None
    )
    critical_override_bytes = (
        int(critical_override) * MIB
        if critical_override is not None else None
    )
    default_warn_bytes = (
        warn_override_bytes
        if warn_override_bytes is not None
        else DEFAULT_GATEWAY_WARN_BYTES
    )
    default_critical_bytes = (
        critical_override_bytes
        if critical_override_bytes is not None
        else DEFAULT_GATEWAY_CRITICAL_BYTES
    )
    default_critical_bytes = max(default_critical_bytes, default_warn_bytes)
    result = {
        "enabled": bool(enabled),
        "unit": unit,
        "warn_bytes": default_warn_bytes,
        "critical_bytes": default_critical_bytes,
        "agents": {},
    }
    if not enabled:
        return result

    for agent in (registry or {}).get("agents", []):
        if not agent.get("enabled"):
            continue
        if unit not in (agent.get("services") or []):
            continue
        user = agent.get("user")
        uid = agent.get("uid")
        if not user or uid is None:
            continue
        argv = [
            "sudo", "-n", "-u", user, "env",
            f"XDG_RUNTIME_DIR=/run/user/{uid}",
            f"DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/{uid}/bus",
            "systemctl", "--user", "show", unit,
            "--property=ActiveState",
            "--property=MemoryCurrent",
            "--property=MemoryPeak",
            "--property=MemoryHigh",
            "--property=MemoryMax",
            "--property=ControlGroup",
            "--property=MainPID",
        ]
        rc, out, err = run_cmd(argv, timeout=5)
        properties = _parse_systemd_properties(out)
        current = _parse_byte_count(properties.get("MemoryCurrent"))
        source = "systemd"
        if current is None:
            current = _read_cgroup_memory(properties.get("ControlGroup"))
            source = "cgroup"
        if current is None:
            current = _read_process_rss(properties.get("MainPID"))
            source = "main-pid-rss"
        peak = _parse_byte_count(properties.get("MemoryPeak"))
        memory_high = _parse_byte_count(properties.get("MemoryHigh"))
        memory_max = _parse_byte_count(properties.get("MemoryMax"))

        critical_bytes = (
            critical_override_bytes
            if critical_override_bytes is not None
            else memory_max or DEFAULT_GATEWAY_CRITICAL_BYTES
        )
        if warn_override_bytes is not None:
            warn_bytes = warn_override_bytes
        elif memory_high is not None:
            warn_bytes = memory_high
        elif memory_max is not None:
            warn_bytes = min(
                DEFAULT_GATEWAY_WARN_BYTES,
                memory_max * 4 // 5,
            )
        else:
            warn_bytes = DEFAULT_GATEWAY_WARN_BYTES
        critical_bytes = max(critical_bytes, warn_bytes)

        state = "unavailable"
        if current is not None:
            state = "critical" if current >= critical_bytes else (
                "warn" if current >= warn_bytes else "ok"
            )
        result["agents"][user] = {
            "uid": uid,
            "active_state": properties.get("ActiveState", "unknown"),
            "current_bytes": current,
            "peak_bytes": peak,
            "source": source if current is not None else None,
            "memory_high_bytes": memory_high,
            "memory_max_bytes": memory_max,
            "warn_bytes": warn_bytes,
            "critical_bytes": critical_bytes,
            "state": state,
            "rc": rc,
            "error": (err or "").strip()[:160],
        }
    return result


_UNSAFE_SHUTDOWN_QUERIES = (
    (
        "systemd-journald",
        r"corrupted or uncleanly shut down|was not closed properly",
        ["-u", "systemd-journald.service"],
    ),
    (
        "kernel",
        (
            r"not cleanly unmounted|recovering journal"
            r"|previous shutdown was not clean"
        ),
        ["-k"],
    ),
)


def _current_boot_epoch():
    try:
        for line in Path("/proc/stat").read_text().splitlines():
            if line.startswith("btime "):
                return int(line.split()[1])
    except (OSError, ValueError, IndexError):
        pass
    return None


def _probe_pstore(path):
    """Return crash-record filenames left by firmware/kernel pstore."""
    evidence = []
    try:
        for entry in sorted(Path(path).iterdir()):
            name = entry.name
            if not (
                name.startswith("dmesg-")
                or name.startswith("console-ramoops")
            ):
                continue
            if entry.is_file() and entry.stat().st_size > 0:
                evidence.append(name)
    except OSError:
        pass
    return evidence


def probe_previous_shutdown(cfg):
    """Report only affirmative local evidence of an unsafe previous shutdown.

    Absence of a clean-shutdown marker is deliberately not enough to alert:
    boot journals can be vacuumed or incomplete. Current-boot recovery
    messages and pstore crash records are explicit evidence.
    """
    check = cfg.get("previous_shutdown_check", {}) or {}
    enabled = check.get("enabled", True)
    result = {
        "enabled": bool(enabled),
        "status": "disabled" if not enabled else "no-unsafe-evidence",
        "evidence": [],
    }
    if not enabled:
        return result

    max_lines = max(1, int(check.get("max_evidence_lines", 20)))
    boot_epoch = _current_boot_epoch()
    journal_errors = []
    if boot_epoch is None:
        journal_errors.append("cannot resolve current boot start")
    else:
        # Recovery messages relevant to the preceding shutdown happen during
        # early boot. Bounding the journal window avoids mistaking a later
        # journald/application restart for host-shutdown evidence.
        until = f"@{boot_epoch + 15 * 60}"
        for source, pattern, source_args in _UNSAFE_SHUTDOWN_QUERIES:
            rc, out, err = run_cmd(
                [
                    "journalctl", "-b", "0", "--no-pager", "-o", "cat",
                    *source_args,
                    "--case-sensitive=no", f"--grep={pattern}",
                    "--until", until, "-n", str(max_lines),
                ],
                timeout=10,
            )
            if rc not in (0, 1):
                journal_errors.append(
                    f"{source}: {(err or out or f'journalctl rc={rc}')[:160]}"
                )
                continue
            matcher = re.compile(pattern, re.IGNORECASE)
            for line in (out or "").splitlines():
                line = line.strip()
                if line and matcher.search(line):
                    result["evidence"].append({
                        "source": f"boot-journal:{source}",
                        "detail": line[:300],
                    })
    if journal_errors:
        result["journal_error"] = "; ".join(journal_errors)[:300]

    pstore_path = check.get("pstore_path", "/sys/fs/pstore")
    for name in _probe_pstore(pstore_path):
        result["evidence"].append({
            "source": "pstore",
            "detail": name[:180],
        })

    if result["evidence"]:
        result["status"] = "unsafe-evidence"
    elif "journal_error" in result:
        result["status"] = "unknown"
    return result


# Model-login findings from openclaw-integrity-check use one fixed shape:
#   [FAIL|WARN] <user>: model-auth <provider>: <detail, including the fix>
# They are routed deterministically (never through the LLM judge, which
# paraphrased expiry lines into wrong times and invented failures) and go
# straight to the human: no agent action can complete a browser/device login.
MODEL_AUTH_LINE_RE = re.compile(
    r"^\[(?P<level>FAIL|WARN)\] (?P<user>[\w.-]+): model-auth (?P<provider>[\w.-]+): (?P<detail>.+)$"
)
MODEL_AUTH_KINDS = {"model-auth-failing", "model-auth-renewal-due"}


def probe_integrity_check(cfg):
    """Read the most recent openclaw-integrity-check output from the journal.
    We don't invoke the binary inline -- when called from a systemd service context
    its systemd-run --user pattern returns 'Transport endpoint is not connected' for
    user services. The openclaw-integrity.timer already runs it every 2 min."""
    tag = cfg["integrity"]["journal_tag"]
    window = cfg["integrity"]["journal_window"]
    rc, out, _ = run_cmd(
        [
            "journalctl", "-t", tag,
            "--since", window,
            "--no-pager", "--output=cat",
        ],
        timeout=10,
    )
    lines = out.strip().splitlines()
    # Group into runs by [INFO] ... started markers; keep the most recent run.
    runs = []
    current = []
    for line in lines:
        if line.startswith("[INFO]") and "started at" in line:
            if current:
                runs.append(current)
            current = [line]
        else:
            current.append(line)
    if current:
        runs.append(current)
    last_run = runs[-1] if runs else []
    fails = [l for l in last_run if l.startswith("[FAIL]")]
    warns = [l for l in last_run if l.startswith("[WARN]")]
    model_auth_lines = [l for l in fails + warns if MODEL_AUTH_LINE_RE.match(l)]
    fails = [l for l in fails if not MODEL_AUTH_LINE_RE.match(l)]
    warns = [l for l in warns if not MODEL_AUTH_LINE_RE.match(l)]
    summary_line = next(
        (l for l in reversed(last_run) if l.startswith("[SUMMARY]")), ""
    )
    # Heuristic: ignore transient "Transport endpoint is not connected" FAILs --
    # those are a known artifact of openclaw-integrity-check's systemd-run --user
    # pattern, not real outages. They self-clear on the next tick.
    real_fails = [
        l for l in fails
        if "Transport endpoint is not connected" not in l
        and "Bad message" not in l
    ]
    transient_fails = len(fails) - len(real_fails)
    return {
        "exit_code": 0 if last_run else None,
        "run_age_lines": len(last_run),
        "summary_line": summary_line,
        "fail_lines": real_fails[-20:],
        "warn_lines": warns[-20:],
        "model_auth_lines": model_auth_lines,
        "transient_fails_ignored": transient_fails,
        "runs_in_window": len(runs),
    }


def probe_journal_integrity(cfg):
    """Kept for backwards compat in the log payload. Returns the count of
    integrity-check journal lines in the window."""
    rc, out, _ = run_cmd(
        [
            "journalctl", "-t", cfg["integrity"]["journal_tag"],
            "--since", cfg["integrity"]["journal_window"],
            "--no-pager", "--output=short",
        ],
        timeout=10,
    )
    lines = out.strip().splitlines()
    return {"line_count": len(lines)}


def _cpu_burst_pct(pids, sample_interval_s=1.0):
    """Sum CPU% across pids by sampling /proc/<pid>/stat twice with a
    small gap. Returns total percent (can exceed 100 on multi-core).
    Returns 0.0 if pids is empty or on any error."""
    if not pids:
        return 0.0

    def read_total_jiffies(pid):
        try:
            with open(f"/proc/{pid}/stat") as f:
                line = f.read()
            tail = line.split(")", 1)[1].split()
            # tail indices (0-based after the closing paren):
            #   0=state, 11=utime, 12=stime
            return int(tail[11]) + int(tail[12])
        except Exception:
            return None

    samples1 = {pid: read_total_jiffies(pid) for pid in pids}
    time.sleep(sample_interval_s)
    samples2 = {pid: read_total_jiffies(pid) for pid in pids}

    try:
        import os as _os
        hz = _os.sysconf("SC_CLK_TCK") or 100
    except Exception:
        hz = 100

    total_jiffies = 0
    for pid in pids:
        s1, s2 = samples1.get(pid), samples2.get(pid)
        if s1 is None or s2 is None:
            continue
        total_jiffies += max(s2 - s1, 0)
    cpu_seconds = total_jiffies / hz
    return (cpu_seconds / sample_interval_s) * 100.0


def probe_busy_state(user, home_dir, max_running_age_s=1800,
                     cli_jsonl_recent_s=60, cpu_threshold_pct=5.0):
    """Distinguish "busy" (mid-turn, doing real work) from "stalled"
    (idle / unresponsive). Three independent signals OR'd together:

      1. sessions.json: any agent:main:* key with status='running' and
         updatedAt within the last `max_running_age_s` (default 30 min).
         The age cap excludes leaked-running statuses from crashed gateways.
      2. claude-cli's own jsonl mtime within the last `cli_jsonl_recent_s`
         (default 60 s). Catches activity for non-streaming claude-cli
         turns where openclaw's sessions.json updatedAt only ticks at
         turn end.
      3. Aggregate CPU% across the agent's openclaw/claude pids over a
         1 s sample > `cpu_threshold_pct` (default 5%). Catches in-process
         work that the other two signals can miss.

    Returns:
      {
        "is_busy": bool,
        "signals": [list of signal names that tripped],
        "details": {per-signal data},
      }
    """
    signals = []
    details = {}

    # Signal 1: sessions.json running key
    sessions_path = Path(home_dir) / ".openclaw/agents/main/sessions/sessions.json"
    if sessions_path.exists():
        try:
            data = json.loads(sessions_path.read_text())
            now_ms = int(time.time() * 1000)
            best = None
            for k, v in (data or {}).items():
                if not k.startswith("agent:main:"):
                    continue
                if (v or {}).get("status") != "running":
                    continue
                upd = int(v.get("updatedAt", 0) or 0)
                age_ms = now_ms - upd
                if age_ms < 0 or age_ms > max_running_age_s * 1000:
                    continue
                if best is None or age_ms < best["age_ms"]:
                    best = {
                        "key": k,
                        "age_ms": age_ms,
                        "model": f"{v.get('modelProvider')}/{v.get('model')}",
                    }
            if best is not None:
                signals.append("running_key")
                details["running_key"] = {
                    "key": best["key"],
                    "age_s": best["age_ms"] // 1000,
                    "model": best["model"],
                }
        except Exception as e:
            details["sessions_error"] = str(e)[:100]

    # Signal 2: claude-cli jsonl mtime within last cli_jsonl_recent_s
    cli_dir = Path(f"/home/{user}/.claude/projects/-home-{user}-workspace")
    if cli_dir.exists():
        try:
            mtimes = [p.stat().st_mtime for p in cli_dir.glob("*.jsonl")]
            if mtimes:
                newest = max(mtimes)
                age_s = int(time.time() - newest)
                details["cli_jsonl"] = {"newest_mtime_age_s": age_s}
                if 0 <= age_s <= cli_jsonl_recent_s:
                    signals.append("cli_jsonl_recent")
        except Exception as e:
            details["cli_jsonl_error"] = str(e)[:100]

    # Signal 3: process CPU > threshold over 1 s sample
    try:
        rc, out, _ = run_cmd(
            ["pgrep", "-u", user, "-f", "openclaw|claude"], timeout=5
        )
        pids = [p.strip() for p in out.splitlines() if p.strip()]
        if pids:
            cpu_pct = _cpu_burst_pct(pids, sample_interval_s=1.0)
            details["cpu_pct"] = round(cpu_pct, 1)
            details["cpu_pid_count"] = len(pids)
            if cpu_pct > cpu_threshold_pct:
                signals.append("cpu_active")
    except Exception as e:
        details["cpu_error"] = str(e)[:100]

    return {
        "is_busy": bool(signals),
        "signals": signals,
        "details": details,
    }


def probe_session_idle_for_user(user, home_dir):
    """Return (idle_seconds, latest_session_path) — seconds since the most recent
    sign of activity for this user. Returns (None, None) when nothing usable.
    Activity sources, most-recent wins:
      1. Newest openclaw session jsonl mtime — for ollama / openai-codex
         providers where openclaw writes its own jsonl.
      2. sessions.json[agent:main:main].updatedAt — works for ALL providers,
         including claude-cli where the openclaw jsonl is never written
         because the conversation content lives in claude-cli's own jsonl
         under ~/.claude/projects/. Without this source the probe would
         falsely report stall for any agent on claude-cli."""
    sessions_dir = f"{home_dir}/.openclaw/agents/main/sessions"
    best_mtime = 0
    best_path = None
    # Source 1: newest openclaw jsonl (skip rotated / checkpoint / archive variants)
    try:
        for fn in os.listdir(sessions_dir):
            if not fn.endswith(".jsonl"):
                continue
            if ".checkpoint." in fn or ".reset." in fn or ".archive-" in fn:
                continue
            full = os.path.join(sessions_dir, fn)
            try:
                m = int(os.path.getmtime(full))
            except OSError:
                continue
            if m > best_mtime:
                best_mtime, best_path = m, full
    except OSError:
        pass
    # Source 2: max updatedAt across ALL agent:main:* conversation keys in
    # sessions.json. Catches claude-cli sessions (no openclaw jsonl) AND
    # activity on non-heartbeat surfaces like telegram DMs / subagents.
    sj_path = os.path.join(sessions_dir, "sessions.json")
    try:
        with open(sj_path) as f:
            sj = json.load(f)
        best_key = None
        for k, e in sj.items():
            if not k.startswith("agent:main:") or not isinstance(e, dict):
                continue
            upd_ms = e.get("updatedAt") or 0
            upd = int(upd_ms / 1000) if upd_ms else 0
            if upd > best_mtime:
                best_mtime, best_key = upd, k
        if best_key:
            best_path = f"{sj_path}#{best_key}"
    except (OSError, ValueError, json.JSONDecodeError):
        pass
    if best_mtime <= 0:
        return None, None
    return int(time.time() - best_mtime), best_path


def probe_jira_stalled_for_agent(agent, cfg, sc):
    """Query Jira (using the agent's own token) for issues assigned to that agent
    in stall-watching statuses. Classifies each in-progress issue into one of:
      - task-stalled-no-agent  (primary, CRIT/WARN)  — agent's session is silent
      - task-stalled-no-progress (secondary, WARN)   — Jira hasn't seen activity
    The two are mutually exclusive: no-progress only fires when no-agent doesn't."""
    user = agent.get("user")
    email = agent.get("email")
    home = agent.get("home") or f"/home/{user}"
    if not user or not email:
        return []
    integrations = agent.get("integrations") or {}
    if not (agent.get("role") == "coding" and integrations.get("jira")):
        return []
    host = sc.get("jira_host", "zeh-ferrari.atlassian.net")
    statuses = sc.get("statuses", ["In Progress"])
    idle_warn_s = sc.get("session_idle_warn_minutes", 5) * 60
    idle_crit_s = sc.get("session_idle_crit_minutes", 15) * 60
    update_warn_s = sc.get("update_warn_minutes", 30) * 60

    status_clause = " OR ".join([f'status="{s}"' for s in statuses])
    jql = f"assignee=currentUser() AND ({status_clause})"
    body = json.dumps(
        {"jql": jql, "fields": ["summary", "status", "updated"], "maxResults": 20}
    )
    url = f"https://{host}/rest/api/3/search/jql"
    cmd = [
        "sudo", "-n", "-u", user, "bash", "-c",
        f"T=$(cat ~/.ssh/jiraToken.txt 2>/dev/null); "
        f"if [ -z \"$T\" ]; then echo NO_TOKEN >&2; exit 2; fi; "
        f"curl -s --max-time {sc.get('http_timeout_s', 10)} -X POST "
        f"-u {shlex.quote(email)}:\"$T\" "
        f"-H 'Accept: application/json' -H 'Content-Type: application/json' "
        f"--data {shlex.quote(body)} "
        f"{shlex.quote(url)}",
    ]
    rc, out, err = run_cmd(cmd, timeout=sc.get("http_timeout_s", 10) + 4)
    if rc != 0 or not out.strip():
        return [{"_error": f"jira query failed for {user}: rc={rc} {err.strip()[:120]}"}]
    try:
        d = json.loads(out)
    except Exception as e:
        return [{"_error": f"jira parse for {user}: {e}; body[:120]={out[:120]}"}]
    if d.get("errorMessages"):
        return [{"_error": f"jira API error for {user}: {d['errorMessages']}"}]

    from datetime import datetime
    now_s = int(time.time())

    # One session-idle reading per agent (issue-level checks share it).
    session_idle_s, session_path = probe_session_idle_for_user(user, home)

    # Busy gate: if the agent is mid-turn (sessions.json running key with
    # recent updatedAt, recent claude-cli jsonl write, or active CPU), the
    # session-idle threshold doesn't mean a stall — the agent is doing
    # heavy work. Skip task-stalled-no-agent. task-stalled-no-progress
    # (Jira not updating despite active session) still fires; that's a
    # different failure mode.
    busy = probe_busy_state(user, home)

    results = []
    for issue in d.get("issues", []) or []:
        f = issue.get("fields", {}) or {}
        updated_str = f.get("updated", "")
        updated_age_s = None
        try:
            dt = datetime.fromisoformat(updated_str)
            updated_age_s = now_s - int(dt.timestamp())
        except Exception:
            pass

        common = {
            "agent": user,
            "key": issue.get("key"),
            "summary": (f.get("summary") or "")[:80],
            "status": (f.get("status") or {}).get("name"),
            "updated": updated_str,
            "updated_age_s": updated_age_s,
            "session_idle_s": session_idle_s,
            "busy_state": busy,
        }

        # PRIMARY: session-idle stall — Jira says In Progress but the agent's
        # openclaw session has been silent. Skipped if busy (mid-turn).
        if session_idle_s is not None and not busy.get("is_busy"):
            if session_idle_s >= idle_crit_s:
                results.append({**common, "kind": "task-stalled-no-agent", "severity": "crit"})
                continue
            if session_idle_s >= idle_warn_s:
                results.append({**common, "kind": "task-stalled-no-agent", "severity": "warn"})
                continue

        # SECONDARY: no-progress stall — agent IS active (session fresh) but
        # Jira hasn't been touched in a while. Catches the heartbeat-loop case
        # (HOMELAB-5 pattern) where the agent is alive but spinning.
        if updated_age_s is not None and updated_age_s >= update_warn_s:
            results.append({**common, "kind": "task-stalled-no-progress", "severity": "warn"})

    return results


def probe_stalled_tasks(cfg, registry):
    """Returns {stalled_tasks: [...], errors: [...], enabled: bool} aggregating
    across all coding+jira-enabled agents in the registry."""
    sc = cfg.get("stalled_tasks_check", {})
    out = {"stalled_tasks": [], "errors": [], "enabled": sc.get("enabled", True)}
    if not out["enabled"] or not registry:
        return out
    for agent in registry.get("agents", []) or []:
        if not (agent.get("enabled")):
            continue
        items = probe_jira_stalled_for_agent(agent, cfg, sc)
        for item in items:
            if item.get("_error"):
                out["errors"].append(item["_error"])
            else:
                out["stalled_tasks"].append(item)
    return out


def probe_idle_with_queue_for_agent(agent, cfg, sc):
    """Catches the gap that `task-stalled-no-agent` cannot: the agent has
    nothing in In Progress but ≥1 ticket in Selected for Development AND
    their session has been idle past threshold. After finishing a ticket
    (transition out of In Progress) agents should pick up the next per
    WORKFLOW.md "Picking the Next Task"; this fires when they don't.
    Returns a single-item list (or empty)."""
    user = agent.get("user")
    email = agent.get("email")
    home = agent.get("home") or f"/home/{user}"
    if not user or not email:
        return []
    integrations = agent.get("integrations") or {}
    if not (agent.get("role") == "coding" and integrations.get("jira")):
        return []

    host = sc.get("jira_host", "zeh-ferrari.atlassian.net")
    in_progress_statuses = sc.get("statuses", ["In Progress"])
    queue_statuses = sc.get("queue_statuses", ["Selected for Development", "To Do"])
    idle_warn_s = sc.get("queue_idle_warn_minutes", 10) * 60
    idle_crit_s = sc.get("queue_idle_crit_minutes", 30) * 60

    # One JQL covering both buckets; classify locally.
    all_statuses = list(in_progress_statuses) + list(queue_statuses)
    status_clause = " OR ".join([f'status="{s}"' for s in all_statuses])
    jql = f"assignee=currentUser() AND ({status_clause})"
    body = json.dumps(
        {"jql": jql, "fields": ["summary", "status"], "maxResults": 50}
    )
    url = f"https://{host}/rest/api/3/search/jql"
    cmd = [
        "sudo", "-n", "-u", user, "bash", "-c",
        f"T=$(cat ~/.ssh/jiraToken.txt 2>/dev/null); "
        f"if [ -z \"$T\" ]; then echo NO_TOKEN >&2; exit 2; fi; "
        f"curl -s --max-time {sc.get('http_timeout_s', 10)} -X POST "
        f"-u {shlex.quote(email)}:\"$T\" "
        f"-H 'Accept: application/json' -H 'Content-Type: application/json' "
        f"--data {shlex.quote(body)} "
        f"{shlex.quote(url)}",
    ]
    rc, out, err = run_cmd(cmd, timeout=sc.get("http_timeout_s", 10) + 4)
    if rc != 0 or not out.strip():
        return [{"_error": f"jira queue query failed for {user}: rc={rc} {err.strip()[:120]}"}]
    try:
        d = json.loads(out)
    except Exception as e:
        return [{"_error": f"jira queue parse for {user}: {e}; body[:120]={out[:120]}"}]
    if d.get("errorMessages"):
        return [{"_error": f"jira queue API error for {user}: {d['errorMessages']}"}]

    in_prog, queue = [], []
    for issue in d.get("issues", []) or []:
        f = issue.get("fields", {}) or {}
        st = (f.get("status") or {}).get("name")
        rec = {"key": issue.get("key"), "summary": (f.get("summary") or "")[:80], "status": st}
        if st in in_progress_statuses:
            in_prog.append(rec)
        elif st in queue_statuses:
            queue.append(rec)

    # Only fire when there's a queue AND nothing in progress.
    if not queue or in_prog:
        return []
    session_idle_s, _ = probe_session_idle_for_user(user, home)
    if session_idle_s is None or session_idle_s < idle_warn_s:
        return []

    # Busy gate: even if the agent has nothing In Progress and the queue is
    # waiting, an active turn (e.g. they're between transitions, writing a
    # comment, or in another conversation) means they're working — don't
    # fire wake-agent on top of an active session.
    busy = probe_busy_state(user, home)
    if busy.get("is_busy"):
        return []

    sev = "crit" if session_idle_s >= idle_crit_s else "warn"
    return [{
        "agent": user,
        "queue_count": len(queue),
        "queue_keys": [q["key"] for q in queue][:5],
        "session_idle_s": session_idle_s,
        "busy_state": busy,
        "severity": sev,
        "kind": "agent-idle-with-queue",
    }]


def probe_agent_queue(cfg, registry):
    """Returns {idle_with_queue: [...], errors: [...], enabled: bool}.
    Companion to probe_stalled_tasks — same shape, different gap."""
    sc_q = cfg.get("agent_queue_check", {})
    out = {"idle_with_queue": [], "errors": [], "enabled": sc_q.get("enabled", True)}
    if not out["enabled"] or not registry:
        return out
    # Inherit host / http_timeout / statuses from stalled_tasks_check unless
    # the agent_queue_check block overrides — keeps Jira config DRY.
    sc = {**(cfg.get("stalled_tasks_check") or {}), **sc_q}
    for agent in registry.get("agents", []) or []:
        if not (agent.get("enabled")):
            continue
        items = probe_idle_with_queue_for_agent(agent, cfg, sc)
        for item in items:
            if item.get("_error"):
                out["errors"].append(item["_error"])
            else:
                out["idle_with_queue"].append(item)
    return out


def _parse_agent_task_timestamp(value):
    """Parse timestamps written by webhook/Gmail task appenders.

    Inputs are a mix of UTC ISO strings and Australia/Brisbane locale strings,
    for example:
      - 2026-05-19T04:47:01.400Z
      - 19/05/2026, 2:28:16 pm
    Returns epoch seconds or None.
    """
    if not value:
        return None
    try:
        from datetime import datetime, timezone, timedelta
        raw = str(value).strip()
        if raw.endswith("Z"):
            return int(datetime.fromisoformat(raw[:-1] + "+00:00").timestamp())
        try:
            return int(datetime.fromisoformat(raw).timestamp())
        except Exception:
            pass
        # Locale format from toLocaleString('en-AU', Australia/Brisbane).
        normalized = raw.upper().replace("\u202f", " ")
        for fmt in ("%d/%m/%Y, %I:%M:%S %p", "%d/%m/%Y, %H:%M:%S"):
            try:
                dt = datetime.strptime(normalized, fmt)
                brisbane = timezone(timedelta(hours=10))
                return int(dt.replace(tzinfo=brisbane).timestamp())
            except Exception:
                pass
    except Exception:
        return None
    return None


def _extract_field_from_section(section, field):
    import re as _re
    m = _re.search(rf"(?im)^\s*{_re.escape(field)}:\s*(.+?)\s*$", section)
    return m.group(1).strip() if m else ""


def probe_pending_email_tasks_for_agent(agent, cfg, sc):
    """Read ~/tasks/current.md and find Gmail-originated tasks still queued.

    Gmail workers append actionable mail to current.md with `Gmail messageId`
    and `Status: QUEUED`. If that section stays queued past the configured
    threshold, the agent either missed the wake or did not act. This closes
    the blind spot where service health is green but a user-facing email sits
    unanswered.
    """
    user = agent.get("user")
    home = agent.get("home") or f"/home/{user}"
    if not user:
        return []
    integrations = agent.get("integrations") or {}
    if not integrations.get("gmail", True):
        return []
    current_path = Path(home) / "tasks/current.md"
    if not current_path.exists():
        return []

    warn_s = int(sc.get("warn_minutes", 15)) * 60
    crit_s = int(sc.get("crit_minutes", 60)) * 60
    max_age_s = int(sc.get("max_age_hours", 24)) * 3600
    max_items = int(sc.get("max_items_per_agent", 10))
    now = int(time.time())
    try:
        text = current_path.read_text(errors="replace")
    except Exception as e:
        return [{"_error": f"pending email task read failed for {user}: {e}"}]

    import re as _re
    sections = _re.split(r"(?m)^---\s*$", text)
    pending = []
    seen_msgids = set()
    for section in sections:
        if "Gmail messageId:" not in section:
            continue
        status = _extract_field_from_section(section, "Status").upper()
        if status != "QUEUED":
            continue
        msgid = _extract_field_from_section(section, "Gmail messageId")
        if not msgid or msgid in seen_msgids:
            continue
        seen_msgids.add(msgid)
        heading = ""
        hm = _re.search(r"(?m)^##\s+(.+?)\s*$", section)
        if hm:
            heading = hm.group(1).strip()
        source = _extract_field_from_section(section, "Source")
        received = _extract_field_from_section(section, "Received")
        received_s = _parse_agent_task_timestamp(received)
        if received_s is None:
            # Conservative fallback: use the task file mtime. This avoids a
            # parse failure creating a false multi-day alert.
            try:
                received_s = int(current_path.stat().st_mtime)
            except Exception:
                continue
        age_s = now - received_s
        if max_age_s > 0 and age_s > max_age_s:
            continue
        if age_s < warn_s:
            continue
        severity = "crit" if age_s >= crit_s else "warn"
        pending.append({
            "agent": user,
            "message_id": msgid,
            "subject": heading[:140],
            "source": source[:140],
            "received": received,
            "age_s": age_s,
            "severity": severity,
            "current_path": str(current_path),
            "kind": "email-awaiting-action",
        })
        if len(pending) >= max_items:
            break
    return pending


def probe_pending_email_tasks(cfg, registry):
    """Returns {pending: [...], errors: [...], enabled: bool} for queued
    actionable Gmail tasks that have not moved out of QUEUED."""
    sc = cfg.get("pending_email_tasks", {})
    out = {"pending": [], "errors": [], "enabled": sc.get("enabled", True)}
    if not out["enabled"] or not registry:
        return out
    for agent in registry.get("agents", []) or []:
        if not (agent.get("enabled") and agent.get("role") == "coding"):
            continue
        items = probe_pending_email_tasks_for_agent(agent, cfg, sc)
        for item in items:
            if item.get("_error"):
                out["errors"].append(item["_error"])
            else:
                out["pending"].append(item)
    return out


def _iso_to_epoch(s):
    try:
        from datetime import datetime
        return int(datetime.fromisoformat(s).timestamp())
    except Exception:
        return None


def _agent_replied_since(agent, pending, cfg):
    """Has the issue moved to a Done status, OR has `agent` posted a comment
    on pending['issue_key'] dated >= pending['comment_created']?
    Either case → resolved (no point chasing a reply on a closed ticket).
    Returns (resolved: bool, error: str|None)."""
    user = agent.get("user")
    email = agent.get("email")
    account_id = agent.get("jira_account_id")
    issue_key = pending.get("issue_key")
    comment_created = pending.get("comment_created")
    sc = cfg.get("stalled_tasks_check") or {}
    host = sc.get("jira_host", "zeh-ferrari.atlassian.net")
    http_timeout_s = int(sc.get("http_timeout_s", 15))
    if not (user and email and account_id and issue_key and comment_created):
        return False, f"pending-mention missing fields for {pending.get('issue_key')}"
    # Single round-trip: status + comments together.
    url = f"https://{host}/rest/api/3/issue/{issue_key}?fields=status,comment"
    cmd = [
        "sudo", "-n", "-u", user, "bash", "-c",
        f"T=$(cat ~/.ssh/jiraToken.txt 2>/dev/null); "
        f"if [ -z \"$T\" ]; then echo NO_TOKEN >&2; exit 2; fi; "
        f"curl -s --max-time {http_timeout_s} -u {shlex.quote(email)}:\"$T\" "
        f"-H 'Accept: application/json' {shlex.quote(url)}",
    ]
    rc, out, err = run_cmd(cmd, timeout=http_timeout_s + 4)
    if rc != 0 or not out.strip():
        return False, f"jira comment fetch {user}/{issue_key}: rc={rc} {err.strip()[:120]}"
    try:
        d = json.loads(out)
    except Exception as e:
        return False, f"jira comment parse {user}/{issue_key}: {e}"
    if d.get("errorMessages"):
        return False, f"jira API error {user}/{issue_key}: {d['errorMessages']}"
    fields = d.get("fields") or {}
    # Done detection: statusCategory.key == 'done' is the workflow-agnostic
    # signal (custom workflows can rename "Done" to "Closed", "Resolved",
    # "Shipped" etc., but the category stays `done`).
    cat = ((fields.get("status") or {}).get("statusCategory") or {}).get("key")
    if cat == "done":
        return True, None
    base_s = _iso_to_epoch(comment_created) or 0
    comments = ((fields.get("comment") or {}).get("comments")) or []
    for c in comments:
        if (c.get("author") or {}).get("accountId") == account_id:
            c_s = _iso_to_epoch(c.get("created", "")) or 0
            if c_s >= base_s:
                return True, None
    return False, None


def probe_pending_mentions(cfg, registry):
    """Walks /var/lib/ai-monitor/pending-mentions/ (written by webhook-receiver
    when a Jira comment @-mentions a known agent). For each pending entry,
    asks Jira whether the mentioned agent has posted any comment since the
    mention. Resolved entries are deleted; aging entries become 'awaiting'
    issues that deterministic_issues turns into mention-awaiting-reply alerts."""
    pmc = cfg.get("pending_mentions") or {}
    out = {"awaiting": [], "resolved": [], "errors": [], "enabled": pmc.get("enabled", True)}
    if not out["enabled"]:
        return out
    pdir = pmc.get("dir", "/var/lib/ai-monitor/pending-mentions")
    warn_s = pmc.get("warn_minutes", 15) * 60
    crit_s = pmc.get("crit_minutes", 60) * 60
    # Safety net: a mention marker older than this is considered stale and
    # silently removed. The original webhook delivery has long since fallen
    # off the operator's radar; continuing to alert about it isn't useful.
    max_age_s = pmc.get("max_age_hours", 168) * 3600
    if not os.path.isdir(pdir):
        return out

    by_user = {}
    for a in (registry.get("agents") or []):
        u = a.get("user")
        if u and a.get("enabled") and a.get("monitor"):
            by_user[u] = a

    for fn in sorted(os.listdir(pdir)):
        if not fn.endswith(".json"):
            continue
        fpath = os.path.join(pdir, fn)
        try:
            with open(fpath) as f:
                data = json.load(f)
        except Exception as e:
            out["errors"].append(f"unreadable {fn}: {e}")
            continue
        agent = by_user.get(data.get("agent"))
        if not agent:
            try:
                os.remove(fpath)
            except Exception:
                pass
            continue
        # Pre-flight age check — if the marker is older than max_age_s,
        # drop it without consulting Jira (saves an API call AND prevents
        # transient probe-failures from bouncing on a stale entry forever).
        created_s = _iso_to_epoch(data.get("comment_created", ""))
        if created_s is not None and (int(time.time()) - created_s) >= max_age_s:
            try:
                os.remove(fpath)
            except Exception:
                pass
            out["resolved"].append({
                "issue_key": data.get("issue_key"),
                "agent": data.get("agent"),
                "reason": f"stale-marker-age>{max_age_s}s",
            })
            continue
        resolved, err = _agent_replied_since(agent, data, cfg)
        if err:
            out["errors"].append(err)
            continue
        if resolved:
            try:
                os.remove(fpath)
            except Exception:
                pass
            out["resolved"].append({
                "issue_key": data.get("issue_key"),
                "agent": data.get("agent"),
                "reason": "ticket-done-or-agent-replied",
            })
            continue
        if created_s is None:
            continue
        age_s = int(time.time()) - created_s
        if age_s >= crit_s:
            severity = "crit"
        elif age_s >= warn_s:
            severity = "warn"
        else:
            continue
        entry = dict(data)
        entry["age_s"] = age_s
        entry["severity"] = severity
        out["awaiting"].append(entry)
    return out


def _database_url_to_path(raw):
    raw = (raw or "").strip().strip('"').strip("'")
    if raw.startswith("file:"):
        raw = raw[5:]
        if raw.startswith("//"):
            raw = raw[2:]
            raw = "/" + raw.lstrip("/")
        raw = raw.split("?", 1)[0]
    return raw


def _read_pm_database_url_from_env_file(path):
    return _read_env_file_value(path, "DATABASE_URL")


def _read_env_file_value(path, wanted_key):
    try:
        with open(path, "r", encoding="utf-8") as fh:
            for line in fh:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, value = line.split("=", 1)
                if key.strip() != wanted_key:
                    continue
                try:
                    return shlex.split(value, comments=False, posix=True)[0]
                except Exception:
                    return value
    except Exception:
        return ""
    return ""


def _active_agent_docs_root(cfg):
    watch = cfg.get("watch") or {}
    configured = watch.get("agent_docs_root")
    if configured:
        return os.path.realpath(str(configured))

    active_root = (
        _read_env_file_value("/etc/default/pm-active-worktree", "PM_APP_ROOT")
        or _read_env_file_value("/etc/default/pm-active-worktree", "PM_APP_DIR")
        or _read_env_file_value("/etc/default/pm", "PM_APP_ROOT")
        or _read_env_file_value("/etc/default/pm", "PM_APP_DIR")
    )
    active_root = (active_root or "").strip()
    if active_root.endswith("/ai/web"):
        return os.path.realpath(active_root[:-len("/ai/web")] + "/ai/openclaw")
    if active_root.endswith("/ai"):
        return os.path.realpath(active_root + "/openclaw")
    if active_root:
        return os.path.realpath(os.path.join(active_root, "ai/openclaw"))
    return os.path.realpath("/srv/Code/environment.worktrees/main/ai/openclaw")


def _content_match_probe(path, expected, label, require_regular=False):
    """Probe that a workspace doc file matches the canonical source by
    content (hash), not by being a symlink. The propagation model copies
    docs into workspaces (content-diff gated), so this checks the copy is
    present and up-to-date rather than checking symlink targets."""
    import hashlib
    path = str(path)
    expected = str(expected)
    item = {
        "path": path,
        "expected": expected,
        "label": label,
        "ok": False,
    }

    def _sha256(fpath):
        h = hashlib.sha256()
        try:
            with open(fpath, "rb") as fh:
                for chunk in iter(lambda: fh.read(65536), b""):
                    h.update(chunk)
            return h.hexdigest()
        except Exception:
            return None

    if not os.path.exists(expected):
        item["reason"] = "source missing"
        return item
    if not os.path.exists(path):
        item["reason"] = "missing"
        return item
    if require_regular:
        try:
            mode = os.lstat(path).st_mode
        except Exception as exc:
            item["reason"] = f"stat failed: {exc}"
            return item
        if stat.S_ISLNK(mode):
            item["reason"] = "symlink unsupported"
            return item
        if not stat.S_ISREG(mode):
            item["reason"] = "not a regular file"
            return item
    expected_hash = _sha256(expected)
    actual_hash = _sha256(path)
    if expected_hash is None:
        item["reason"] = "source unreadable"
        return item
    if actual_hash is None:
        item["reason"] = "file unreadable"
        return item
    if actual_hash != expected_hash:
        item["reason"] = "content drift"
        item["expected_hash"] = expected_hash[:12]
        item["actual_hash"] = actual_hash[:12]
        return item
    item["ok"] = True
    return item


def probe_agent_files(cfg, registry):
    sc = (
        cfg.get("agent_files")
        or cfg.get("agent_symlinks")
        or cfg.get("symlink_check")
        or {}
    )
    out = {
        "enabled": sc.get("enabled", True),
        "issues": [],
        "checked": 0,
    }
    if not out["enabled"] or not registry:
        return out

    agent_files_root = (
        sc.get("agent_files_root")
        or registry.get("agentFilesRoot")
        or "/srv/agents/openclaw"
    )
    docs_root = _active_agent_docs_root(cfg)
    shared_user_doc = os.path.realpath(os.path.join(agent_files_root, "_shared", "USER.md"))
    user_doc_expected = shared_user_doc if os.path.exists(shared_user_doc) else os.path.join(docs_root, "USER.md")

    # Common docs retain flat compatibility copies and canonical guides/
    # aliases. The canonical
    # sources live at docs_root (for AGENTS.md, WORKFLOW.md) or
    # docs_root/guides/ (for ROLES.md, CODE_REPOS.md). The workspace copy
    # paths used inside AGENTS.md/WORKFLOW.md must be probed too; otherwise the
    # monitor reports green while agents receive ENOENT for required policy.
    guides_dir = os.path.join(docs_root, "guides")
    common_doc_specs = list(sc.get("common_docs") or [
        ("AGENTS.md", os.path.join(docs_root, "AGENTS.md")),
        ("WORKFLOW.md", os.path.join(docs_root, "WORKFLOW.md")),
        ("ROLES.md", os.path.join(guides_dir, "ROLES.md")),
        ("guides/ROLES.md", os.path.join(guides_dir, "ROLES.md")),
        ("CODE_REPOS.md", os.path.join(guides_dir, "CODE_REPOS.md")),
        ("guides/CODE_REPOS.md", os.path.join(guides_dir, "CODE_REPOS.md")),
        ("USER.md", user_doc_expected),
    ])
    monitor_doc_specs = list(sc.get("monitor_docs") or [
        ("INCIDENT_HANDLING.md", os.path.join(guides_dir, "INCIDENT_HANDLING.md")),
        ("guides/INCIDENT_HANDLING.md", os.path.join(guides_dir, "INCIDENT_HANDLING.md")),
        ("MONITORING.md", os.path.join(guides_dir, "MONITORING.md")),
        ("guides/MONITORING.md", os.path.join(guides_dir, "MONITORING.md")),
        ("SERVICES.md", os.path.join(guides_dir, "SERVICES.md")),
        ("guides/SERVICES.md", os.path.join(guides_dir, "SERVICES.md")),
    ])

    def expected_doc(name):
        if name == "USER.md":
            return user_doc_expected
        for ws_name, src in common_doc_specs + monitor_doc_specs:
            if ws_name == name:
                return src
        return os.path.join(docs_root, name)

    for agent in registry.get("agents", []) or []:
        if not agent.get("enabled"):
            continue
        user = agent.get("user")
        if not user:
            continue
        home = agent.get("home") or f"/home/{user}"
        expected_config = os.path.join(agent_files_root, user, "openclaw.json")
        # OpenClaw requires its active config path to be a regular file. The PM
        # canonical config is copied into the home path by openclaw-doc-sync.
        config_probe = _content_match_probe(
            os.path.join(home, ".openclaw", "openclaw.json"),
            expected_config,
            "openclaw-config",
            require_regular=True,
        )
        out["checked"] += 1
        if not config_probe.get("ok"):
            out["issues"].append({"agent": user, **config_probe})

        doc_roots = []
        role = agent.get("role")
        if role == "monitor":
            doc_roots.append(os.path.join(home, ".openclaw", "workspace"))
            specs = common_doc_specs + [s for s in monitor_doc_specs if s[0] not in {n for n, _ in common_doc_specs}]
        else:
            workspace = agent.get("workspace") or os.path.join(home, "workspace")
            doc_roots.extend([
                workspace,
                os.path.join(home, ".openclaw", "workspace"),
            ])
            specs = common_doc_specs

        seen = set()
        for root in doc_roots:
            if root in seen:
                continue
            seen.add(root)
            for ws_name, src in specs:
                probe = _content_match_probe(
                    os.path.join(root, ws_name),
                    src,
                    f"doc:{ws_name}",
                )
                out["checked"] += 1
                if not probe.get("ok"):
                    out["issues"].append({"agent": user, **probe})

    out["issue_count"] = len(out["issues"])
    out["docs_root"] = docs_root
    out["agent_files_root"] = agent_files_root
    return out


def _sqlite_pm_db_path(cfg):
    pc = cfg.get("pm_workflow") or {}
    raw = (
        pc.get("database_path")
        or os.environ.get("PM_DATABASE_PATH")
        or os.environ.get("DATABASE_URL")
        or _read_pm_database_url_from_env_file("/etc/default/pm-active-worktree")
        or _read_pm_database_url_from_env_file("/etc/default/pm")
        or ""
    )
    raw = _database_url_to_path(raw)
    if raw:
        return raw
    candidates = [
        "/srv/Data/pm/pm.db",
        "/srv/Code/environment.worktrees/feature_HOMELAB-41-local-project-manager-webapp-/ai/web/prisma/prisma/dev.db",
        "/srv/Code/environment.worktrees/feature_HOMELAB-41-local-project-manager-webapp-/ai/web/prisma/dev.db",
    ]
    for path in candidates:
        if os.path.exists(path):
            return path
    return candidates[0]


def _parse_pm_ts(value):
    if value is None:
        return None
    if isinstance(value, (int, float)):
        # Prisma SQLite DateTime values are commonly stored as ms.
        if value > 10_000_000_000:
            return int(value / 1000)
        return int(value)
    text = str(value).strip()
    if not text:
        return None
    try:
        from datetime import datetime, timezone
        if text.endswith("Z"):
            text = text[:-1] + "+00:00"
        dt = datetime.fromisoformat(text)
        if dt.tzinfo is None:
            dt = dt.replace(tzinfo=timezone.utc)
        return int(dt.timestamp())
    except Exception:
        return None


def _pm_age_s(value):
    ts = _parse_pm_ts(value)
    if ts is None:
        return None
    return max(0, int(time.time()) - ts)


def _pm_latest_assignment_s(conn, task_id, username, fallback_created_at):
    try:
        rows = conn.execute(
            """
            SELECT payload, createdAt
            FROM ActivityLog
            WHERE taskId = ? AND kind = 'task.assign'
            ORDER BY createdAt DESC
            LIMIT 20
            """,
            (task_id,),
        ).fetchall()
    except Exception:
        return _parse_pm_ts(fallback_created_at)
    for row in rows:
        payload = row["payload"] or ""
        try:
            doc = json.loads(payload)
        except Exception:
            doc = {}
        if doc.get("to") == username:
            return _parse_pm_ts(row["createdAt"])
    return _parse_pm_ts(fallback_created_at)


def _pm_has_comment_since(conn, task_id, user_id, since_s):
    if since_s is None:
        since_s = 0
    try:
        rows = conn.execute(
            """
            SELECT createdAt
            FROM Comment
            WHERE taskId = ? AND userId = ?
            ORDER BY createdAt DESC
            LIMIT 20
            """,
            (task_id, user_id),
        ).fetchall()
    except Exception:
        return False
    for row in rows:
        ts = _parse_pm_ts(row["createdAt"])
        if ts is not None and ts >= since_s:
            return True
    return False


def _pm_has_action_plan_since(conn, task_id, user_id, since_s):
    if since_s is None:
        since_s = 0
    try:
        rows = conn.execute(
            """
            SELECT createdAt
            FROM ActionPlanRevision
            WHERE taskId = ?
              AND authorId = ?
            ORDER BY createdAt DESC
            LIMIT 20
            """,
            (task_id, user_id),
        ).fetchall()
    except Exception:
        return False
    for row in rows:
        ts = _parse_pm_ts(row["createdAt"])
        if ts is not None and ts >= since_s:
            return True
    return False


def _pm_has_action_plan_feedback_since(conn, task_id, reviewer_id, since_s):
    """Return true only for reviewer discussion newer than the plan revision.

    Task Action Plans are durable ActionPlanRevision rows. Reviewer feedback is
    intentionally free-form Action Plan chat, so it remains an
    AgentChatMessage. Once feedback exists for the latest revision, the worker
    owns the next turn; repeatedly waking the reviewer would create a feedback
    loop around an unchanged plan.
    """
    if not reviewer_id or since_s is None:
        return False
    try:
        rows = conn.execute(
            """
            SELECT createdAt
            FROM AgentChatMessage
            WHERE taskId = ?
              AND senderUserId = ?
              AND originChannel = 'chat'
              AND deletedAt IS NULL
            ORDER BY createdAt DESC
            LIMIT 20
            """,
            (task_id, reviewer_id),
        ).fetchall()
    except Exception:
        return False
    for row in rows:
        ts = _parse_pm_ts(row["createdAt"])
        if ts is not None and ts >= since_s:
            return True
    return False


def _pm_latest_action_plan_revision_s(conn, task_id, user_id, since_s):
    """Return the latest durable plan revision timestamp for this assignee."""
    if since_s is None:
        since_s = 0
    try:
        rows = conn.execute(
            """
            SELECT createdAt
            FROM ActionPlanRevision
            WHERE taskId = ?
              AND authorId = ?
            ORDER BY createdAt DESC
            LIMIT 20
            """,
            (task_id, user_id),
        ).fetchall()
    except Exception:
        return None
    for row in rows:
        ts = _parse_pm_ts(row["createdAt"])
        if ts is not None and ts >= since_s:
            return ts
    return None


def _pm_active_in_progress_task(conn, assignee_id, task_id):
    if not assignee_id:
        return None
    try:
        return conn.execute(
            """
            SELECT id, title
            FROM Task
            WHERE assigneeId = ?
              AND id != ?
              AND status = 'In Progress'
              AND deletedAt IS NULL
              AND archived_at IS NULL
            ORDER BY statusChangedAt ASC, updatedAt ASC
            LIMIT 1
            """,
            (assignee_id, task_id),
        ).fetchone()
    except Exception:
        return None


def _pm_latest_comment_by(conn, task_id, user_id, since_s):
    if not user_id:
        return None
    rows = conn.execute(
        """
        SELECT id, body, createdAt
        FROM Comment
        WHERE taskId = ? AND userId = ?
        ORDER BY createdAt DESC
        LIMIT 5
        """,
        (task_id, user_id),
    ).fetchall()
    for row in rows:
        ts = _parse_pm_ts(row["createdAt"])
        if ts is not None and (since_s is None or ts >= since_s):
            return row
    return None


def _pm_repository_finalization_owns_task(row):
    """Return true after one immutable repository candidate was accepted.

    Operational cleanup failures retain reviewedSha. They are operator-owned
    finalization state, not informal reviewer feedback and not permission to
    reopen implementation.
    """
    values = dict(row)
    phase = values.get("repositoryPhase")
    if phase not in ("finalizing", "operational_error", "completed"):
        return False
    accepted_candidate = (
        values.get("repositoryCandidateSha")
        if values.get("repositoryRepoTouched") == 1
        else values.get("repositoryBaseSha")
    )
    return bool(
        accepted_candidate
        and values.get("repositoryReviewedSha") == accepted_candidate
    )


def _pm_latest_blocker_activity(conn, task_id):
    try:
        return conn.execute(
            """
            SELECT kind, payload, createdAt
            FROM ActivityLog
            WHERE taskId = ?
              AND kind IN ('task.blocker', 'task.extra_work.blocker', 'task.blocker.cleared')
            ORDER BY createdAt DESC
            LIMIT 1
            """,
            (task_id,),
        ).fetchone()
    except Exception:
        return None


def _pm_blocker_permission_grant(conn, task_id, blocker):
    """Return the exact grant attached to an active permission blocker."""
    if not blocker or blocker["kind"] == "task.blocker.cleared":
        return None
    try:
        blocker_payload = json.loads(blocker["payload"] or "{}")
        blocker_comment_id = blocker_payload.get("commentId")
        permission = blocker_payload.get("permissionRequest")
        if not blocker_comment_id or not isinstance(permission, dict):
            return None
        rows = conn.execute(
            """
            SELECT payload, createdAt
            FROM ActivityLog
            WHERE taskId = ? AND kind = 'task.blocker.permission.granted'
            ORDER BY createdAt DESC
            """,
            (task_id,),
        ).fetchall()
        for row in rows:
            payload = json.loads(row["payload"] or "{}")
            if payload.get("blockerCommentId") == blocker_comment_id:
                return {
                    "authorizationCommentId": payload.get("authorizationCommentId"),
                    "createdAt": row["createdAt"],
                }
    except Exception:
        return None
    return None


def _pm_has_live_channel_run(conn, task_id, agent_slug):
    if not task_id or not agent_slug:
        return False
    try:
        row = conn.execute(
            """
            SELECT 1
            FROM PmChannelRun
            WHERE taskId = ?
              AND agentSlug = ?
              AND status IN ('queued', 'accepted', 'admitted', 'streaming', 'retryable', 'waiting_capacity')
            LIMIT 1
            """,
            (task_id, agent_slug),
        ).fetchone()
        return row is not None
    except Exception:
        return False


def _pm_mentions_username(body, username):
    if not username:
        return False
    return re.search(
        rf"(^|[^A-Za-z0-9_])@{re.escape(username)}(?![A-Za-z0-9_])",
        body or "",
        flags=re.IGNORECASE,
    ) is not None


def _pm_latest_comment_not_by(
    conn,
    task_id,
    user_id,
    since_s,
    assignee_username=None,
    reviewer_username=None,
):
    if not user_id:
        return None
    rows = conn.execute(
        """
        SELECT
          c.id, c.body, c.createdAt, u.username, u.kind,
          agent.role AS agentRole
        FROM Comment c
        LEFT JOIN User u ON u.id = c.userId
        LEFT JOIN Agent agent ON agent.id = u.agentId
        WHERE c.taskId = ?
          AND c.userId != ?
          AND c.deletedAt IS NULL
        ORDER BY c.createdAt DESC
        LIMIT 50
        """,
        (task_id, user_id),
    ).fetchall()
    for row in rows:
        ts = _parse_pm_ts(row["createdAt"])
        if ts is None or (since_s is not None and ts < since_s):
            continue
        if row["agentRole"] == "monitor":
            continue
        if (
            _pm_mentions_username(row["body"], reviewer_username)
            and not _pm_mentions_username(row["body"], assignee_username)
        ):
            continue
        return row
    return None


def _pm_workflow_notification_status(body):
    text = body or ""
    if not text.startswith("PM workflow notification for @"):
        return None
    if " while it is in Backlog." in text:
        return "Backlog"
    if " is now in To Do " in text:
        return "To Do"
    if " was moved to Review" in text:
        return "Review"
    return None


def _pm_closed_epic_human_target(row):
    if (
        row["epicStatus"] not in ("Backlog", "Done")
        or row["status"] not in ("To Do", "In Progress", "Review")
    ):
        return None
    if row["reporterKind"] == "human" and row["reporterUsername"]:
        return row["reporterUsername"]
    return row["ownerUsername"]


def _pm_closed_epic_items(rows):
    """Collapse active child-task drift into one human issue per closed Epic."""
    closed_epics = {}
    for row in rows:
        human_owner = _pm_closed_epic_human_target(row)
        if not human_owner or not row["epicId"]:
            continue
        key = (row["epicId"], human_owner)
        item = closed_epics.setdefault(key, {
            "kind": "pm-epic-not-open",
            "severity": "warn",
            "agent": human_owner,
            "scope": "epic",
            "epic_id": row["epicId"],
            "task_id": f"epic:{row['epicId']}",
            "task_title": (row["epicTitle"] or "")[:140],
            "project": row["projectSlug"],
            "status": row["epicStatus"],
            "epic_status": row["epicStatus"],
            "age_s": _pm_age_s(row["epicStatusChangedAt"]) or 0,
            "child_count": 0,
            "child_statuses": set(),
            "required_action": "This Epic is non-actionable. Reopen it only if work should resume; otherwise align or archive its active child tasks. This human-owned alert will not repeat until the Epic state changes.",
        })
        item["child_count"] += 1
        item["child_statuses"].add(row["status"])

    items = []
    for item in closed_epics.values():
        item["child_statuses"] = sorted(item["child_statuses"])
        items.append(item)
    return items


def _pm_actor_slug(row, agent_key, username_key):
    return row[agent_key] or row[username_key]


def _pm_current_workflow_slugs(row):
    status = row["status"]
    if status in ("Backlog", "To Do", "In Progress"):
        slug = _pm_actor_slug(row, "assigneeAgentSlug", "assigneeUsername")
        return {slug} if slug else set()
    if status == "Review":
        # Mirrors the webapp's resolveReviewOwnerId: the epic manager
        # backstops review throughout the actionable Epic lifecycle.
        slug = (
            _pm_actor_slug(row, "reviewerAgentSlug", "reviewerUsername")
            or (
                _pm_actor_slug(row, "epicManagerAgentSlug", "epicManagerUsername")
                if row["epicStatus"] in ("To Do", "In Progress")
                else None
            )
            or row["reporterUsername"]
        )
        return {slug} if slug else set()
    return set()


def _pm_workflow_notification_is_current(row):
    expected_status = _pm_workflow_notification_status(row["body"])
    if not expected_status:
        # Human-authored task messages also enter the orphan-run query when a
        # PM-channel row exists. They do not encode the workflow status in
        # their body, so treating an unparseable body as current is unsafe: a
        # failed run from an old assignee can otherwise be resurrected months
        # after the task moved to Review. Fail closed against the task's
        # current workflow owner instead.
        return row["messageAgentSlug"] in _pm_current_workflow_slugs(row)
    if row["status"] != expected_status:
        return False
    return row["messageAgentSlug"] in _pm_current_workflow_slugs(row)


def probe_pm_workflow(cfg, registry):
    """Probe Mission Control / PM workflow invariants for the monitor agent.

    The PM webapp owns writes. Before the read-only drift probe, this runs
    the PM self-assignment guard through the active PM app so illegal agent
    self-assignments are undone and activity-logged.
    """
    pc = cfg.get("pm_workflow") or {}
    out = {
        "items": [],
        "errors": [],
        "self_assignment_repairs": [],
        "enabled": pc.get("enabled", True),
    }
    if not out["enabled"]:
        return out
    db_path = _sqlite_pm_db_path(cfg)
    out["database_path"] = db_path
    if not os.path.exists(db_path):
        out["errors"].append(f"PM database not found: {db_path}")
        return out

    warn_todo_s = int(pc.get("todo_start_warn_minutes", 2)) * 60
    warn_progress_s = int(pc.get("in_progress_stale_minutes", 5)) * 60
    warn_review_s = int(pc.get("review_wait_warn_minutes", 10)) * 60
    warn_channel_s = int(pc.get("channel_no_start_warn_minutes", 2)) * 60
    # A gateway acknowledgement means the agent turn is executing, not that
    # it failed to start. Native CLI turns can legitimately spend many
    # minutes in tools before producing a PM-visible token; treating the
    # ordinary two-minute dispatch lease as an execution timeout caused the
    # monitor to restart agents in the middle of real work.
    warn_accepted_channel_s = int(pc.get("channel_accepted_warn_minutes", 30)) * 60
    failed_run_max_age_hours = int(pc.get("failed_run_max_age_hours", 48))
    max_items = int(pc.get("max_items", 50))

    if pc.get("self_assignment_guard_enabled", True):
        rc, guard_out, guard_err = run_cmd(
            ["/usr/local/sbin/pm-self-assignment-guard"],
            timeout=int(pc.get("self_assignment_guard_timeout_seconds", 60)),
        )
        if rc != 0:
            out["errors"].append(
                f"PM self-assignment guard failed rc={rc}: {(guard_err or guard_out).strip()[:240]}"
            )
        elif guard_out.strip():
            try:
                parsed = json.loads(guard_out)
                out["self_assignment_repairs"] = parsed.get("repairs") or []
            except Exception as e:
                out["errors"].append(f"PM self-assignment guard returned invalid JSON: {e}")

    try:
        conn = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
        conn.row_factory = sqlite3.Row
    except Exception as e:
        out["errors"].append(f"PM database open failed: {e}")
        return out

    try:
        rows = conn.execute(
            """
            SELECT
              t.id, t.title, t.status, t.statusChangedAt, t.createdAt, t.updatedAt,
              t.approved_on AS approvedOn,
              t.assigneeId, t.actingManagerId, t.reporterId,
              p.slug AS projectSlug,
              a.username AS assigneeUsername,
              aa.slug AS assigneeAgentSlug,
              r.username AS reviewerUsername,
              ra.slug AS reviewerAgentSlug,
              rep.username AS reporterUsername,
              rep.kind AS reporterKind,
              er.username AS epicManagerUsername,
              era.slug AS epicManagerAgentSlug,
              e.id AS epicId,
              e.title AS epicTitle,
              e.status AS epicStatus,
              e.statusChangedAt AS epicStatusChangedAt,
              e.actingManagerId AS epicManagerId,
              tr.phase AS repositoryPhase,
              tr.repo_touched AS repositoryRepoTouched,
              tr.base_sha AS repositoryBaseSha,
              tr.candidate_sha AS repositoryCandidateSha,
              tr.reviewed_sha AS repositoryReviewedSha,
              (
                SELECT owner.username
                FROM User owner
                WHERE owner.kind = 'human'
                  AND owner.status = 'active'
                  AND owner.is_owner = 1
                ORDER BY owner.createdAt ASC
                LIMIT 1
              ) AS ownerUsername
            FROM Task t
            JOIN Project p ON p.id = t.projectId
            LEFT JOIN User a ON a.id = t.assigneeId
            LEFT JOIN Agent aa ON aa.id = a.agentId
            LEFT JOIN User r ON r.id = t.actingManagerId
            LEFT JOIN Agent ra ON ra.id = r.agentId
            LEFT JOIN User rep ON rep.id = t.reporterId
            LEFT JOIN Epic e ON e.id = t.epicId
            LEFT JOIN User er ON er.id = e.actingManagerId
            LEFT JOIN Agent era ON era.id = er.agentId
            LEFT JOIN task_repository_runs tr ON tr.task_id = t.id
            WHERE t.deletedAt IS NULL
              AND p.deletedAt IS NULL
              AND t.parentTaskId IS NULL
              AND t.status IN ('To Do', 'In Progress', 'Review')
            ORDER BY t.updatedAt DESC
            LIMIT 500
            """
        ).fetchall()

        orphan_rows = conn.execute(
            """
            SELECT
              m.id AS messageId,
              CASE
                WHEN m.agentSlug = 'room' AND m.targetValue LIKE 'agent:%'
                  THEN substr(m.targetValue, 7)
                ELSE m.agentSlug
              END AS messageAgentSlug,
              m.body,
              m.createdAt AS messageCreatedAt,
              r.status AS runStatus,
              r.lastEventAt AS runLastEventAt,
              r.error AS runError,
              r.failedAt AS runFailedAt,
              t.id, t.title, t.status, t.statusChangedAt, t.createdAt, t.updatedAt,
              t.approved_on AS approvedOn,
              t.assigneeId, t.actingManagerId, t.reporterId,
              p.slug AS projectSlug,
              a.username AS assigneeUsername,
              aa.slug AS assigneeAgentSlug,
              rv.username AS reviewerUsername,
              rva.slug AS reviewerAgentSlug,
              rep.username AS reporterUsername,
              er.username AS epicManagerUsername,
              era.slug AS epicManagerAgentSlug,
              e.status AS epicStatus,
              e.actingManagerId AS epicManagerId
            FROM AgentChatMessage m
            JOIN User sender ON sender.id = m.senderUserId
            JOIN Task t ON t.id = m.taskId
            JOIN Project p ON p.id = t.projectId
            LEFT JOIN PmChannelRun r
              ON r.kind IN ('task-comment', 'task-chat')
             AND r.taskId = t.id
             AND r.messageId = m.id
             AND r.agentSlug = CASE
                WHEN m.agentSlug = 'room' AND m.targetValue LIKE 'agent:%'
                  THEN substr(m.targetValue, 7)
                ELSE m.agentSlug
              END
            LEFT JOIN User a ON a.id = t.assigneeId
            LEFT JOIN Agent aa ON aa.id = a.agentId
            LEFT JOIN User rv ON rv.id = t.actingManagerId
            LEFT JOIN Agent rva ON rva.id = rv.agentId
            LEFT JOIN User rep ON rep.id = t.reporterId
            LEFT JOIN Epic e ON e.id = t.epicId
            LEFT JOIN User er ON er.id = e.actingManagerId
            LEFT JOIN Agent era ON era.id = er.agentId
            WHERE (
                m.body LIKE 'PM workflow notification for @%'
                OR (r.id IS NOT NULL AND sender.kind = 'human')
              )
              AND t.deletedAt IS NULL
              AND p.deletedAt IS NULL
              AND m.deletedAt IS NULL
              AND t.parentTaskId IS NULL
              AND t.status NOT IN ('Backlog', 'Done')
              AND (r.status IS NULL OR r.status IN ('queued', 'accepted', 'admitted', 'streaming', 'retryable', 'failed'))
              AND (COALESCE(r.status, '') != 'failed' OR m.createdAt >= ?)
              -- A missing run is useful recovery evidence only near the
              -- original message. Older gaps are legacy display residue; the
              -- status-specific task detectors own any real unfinished work.
              -- Keeping them forever manufactured month-old "live bubbles"
              -- and repeatedly pulled the monitor agent into dead tasks.
              AND (r.id IS NOT NULL OR m.createdAt >= ?)
              AND NOT EXISTS (
                SELECT 1
                FROM PmChannelRun rr
                WHERE rr.taskId = t.id
                  AND rr.agentSlug = CASE
                    WHEN m.agentSlug = 'room' AND m.targetValue LIKE 'agent:%'
                      THEN substr(m.targetValue, 7)
                    ELSE m.agentSlug
                  END
                  -- `completed` is the canonical ENV-117 terminal spelling.
                  -- Keep `complete` during rolling upgrades, otherwise the
                  -- status-normalization migration makes every historical
                  -- successful turn invisible and resurrects old messages.
                  AND rr.status IN ('streaming', 'complete', 'completed')
                  AND COALESCE(rr.lastEventAt, rr.updatedAt, rr.createdAt) >= m.createdAt
              )
              AND NOT EXISTS (
                SELECT 1
                FROM ActivityLog al
                WHERE al.targetAgent = CASE
                    WHEN m.agentSlug = 'room' AND m.targetValue LIKE 'agent:%'
                      THEN substr(m.targetValue, 7)
                    ELSE m.agentSlug
                  END
                  AND al.kind IN ('task.comment', 'task.chat.reply', 'task.comment.silent', 'task.chat.silent')
                  AND al.payload LIKE '%"inReplyToMessageId":"' || m.id || '"%'
              )
            ORDER BY m.createdAt DESC
            LIMIT 200
            """,
            # Prisma stores DateTime as integer epoch-milliseconds in SQLite,
            # so the failed-run age floor is a ms cutoff computed here rather
            # than a datetime('now', ...) expression.
            (
                int((time.time() - failed_run_max_age_hours * 3600) * 1000),
                int((time.time() - failed_run_max_age_hours * 3600) * 1000),
            ),
        ).fetchall()

        def add(row, kind, target_agent, age_s, required_action, severity="warn", extra=None):
            if not target_agent:
                return
            # Never stack a monitor recovery behind a PM-channel turn that is
            # already queued or executing for the same task/agent. Channel
            # health items themselves remain eligible so their recovery ladder
            # can settle a genuinely expired run.
            if (
                not kind.startswith("pm-channel-")
                and kind != "pm-orphan-live-bubble"
                and _pm_has_live_channel_run(conn, row["id"], target_agent)
            ):
                return
            out["items"].append({
                "kind": kind,
                "severity": severity,
                "agent": target_agent,
                "task_id": row["id"],
                "task_title": (row["title"] or "")[:140],
                "project": row["projectSlug"],
                "status": row["status"],
                "epic_status": row["epicStatus"],
                "age_s": age_s,
                "required_action": required_action,
                **(extra or {}),
            })

        monitor_agent = get_monitor_agent(registry) or {}
        monitor_agent_slug = (
            monitor_agent.get("slug")
            or monitor_agent.get("user")
            or "monitor-agent"
        )

        # A closed Epic with several still-active children is one human-owned
        # inconsistency, not N independent task incidents. Aggregate it by
        # Epic so Telegram can never fan out once per child task. Historical
        # invalid statuses (for example the retired Epic "Review" state) are
        # intentionally ignored below rather than treated as actionable work.
        for item in _pm_closed_epic_items(rows):
            if len(out["items"]) >= max_items:
                break
            out["items"].append(item)

        seen_orphan_rows = set()
        for row in orphan_rows:
            if len(out["items"]) >= max_items:
                break
            if row["status"] in ("Backlog", "Done"):
                continue
            run_status = row["runStatus"] or "missing"
            dedupe_key = (row["id"], row["messageAgentSlug"], row["status"], run_status)
            if dedupe_key in seen_orphan_rows:
                continue
            seen_orphan_rows.add(dedupe_key)
            is_current = _pm_workflow_notification_is_current(row)
            age_s = (
                _pm_age_s(row["runLastEventAt"])
                or _pm_age_s(row["messageCreatedAt"])
                or 0
            )
            if is_current:
                if run_status == "failed":
                    if age_s < warn_channel_s:
                        continue
                    run_error = (row["runError"] or "")[:200]
                    add(
                        row,
                        "pm-channel-failed",
                        row["messageAgentSlug"],
                        age_s,
                        (
                            "The native PM-channel turn failed terminally "
                            f"({run_error or 'no error recorded'}) and no durable "
                            "reply exists. Resend the PM-channel context "
                            "(pm-channel-nudge); restart the agent services first "
                            "if the gateway looks unhealthy."
                        ),
                        extra={
                            "message_id": row["messageId"],
                            "run_status": run_status,
                            "run_error": run_error,
                            "run_failed_at": row["runFailedAt"],
                        },
                    )
                    continue
                if run_status == "retryable":
                    # Mid-ladder webapp retry with a scheduled backoff — give
                    # the retry ladder room before flagging a stall.
                    if age_s < warn_channel_s * 2:
                        continue
                elif run_status in ("accepted", "admitted"):
                    if age_s < warn_accepted_channel_s:
                        continue
                elif age_s < warn_channel_s:
                    continue
                kind = (
                    "pm-channel-no-start"
                    if run_status in ("queued", "accepted", "missing")
                    else "pm-channel-stalled"
                )
                add(
                    row,
                    kind,
                    row["messageAgentSlug"],
                    age_s,
                    "The native PM-channel workflow turn has not produced live output or a durable reply. Restart the agent services if needed and resend the PM-channel context.",
                    extra={
                        "message_id": row["messageId"],
                        "run_status": run_status,
                    },
                )
                continue
            add(
                row,
                "pm-orphan-live-bubble",
                monitor_agent_slug,
                age_s,
                "The PM app must hide or settle this stale workflow live bubble; do not wake the task agent.",
                extra={
                    "bubble_agent": row["messageAgentSlug"],
                    "message_id": row["messageId"],
                    "run_status": row["runStatus"] or "missing",
                },
            )

        for row in rows:
            if len(out["items"]) >= max_items:
                break
            status = row["status"]
            changed_age = _pm_age_s(row["statusChangedAt"]) or _pm_age_s(row["updatedAt"]) or 0
            assignee_slug = row["assigneeAgentSlug"] or row["assigneeUsername"]
            # Reviewer fallback mirrors the webapp's resolveReviewOwnerId:
            # epic manager throughout To Do/In Progress, else reporter.
            if row["actingManagerId"]:
                reviewer_id = row["actingManagerId"]
                reviewer_slug = row["reviewerAgentSlug"] or row["reviewerUsername"]
                reviewer_username = row["reviewerUsername"]
            elif row["epicManagerId"] and row["epicStatus"] in ("To Do", "In Progress"):
                reviewer_id = row["epicManagerId"]
                reviewer_slug = row["epicManagerAgentSlug"] or row["epicManagerUsername"]
                reviewer_username = row["epicManagerUsername"]
            else:
                reviewer_id = row["reporterId"]
                reviewer_slug = row["reporterUsername"]
                reviewer_username = row["reporterUsername"]

            # Epic actionability mirrors the webapp's epicAllowsAgentAction:
            # tasks under an epic are workable only while the epic is
            # To Do/In Progress; Backlog/Done epics gate their tasks.
            human_owner = _pm_closed_epic_human_target(row)
            if human_owner:
                # Already represented once by the Epic-level aggregate above.
                continue

            # Non-actionable/legacy Epic states are deliberate human-owned
            # gates, not reasons to wake every child-task actor. Backlog/Done
            # inconsistencies were aggregated above; a legacy Epic Review
            # state is ignored entirely.
            if row["epicStatus"] not in (None, "To Do", "In Progress"):
                continue

            if status == "To Do" and row["assigneeId"] and assignee_slug:
                assigned_s = _pm_latest_assignment_s(
                    conn,
                    row["id"],
                    row["assigneeUsername"],
                    row["createdAt"],
                )
                action_plan_revision_s = _pm_latest_action_plan_revision_s(
                    conn,
                    row["id"],
                    row["assigneeId"],
                    assigned_s,
                )
                action_plan_posted = action_plan_revision_s is not None
                reviewer_responded = _pm_has_action_plan_feedback_since(
                    conn,
                    row["id"],
                    reviewer_id,
                    action_plan_revision_s,
                )
                if not row["approvedOn"]:
                    if changed_age >= warn_todo_s and not action_plan_posted:
                        add(
                            row,
                            "pm-action-plan-missing",
                            assignee_slug,
                            changed_age,
                            "Call action=submit_plan with one concise structured Action Plan. Plain Action Plan chat text is discussion only. Wait for reviewer/reporter approval before starting.",
                        )
                    elif (
                        changed_age >= warn_todo_s
                        and action_plan_posted
                        and not reviewer_responded
                    ):
                        add(
                            row,
                            "pm-action-plan-awaiting-approval",
                            reviewer_slug,
                            changed_age,
                            "Review the Action Plan. If acceptable, approve it so approved_on is set; otherwise reply with concise feedback in Action Plan.",
                            extra={"assignee": assignee_slug},
                        )
                    continue
                if changed_age >= warn_todo_s:
                    active_task = _pm_active_in_progress_task(conn, row["assigneeId"], row["id"])
                    if active_task:
                        continue
                    add(
                        row,
                        "pm-todo-not-started",
                        assignee_slug,
                        changed_age,
                        "Move the task to In Progress through PM workflow and start work immediately.",
                    )
                continue

            if status == "In Progress" and row["assigneeId"] and assignee_slug:
                # A durable blocker escalation is deliberately human/external
                # owned. The workflow action already notified the decision
                # owners; repeatedly waking the assignee cannot make progress
                # and only creates a stale-nudge loop. Once a decision owner
                # responds after the formal blocker activity, wake the assignee
                # exactly for that response; clear_blocker then resumes normal
                # stale-work probes.
                # Only a currently-active formal blocker suppresses assignee
                # recovery. alertReporter is also used for repository/admin
                # alerts and must never silently transfer or pause task
                # execution ownership.
                blocker = _pm_latest_blocker_activity(conn, row["id"])
                blocker_s = _parse_pm_ts(blocker["createdAt"]) if blocker else None
                if blocker and blocker["kind"] != "task.blocker.cleared":
                    permission_grant = _pm_blocker_permission_grant(conn, row["id"], blocker)
                    if permission_grant and permission_grant.get("authorizationCommentId"):
                        grant_s = _parse_pm_ts(permission_grant["createdAt"])
                        grant_age = _pm_age_s(permission_grant["createdAt"]) or 0
                        assignee_response = _pm_latest_comment_by(
                            conn,
                            row["id"],
                            row["assigneeId"],
                            grant_s,
                        )
                        latest_action_s = (
                            _parse_pm_ts(assignee_response["createdAt"])
                            if assignee_response
                            else grant_s
                        )
                        action_age = (
                            max(0, int(time.time()) - latest_action_s)
                            if latest_action_s is not None
                            else grant_age
                        )
                        if action_age >= warn_progress_s:
                            add(
                                row,
                                "pm-granted-blocker-awaiting-assignee",
                                assignee_slug,
                                action_age,
                                "The active permission request is already granted and agent-actionable. Execute the exact authorized operation now using authorization comment "
                                + str(permission_grant["authorizationCommentId"])
                                + ". Do not wait for another human response. The checkpoint outcome closes this permission round automatically; a later publication needs a fresh blocker.",
                            )
                        continue
                    response = _pm_latest_comment_not_by(
                        conn,
                        row["id"],
                        row["assigneeId"],
                        blocker_s,
                        row["assigneeUsername"],
                        reviewer_username,
                    )
                    if response:
                        response_ts = _parse_pm_ts(response["createdAt"])
                        response_age = _pm_age_s(response["createdAt"]) or 0
                        if (
                            response_ts
                            and response_age >= warn_channel_s
                            and not _pm_has_comment_since(
                                conn,
                                row["id"],
                                row["assigneeId"],
                                response_ts,
                            )
                        ):
                            add(
                                row,
                                "pm-blocker-response-awaiting-assignee",
                                assignee_slug,
                                response_age,
                                "A decision owner responded after your active blocker. Re-evaluate it now: if resolved, call action=clear_blocker with the evidence and resume; otherwise keep the alert and post only material new blocker evidence.",
                                extra={"reviewer": reviewer_slug, "comment_preview": (response["body"] or "")[:180]},
                            )
                    continue
                status_s = _parse_pm_ts(row["statusChangedAt"]) or _parse_pm_ts(row["updatedAt"]) or _parse_pm_ts(row["createdAt"])
                latest_assignee_comment = _pm_latest_comment_by(conn, row["id"], row["assigneeId"], status_s)
                latest_assignee_progress_s = (
                    _parse_pm_ts(latest_assignee_comment["createdAt"])
                    if latest_assignee_comment
                    else status_s
                )
                latest_progress_s = latest_assignee_progress_s
                progress_age = (
                    max(0, int(time.time()) - latest_progress_s)
                    if latest_progress_s is not None
                    else changed_age
                )
                if progress_age >= warn_progress_s:
                    add(
                        row,
                        "pm-in-progress-stale",
                        assignee_slug,
                        progress_age,
                        "Continue implementation now. If complete, call action=ready_for_review with one concise note. Never move incomplete work to Review as a waiting room. If another agent must perform separate work, create and explicitly assign a separate PM task; use flag_blocker only for a human/external dependency.",
                    )
                continue

            if status == "Review":
                # Once reviewedSha records acceptance, repository finalization
                # owns the Task even if cleanup moved the repository phase to
                # operational_error. A reviewer comment describing that error
                # is not implementation feedback; waking review_feedback here
                # would invalidate a candidate PM may already have merged.
                if _pm_repository_finalization_owns_task(row):
                    continue
                status_s = _parse_pm_ts(row["statusChangedAt"])
                feedback = _pm_latest_comment_by(conn, row["id"], reviewer_id, status_s)
                if feedback and row["assigneeId"] and assignee_slug:
                    feedback_age = _pm_age_s(feedback["createdAt"]) or 0
                    if feedback_age >= warn_review_s and not _pm_has_comment_since(
                        conn,
                        row["id"],
                        row["assigneeId"],
                        _parse_pm_ts(feedback["createdAt"]),
                    ):
                        # P1: agents cannot resume a Review task with start.
                        # Informal feedback that never became review_feedback/
                        # review_done leaves the task stuck — the REVIEWER
                        # must formalize, so target them (kind slug kept for
                        # state continuity).
                        add(
                            row,
                            "pm-review-feedback-awaiting-assignee",
                            reviewer_slug,
                            feedback_age,
                            "Feedback exists in comments but was never formalized. Call action=review_feedback with a concise summary (the task returns to the front of To Do for the assignee) or action=review_done if the work is acceptable.",
                            extra={"assignee": assignee_slug, "comment_preview": (feedback["body"] or "")[:180]},
                        )
                    continue
                response = _pm_latest_comment_not_by(
                    conn,
                    row["id"],
                    row["assigneeId"],
                    status_s,
                    row["assigneeUsername"],
                    reviewer_username,
                )
                if response and row["assigneeId"] and assignee_slug:
                    response_ts = _parse_pm_ts(response["createdAt"])
                    if response_ts and not _pm_has_comment_since(
                        conn,
                        row["id"],
                        row["assigneeId"],
                        response_ts,
                    ):
                        response_age = _pm_age_s(response["createdAt"]) or 0
                        if response_age >= warn_review_s:
                            add(
                                row,
                                "pm-review-response-awaiting-assignee",
                                assignee_slug,
                                response_age,
                                "A reviewer/manager/reporter/human response arrived while this task is in Review. Reply in the task comments if a response is needed. Do not call action=start from Review — if code changes are required, the reviewer must call action=review_feedback to return the task to the front of To Do.",
                                extra={"reviewer": reviewer_slug, "comment_preview": (response["body"] or "")[:180]},
                            )
                        continue
                if changed_age >= warn_review_s:
                    add(
                        row,
                        "pm-review-awaiting-reviewer",
                        reviewer_slug,
                        changed_age,
                        "Review the completed work. Move to Done if satisfied without posting an approval-only comment, or call action=review_feedback with concise feedback to send the task back to the front of To Do.",
                        extra={"assignee": assignee_slug},
                    )
    except Exception as e:
        out["errors"].append(f"PM workflow probe failed: {type(e).__name__}: {e}")
    finally:
        try:
            conn.close()
        except Exception:
            pass

    return out


def probe_ollama(cfg):
    """Reachability check only. We do NOT force a model load here -- on a CPU host the
    cold-load latency dwarfs the tick budget. The AI judge call (when invoked) is the
    real functional probe."""
    base = cfg["ollama_probe"]["endpoint"]
    timeout = cfg["ollama_probe"].get("timeout_s", 5)
    expected_models = [
        cfg["ai"].get("model"),
        cfg["ai"].get("fallback_model"),
    ]
    t0 = time.time()
    try:
        with urllib.request.urlopen(base + "/api/tags", timeout=timeout) as resp:
            status = resp.status
            body = resp.read().decode("utf-8", errors="replace")
        obj = json.loads(body)
        names = [m.get("name") for m in obj.get("models", [])]
        missing = [m for m in expected_models if m and m not in names]
        return {
            "ok": status == 200 and not missing,
            "status": status,
            "latency_s": round(time.time() - t0, 2),
            "models_count": len(names),
            "missing_models": missing,
        }
    except Exception as e:
        return {
            "ok": False,
            "error": str(e)[:200],
            "latency_s": round(time.time() - t0, 2),
        }


SYSTEM_PROMPT = """You are the AI judge for the host's agent monitor on openSUSE Tumbleweed.

The host runs one or more tenant users (registered in /etc/openclaw/agents.json) plus system services (ollama, nginx, mariadb, php-fpm). The procedural watchdog `openclaw-integrity-check` has already run; you receive its output plus host resources and an ollama liveness probe.

Output ONLY a single JSON object with this shape:
{
  "healthy": true|false,
  "summary": "<=180 chars plain English",
  "issues": [
    {
      "unit": "<systemd unit OR resource name OR listener host:port>",
      "kind": "<short slug, e.g. crash-loop, gmail-watch-expiring, telegram-send-failing, mem-high, listener-down>",
      "severity": "info"|"warn"|"crit",
      "reason": "<one sentence with concrete evidence from the probes>",
      "suggested_action": "none"|"investigate"|"rotate-credentials"|"observe"
    }
  ]
}

Rules:
- A FAIL line in `integrity_check.fail_lines` is at minimum WARN; persistent FAIL across runs (also in `previously_open`) is CRIT.
- Treat is_active=active as insufficient if the unit's recent journal shows repeated "Scheduled restart" or rapid exits — that is a crash loop and is CRIT.
- Telegram sendMessage failures: WARN if 1-3 in last 10min, CRIT if more.
- Gmail watch expiring within 24h is WARN; expired is CRIT.
- Resource threshold breaches in `resources.threshold_breaches` are WARN; if the same breach appears in `previously_open`, escalate to CRIT.
- A listener marked open=false for an expected port is CRIT.
- Functional ollama probe `ok=false` is CRIT.
- Healthy state: `healthy=true`, `issues=[]`, summary names the green services briefly.
- Be terse. No prose outside JSON. Do NOT recommend `restart` — the procedural checker already restarts. Use `investigate` or `observe`.
"""


def build_compact_input(probes):
    """Produce a minimal probe summary for the LLM. The full probe lives in log.jsonl."""
    r = probes.get("resources", {})
    cpu = max(r.get("cpu_count", 1) or 1, 1)
    integrity = probes.get("integrity_check", {})
    listeners = probes.get("listeners", {})
    return {
        "ts": probes.get("ts"),
        "host": probes.get("host"),
        "integrity_check": {
            "exit_code": integrity.get("exit_code"),
            "fail_lines": integrity.get("fail_lines", [])[:10],
            "warn_lines": integrity.get("warn_lines", [])[:10],
        },
        "ollama_probe": {
            "ok": probes.get("ollama_probe", {}).get("ok"),
            "latency_s": probes.get("ollama_probe", {}).get("latency_s"),
            "error": probes.get("ollama_probe", {}).get("error"),
        },
        "resources": {
            "load1_per_core": round(r.get("load1", 0) / cpu, 2),
            "mem_used_pct": r.get("mem_used_pct"),
            "swap_used_pct": r.get("swap_used_pct"),
            "temp_max_c": r.get("temp_max_c"),
            "fan_rpm_max": r.get("fan_rpm_max"),
            "rootfs_used_pct": r.get("rootfs_used_pct"),
            "ac_online": r.get("ac_online"),
            "battery": r.get("battery"),
            "threshold_breaches": r.get("threshold_breaches", []),
        },
        "gateway_memory": [
            {
                "agent": user,
                "state": state.get("state"),
                "current_bytes": state.get("current_bytes"),
                "peak_bytes": state.get("peak_bytes"),
                "source": state.get("source"),
            }
            for user, state in probes.get("gateway_memory", {}).get(
                "agents", {}
            ).items()
            if state.get("state") != "ok"
        ],
        "previous_shutdown": {
            "status": probes.get("previous_shutdown", {}).get("status"),
            "evidence": probes.get("previous_shutdown", {}).get(
                "evidence", []
            )[:5],
        },
        "system_units": {
            u: s.get("is_active") for u, s in probes.get("system_units", {}).items()
        },
        "user_units": {
            k: v.get("is_active") for k, v in probes.get("user_units", {}).items()
        },
        "down_listeners": [
            f"{k} ({v.get('owner','?')})"
            for k, v in listeners.items()
            if not v.get("open") and v.get("expected", True)
        ],
        "registry": {
            "ok": probes.get("registry", {}).get("ok"),
            "agents_seen": probes.get("registry", {}).get("agents_seen", 0),
            "stale": probes.get("registry", {}).get("stale", False),
        },
        "stalled_tasks": [
            {"agent": t["agent"], "key": t["key"],
             "age_minutes": (t.get("age_s") or t.get("session_idle_s") or 0) // 60,
             "severity": t["severity"]}
            for t in probes.get("stalled_tasks", {}).get("stalled_tasks", [])
        ],
        "pending_email_tasks": [
            {"agent": e["agent"], "message_id": e["message_id"],
             "age_minutes": (e.get("age_s") or 0) // 60,
             "severity": e["severity"],
             "subject": e.get("subject", "")[:80]}
            for e in probes.get("pending_email_tasks", {}).get("pending", [])
        ],
        "pm_workflow": [
            {"agent": p["agent"], "task_id": p["task_id"],
             "kind": p["kind"], "status": p.get("status"),
             "age_minutes": (p.get("age_s") or 0) // 60,
             "required_action": p.get("required_action", "")[:140]}
            for p in probes.get("pm_workflow", {}).get("items", [])
        ],
        "agent_files": [
            {"agent": s.get("agent"),
             "label": s.get("label"),
             "path": s.get("path"),
             "reason": s.get("reason"),
             "expected": s.get("expected")}
            for s in probes.get("agent_files", {}).get("issues", [])[:20]
        ],
    }


def model_auth_issues(lines):
    """One issue per agent login, from integrity-check model-auth lines.

    A login can report both a renewal problem and observed failures in one run;
    those merge into a single issue so the human gets one bullet per login.
    """
    by_unit = {}
    for line in lines or []:
        m = MODEL_AUTH_LINE_RE.match(line)
        if not m:
            continue
        failing = m.group("level") == "FAIL"
        unit = f"{m.group('user')}/model-auth:{m.group('provider')}"
        issue = by_unit.get(unit)
        if issue is None or (failing and issue["severity"] != "crit"):
            by_unit[unit] = {
                "unit": unit,
                "kind": "model-auth-failing" if failing else "model-auth-renewal-due",
                "severity": "crit" if failing else "warn",
                "reason": m.group("detail")[:420],
                "suggested_action": "rotate-credentials",
            }
        elif failing == (issue["severity"] == "crit"):
            issue["reason"] = f"{issue['reason']} | {m.group('detail')}"[:600]
    return list(by_unit.values())


def deterministic_issues(probes):
    """Emit issues we can derive without an LLM. These are the unambiguous signals;
    no natural-language interpretation needed. Run on every tick."""
    out = []
    for unit, state in probes.get("system_units", {}).items():
        v = state.get("is_active")
        if v != "active":
            out.append({
                "unit": unit, "kind": "system-unit-not-active",
                "severity": "crit",
                "reason": f"systemctl is-active reports '{v}'",
                "suggested_action": "investigate",
            })
    broken_user_managers = {}
    for key, state in probes.get("user_units", {}).items():
        if systemd_user_bus_broken(state):
            user = state.get("user") or key.split("/", 1)[0]
            broken_user_managers.setdefault(user, {
                "uid": state.get("uid"),
                "err": state.get("err", ""),
            })
    for user, meta in broken_user_managers.items():
        uid_text = f" uid={meta.get('uid')}" if meta.get("uid") is not None else ""
        out.append({
            "unit": f"user-manager:{user}",
            "kind": "user-manager-bus-broken",
            "severity": "crit",
            "reason": (
                f"{user}{uid_text}: systemd user bus is broken "
                f"({(meta.get('err') or '')[:120]})"
            ),
            "suggested_action": "restart user@UID.service and restart openclaw user services",
        })
    for key, state in probes.get("user_units", {}).items():
        user = state.get("user") or key.split("/", 1)[0]
        if user in broken_user_managers:
            continue
        v = state.get("is_active")
        if v != "active":
            out.append({
                "unit": key, "kind": "user-unit-not-active",
                "severity": "crit",
                "reason": f"systemctl --user is-active reports '{v}' ({state.get('err','')[:80]})",
                "suggested_action": "investigate",
            })
    for key, state in probes.get("listeners", {}).items():
        if state.get("expected", True) and not state.get("open"):
            out.append({
                "unit": f"listener:{key}", "kind": "listener-down",
                "severity": "crit",
                "reason": f"TCP connect failed for {state.get('owner','')} ({state.get('error','')[:80]})",
                "suggested_action": "investigate",
            })
    op = probes.get("ollama_probe", {})
    if not op.get("ok"):
        miss = op.get("missing_models")
        reason = (
            f"missing models: {miss}" if miss
            else f"/api/tags failed ({op.get('error','')[:80]})"
        )
        out.append({
            "unit": "ollama:127.0.0.1:11434", "kind": "ollama-unreachable",
            "severity": "crit",
            "reason": reason,
            "suggested_action": "investigate",
        })
    for breach in probes.get("resources", {}).get("threshold_breaches", []):
        kind = breach.split("=")[0]
        out.append({
            "unit": f"resource:{kind}", "kind": f"threshold-{kind}",
            "severity": "warn",
            "reason": f"breach: {breach}",
            "suggested_action": "observe",
        })
    gateway_memory = probes.get("gateway_memory", {})
    warn_bytes = gateway_memory.get(
        "warn_bytes", DEFAULT_GATEWAY_WARN_BYTES
    )
    critical_bytes = gateway_memory.get("critical_bytes", warn_bytes)
    for user, state in gateway_memory.get("agents", {}).items():
        current = state.get("current_bytes")
        memory_state = state.get("state")
        if memory_state in ("warn", "critical") and current is not None:
            current_gib = current / 1024 ** 3
            threshold = (
                state.get("critical_bytes", critical_bytes)
                if memory_state == "critical"
                else state.get("warn_bytes", warn_bytes)
            )
            out.append({
                "unit": f"{user}/openclaw-gateway.service",
                "kind": "gateway-memory-high",
                "severity": "crit" if memory_state == "critical" else "warn",
                "reason": (
                    f"gateway memory is {current_gib:.2f} GiB "
                    f"(threshold {threshold / 1024 ** 3:.2f} GiB; "
                    f"source={state.get('source') or 'unknown'})"
                ),
                "suggested_action": "investigate",
            })
        elif (
            memory_state == "unavailable"
            and state.get("active_state") == "active"
            and state.get("rc") == 0
        ):
            out.append({
                "unit": f"{user}/openclaw-gateway.service",
                "kind": "gateway-memory-unavailable",
                "severity": "warn",
                "reason": (
                    "gateway is active but MemoryCurrent, cgroup "
                    "memory.current, and main-process RSS are unavailable"
                ),
                "suggested_action": "investigate",
            })
    previous_shutdown = probes.get("previous_shutdown", {})
    if previous_shutdown.get("status") == "unsafe-evidence":
        evidence = previous_shutdown.get("evidence", [])
        first = evidence[0] if evidence else {}
        out.append({
            "unit": "host:previous-shutdown",
            "kind": "previous-shutdown-unclean",
            "severity": "warn",
            "reason": (
                f"{first.get('source', 'local evidence')}: "
                f"{first.get('detail', 'unsafe shutdown evidence found')}"
            )[:420],
            "suggested_action": "investigate",
        })
    integ = probes.get("integrity_check", {})
    if integ.get("exit_code") is None:
        out.append({
            "unit": "openclaw-integrity-check", "kind": "no-recent-run",
            "severity": "warn",
            "reason": f"no openclaw-integrity output in window ({integ.get('runs_in_window',0)} runs seen)",
            "suggested_action": "investigate",
        })
    out.extend(model_auth_issues(integ.get("model_auth_lines")))
    reg = probes.get("registry", {})
    if not reg.get("ok"):
        out.append({
            "unit": "ai-monitor:registry",
            "kind": "registry-unreadable",
            "severity": "crit",
            "reason": f"agents.json registry not readable at {reg.get('path','?')}: {reg.get('error','?')}",
            "suggested_action": "investigate",
        })
    elif reg.get("stale"):
        out.append({
            "unit": "ai-monitor:registry",
            "kind": "registry-stale",
            "severity": "warn",
            "reason": f"agents.json registry not modified in {reg.get('age_s',0)//86400} days (>{reg.get('max_age_hours','?')}h threshold)",
            "suggested_action": "observe",
        })
    elif reg.get("agents_seen", 0) == 0:
        out.append({
            "unit": "ai-monitor:registry",
            "kind": "registry-empty",
            "severity": "warn",
            "reason": "agents.json has zero enabled+monitored agents — nothing tenant-side is being watched",
            "suggested_action": "investigate",
        })
    agent_files = probes.get("agent_files", {})
    for issue in agent_files.get("issues", []) or []:
        label = issue.get("label", "doc")
        is_config = label == "openclaw-config"
        if is_config:
            unit = f"agent-config:{issue.get('agent','?')}"
            kind = "agent-config-drift"
            reason = (
                f"{issue.get('path')} is {issue.get('reason','invalid')}; "
                f"expected content from {issue.get('expected')}"
            )
        else:
            unit = f"agent-doc:{issue.get('agent','?')}/{label}"
            kind = "agent-doc-drift"
            reason = (
                f"{issue.get('path')} is {issue.get('reason','invalid')}; "
                f"expected={issue.get('expected')}"
            )
        severity = "warn"
        out.append({
            "unit": unit,
            "kind": kind,
            "severity": severity,
            "reason": reason,
            "suggested_action": "investigate",
        })
    stalled = probes.get("stalled_tasks", {})
    for task in stalled.get("stalled_tasks", []) or []:
        kind = task.get("kind", "task-stalled")
        idle_s = task.get("session_idle_s")
        upd_s = task.get("updated_age_s")
        if kind == "task-stalled-no-agent":
            mins = (idle_s or 0) // 60
            reason = (
                f"{task['key']} ({task['summary']}) — assigned to {task['agent']} "
                f"({task.get('status','?')}); agent session silent for {mins} min — "
                f"agent isn't running this ticket"
            )
        else:  # task-stalled-no-progress
            mins = (upd_s or 0) // 60
            idle_mins = (idle_s or 0) // 60 if idle_s is not None else None
            extra = f", session active ({idle_mins}m idle)" if idle_mins is not None else ""
            reason = (
                f"{task['key']} ({task['summary']}) — assigned to {task['agent']} "
                f"({task.get('status','?')}); no Jira update in {mins} min{extra} — "
                f"possible heartbeat loop"
            )
        out.append({
            "unit": f"jira:{task['agent']}/{task['key']}",
            "kind": kind,
            "severity": task.get("severity", "warn"),
            "reason": reason,
            "suggested_action": "investigate",
        })
    # Item 4: surface jira-probe failures so a token rot or network glitch
    # doesn't go silent. Was previously buried in stalled["errors"].
    for err in stalled.get("errors", []) or []:
        out.append({
            "unit": "jira:probe",
            "kind": "jira-probe-failed",
            "severity": "warn",
            "reason": f"jira probe error: {err}",
            "suggested_action": "investigate",
        })
    # agent-idle-with-queue: agent has nothing In Progress but ≥1 ticket
    # in any of the configured queue_statuses (Selected for Development /
    # To Do by default) AND session is idle past threshold. Catches the
    # gap where an agent finishes a ticket and just sits instead of
    # picking up the next per WORKFLOW.md "Picking the Next Task".
    # Handled deterministically by ai-monitor (auto-wake, no monitor agent).
    queue_probe = probes.get("agent_queue", {})
    for q in queue_probe.get("idle_with_queue", []) or []:
        mins = (q.get("session_idle_s") or 0) // 60
        keys = ", ".join(q.get("queue_keys", []) or [])
        more = q.get("queue_count", 0) - len(q.get("queue_keys", []) or [])
        extra = f" (and {more} more)" if more > 0 else ""
        out.append({
            "unit": f"jira:{q['agent']}/queue",
            "kind": "agent-idle-with-queue",
            "severity": q.get("severity", "warn"),
            "reason": (
                f"{q['agent']}: {q['queue_count']} queued ticket(s) "
                f"({keys}{extra}), nothing In Progress, session idle {mins} min — "
                f"agent should be picking up next task per WORKFLOW.md "
                f"\"Picking the Next Task\""
            ),
            "suggested_action": "investigate",
        })
    for err in queue_probe.get("errors", []) or []:
        out.append({
            "unit": "jira:agent-queue",
            "kind": "agent-queue-probe-failed",
            "severity": "warn",
            "reason": f"agent-queue probe error: {err}",
            "suggested_action": "investigate",
        })
    # Actionable Gmail queued but not acted on. The Gmail worker already
    # woke the agent when it wrote the QUEUED task; if it is still queued
    # after the threshold, wake/restart escalation is justified.
    email_probe = probes.get("pending_email_tasks", {})
    for e in email_probe.get("pending", []) or []:
        mins = (e.get("age_s") or 0) // 60
        out.append({
            "unit": f"email:{e['agent']}/{e['message_id']}",
            "kind": "email-awaiting-action",
            "severity": e.get("severity", "warn"),
            "reason": (
                f"{e['agent']}: actionable email still QUEUED for {mins} min — "
                f"from {e.get('source','?')}; subject \"{e.get('subject','(no subject)')}\". "
                f"Task file: {e.get('current_path')}"
            ),
            "suggested_action": "investigate",
        })
    for err in email_probe.get("errors", []) or []:
        out.append({
            "unit": "email:pending-tasks",
            "kind": "pending-email-probe-failed",
            "severity": "warn",
            "reason": f"pending-email probe error: {err}",
            "suggested_action": "investigate",
        })
    # Item 2: @-mention awaiting reply (sourced from pending-mentions queue
    # written by the webhook receiver).
    pm = probes.get("pending_mentions", {})
    for m in pm.get("awaiting", []) or []:
        age_min = (m.get("age_s") or 0) // 60
        preview = (m.get("preview") or "")[:140]
        out.append({
            "unit": f"jira:{m['agent']}/{m['issue_key']}",
            "kind": "mention-awaiting-reply",
            "severity": m.get("severity", "warn"),
            "reason": (
                f"{m['issue_key']} — {m['agent']} was @-mentioned by "
                f"{m.get('mentioner_name','someone')} {age_min}m ago and has not replied. "
                f"Comment preview: \"{preview}\""
            ),
            "suggested_action": "investigate",
        })
    for err in pm.get("errors", []) or []:
        out.append({
            "unit": "jira:pending-mentions",
            "kind": "pending-mentions-probe-failed",
            "severity": "warn",
            "reason": f"pending-mentions probe error: {err}",
            "suggested_action": "investigate",
        })
    pmw = probes.get("pm_workflow", {})
    for repair in pmw.get("self_assignment_repairs", []) or []:
        out.append({
            "unit": f"pm:self-assignment/{repair.get('scope','item')}:{repair.get('id','unknown')}",
            "kind": "pm-self-assignment-repaired",
            "severity": "warn",
            "reason": (
                f"PM self-assignment guard cleared {repair.get('field','field')} "
                f"for @{repair.get('agentUsername','agent')} on "
                f"{repair.get('scope','item')} {repair.get('id','unknown')} "
                f"({repair.get('title','')})."
            ),
            "suggested_action": "investigate",
        })
    for item in pmw.get("items", []) or []:
        # Backlog is explicitly non-actionable. Defense in depth: even if a
        # future probe accidentally emits an item, it cannot become an alert.
        if item.get("status") == "Backlog":
            continue
        age_min = (item.get("age_s") or 0) // 60
        unit = f"pm:{item['agent']}/{item['task_id']}"
        if item.get("scope") == "epic":
            child_statuses = ", ".join(item.get("child_statuses") or []) or "unknown"
            reason = (
                f"{item.get('project','?')} Epic {item.get('epic_id','?')} "
                f"({item.get('task_title','')}) is {item.get('epic_status','?')} "
                f"for {age_min} min with {item.get('child_count', 0)} active child "
                f"task(s) ({child_statuses}). Required action: "
                f"{item.get('required_action','follow PM workflow')}"
            )
        else:
            reason = (
                f"{item.get('project','?')} task {item['task_id']} "
                f"({item.get('task_title','')}) is {item.get('status','?')} "
                f"for {age_min} min; Epic={item.get('epic_status') or 'none'}. "
                f"Required action: {item.get('required_action','follow PM workflow')}"
            )
        out.append({
            "unit": unit,
            "kind": item.get("kind", "pm-workflow"),
            "severity": item.get("severity", "warn"),
            "reason": reason,
            "suggested_action": "investigate",
            # Preserve the concrete channel incident identity through the
            # deterministic issue/ladder boundary. The nudge helper must
            # revalidate this exact message/run immediately before it writes;
            # task id + kind alone are not enough once task state can change
            # during a monitor confirmation window.
            **({"message_id": item.get("message_id")} if item.get("message_id") else {}),
            **({"run_status": item.get("run_status")} if item.get("run_status") else {}),
            **({"run_failed_at": item.get("run_failed_at")} if item.get("run_failed_at") else {}),
        })
    for err in pmw.get("errors", []) or []:
        out.append({
            "unit": "pm:workflow",
            "kind": "pm-workflow-probe-failed",
            "severity": "warn",
            "reason": f"PM workflow probe error: {err}",
            "suggested_action": "investigate",
        })
    return out


def needs_ai_interpretation(probes):
    """The AI adds value when there are integrity FAIL/WARN lines that need translation
    into plain-English alerts with severity grading. Deterministic issues are already
    handled. Returns (should_invoke, reason)."""
    integ = probes.get("integrity_check", {})
    if integ.get("fail_lines"):
        return True, f"{len(integ['fail_lines'])} integrity FAIL lines"
    if integ.get("warn_lines"):
        return True, f"{len(integ['warn_lines'])} integrity WARN lines"
    return False, "no integrity log lines to interpret"


def make_verdict(deterministic, ai_verdict_or_none):
    issues = list(deterministic)
    dropped_ungrounded_pm_issues = 0
    ai_succeeded = bool(
        ai_verdict_or_none and ai_verdict_or_none.get("_model") not in (None, "none")
    )
    if ai_succeeded:
        ai_issues = ai_verdict_or_none.get("issues", []) or []
        seen = {event_key(i) for i in issues}
        for ai_issue in ai_issues:
            # PM workflow state is structured and probed deterministically.
            # The model receives previously-open incidents as context, but it
            # must never turn that history back into a current PM action after
            # the live probe has cleared. Only deterministic_issues() may
            # introduce pm-* findings into the action ladder.
            if str(ai_issue.get("kind") or "").startswith("pm-"):
                dropped_ungrounded_pm_issues += 1
                continue
            if event_key(ai_issue) not in seen:
                issues.append(ai_issue)
        model = ai_verdict_or_none.get("_model")
    elif ai_verdict_or_none:
        model = "deterministic+ai-failed"
    else:
        model = "deterministic"

    if not issues:
        return {
            "healthy": True,
            "summary": (
                ai_verdict_or_none.get("summary") or "all signals nominal"
            )[:180] if ai_succeeded and not dropped_ungrounded_pm_issues else "all signals nominal",
            "issues": [],
            "_model": model if ai_succeeded else "bypass",
            "_ai_error": (ai_verdict_or_none or {}).get("_ai_error"),
        }
    crit = sum(1 for i in issues if i.get("severity") == "crit")
    warn = sum(1 for i in issues if i.get("severity") == "warn")
    summary = (
        ai_verdict_or_none["summary"][:180]
        if (
            ai_succeeded
            and not dropped_ungrounded_pm_issues
            and ai_verdict_or_none.get("summary")
        )
        else f"{crit} crit, {warn} warn — {issues[0].get('unit','?')}: {issues[0].get('kind','?')}"
    )
    return {
        "healthy": False,
        "summary": summary[:180],
        "issues": issues,
        "_model": model,
        "_ai_error": (ai_verdict_or_none or {}).get("_ai_error"),
    }


def _strip_json_fence(s):
    """Some cloud models (notably glm-5.1) wrap their JSON output in markdown
    code fences even when format=json is set. Strip ```json ... ``` /
    ``` ... ``` envelopes if present."""
    s = (s or "").strip()
    if s.startswith("```"):
        # drop opening fence + optional language tag
        first_nl = s.find("\n")
        if first_nl != -1:
            s = s[first_nl + 1 :]
        if s.endswith("```"):
            s = s[:-3]
        elif "```" in s:
            s = s[: s.rfind("```")]
        s = s.strip()
    return s


def _ai_chain(cfg):
    """Build the model fallback chain: primary first, then fallbacks. Supports
    both new `fallback_models: [...]` and the old single `fallback_model`."""
    chain = [cfg["ai"]["model"]]
    fbs = cfg["ai"].get("fallback_models")
    if fbs:
        chain.extend(fbs)
    elif cfg["ai"].get("fallback_model"):
        chain.append(cfg["ai"]["fallback_model"])
    return [m for m in chain if m]


def ai_judge(cfg, probe_blob, prev_open):
    compact = build_compact_input(probe_blob)
    user_msg = json.dumps(
        {"probes": compact, "previously_open": prev_open}, default=str
    )
    last_error = ""
    fallback_errors = []
    for model in _ai_chain(cfg):
        try:
            url = cfg["ai"]["endpoint"] + "/api/chat"
            payload = {
                "model": model,
                "messages": [
                    {"role": "system", "content": SYSTEM_PROMPT},
                    {"role": "user", "content": user_msg},
                ],
                "format": "json",
                "stream": False,
                "keep_alive": cfg["ai"].get("keep_alive", "30m"),
                # num_predict must fit a full issues array from a verbose
                # model — 1024 silently truncated glm's JSON mid-array, the
                # parse failed, and every tick fell back to the tiny local
                # model without any recorded reason.
                "options": {
                    "temperature": 0.1,
                    "num_predict": int(cfg["ai"].get("num_predict", 4096)),
                },
            }
            status, body = http_post_json(
                url, payload, timeout=cfg["ai"]["timeout_s"]
            )
            obj = json.loads(body)
            verdict_text = obj.get("message", {}).get("content", "")
            verdict = json.loads(_strip_json_fence(verdict_text))
            if not isinstance(verdict.get("issues"), list):
                verdict["issues"] = []
            verdict["_model"] = model
            verdict["_latency_s"] = obj.get("total_duration", 0) / 1e9 if obj.get("total_duration") else None
            # Surface WHY better models were skipped, so a degraded judge is
            # visible in the JSONL instead of masquerading as success.
            if fallback_errors:
                verdict["_ai_fallback_errors"] = fallback_errors[:4]
            return verdict
        except Exception as e:
            last_error = f"{type(e).__name__}: {e}"
            fallback_errors.append(f"{model}: {last_error[:140]}")
            continue
    # AI failed silently: deterministic_issues already produced the alerts the user
    # cares about. Don't add a noisy "judge-failed" issue on top. The failure is
    # captured in the JSONL log via the _model field and _ai_error.
    return {
        "healthy": True,
        "summary": "",
        "issues": [],
        "_model": "none",
        "_ai_error": last_error[:200],
    }


PM_EXECUTION_RECOVERY_KINDS = {
    "pm-todo-not-started",
    "pm-in-progress-stale",
    "pm-channel-no-start",
    "pm-channel-stalled",
    "pm-channel-failed",
}


def event_key(issue):
    kind = issue.get("kind", "?")
    # These are successive symptoms of one task execution episode, not fresh
    # incidents. Keep the same ladder/budget when a validation callback moves
    # the task To Do and the recovery moves it back In Progress, or when the
    # channel symptom changes from no-start to failed/stalled.
    if kind in PM_EXECUTION_RECOVERY_KINDS:
        kind = "pm-execution-recovery"
    raw = (
        f"{issue.get('unit','?')}|{kind}|{issue.get('severity','?')}"
    )
    return hashlib.sha1(raw.encode()).hexdigest()[:16]


PM_WORKFLOW_RETRY_KINDS = {
    "pm-action-plan-missing",
    "pm-action-plan-awaiting-approval",
    "pm-todo-not-started",
    "pm-in-progress-stale",
    "pm-blocker-response-awaiting-assignee",
    "pm-review-feedback-awaiting-assignee",
    "pm-review-response-awaiting-assignee",
    "pm-review-awaiting-reviewer",
    "pm-channel-no-start",
    "pm-channel-stalled",
    "pm-channel-failed",
}


def _is_pm_workflow_retry_kind(kind):
    return kind in PM_WORKFLOW_RETRY_KINDS


def _is_pm_backlog_issue(issue):
    """Recognize current and legacy PM alerts sourced from Backlog tasks."""
    if not (issue.get("unit", "") or "").startswith("pm:"):
        return False
    if issue.get("task_status") == "Backlog":
        return True
    reason = issue.get("reason", "") or ""
    return re.search(r"\bis Backlog for \d+ min;", reason) is not None


def _pm_issue_target_user(issue):
    """Target user/agent-slug of a pm:* workflow issue (unit pm:<user>/<taskId>)."""
    unit = issue.get("unit", "") or ""
    if not unit.startswith("pm:"):
        return None
    rest = unit[3:]
    if "/" not in rest:
        return None
    return rest.split("/", 1)[0] or None


def _is_active_agent_user(user, registry):
    """True when `user` matches an enabled agent registry entry (user or slug).
    PM workflow targets can resolve to humans (reporter, epic manager) —
    those must never receive wake/restart/nudge actions."""
    if not user or not registry:
        return False
    for a in (registry.get("agents") or []):
        if a.get("enabled") and user in (a.get("user"), a.get("slug")):
            return True
    return False


def get_monitor_agent(registry):
    """Find the monitor (triage) agent in the registry by `role: 'monitor'`.
    Returns the registry entry dict (with keys like 'user', 'home', etc.) or
    None if no monitor is configured / enabled. The monitor field on coding
    agents means 'ai-monitor watches them' — only role='monitor' identifies
    the actual triage agent."""
    if not registry:
        return None
    for a in (registry.get("agents") or []):
        if a.get("role") == "monitor" and a.get("enabled"):
            return a
    return None


def get_coding_agents(registry):
    """All enabled, monitored, coding agents from the registry."""
    if not registry:
        return []
    return [
        a for a in (registry.get("agents") or [])
        if a.get("enabled") and a.get("monitor") and a.get("coding")
    ]


def resolve_user_uid(user):
    """Resolve a Linux user to their UID. Returns None on failure."""
    try:
        return pwd.getpwnam(user).pw_uid
    except Exception:
        return None


def _is_monitor_self_incident(issues, monitor_user):
    """Return True if any issue is about the monitor agent's own services
    or ai-monitor itself. The monitor agent can't safely triage her own
    outage — ai-monitor must escalate directly."""
    if not monitor_user:
        return False
    for i in issues:
        unit = i.get("unit", "")
        if unit.startswith(f"{monitor_user}/"):
            return True
        if unit.startswith("ai-monitor"):
            return True
    return False


def _email_task_resolved(user, message_id):
    """True when the Gmail-backed task section is no longer QUEUED."""
    path = Path(f"/home/{user}/tasks/current.md")
    try:
        text = path.read_text(errors="replace")
    except Exception:
        return False
    for section in re.split(r"(?m)^---\s*$", text):
        if f"Gmail messageId: {message_id}" not in section:
            continue
        status = (_extract_field_from_section(section, "Status") or "").strip().upper()
        return bool(status and status != "QUEUED")
    return False


def _issues_resolved_for_user(user, bucket):
    email_results = {}
    for e in bucket.get("emails") or []:
        mid = e.get("message_id") or ""
        email_results[mid] = _email_task_resolved(user, mid)
    if email_results:
        return {
            "email_results": email_results,
            "all_email_resolved": all(email_results.values()),
        }
    return {"email_results": {}, "all_email_resolved": None}


def _pm_required_action_from_reason(reason):
    marker = "Required action:"
    if marker not in (reason or ""):
        return None
    return reason.split(marker, 1)[1].strip()[:500]


def _run_pm_workflow_nudges(user, bucket, cfg=None):
    """Send PM workflow recovery through the native PM channel.

    Generic openclaw-control wakes land in the heartbeat/system-event lane
    and do not carry the Mission Control context packet or workflow endpoint.
    PM drift must use the PM channel so the agent receives the same task
    context and task-comment reply target as a normal comment/discussion.
    """
    results = []
    for p in bucket.get("pm_tasks") or []:
        cmd = [
            "/usr/local/sbin/pm-workflow-nudge",
            "--task-id", p.get("task_id") or "",
            "--agent", user,
            "--kind", p.get("kind") or "pm-workflow",
        ]
        if p.get("message_id"):
            cmd.extend(["--message-id", p.get("message_id")])
        required = _pm_required_action_from_reason(p.get("reason") or "")
        if required:
            cmd.extend(["--required-action", required])
        rc, out, err = run_cmd(cmd, timeout=90)
        parsed = None
        if out.strip():
            try:
                parsed = json.loads(out)
            except Exception:
                parsed = None
        results.append({
            "task_id": p.get("task_id"),
            "kind": p.get("kind"),
            "rc": rc,
            "ok": bool(parsed.get("ok")) if isinstance(parsed, dict) else rc == 0,
            "out": out.strip()[:500],
            "err": err.strip()[:300],
            "parsed": parsed if isinstance(parsed, dict) else None,
        })
    return results


def _pm_recovery_confirm_delay_s(cfg, default_s):
    pc = (cfg or {}).get("pm_workflow") or {}
    try:
        return int(pc.get("recovery_confirm_seconds", default_s))
    except Exception:
        return default_s


def _pm_channel_run_snapshot(cfg, agent, message_id):
    if not message_id:
        return {"ok": False, "error": "missing messageId"}
    db_path = _sqlite_pm_db_path(cfg or {})
    if not os.path.exists(db_path):
        return {"ok": False, "error": f"PM database not found: {db_path}"}
    try:
        conn = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
        conn.row_factory = sqlite3.Row
        try:
            row = conn.execute(
                """
                SELECT
                  id, status, error, acceptedAt, streamingAt, completedAt,
                  failedAt, lastEventAt, streamSeq, updatedAt
                FROM PmChannelRun
                WHERE agentSlug = ? AND messageId = ?
                ORDER BY updatedAt DESC
                LIMIT 1
                """,
                (agent, message_id),
            ).fetchone()
        finally:
            conn.close()
    except Exception as e:
        return {"ok": False, "error": f"PM channel run lookup failed: {e}"}
    if not row:
        return {"ok": False, "error": "PmChannelRun row not found"}
    return {
        "ok": True,
        "id": row["id"],
        "status": row["status"],
        "error": row["error"],
        "acceptedAt": row["acceptedAt"],
        "streamingAt": row["streamingAt"],
        "completedAt": row["completedAt"],
        "failedAt": row["failedAt"],
        "lastEventAt": row["lastEventAt"],
        "streamSeq": row["streamSeq"],
        "updatedAt": row["updatedAt"],
    }


def _pm_channel_run_confirmed(snapshot, accepted_window_s=120):
    """Confirmed only when the run is actually alive: streaming/completed, or
    accepted with a fresh lastEventAt. A failed run never confirms recovery
    — streamSeq>0 on a failed run is a dead stream, not progress."""
    if not snapshot or not snapshot.get("ok"):
        return False
    status = snapshot.get("status")
    # `completed` is canonical; `complete` remains accepted while a rolling
    # deployment may still have an older PM process writing the legacy value.
    if status in ("streaming", "complete", "completed"):
        return True
    if status in ("accepted", "admitted"):
        age_s = _pm_age_s(snapshot.get("lastEventAt"))
        return age_s is not None and age_s <= accepted_window_s
    return False


def _confirm_pm_nudge_results(cfg, user, nudge_results):
    confirmed_any = False
    for result in nudge_results:
        parsed = result.get("parsed") or {}
        message_id = parsed.get("messageId")
        snapshot = _pm_channel_run_snapshot(cfg or {}, user, message_id)
        confirmed = _pm_channel_run_confirmed(snapshot)
        result["confirmation"] = snapshot
        result["confirmed"] = bool(confirmed)
        if confirmed:
            confirmed_any = True
    return confirmed_any


def _bucket_only_pm(bucket):
    return bool(bucket.get("pm_tasks")) and not (
        bucket.get("tickets") or bucket.get("queue_keys") or bucket.get("emails")
    )


def _bucket_needs_pm_restart(bucket):
    return any(
        (p.get("kind") or "")
        in ("pm-channel-no-start", "pm-channel-stalled", "pm-channel-failed")
        for p in bucket.get("pm_tasks") or []
    )


def _record_pm_recovery_deferral(issue, results, event, now, delay):
    result = results.get(_pm_issue_target_user(issue)) or {}
    if result.get("action") != "pm-recovery-deferred":
        return False
    event["next_attempt_after"] = now + delay
    event.setdefault("attempt_history", []).append({
        "ts": now, "tier": event.get("attempts", 0),
        "kind": issue.get("kind"), "route": "bypass-monitor",
        "action": "pm-recovery-deferred", "preflight": result.get("preflight"),
    })
    return True


def _pm_recovery_preflight(cfg, user, bucket):
    """Revalidate immediately before a PM restart/nudge, not at probe time.

    A gateway is shared by all this agent's tasks. Never terminate admitted
    execution to recover a different queued/failed turn. PM owns execution
    leases and capacity retries; an unavailable DB is not restart permission.
    """
    def defer(reason, resolved=False):
        return {"allowed": False, "reason": reason, "resolved": resolved}

    pc = cfg.get("pm_workflow") or {}
    grace_s = float(pc.get("channel_accepted_warn_minutes", 30)) * 60
    warn_s = float(pc.get("channel_no_start_warn_minutes", 2)) * 60
    try:
        conn = sqlite3.connect(f"file:{_sqlite_pm_db_path(cfg)}?mode=ro", uri=True)
        conn.row_factory = sqlite3.Row
        try:
            active = conn.execute("""
                SELECT id, messageId, status, lastEventAt FROM PmChannelRun
                WHERE agentSlug = ? AND status IN ('accepted', 'admitted', 'streaming')
            """, (user,)).fetchall()
            incident_messages = {p.get("message_id") for p in bucket.get("pm_tasks") or []}
            for run in active:
                age = _pm_age_s(run["lastEventAt"])
                if run["messageId"] not in incident_messages or run["status"] in ("admitted", "streaming") or age is None or age < grace_s:
                    return defer(f"agent has live execution: {run['id']} ({run['status']})")
            leases = conn.execute("""
                SELECT runId, expiresAt FROM AgentExecutionLease
                WHERE agentSlug = ? AND status IN ('reserved', 'admitted', 'running')
            """, (user,)).fetchall()
            for lease in leases:
                expires = _parse_pm_ts(lease["expiresAt"])
                if expires is None or expires > time.time():
                    return defer(f"agent execution lease is occupied: {lease['runId']}")

            for incident in bucket.get("pm_tasks") or []:
                if not (incident.get("kind") or "").startswith("pm-channel-"):
                    if _pm_has_live_channel_run(conn, incident.get("task_id"), user):
                        return defer("task already has a queued or active turn")
                    continue
                message_id = incident.get("message_id")
                if not message_id:
                    return defer("channel incident has no exact message identity")
                # Recheck the current task owner/status as well as the run.
                # A historical assignee incident must not restart a reviewer.
                current = conn.execute("""
                    SELECT m.body, t.status, ? AS messageAgentSlug,
                      aa.slug AS assigneeAgentSlug, a.username AS assigneeUsername,
                      ra.slug AS reviewerAgentSlug, r.username AS reviewerUsername,
                      ea.slug AS epicManagerAgentSlug, er.username AS epicManagerUsername,
                      e.status AS epicStatus, rep.username AS reporterUsername
                    FROM AgentChatMessage m JOIN Task t ON t.id = m.taskId
                    JOIN Project p ON p.id = t.projectId
                    LEFT JOIN User a ON a.id = t.assigneeId LEFT JOIN Agent aa ON aa.id = a.agentId
                    LEFT JOIN User r ON r.id = t.actingManagerId LEFT JOIN Agent ra ON ra.id = r.agentId
                    LEFT JOIN User rep ON rep.id = t.reporterId
                    LEFT JOIN Epic e ON e.id = t.epicId
                    LEFT JOIN User er ON er.id = e.actingManagerId LEFT JOIN Agent ea ON ea.id = er.agentId
                    WHERE m.id = ? AND t.id = ? AND m.deletedAt IS NULL
                      AND t.deletedAt IS NULL AND t.archived_at IS NULL AND p.deletedAt IS NULL
                """, (user, message_id, incident.get("task_id"))).fetchone()
                if not current or not _pm_workflow_notification_is_current(current):
                    return defer("incident no longer belongs to the current workflow owner", True)
                run = conn.execute("""
                    SELECT id, status, lastEventAt, createdAt FROM PmChannelRun
                    WHERE agentSlug = ? AND messageId = ? AND taskId = ?
                    ORDER BY createdAt DESC LIMIT 1
                """, (user, message_id, incident.get("task_id"))).fetchone()
                if not run:
                    return defer("no current run proves a gateway fault")
                if run["status"] in ("complete", "completed", "canceled", "cancelled", "superseded"):
                    return defer("incident run has settled", True)
                if run["status"] == "waiting_capacity":
                    return defer("capacity wait is owned by the PM queue")
                if run["status"] not in ("queued", "accepted", "retryable", "failed", "timed_out"):
                    return defer(f"run is no longer restartable: {run['status']}")
                age = _pm_age_s(run["lastEventAt"])
                threshold = grace_s if run["status"] == "accepted" else warn_s
                if run["status"] == "retryable":
                    threshold *= 2
                if age is None or age < threshold:
                    return defer("incident has made recent progress or is within retry grace")
                newer = conn.execute("""
                    SELECT id FROM PmChannelRun WHERE agentSlug = ? AND taskId = ?
                      AND createdAt > ? LIMIT 1
                """, (user, incident.get("task_id"), run["createdAt"])).fetchone()
                if newer:
                    return defer("a newer turn supersedes the incident", True)
            return {"allowed": True, "reason": "current incident; no live execution or lease"}
        finally:
            conn.close()
    except Exception as error:
        return defer(f"cannot verify live PM state: {error}")


def _gateway_listener_for_user(registry, user):
    for agent in (registry or {}).get("agents") or []:
        if not agent.get("enabled"):
            continue
        if user not in (agent.get("user"), agent.get("slug")):
            continue
        for listener in agent.get("listeners") or []:
            if listener.get("owner") != "openclaw-gateway":
                continue
            host = listener.get("host") or "127.0.0.1"
            port = listener.get("port")
            if isinstance(port, int) and port > 0:
                return host, port
    return None


def _wait_for_gateway_ready(user, registry, cfg=None):
    """Wait for a restarted gateway to mount plugins and report ready.

    systemctl restart returns while OpenClaw is still starting. Sending the
    native PM nudge in that gap creates a terminal `fetch failed` turn and a
    new recovery ladder. A failed readiness wait deliberately skips the
    nudge so a later monitor tier can retry without manufacturing a doomed
    PM message.
    """
    listener = _gateway_listener_for_user(registry, user)
    if not listener:
        return {
            "ready": False,
            "error": f"no openclaw-gateway listener registered for {user}",
        }
    host, port = listener
    pm_cfg = (cfg or {}).get("pm_workflow") or {}
    try:
        timeout_s = max(5, int(pm_cfg.get("gateway_ready_wait_seconds", 45)))
    except Exception:
        timeout_s = 45
    url_host = f"[{host}]" if ":" in host and not host.startswith("[") else host
    url = f"http://{url_host}:{port}/readyz"
    deadline = time.time() + timeout_s
    last_error = ""
    while time.time() < deadline:
        try:
            with urllib.request.urlopen(url, timeout=2) as response:
                body = response.read().decode("utf-8", errors="replace")
                payload = json.loads(body)
                if response.status == 200 and payload.get("ready") is True:
                    return {
                        "ready": True,
                        "url": url,
                        "failing": payload.get("failing") or [],
                    }
                last_error = f"HTTP {response.status}: ready={payload.get('ready')}"
        except Exception as error:
            last_error = str(error)[:200]
        time.sleep(0.5)
    return {
        "ready": False,
        "url": url,
        "error": last_error or f"gateway not ready after {timeout_s}s",
    }


def _skipped_pm_nudge_results(bucket, error):
    return [
        {
            "task_id": item.get("task_id"),
            "kind": item.get("kind"),
            "rc": 1,
            "ok": False,
            "out": "",
            "err": error[:300],
            "parsed": None,
        }
        for item in bucket.get("pm_tasks") or []
    ]


def _user_from_user_manager_issue(issue):
    unit = issue.get("unit", "")
    if not unit.startswith("user-manager:"):
        return None
    user = unit.split(":", 1)[1].split("/", 1)[0].strip()
    return user or None


def auto_repair_user_managers(issues):
    """Deterministic repair for a broken systemd user manager/bus.

    A broken user bus prevents normal `systemctl --user` operations and can make
    PM-channel nudges look accepted while no stream ever starts. Restarting
    user@UID is intentionally reserved for this explicit bus-broken signal.
    """
    users = sorted({u for u in (_user_from_user_manager_issue(i) for i in issues) if u})
    results = {}
    for user in users:
        try:
            uid = pwd.getpwnam(user).pw_uid
        except KeyError:
            results[user] = {
                "action": "restart-user-manager",
                "recovered": False,
                "restart_rc": 1,
                "restart_err": "unknown user",
            }
            continue

        restart_cmd = ["systemctl", "restart", f"user@{uid}.service"]
        restart_rc, _, restart_err = run_cmd(restart_cmd, timeout=60)
        time.sleep(2)

        services_cmd = [
            "sudo", "-n", "/usr/local/sbin/openclaw-control",
            "restart-services", user, "ai-monitor user manager bus repair",
        ]
        services_rc, _, services_err = run_cmd(services_cmd, timeout=120)
        time.sleep(3)

        probe_rc, probe_out, probe_err = run_cmd([
            "sudo", "-n", "-u", user, "env",
            f"XDG_RUNTIME_DIR=/run/user/{uid}",
            f"DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/{uid}/bus",
            "systemctl", "--user", "is-active", "default.target",
        ], timeout=10)
        recovered = probe_rc == 0 and (probe_out.strip() in ("active", "reloading"))
        results[user] = {
            "action": "restart-user-manager-and-services",
            "uid": uid,
            "restart_rc": restart_rc,
            "restart_err": restart_err.strip()[:240],
            "services_rc": services_rc,
            "services_err": services_err.strip()[:240],
            "probe_rc": probe_rc,
            "probe_state": probe_out.strip() or "unknown",
            "probe_err": probe_err.strip()[:240],
            "recovered": bool(recovered),
        }
    return results


def _merge_recovery_results(*parts):
    merged = {}
    for part in parts:
        if part:
            merged.update(part)
    return merged


def restart_and_wake_stalled_agents(no_agent_issues, cfg=None, registry=None):
    """Tier-2 escalation for bypass-monitor kinds.

    Semantic PM drift (for example, an In Progress task with no recent
    progress) gets another native PM execution turn. It is not evidence that
    the gateway is unhealthy, so restarting services here would destroy the
    very browser/session state needed to finish the task. Service restarts are
    reserved for explicit PM-channel no-start/stalled/failed evidence. Other
    legacy queue kinds retain the existing restart-and-wake behavior.
    """
    by_user = {}
    for issue in no_agent_issues:
        kind = issue.get("kind")
        unit = issue.get("unit", "")
        if unit.startswith("jira:"):
            rest = unit[5:]
        elif unit.startswith("email:"):
            rest = unit[6:]
        elif unit.startswith("pm:"):
            rest = unit[3:]
        else:
            continue
        if "/" not in rest:
            continue
        user, tail = rest.split("/", 1)
        bucket = by_user.setdefault(user, {
            "tickets": [], "queue_count": 0, "queue_keys": [], "emails": [], "pm_tasks": []
        })
        if kind == "task-stalled-no-agent":
            bucket["tickets"].append(tail)
        elif kind == "agent-idle-with-queue":
            reason = issue.get("reason", "") or ""
            import re as _re
            keys = _re.findall(r"\b[A-Z][A-Z0-9]+-\d+\b", reason)
            bucket["queue_keys"].extend(keys)
            m = _re.match(r"^[a-z0-9_-]+:\s*(\d+)\s+ticket", reason)
            if m:
                bucket["queue_count"] = max(bucket["queue_count"], int(m.group(1)))
        elif kind == "email-awaiting-action":
            reason = issue.get("reason", "") or ""
            subject = ""
            import re as _re
            m = _re.search(r"subject \"(.+?)\"", reason)
            if m:
                subject = m.group(1)
            bucket["emails"].append({"message_id": tail, "subject": subject[:100]})
        elif kind.startswith("pm-"):
            bucket["pm_tasks"].append({
                # pm-channel-failed units carry a /failed:<ts> instance
                # suffix after the task id — strip it for the nudge target.
                "task_id": tail.split("/", 1)[0],
                "kind": kind,
                "message_id": issue.get("message_id"),
                # Keep the probe's full "Required action:" tail intact — a
                # tighter cap truncated the nudge's required-action text
                # mid-sentence.
                "reason": (issue.get("reason") or "")[:600],
            })

    results = {}
    for user, b in by_user.items():
        if registry is not None and not _is_active_agent_user(user, registry):
            # Human (or inactive-agent) target: never restart services or
            # send agent nudges at a non-agent user. The bypass ladder
            # telegrams the human separately; just record the skip here.
            results[user] = {
                "tickets": b["tickets"],
                "queue_keys": b["queue_keys"],
                "emails": b["emails"],
                "pm_tasks": b["pm_tasks"],
                "wake_rc": 0,
                "wake_err": "",
                "post_idle_s": None,
                "recovered": False,
                "email_results": {},
                "all_email_resolved": None,
                "action": "human-target-skip",
                "human_target": True,
            }
            continue
        if b.get("pm_tasks"):
            preflight = _pm_recovery_preflight(cfg or {}, user, b)
            if not preflight["allowed"]:
                results[user] = {
                    **b, "wake_rc": 0, "wake_err": "", "post_idle_s": None,
                    "recovered": preflight.get("resolved", False),
                    "email_results": {}, "all_email_resolved": None,
                    "action": "pm-recovery-deferred", "preflight": preflight,
                    "restart_rc": None, "restart_err": "", "gateway_ready": None,
                    "pm_nudge_results": [],
                }
                continue
        if _bucket_only_pm(b):
            restart_rc = None
            restart_err = ""
            gateway_ready = None
            if _bucket_needs_pm_restart(b):
                restart_cmd = [
                    "sudo", "-n", "/usr/local/sbin/openclaw-control",
                    "restart-services", user, "ai-monitor PM channel recovery",
                ]
                restart_rc, _, restart_err = run_cmd(restart_cmd, timeout=120)
                gateway_ready = _wait_for_gateway_ready(user, registry, cfg)
            nudge_results = (
                _run_pm_workflow_nudges(user, b, cfg)
                if gateway_ready is None or gateway_ready.get("ready")
                else _skipped_pm_nudge_results(
                    b,
                    gateway_ready.get("error") or "gateway readiness check failed",
                )
            )
            time.sleep(_pm_recovery_confirm_delay_s(cfg, 20))
            confirmed = _confirm_pm_nudge_results(cfg, user, nudge_results)
            post_idle_s, _ = probe_session_idle_for_user(user, f"/home/{user}")
            recovered = confirmed
            results[user] = {
                "tickets": b["tickets"],
                "queue_keys": b["queue_keys"],
                "emails": b["emails"],
                "pm_tasks": b["pm_tasks"],
                "wake_rc": 0 if recovered else 1,
                "wake_err": "; ".join(r.get("err") or "" for r in nudge_results if r.get("err"))[:200],
                "post_idle_s": post_idle_s,
                "recovered": bool(recovered),
                "email_results": {},
                "all_email_resolved": None,
                "action": (
                    "restart-services-and-pm-channel-nudge"
                    if restart_rc is not None else "pm-channel-nudge"
                ),
                "restart_rc": restart_rc,
                "restart_err": restart_err.strip()[:200],
                "gateway_ready": gateway_ready,
                "pm_nudge_results": nudge_results,
            }
            continue

        parts = []
        if b["tickets"]:
            parts.append(
                f"tier-2 escalation — wake-agent didn't take. ticket(s) "
                f"{', '.join(b['tickets'])} are stalled In Progress; restarting "
                f"your session and waking you with this reminder. resume work "
                f"or transition them appropriately"
            )
        if b["queue_keys"]:
            kc = b["queue_count"] or len(b["queue_keys"])
            kk = ", ".join(b["queue_keys"][:5])
            more = kc - len(b["queue_keys"][:5])
            extra = f" (and {more} more)" if more > 0 else ""
            parts.append(
                f"tier-2 escalation — wake-agent didn't take. you have {kc} "
                f"queued ticket(s) ({kk}{extra}) and nothing In Progress; "
                f"restarting your session — pick the next task per "
                f"WORKFLOW.md \"Picking the Next Task\""
            )
        if b["emails"]:
            subjects = "; ".join(
                f"{e['message_id']} {e['subject']}".strip()
                for e in b["emails"][:5]
            )
            parts.append(
                f"tier-2 escalation — wake-agent didn't take. actionable email "
                f"task(s) are still QUEUED ({subjects}); restarting your session "
                f"and waking you to process them now. reply in the source email "
                f"thread and update ~/tasks/current.md out of QUEUED"
            )
        if b["pm_tasks"]:
            details = "; ".join(
                f"{p['task_id']} {p['kind']}: {p['reason']}"
                for p in b["pm_tasks"][:5]
            )
            parts.append(
                f"PM workflow action required ({details}) — follow the "
                f"Mission Control task context and respond/update status now"
            )
        reminder = "ai-monitor: " + "; ".join(parts) + "."
        cmd = [
            "sudo", "-n", "/usr/local/sbin/openclaw-control",
            "restart-and-wake", user, reminder,
        ]
        rc, out, err = run_cmd(cmd, timeout=120)
        time.sleep(20)
        post_idle_s, post_path = probe_session_idle_for_user(user, f"/home/{user}")
        resolution = _issues_resolved_for_user(user, b)
        recovered = (
            resolution["all_email_resolved"]
            if resolution["all_email_resolved"] is not None
            else (post_idle_s is not None and post_idle_s < 30)
        )
        results[user] = {
            "tickets": b["tickets"],
            "queue_keys": b["queue_keys"],
            "emails": b["emails"],
            "pm_tasks": b["pm_tasks"],
            "wake_rc": rc,
            "wake_err": (err.strip()[:200] if rc != 0 else ""),
            "post_idle_s": post_idle_s,
            "recovered": bool(recovered),
            **resolution,
            "action": "restart-and-wake",
        }
    return results


def auto_wake_stalled_agents(no_agent_issues, cfg=None, registry=None):
    """Deterministic fallback when the monitor suppresses an issue that REQUIRED
    a wake without performing one. Handles two kinds:
      - task-stalled-no-agent (ticket-attached) — reminder names the ticket(s)
      - agent-idle-with-queue (per-agent) — reminder names the queued tickets
    ai-monitor itself runs `openclaw-control wake-agent <user>` for each
    affected user, sleeps 15 s, then re-probes session idleness. Returns
    dict of per-user results."""
    # Group: user -> {ticket_keys: [...], queue_keys: [...]}
    by_user = {}
    for issue in no_agent_issues:
        kind = issue.get("kind")
        unit = issue.get("unit", "")
        if unit.startswith("jira:"):
            rest = unit[5:]
        elif unit.startswith("email:"):
            rest = unit[6:]
        elif unit.startswith("pm:"):
            rest = unit[3:]
        else:
            continue
        if "/" not in rest:
            continue
        user, tail = rest.split("/", 1)
        bucket = by_user.setdefault(user, {
            "tickets": [], "queue_count": 0, "queue_keys": [], "emails": [], "pm_tasks": []
        })
        if kind == "task-stalled-no-agent":
            bucket["tickets"].append(tail)
        elif kind == "agent-idle-with-queue":
            # tail is the literal "queue"; pull keys out of issue payload
            # (the deterministic_issues reason text has them, but we kept
            # queue_keys on the original probe item — re-derive here).
            # Easier: parse keys from the reason string.
            reason = issue.get("reason", "") or ""
            # heuristic: keys appear as ALLCAPS-DIGITS tokens in the reason
            import re as _re
            keys = _re.findall(r"\b[A-Z][A-Z0-9]+-\d+\b", reason)
            bucket["queue_keys"].extend(keys)
            # extract count too
            m = _re.match(r"^[a-z0-9_-]+:\s*(\d+)\s+ticket", reason)
            if m:
                bucket["queue_count"] = max(bucket["queue_count"], int(m.group(1)))
        elif kind == "email-awaiting-action":
            reason = issue.get("reason", "") or ""
            subject = ""
            import re as _re
            m = _re.search(r"subject \"(.+?)\"", reason)
            if m:
                subject = m.group(1)
            bucket["emails"].append({"message_id": tail, "subject": subject[:100]})
        elif kind.startswith("pm-"):
            bucket["pm_tasks"].append({
                # pm-channel-failed units carry a /failed:<ts> instance
                # suffix after the task id — strip it for the nudge target.
                "task_id": tail.split("/", 1)[0],
                "kind": kind,
                "message_id": issue.get("message_id"),
                # Keep the probe's full "Required action:" tail intact — a
                # tighter cap truncated the nudge's required-action text
                # mid-sentence.
                "reason": (issue.get("reason") or "")[:600],
            })

    results = {}
    for user, b in by_user.items():
        if registry is not None and not _is_active_agent_user(user, registry):
            # Human (or inactive-agent) target: never wake/restart or send
            # agent nudges at a non-agent user. The bypass ladder telegrams
            # the human separately; just record the skip here.
            results[user] = {
                "tickets": b["tickets"],
                "queue_keys": b["queue_keys"],
                "emails": b["emails"],
                "pm_tasks": b["pm_tasks"],
                "wake_rc": 0,
                "wake_err": "",
                "post_idle_s": None,
                "recovered": False,
                "email_results": {},
                "all_email_resolved": None,
                "action": "human-target-skip",
                "human_target": True,
            }
            continue
        if b.get("pm_tasks"):
            preflight = _pm_recovery_preflight(cfg or {}, user, b)
            if not preflight["allowed"]:
                results[user] = {
                    **b, "wake_rc": 0, "wake_err": "", "post_idle_s": None,
                    "recovered": preflight.get("resolved", False),
                    "email_results": {}, "all_email_resolved": None,
                    "action": "pm-recovery-deferred", "preflight": preflight,
                    "restart_rc": None, "restart_err": "", "gateway_ready": None,
                    "pm_nudge_results": [],
                }
                continue
        if _bucket_only_pm(b):
            restart_rc = None
            restart_err = ""
            gateway_ready = None
            if _bucket_needs_pm_restart(b):
                restart_cmd = [
                    "sudo", "-n", "/usr/local/sbin/openclaw-control",
                    "restart-services", user, "ai-monitor PM channel no-start",
                ]
                restart_rc, _, restart_err = run_cmd(restart_cmd, timeout=120)
                gateway_ready = _wait_for_gateway_ready(user, registry, cfg)
            nudge_results = (
                _run_pm_workflow_nudges(user, b, cfg)
                if gateway_ready is None or gateway_ready.get("ready")
                else _skipped_pm_nudge_results(
                    b,
                    gateway_ready.get("error") or "gateway readiness check failed",
                )
            )
            time.sleep(_pm_recovery_confirm_delay_s(cfg, 15))
            confirmed = _confirm_pm_nudge_results(cfg, user, nudge_results)
            post_idle_s, _ = probe_session_idle_for_user(user, f"/home/{user}")
            recovered = confirmed
            results[user] = {
                "tickets": b["tickets"],
                "queue_keys": b["queue_keys"],
                "emails": b["emails"],
                "pm_tasks": b["pm_tasks"],
                "wake_rc": 0 if recovered else 1,
                "wake_err": "; ".join(r.get("err") or "" for r in nudge_results if r.get("err"))[:200],
                "post_idle_s": post_idle_s,
                "recovered": bool(recovered),
                "email_results": {},
                "all_email_resolved": None,
                "action": (
                    "restart-services-and-pm-channel-nudge"
                    if restart_rc is not None else "pm-channel-nudge"
                ),
                "restart_rc": restart_rc,
                "restart_err": restart_err.strip()[:200],
                "gateway_ready": gateway_ready,
                "pm_nudge_results": nudge_results,
            }
            continue

        parts = []
        if b["tickets"]:
            parts.append(
                f"ticket(s) {', '.join(b['tickets'])} are assigned to you in "
                f"'In Progress' but your session has been idle — resume work "
                f"or transition them appropriately"
            )
        if b["queue_keys"]:
            kc = b["queue_count"] or len(b["queue_keys"])
            kk = ", ".join(b["queue_keys"][:5])
            more = kc - len(b["queue_keys"][:5])
            extra = f" (and {more} more)" if more > 0 else ""
            parts.append(
                f"you have {kc} queued ticket(s) "
                f"({kk}{extra}) and nothing In Progress — pick the next task "
                f"per WORKFLOW.md \"Picking the Next Task\" "
                f"(unanswered feedback first, then Selected for Development, then To Do)"
            )
        if b["emails"]:
            subjects = "; ".join(
                f"{e['message_id']} {e['subject']}".strip()
                for e in b["emails"][:5]
            )
            parts.append(
                f"actionable email task(s) are still QUEUED ({subjects}) — "
                f"process {f'/home/{user}/tasks/current.md'} now, reply in the "
                f"source email thread if a response or acknowledgement is needed, "
                f"sign outbound email with the current runtime model, and update "
                f"the task status out of QUEUED"
            )
        if b["pm_tasks"]:
            details = "; ".join(
                f"{p['task_id']} {p['kind']}: {p['reason']}"
                for p in b["pm_tasks"][:5]
            )
            parts.append(
                f"PM workflow action required ({details}) — follow the "
                f"Mission Control task context and respond/update status now"
            )
        reminder = "ai-monitor: " + "; ".join(parts) + "."
        cmd = [
            "sudo", "-n", "/usr/local/sbin/openclaw-control",
            "wake-agent", user, reminder,
        ]
        rc, out, err = run_cmd(cmd, timeout=60)
        time.sleep(15)
        post_idle_s, post_path = probe_session_idle_for_user(user, f"/home/{user}")
        resolution = _issues_resolved_for_user(user, b)
        recovered = (
            resolution["all_email_resolved"]
            if resolution["all_email_resolved"] is not None
            else (post_idle_s is not None and post_idle_s < 30)
        )
        results[user] = {
            "tickets": b["tickets"],
            "queue_keys": b["queue_keys"],
            "emails": b["emails"],
            "pm_tasks": b["pm_tasks"],
            "wake_rc": rc,
            "wake_err": (err.strip()[:200] if rc != 0 else ""),
            "post_idle_s": post_idle_s,
            "recovered": bool(recovered),
            **resolution,
        }
    return results


def _clear_monitor_pending_delivery(monitor_user, monitor_home=None,
                                    key="agent:main:main"):
    """Null out pendingFinalDelivery* fields on the monitor agent's heartbeat
    session.

    Why: ai-monitor invokes the monitor via `openclaw system event --mode now`,
    which expects a caller waiting to ACK the response. There is no such
    caller — the decision file ai-monitor polls for is the deliverable,
    and the response text is unused. Without this cleanup, openclaw marks
    `pendingFinalDelivery: true` and refuses to start a new turn until
    delivery succeeds; over time the `agent:main:main` queue blocks and
    every subsequent wake silently times out.

    Safety:
      - Skip if status == 'running' (would race with an in-flight turn).
      - Atomic tmp+rename, preserving the agent's owner/mode on the file.
    Returns {cleared, prior_attempt_count?, reason?, error?}.
    """
    if not monitor_user:
        return {"cleared": False, "reason": "no-monitor-user"}
    home = monitor_home or f"/home/{monitor_user}"
    sj_path = Path(f"{home}/.openclaw/agents/main/sessions/sessions.json")
    try:
        st = sj_path.stat()
        data = json.loads(sj_path.read_text())
        entry = data.get(key) or {}
        if not entry.get("pendingFinalDelivery"):
            return {"cleared": False, "reason": "no-pending"}
        if entry.get("status") == "running":
            return {"cleared": False, "reason": "still-running"}
        prior = entry.get("pendingFinalDeliveryAttemptCount")
        entry["pendingFinalDelivery"] = False
        for f in (
            "pendingFinalDeliveryText",
            "pendingFinalDeliveryCreatedAt",
            "pendingFinalDeliveryLastAttemptAt",
            "pendingFinalDeliveryAttemptCount",
            "pendingFinalDeliveryLastError",
        ):
            entry.pop(f, None)
        tmp = sj_path.with_suffix(sj_path.suffix + ".aim-tmp")
        tmp.write_text(json.dumps(data, indent=2, default=str))
        os.chown(tmp, st.st_uid, st.st_gid)
        os.chmod(tmp, stat.S_IMODE(st.st_mode))
        os.replace(tmp, sj_path)
        return {"cleared": True, "prior_attempt_count": prior}
    except Exception as e:
        return {"cleared": False, "error": str(e)[:200]}


def hand_off_to_monitor(cfg, registry, incident_id, incident_payload):
    """Write the incident to disk, wake the monitor agent via
    `openclaw system event`, then poll for its decision file with timeout.
    The monitor agent is identified by `role: 'monitor'` in the registry.
    Returns the decision dict or {"_error": "..."} on failure/timeout."""
    triage = cfg.get("monitor_triage") or cfg.get("karen_triage") or {}

    monitor = get_monitor_agent(registry)
    monitor_user = (
        triage.get("monitor_user")  # explicit override
        or triage.get("karen_user")  # legacy alias
        or (monitor and monitor.get("user"))
    )
    if not monitor_user:
        return {"_error": "no monitor agent in registry (role='monitor')"}
    monitor_home = (monitor and monitor.get("home")) or f"/home/{monitor_user}"
    monitor_uid = (
        triage.get("monitor_uid")
        or triage.get("karen_uid")
        or (monitor and monitor.get("uid"))
        or resolve_user_uid(monitor_user)
    )
    if monitor_uid is None:
        return {"_error": f"cannot resolve uid for monitor user '{monitor_user}'"}

    incidents_dir = Path(triage.get("incidents_dir", "/var/lib/ai-monitor/incidents"))
    decisions_dir = Path(triage.get("decisions_dir", "/var/lib/ai-monitor/decisions"))
    poll_interval_s = triage.get("poll_interval_s", 2)
    timeout_s = triage.get("timeout_s", 120)
    secrets_path = (
        triage.get("secrets_path")
        or f"{monitor_home}/.config/openclaw/openclaw-secrets.env"
    )

    incidents_dir.mkdir(parents=True, exist_ok=True)
    incident_file = incidents_dir / f"{incident_id}.json"
    incident_file.write_text(
        json.dumps(incident_payload, indent=2, default=str)
    )

    decision_file = decisions_dir / f"{incident_id}.json"
    if decision_file.exists():
        decision_file.unlink()

    # Pre-clear: openclaw flips pendingFinalDelivery=true ~3-8 s AFTER the
    # monitor finishes a turn (when delivery to the invoking channel fails).
    # The end-of-handoff cleanup races with that flip, so we also clear at
    # the START of every handoff — catches any leftover from the prior
    # tick before it can block this wake.
    pre_clear = _clear_monitor_pending_delivery(monitor_user, monitor_home)

    wake_text = (
        f"INCIDENT {incident_id}\n"
        f"ai-monitor handed off an incident to you. Payload: "
        f"/var/lib/ai-monitor/incidents/{incident_id}.json\n"
        f"Follow ~/.openclaw/workspace/INCIDENT_HANDLING.md. Write your "
        f"decision to /var/lib/ai-monitor/decisions/{incident_id}.json when done."
    )
    cmd = [
        RUNUSER_BIN, "-u", monitor_user, "--",
        "env", f"HOME={monitor_home}",
        f"XDG_RUNTIME_DIR=/run/user/{monitor_uid}",
        "bash", "-lc",
        (
            f"set -a; "
            f"if [ -r {shlex.quote(secrets_path)} ]; then . {shlex.quote(secrets_path)}; fi; "
            f"set +a; "
            f"exec openclaw system event --mode now --text \"$1\" --timeout 30000 --json"
        ),
        "_", wake_text,
    ]
    rc, out, err = run_cmd(cmd, timeout=45)
    if rc != 0:
        result = {
            "_error": (
                f"monitor wake failed (rc={rc}): "
                f"{err.strip()[:200] or out.strip()[:200]}"
            )
        }
        # Try cleanup anyway — a previously-stuck pendingFinalDelivery
        # may itself be why the wake failed.
        result["_pending_clear"] = _clear_monitor_pending_delivery(
            monitor_user, monitor_home
        )
        return result

    deadline = time.time() + timeout_s
    result = None
    while time.time() < deadline:
        if decision_file.exists():
            try:
                d = json.loads(decision_file.read_text())
                d["_handoff_latency_s"] = round(
                    timeout_s - max(deadline - time.time(), 0), 1
                )
                result = d
            except Exception as e:
                result = {"_error": f"decision parse: {e}"}
            break
        time.sleep(poll_interval_s)
    if result is None:
        result = {
            "_error": f"monitor did not write a decision within {timeout_s}s"
        }
    # Best-effort post-clear (often a no-op because openclaw hasn't yet
    # flipped pendingFinalDelivery). The pre-clear at the start of the
    # NEXT handoff is the actual safeguard.
    result["_pending_clear_pre"] = pre_clear
    result["_pending_clear_post"] = _clear_monitor_pending_delivery(
        monitor_user, monitor_home
    )
    return result


def read_telegram_creds(cfg, registry=None):
    """Resolve the Telegram bot's home (where the token lives) and the
    allowed chat list. Default to the monitor agent in the registry; can
    be overridden via `notify.telegram_bot_user` for cases where alerts
    should come from a different agent's bot.
    """
    notify = cfg.get("notify", {})
    user = notify.get("telegram_bot_user")
    if not user:
        monitor = get_monitor_agent(registry)
        user = monitor.get("user") if monitor else None
    if not user:
        return None, None
    home = f"/home/{user}"
    if registry:
        for a in (registry.get("agents") or []):
            if a.get("user") == user and a.get("home"):
                home = a["home"]
                break
    secrets_path = notify.get(
        "secrets_path", f"{home}/.config/openclaw/openclaw-secrets.env"
    )
    chat_ids_path = notify.get(
        "chat_ids_path",
        f"{home}/.openclaw/credentials/telegram-allowFrom.json",
    )
    rc1, token, _ = run_cmd(
        [
            "sudo", "-n", "-u", user, "bash", "-c",
            f"grep -E '^TELEGRAM_BOT_TOKEN=' {shlex.quote(secrets_path)} | head -1 | cut -d= -f2-",
        ],
        timeout=5,
    )
    token = token.strip().strip("'\"")
    rc2, blob, _ = run_cmd(
        ["sudo", "-n", "-u", user, "cat", chat_ids_path],
        timeout=5,
    )
    chat_id = None
    try:
        obj = json.loads(blob)
        ids = obj.get("allowFrom", [])
        if ids:
            chat_id = ids[0]
    except Exception:
        pass
    return token, chat_id


def fit_telegram_text(text, limit=3900):
    """Telegram sendMessage caps text at 4096 chars; leave room for Unicode/API variance."""
    text = str(text)
    if len(text) <= limit:
        return text
    suffix = "\n\n[truncated by ai-monitor: alert exceeded Telegram message length]"
    return text[: max(0, limit - len(suffix))].rstrip() + suffix


def send_telegram(cfg, text, registry=None):
    token, chat_id = read_telegram_creds(cfg, registry=registry)
    if not token:
        return {"ok": False, "error": "no token"}
    if not chat_id:
        return {"ok": False, "error": "no chat_id"}
    url = f"https://api.telegram.org/bot{token}/sendMessage"
    text = fit_telegram_text(text)
    try:
        status, body = http_post_json(
            url,
            {
                "chat_id": chat_id,
                "text": text,
                "disable_web_page_preview": True,
            },
            timeout=8,
        )
        return {"ok": status == 200, "status": status, "body": body[:200]}
    except urllib.error.HTTPError as e:
        try:
            return {"ok": False, "status": e.code, "body": e.read().decode("utf-8", errors="replace")[:200]}
        except Exception:
            return {"ok": False, "status": e.code, "error": str(e)}
    except Exception as e:
        return {"ok": False, "error": str(e)[:200]}


SEVERITY_ICON = {"crit": "🔴", "warn": "🟡", "info": "🔵"}


def _worst_severity(issues):
    order = ["crit", "warn", "info"]
    for sev in order:
        if any(i.get("severity") == sev for i in issues):
            return sev
    return "info"


def format_alerts_message(issues):
    """Build a single Telegram message for all new-alert issues in this tick."""
    head_icon = SEVERITY_ICON.get(_worst_severity(issues), "⚪")
    n = len(issues)
    header = (
        f"{head_icon} {socket.gethostname()} — "
        f"{n} issue{'s' if n != 1 else ''}"
    )
    blocks = []
    for issue in issues:
        sev_icon = SEVERITY_ICON.get(issue.get("severity"), "⚪")
        blocks.append(
            f"{sev_icon} {issue.get('unit','?')} — {issue.get('kind','?')}\n"
            f"{issue.get('reason','(no reason)')}\n"
            f"action: {issue.get('suggested_action','none')}"
        )
    return header + "\n\n" + "\n\n".join(blocks)


def format_model_auth_message(issues):
    """Telegram for logins only a human can restore; each reason ends with the fix."""
    head_icon = SEVERITY_ICON.get(_worst_severity(issues), "⚪")
    lines = [
        f"{head_icon} {socket.gethostname()} — model login needs you "
        "(monitor agent skipped; only a login can fix this)"
    ]
    for issue in issues:
        lines.append(f"• {issue.get('unit', '?')}: {issue.get('reason', '(no reason)')}")
    return "\n\n".join(lines)


def format_resolved_message(issues):
    """Build a single Telegram message for all resolved issues in this tick."""
    n = len(issues)
    header = f"✅ {socket.gethostname()} — {n} resolved"
    lines = [
        f"{issue.get('unit','?')} — {issue.get('kind','?')}" for issue in issues
    ]
    return header + "\n" + "\n".join(lines)


def dedupe_and_act(cfg, verdict, state, registry=None, dry_run=False):
    now = int(time.time())
    issues = verdict.get("issues", []) or []
    actions = []
    state.setdefault("events", {})
    seen_keys = set()

    new_alert_issues = []
    new_alert_keys = []

    triage_cfg_for_init = cfg.get("monitor_triage") or cfg.get("karen_triage") or {}
    ladder_cfg = triage_cfg_for_init.get("escalation_ladder", {}) or {}
    confirmation_window_s = int(ladder_cfg.get("confirmation_window_s", 300))

    # Transient kinds: infrastructure flakes (curl timeouts, transient API
    # failures) that aren't actionable by the monitor agent and shouldn't
    # telegram on a single occurrence. These never reach the monitor and
    # require N consecutive ticks of the SAME key being seen before they
    # graduate to a real alert.
    # After telegram, suppressed for `transient_cooldown_s` to avoid a
    # repeat-page loop on a network partition that lasts an hour.
    TRANSIENT_KINDS = set(triage_cfg_for_init.get(
        "transient_kinds",
        [
            "jira-probe-failed",
            "agent-queue-probe-failed",
            "pending-mentions-probe-failed",
            "gmail-pubsub-timeout",
            "telegram-network-unreachable",
            "agent-config-drift",
        ],
    ))
    transient_threshold = int(triage_cfg_for_init.get(
        "transient_consecutive_threshold", 5
    ))
    transient_cooldown_s = int(triage_cfg_for_init.get(
        "transient_cooldown_s", 3600
    ))

    for issue in issues:
        if _is_pm_backlog_issue(issue):
            continue
        key = event_key(issue)
        seen_keys.add(key)
        sev = issue.get("severity", "info")
        kind = issue.get("kind", "")
        ev = state["events"].get(key)
        if ev is None:
            ev = {
                "first_seen": now,
                "last_seen": now,
                "alert_sent": False,
                "issue": issue,
                "missed_runs": 0,
                "attempts": 0,
                "attempt_history": [],
                "next_attempt_after": 0,
                "consecutive_seen": 0,
                "transient_telegram_after": 0,
            }
            state["events"][key] = ev
        else:
            ev["last_seen"] = now
            ev["missed_runs"] = 0
            ev["issue"] = issue
            ev.setdefault("attempts", 0)
            ev.setdefault("attempt_history", [])
            ev.setdefault("next_attempt_after", 0)
            ev.setdefault("consecutive_seen", 0)
            ev.setdefault("transient_telegram_after", 0)

        # Bump the consecutive-seen counter every tick this issue is present.
        # Reset is handled by the missed_runs eviction path below.
        ev["consecutive_seen"] = int(ev.get("consecutive_seen", 0)) + 1

        if (
            ev.get("alert_sent")
            and _is_pm_workflow_retry_kind(kind)
            and not ev.get("human_notification_final")
        ):
            # Old monitor state treated a Telegram/nudge as final. For PM
            # workflow drift, the task itself must resolve the issue.
            if now >= ev.get("next_attempt_after", 0):
                ev["alert_sent"] = False
                ev["attempts"] = 0
                ev["next_attempt_after"] = 0

        if sev not in ("warn", "crit") or ev["alert_sent"]:
            continue

        # Transient gate: don't graduate to an alert until we've seen the
        # same key N consecutive ticks. Once telegrammed, hold off for the
        # cooldown window even if it stays present.
        if kind in TRANSIENT_KINDS:
            if ev["consecutive_seen"] < transient_threshold:
                continue
            if now < ev.get("transient_telegram_after", 0):
                continue
            # Graduate: queue as alert AND mark it transient so the
            # downstream router skips the monitor and adds a sustained-failure note.
            issue["_transient"] = True
            issue["_consecutive_seen"] = ev["consecutive_seen"]
            new_alert_issues.append(issue)
            new_alert_keys.append(key)
            continue

        # Tier framework: respect the confirmation window between attempts.
        # If we acted at tier N within the last `confirmation_window_s`,
        # don't act again — give the prior fix time to take. The natural
        # recovery path is: tier-N succeeds → next probe doesn't see the
        # issue → missed_runs increments → silent eviction. If the issue
        # is still seen after the window expires, we proceed to tier N+1.
        if now < ev.get("next_attempt_after", 0):
            continue
        new_alert_issues.append(issue)
        new_alert_keys.append(key)

    if new_alert_issues:
        text = format_alerts_message(new_alert_issues)
        triage_cfg = cfg.get("monitor_triage") or cfg.get("karen_triage") or {}
        monitor_enabled = triage_cfg.get("enabled", True)
        monitor_agent = get_monitor_agent(registry)
        monitor_user = (
            triage_cfg.get("monitor_user")
            or triage_cfg.get("karen_user")
            or (monitor_agent and monitor_agent.get("user"))
        )
        self_incident = _is_monitor_self_incident(new_alert_issues, monitor_user)

        # Transient issues (graduated from the consecutive-failure gate
        # above) skip the monitor agent entirely. They get a single rolled-up
        # telegram naming the kind and how long it's been failing, then
        # enter cooldown.
        transient_issues = [i for i in new_alert_issues if i.get("_transient")]
        transient_keys = [event_key(i) for i in transient_issues]

        if transient_issues and not dry_run:
            tg_text_parts = [
                "⚠️ Sustained probe failure (monitor bypassed)\n"
            ]
            for ti in transient_issues:
                cs = ti.get("_consecutive_seen", "?")
                tg_text_parts.append(
                    f"\n• {ti.get('kind')} — {cs} consecutive ticks "
                    f"(~{cs * 2} min)\n  reason: {(ti.get('reason') or '')[:200]}"
                )
            r = send_telegram(cfg, "".join(tg_text_parts), registry=registry)
            actions.append({
                "type": "alert_transient_sustained",
                "keys": transient_keys,
                "kinds": sorted({i.get("kind") for i in transient_issues}),
                "result": r,
            })
            for k in transient_keys:
                if k in state["events"]:
                    if r.get("ok"):
                        state["events"][k]["alert_sent"] = True
                    state["events"][k]["transient_telegram_after"] = now + transient_cooldown_s
                    # Reset consecutive_seen so the next telegram waits the
                    # full threshold again rather than firing on the next tick.
                    state["events"][k]["consecutive_seen"] = 0

        # Now strip transient issues out of the working set — they're done.
        new_alert_issues = [i for i in new_alert_issues if not i.get("_transient")]
        new_alert_keys = [event_key(i) for i in new_alert_issues]

        # Model logins are restored only by a human (browser/device login),
        # so they skip the monitor agent and the recovery ladder: one Telegram
        # per episode carrying the fix command. Log-derived failures come and
        # go with agent activity, so eviction is silent (idle is not a
        # recovery) and a recurrence for the same login within
        # `model_auth_renotify_s` of the last page stays quiet.
        auth_issues = [i for i in new_alert_issues if i.get("kind") in MODEL_AUTH_KINDS]
        if auth_issues:
            renotify_s = int(triage_cfg.get("model_auth_renotify_s", 6 * 3600))
            notified = state.setdefault("model_auth_notified", {})
            for unit in [u for u, ts in notified.items() if now - int(ts) > 7 * 86400]:
                del notified[unit]
            due = [
                i for i in auth_issues
                if i.get("unit", "?") not in notified
                or now - int(notified[i.get("unit", "?")]) >= renotify_s
            ]
            sent_ok = not due
            if due and dry_run:
                actions.append({
                    "type": "would_notify_model_auth",
                    "keys": [event_key(i) for i in due],
                    "text": format_model_auth_message(due),
                })
            elif due:
                r = send_telegram(cfg, format_model_auth_message(due), registry=registry)
                sent_ok = bool(r.get("ok"))
                if sent_ok:
                    for i in due:
                        notified[i.get("unit", "?")] = now
                actions.append({
                    "type": "model_auth_human_notified",
                    "keys": [event_key(i) for i in due],
                    "units": sorted(i.get("unit", "?") for i in due),
                    "result": r,
                })
            for i in auth_issues:
                ev = state["events"].get(event_key(i), {})
                ev["silent_resolve"] = True
                # Retry next tick if Telegram failed; otherwise this login is
                # handled until it clears or the renotify window passes.
                if sent_ok or i not in due:
                    ev["alert_sent"] = True
                    ev["human_notification_final"] = True
            new_alert_issues = [i for i in new_alert_issues if i.get("kind") not in MODEL_AUTH_KINDS]
            new_alert_keys = [event_key(i) for i in new_alert_issues]
            # A monitor-agent login issue is handled above; it must not turn
            # the rest of this tick into a self-incident.
            self_incident = _is_monitor_self_incident(new_alert_issues, monitor_user)

        if new_alert_issues:
            text = format_alerts_message(new_alert_issues)
        else:
            text = ""

        # Kinds ai-monitor handles deterministically without involving the
        # monitor agent. The situation is unambiguous (e.g. "agent has nothing
        # In Progress but tickets are queued and they're idle") and the
        # action is bounded and idempotent (wake-agent). No judgment needed;
        # routing through the monitor just adds latency and a chance of a
        # wrong suppress.
        default_auto_action_kinds = {
            "agent-idle-with-queue",
            "email-awaiting-action",
            "user-manager-bus-broken",
            "pm-action-plan-missing",
            "pm-action-plan-awaiting-approval",
            "pm-todo-not-started",
            "pm-in-progress-stale",
            "pm-blocker-response-awaiting-assignee",
            "pm-review-feedback-awaiting-assignee",
            "pm-review-response-awaiting-assignee",
            "pm-review-awaiting-reviewer",
            "pm-channel-no-start",
            "pm-channel-stalled",
            "pm-epic-not-open",
        }
        configured_auto_action_kinds = (
            triage_cfg.get("auto_action_kinds_bypass_monitor")
            or triage_cfg.get("auto_action_kinds_bypass_karen")
            or []
        )
        AUTO_ACTION_KINDS = default_auto_action_kinds | set(configured_auto_action_kinds)
        AUTO_ACTION_KINDS -= set(triage_cfg.get("disable_auto_action_kinds", []))
        auto_issues = [i for i in new_alert_issues if i.get("kind") in AUTO_ACTION_KINDS]
        monitor_bound_issues = [
            i for i in new_alert_issues if i.get("kind") not in AUTO_ACTION_KINDS
        ]
        auto_keys = [event_key(i) for i in auto_issues]
        monitor_bound_keys = [event_key(i) for i in monitor_bound_issues]

        max_attempts = int(ladder_cfg.get("max_attempts", 3))

        if auto_issues and not dry_run:
            # Human-target safety: pm-* drift whose resolved target is not an
            # active agent (e.g. a human reporter or epic manager) must never
            # enter the wake/restart/nudge ladder. Send one Telegram for the
            # human, then suppress it until the underlying PM state changes.
            human_target_issues = []
            routed_issues = []
            for i in auto_issues:
                target = _pm_issue_target_user(i)
                if target and not _is_active_agent_user(target, registry):
                    human_target_issues.append(i)
                else:
                    routed_issues.append(i)
            if human_target_issues:
                tg_parts = ["👤 PM workflow: human action required (agent ladder skipped)"]
                for i in human_target_issues:
                    tg_parts.append(
                        f"\n• @{_pm_issue_target_user(i)} — {i.get('kind')}: "
                        f"{(i.get('reason') or '')[:300]}"
                    )
                r = send_telegram(cfg, "".join(tg_parts), registry=registry)
                for i in human_target_issues:
                    k = event_key(i)
                    ev = state["events"].get(k, {})
                    ev.setdefault("attempt_history", []).append({
                        "ts": now,
                        "tier": 0,
                        "kind": i.get("kind"),
                        "route": "human-target",
                        "action": "telegram-human",
                        "target": _pm_issue_target_user(i),
                        "telegram_result": r,
                    })
                    if r.get("ok"):
                        ev["attempts"] = 0
                        ev["alert_sent"] = True
                        ev["human_notification_final"] = True
                        ev["next_attempt_after"] = 0
                        ev["last_human_notify"] = now
                actions.append({
                    "type": "pm_human_target_notified",
                    "keys": [event_key(i) for i in human_target_issues],
                    "targets": sorted({
                        _pm_issue_target_user(i) for i in human_target_issues
                    }),
                    "result": r,
                })
                auto_issues = routed_issues

            # Tier framework for bypass-monitor kinds:
            #   T1 = wake-agent / native PM-channel nudge
            #   T2 = repeat semantic PM nudge; restart only on concrete
            #        service/channel-failure evidence
            #   T3 = final recovery attempt under the same boundary
            #   T4 = Telegram only if the issue is still present after T3
            # The ev["attempts"] counter on each event tracks how many
            # tiers have already fired. Recovery from a tier resets the
            # counter; eviction (issue stops appearing) is silent.
            tier1_issues, tier2_issues, tier3_issues, exhausted_issues = [], [], [], []
            for i in auto_issues:
                k = event_key(i)
                ev = state["events"].get(k, {})
                attempt = int(ev.get("attempts", 0)) + 1
                if attempt == 1:
                    tier1_issues.append(i)
                elif attempt == 2:
                    tier2_issues.append(i)
                elif attempt <= max_attempts:
                    tier3_issues.append(i)
                else:
                    exhausted_issues.append(i)

            tier_actions = []

            if tier1_issues:
                manager_issues = [
                    i for i in tier1_issues
                    if i.get("kind") == "user-manager-bus-broken"
                ]
                wake_issues = [
                    i for i in tier1_issues
                    if i.get("kind") != "user-manager-bus-broken"
                ]
                wake_results = _merge_recovery_results(
                    auto_wake_stalled_agents(wake_issues, cfg, registry) if wake_issues else {},
                    auto_repair_user_managers(manager_issues) if manager_issues else {},
                )
                for i in tier1_issues:
                    k = event_key(i)
                    ev = state["events"].get(k, {})
                    if _record_pm_recovery_deferral(i, wake_results, ev, now, confirmation_window_s):
                        continue
                    ev["attempts"] = 1
                    ev.setdefault("attempt_history", []).append({
                        "ts": now,
                        "tier": 1,
                        "kind": i.get("kind"),
                        "route": "bypass-monitor",
                        "action": "wake-agent",
                        "wake_results": wake_results,
                    })
                    ev["next_attempt_after"] = now + confirmation_window_s
                tier_actions.append({
                    "type": "auto_action_bypass_monitor_tier1",
                    "keys": [event_key(i) for i in tier1_issues],
                    "wake_results": wake_results,
                })

            if tier2_issues:
                manager_issues = [
                    i for i in tier2_issues
                    if i.get("kind") == "user-manager-bus-broken"
                ]
                wake_issues = [
                    i for i in tier2_issues
                    if i.get("kind") != "user-manager-bus-broken"
                ]
                rw_results = _merge_recovery_results(
                    restart_and_wake_stalled_agents(wake_issues, cfg, registry) if wake_issues else {},
                    auto_repair_user_managers(manager_issues) if manager_issues else {},
                )
                for i in tier2_issues:
                    k = event_key(i)
                    ev = state["events"].get(k, {})
                    if _record_pm_recovery_deferral(i, rw_results, ev, now, confirmation_window_s):
                        continue
                    ev["attempts"] = 2
                    semantic_pm_only = i.get("kind", "").startswith("pm-") and i.get("kind") not in (
                        "pm-channel-no-start", "pm-channel-stalled", "pm-channel-failed"
                    )
                    ev.setdefault("attempt_history", []).append({
                        "ts": now,
                        "tier": 2,
                        "kind": i.get("kind"),
                        "route": "bypass-monitor",
                        "action": "repeat-pm-channel-nudge" if semantic_pm_only else "restart-and-wake",
                        "wake_results": rw_results,
                    })
                    ev["next_attempt_after"] = now + confirmation_window_s
                tier_actions.append({
                    "type": "auto_action_bypass_monitor_tier2",
                    "keys": [event_key(i) for i in tier2_issues],
                    "wake_results": rw_results,
                })

            if tier3_issues:
                manager_issues = [
                    i for i in tier3_issues
                    if i.get("kind") == "user-manager-bus-broken"
                ]
                wake_issues = [
                    i for i in tier3_issues
                    if i.get("kind") != "user-manager-bus-broken"
                ]
                final_results = _merge_recovery_results(
                    restart_and_wake_stalled_agents(wake_issues, cfg, registry) if wake_issues else {},
                    auto_repair_user_managers(manager_issues) if manager_issues else {},
                )
                for i in tier3_issues:
                    k = event_key(i)
                    ev = state["events"].get(k, {})
                    if _record_pm_recovery_deferral(i, final_results, ev, now, confirmation_window_s):
                        continue
                    ev["attempts"] = max_attempts
                    ev.setdefault("attempt_history", []).append({
                        "ts": now,
                        "tier": max_attempts,
                        "kind": i.get("kind"),
                        "route": "bypass-monitor",
                        "action": "final-recovery",
                        "wake_results": final_results,
                    })
                    ev["next_attempt_after"] = now + confirmation_window_s
                tier_actions.append({
                    "type": "auto_action_bypass_monitor_tier3_final_recovery",
                    "keys": [event_key(i) for i in tier3_issues],
                    "wake_results": final_results,
                })

            if exhausted_issues:
                # Recovery already had max_attempts chances. Now alert.
                hist_text_parts = [format_alerts_message(exhausted_issues)]
                hist_text_parts.append(
                    f"\n\n[Recovery failed after {max_attempts} attempt(s). "
                    "Attempt history:"
                )
                for i in exhausted_issues:
                    k = event_key(i)
                    ev = state["events"].get(k, {})
                    for h in (ev.get("attempt_history") or [])[-3:]:
                        hist_text_parts.append(
                            f"\n  T{h.get('tier')} ({h.get('action')}): "
                            f"{json.dumps(h.get('wake_results') or {}, default=str)[:200]}"
                        )
                hist_text_parts.append("\n]")
                tier3_text = "".join(hist_text_parts)
                r = send_telegram(cfg, tier3_text, registry=registry)
                pm_retry_cooldown_s = int(
                    (cfg.get("pm_workflow") or {}).get(
                        "retry_after_tier3_seconds",
                        max(1800, confirmation_window_s),
                    )
                )
                for i in exhausted_issues:
                    k = event_key(i)
                    ev = state["events"].get(k, {})
                    ev["attempts"] = max_attempts + 1
                    ev.setdefault("attempt_history", []).append({
                        "ts": now,
                        "tier": max_attempts + 1,
                        "kind": i.get("kind"),
                        "route": "bypass-monitor",
                        "action": "telegram",
                        "telegram_result": r,
                    })
                    if r.get("ok"):
                        if i.get("kind") == "email-awaiting-action":
                            # The user has been paged, but the work is not
                            # done while the task section remains QUEUED.
                            # Keep the event live and restart the ladder
                            # after a longer cooldown instead of suppressing
                            # future recovery attempts permanently.
                            ev["attempts"] = 0
                            ev["next_attempt_after"] = now + max(1800, confirmation_window_s)
                            ev["last_tier3_telegram"] = now
                        elif _is_pm_workflow_retry_kind(i.get("kind")):
                            # Same reasoning as email-awaiting-action: a
                            # Telegram or accepted PM-channel nudge is not
                            # task completion. Retry the PM-channel ladder
                            # after cooldown until the PM workflow probe no
                            # longer sees this task as stale.
                            ev["attempts"] = 0
                            ev["next_attempt_after"] = now + max(
                                300,
                                pm_retry_cooldown_s,
                            )
                            ev["last_tier3_telegram"] = now
                        else:
                            ev["alert_sent"] = True
                tier_actions.append({
                    "type": "auto_action_bypass_monitor_recovery_failed_telegram",
                    "keys": [event_key(i) for i in exhausted_issues],
                    "result": r,
                })

            actions.extend(tier_actions)
            # Refresh the local view: only the monitor-bound subset proceeds.
            new_alert_issues = monitor_bound_issues
            new_alert_keys = monitor_bound_keys
            if monitor_bound_issues:
                # Rebuild the alert text without the auto-handled issues.
                text = format_alerts_message(monitor_bound_issues)

        if not new_alert_issues:
            # Nothing left after transient-strip + auto-action — no monitor, no Telegram.
            pass
        elif dry_run:
            actions.append(
                {"type": "would_alert", "keys": new_alert_keys, "text": text}
            )
            for k in new_alert_keys:
                state["events"][k]["alert_sent"] = True
        elif monitor_enabled and not self_incident:
            incident_id = hashlib.sha1(
                "|".join(sorted(new_alert_keys)).encode()
            ).hexdigest()[:16]

            # Tier framework for monitor-bound kinds:
            #   T1 = monitor acts, suppress, no telegram
            #   T2 = monitor acts (with escalation_context), suppress, no telegram
            #   T3 = monitor acts AND telegrams with attempt history (or
            #        ai-monitor falls back to telegram if the monitor punts)
            # Compute the tier based on the highest attempts counter across
            # the keys in this incident. All keys in one incident share a
            # tier — they're co-occurring symptoms.
            this_tier = max(
                int(state["events"].get(k, {}).get("attempts", 0)) for k in new_alert_keys
            ) + 1
            is_final = this_tier >= max_attempts
            prior_history = []
            for k in new_alert_keys:
                ev = state["events"].get(k, {})
                for h in (ev.get("attempt_history") or []):
                    prior_history.append({
                        "ts": h.get("ts"),
                        "tier": h.get("tier"),
                        "kind": h.get("kind"),
                        "actions_taken": h.get("actions_taken")
                            or h.get("action") or [],
                    })

            payload = {
                "incident_id": incident_id,
                "ts": now,
                "summary": text.split("\n", 1)[0],
                "issues": new_alert_issues,
                "event_keys": new_alert_keys,
                "escalation_context": {
                    "attempt": this_tier,
                    "max_attempts": max_attempts,
                    "is_final": is_final,
                    "confirmation_window_s": confirmation_window_s,
                    "prior_attempts": prior_history,
                    "guidance": (
                        "Final attempt — try the heaviest sensible fix and "
                        "send Telegram with attempt history (telegram_sent: true)."
                        if is_final else
                        f"Attempt {this_tier} of {max_attempts}. Try a fix "
                        f"and suppress with telegram_sent: false. ai-monitor "
                        f"will re-handoff in {confirmation_window_s} s if "
                        f"the fix doesn't take."
                    ),
                },
            }
            decision = hand_off_to_monitor(cfg, registry, incident_id, payload)

            # Whatever the monitor does, advance the attempt counter and
            # record what happened for the next tier's escalation_context.
            for k in new_alert_keys:
                ev = state["events"].setdefault(k, {})
                ev["attempts"] = this_tier
                ev.setdefault("attempt_history", []).append({
                    "ts": now,
                    "tier": this_tier,
                    "kind": (ev.get("issue") or {}).get("kind"),
                    "route": "monitor",
                    "actions_taken": (decision or {}).get("actions_taken") or [],
                    "decision": (decision or {}).get("decision"),
                    "telegram_sent": (decision or {}).get("telegram_sent", False),
                    "monitor_error": (decision or {}).get("_error"),
                })
                ev["next_attempt_after"] = now + confirmation_window_s

            if decision and not decision.get("_error"):
                d = decision.get("decision")
                if d == "suppress":
                    suppression_required_actions = {
                        "task-stalled-no-agent": ("wake-agent", "restart-and-wake"),
                        "agent-idle-with-queue": ("wake-agent", "restart-and-wake"),
                        "email-awaiting-action": ("wake-agent", "restart-and-wake"),
                        "pm-action-plan-missing": ("wake-agent", "pm-channel-nudge"),
                        "pm-action-plan-awaiting-approval": ("wake-agent", "pm-channel-nudge"),
                        "pm-todo-not-started": ("wake-agent", "pm-channel-nudge"),
                        "pm-in-progress-stale": ("wake-agent", "pm-channel-nudge"),
                        "pm-blocker-response-awaiting-assignee": ("wake-agent", "pm-channel-nudge"),
                        "pm-review-feedback-awaiting-assignee": ("wake-agent", "pm-channel-nudge"),
                        "pm-review-response-awaiting-assignee": ("wake-agent", "pm-channel-nudge"),
                        "pm-review-awaiting-reviewer": ("wake-agent", "pm-channel-nudge"),
                        "pm-epic-not-open": ("wake-agent", "pm-channel-nudge"),
                        "pm-channel-no-start": ("pm-channel-nudge", "restart-services"),
                        "pm-channel-stalled": ("pm-channel-nudge", "restart-services"),
                        "pm-channel-failed": ("pm-channel-nudge", "restart-services"),
                    }
                    actions_taken_lc = [a.lower() for a in (decision.get("actions_taken") or [])]
                    violations = []
                    for issue in new_alert_issues:
                        kind = issue.get("kind")
                        if kind in suppression_required_actions:
                            needed = suppression_required_actions[kind]
                            if not any(any(n in a for n in needed) for a in actions_taken_lc):
                                violations.append(f"{kind} requires one of {needed}")

                    if violations:
                        # The monitor punted on a kind that requires action.
                        # Run the deterministic fallback wake (silent on tier
                        # 1/2; recorded in attempt_history). Telegram only
                        # on the final tier if recovery still didn't happen.
                        no_agent_issues = [
                            i for i in new_alert_issues
                            if i.get("kind") in (
                                "task-stalled-no-agent",
                                "agent-idle-with-queue",
                                "email-awaiting-action",
                                "pm-action-plan-missing",
                                "pm-action-plan-awaiting-approval",
                                "pm-todo-not-started",
                                "pm-in-progress-stale",
                                "pm-blocker-response-awaiting-assignee",
                                "pm-review-feedback-awaiting-assignee",
                                "pm-review-response-awaiting-assignee",
                                "pm-review-awaiting-reviewer",
                                "pm-epic-not-open",
                                "pm-channel-no-start",
                                "pm-channel-stalled",
                                "pm-channel-failed",
                            )
                        ]
                        wake_results = (
                            auto_wake_stalled_agents(no_agent_issues, cfg, registry)
                            if no_agent_issues else {}
                        )
                        all_recovered = bool(wake_results) and all(
                            r.get("recovered") for r in wake_results.values()
                        )
                        for k in new_alert_keys:
                            ev = state["events"].get(k, {})
                            (ev.get("attempt_history") or [{}])[-1]["fallback_wake_results"] = wake_results
                            (ev.get("attempt_history") or [{}])[-1]["fallback_recovered"] = all_recovered

                        if is_final and not all_recovered:
                            wake_summary = ""
                            if wake_results:
                                lines = []
                                for u, r in wake_results.items():
                                    if r.get("recovered"):
                                        lines.append(f"  {u}: ✓ now active")
                                    else:
                                        idle_s = r.get("post_idle_s")
                                        idle_str = (
                                            f"{idle_s//60}m{idle_s%60}s"
                                            if idle_s is not None else "unknown"
                                        )
                                        lines.append(
                                            f"  {u}: ✗ still idle ({idle_str}) — wake_rc={r.get('wake_rc')}"
                                        )
                                wake_summary = (
                                    "\n\n[ai-monitor wake attempts:\n"
                                    + "\n".join(lines)
                                    + "\n]"
                                )
                            override_text = (
                                f"⚠️ Tier {this_tier}/{max_attempts} — monitor "
                                f"suppressed without acting; auto-wake didn't recover\n"
                                f"Violation: {'; '.join(violations)}\n\n"
                                + text + wake_summary
                            )
                            r = send_telegram(cfg, override_text, registry=registry)
                            actions.append({
                                "type": "alert_policy_override_monitor_suppress",
                                "incident_id": incident_id,
                                "keys": new_alert_keys,
                                "tier": this_tier,
                                "decision": decision,
                                "violations": violations,
                                "wake_results": wake_results,
                                "result": r,
                            })
                            for k in new_alert_keys:
                                state["events"][k]["alert_sent"] = True
                        else:
                            actions.append({
                                "type": "auto_woke_after_monitor_suppress_silent" if not is_final else
                                        "auto_woke_after_monitor_suppress_recovered_final",
                                "incident_id": incident_id,
                                "keys": new_alert_keys,
                                "tier": this_tier,
                                "decision": decision,
                                "violations": violations,
                                "wake_results": wake_results,
                                "all_recovered": all_recovered,
                            })
                            if is_final:
                                # Recovered on the final tier — still mark
                                # alert_sent so eviction is tracked, but no
                                # telegram (the user said: only telegram if
                                # the fix didn't work).
                                for k in new_alert_keys:
                                    state["events"][k]["alert_sent"] = True
                    else:
                        # The monitor acted (suppress with action). On tier
                        # 1/2 we trust it and wait the confirmation window.
                        # On the final tier we still send a telegram with
                        # attempt history so the operator sees what happened
                        # — but only if the monitor didn't already telegram
                        # (it's instructed to do so on the final tier).
                        if is_final and not decision.get("telegram_sent"):
                            hist_lines = []
                            for h in prior_history[-3:]:
                                hist_lines.append(
                                    f"  T{h.get('tier')}: {h.get('actions_taken') or []}"
                                )
                            hist_block = (
                                "\n\n[Tier 3 final attempt — monitor suppressed; "
                                "prior tiers:\n" + "\n".join(hist_lines) + "\n]"
                                if hist_lines else
                                "\n\n[Tier 3 final attempt — monitor suppressed]"
                            )
                            r = send_telegram(cfg, text + hist_block, registry=registry)
                            actions.append({
                                "type": "alert_after_monitor_suppress_final_tier",
                                "incident_id": incident_id,
                                "keys": new_alert_keys,
                                "tier": this_tier,
                                "decision": decision,
                                "result": r,
                            })
                            for k in new_alert_keys:
                                state["events"][k]["alert_sent"] = True
                        else:
                            actions.append({
                                "type": "suppressed_by_monitor",
                                "incident_id": incident_id,
                                "keys": new_alert_keys,
                                "tier": this_tier,
                                "decision": decision,
                            })
                            if is_final:
                                # Final tier with monitor-sent telegram — done.
                                for k in new_alert_keys:
                                    state["events"][k]["alert_sent"] = True
                else:  # escalate or unknown — monitor overrode the framework
                    if decision.get("telegram_sent"):
                        actions.append({
                            "type": "escalated_by_monitor",
                            "incident_id": incident_id,
                            "keys": new_alert_keys,
                            "tier": this_tier,
                            "decision": decision,
                        })
                    else:
                        r = send_telegram(cfg, text, registry=registry)
                        actions.append({
                            "type": "alert_after_monitor",
                            "incident_id": incident_id,
                            "keys": new_alert_keys,
                            "tier": this_tier,
                            "result": r,
                            "decision": decision,
                        })
                    for k in new_alert_keys:
                        state["events"][k]["alert_sent"] = True
            else:
                fallback_text = (
                    "⚠️ Monitor unavailable — direct alert\n\n" + text
                )
                r = send_telegram(cfg, fallback_text, registry=registry)
                actions.append({
                    "type": "alert_monitor_unavailable",
                    "incident_id": incident_id,
                    "keys": new_alert_keys,
                    "result": r,
                    "monitor_error": (decision or {}).get("_error", "no decision"),
                })
                if r.get("ok"):
                    for k in new_alert_keys:
                        state["events"][k]["alert_sent"] = True
        else:
            tag = ""
            if self_incident:
                tag = "🔒 Self-incident (monitor agent affected) — direct alert\n\n"
            r = send_telegram(cfg, tag + text, registry=registry)
            actions.append({
                "type": "alert" if not self_incident else "alert_self_incident",
                "keys": new_alert_keys,
                "result": r,
            })
            if r.get("ok"):
                for k in new_alert_keys:
                    state["events"][k]["alert_sent"] = True

    threshold = cfg["notify"]["dedupe"]["resolved_after_runs"]
    resolved_issues = []
    resolved_keys = []
    silent_evict_keys = []
    for key, ev in state["events"].items():
        if key in seen_keys:
            continue
        if _is_pm_backlog_issue(ev.get("issue", {})):
            # Policy changed from reminding on Backlog to total suppression.
            # Remove old state silently so it cannot emit a resolved Telegram.
            silent_evict_keys.append(key)
            continue
        ev["missed_runs"] = ev.get("missed_runs", 0) + 1
        if ev["missed_runs"] >= threshold:
            if ev.get("alert_sent") and not ev.get("silent_resolve"):
                resolved_issues.append(ev.get("issue", {}))
                resolved_keys.append(key)
            else:
                silent_evict_keys.append(key)

    if resolved_issues:
        text = format_resolved_message(resolved_issues)
        if dry_run:
            actions.append(
                {"type": "would_resolve", "keys": resolved_keys, "text": text}
            )
            silent_evict_keys.extend(resolved_keys)
        else:
            r = send_telegram(cfg, text, registry=registry)
            actions.append(
                {"type": "resolved", "keys": resolved_keys, "result": r}
            )
            if r.get("ok"):
                silent_evict_keys.extend(resolved_keys)

    for key in silent_evict_keys:
        state["events"].pop(key, None)
    return actions


def append_jsonl(path, payload):
    Path(path).parent.mkdir(parents=True, exist_ok=True)
    with open(path, "a") as f:
        f.write(json.dumps(payload, default=str) + "\n")


def rotate_log(path, max_age_days=14):
    p = Path(path)
    if not p.exists():
        return
    cutoff = time.time() - max_age_days * 86400
    try:
        kept = []
        total = 0
        for line in p.open():
            total += 1
            try:
                ts = json.loads(line).get("ts", 0)
                if ts >= cutoff:
                    kept.append(line)
            except Exception:
                kept.append(line)
        if len(kept) < total:
            p.write_text("".join(kept))
    except Exception:
        pass


def load_state():
    try:
        return json.loads(Path(STATE_PATH).read_text())
    except Exception:
        return {"events": {}}


def save_state(state):
    Path(STATE_PATH).parent.mkdir(parents=True, exist_ok=True)
    tmp = Path(STATE_PATH).with_suffix(".tmp")
    tmp.write_text(json.dumps(state, indent=2, default=str))
    tmp.replace(STATE_PATH)


def load_config():
    try:
        return json.loads(Path(CONFIG_PATH).read_text())
    except Exception as e:
        print(f"FATAL: cannot load {CONFIG_PATH}: {e}", file=sys.stderr)
        sys.exit(2)


def load_agent_defaults(cfg):
    """Read /etc/openclaw/agent-defaults.json (or override). Returns a
    defaults dict; on read/parse failure returns a minimal safe default
    so derived views still produce sensible results."""
    path = (cfg.get("watch") or {}).get(
        "agent_defaults", "/etc/openclaw/agent-defaults.json"
    )
    try:
        return json.loads(Path(path).read_text())
    except Exception:
        return {"core": {"services": [], "capabilities": {}},
                "byRole": {}, "byIntegration": {}}


def derive_effective_agent(agent, defaults, all_agents=None):
    """Compute effective services and capabilities for an agent by
    merging the central defaults schema with the per-agent flags.

    Algorithm (see agent-defaults.json comments.merge_algorithm):
      1. Start with core.{services, capabilities}.
      2. Merge byRole[agent.role].
      3. For each integration where agent.integrations[k] is truthy,
         merge byIntegration[k].
      4. Per-agent agent.services APPENDS (dedup); agent.capabilities
         OVERRIDES key-by-key.

    Returns a shallow copy of `agent` with `services` and `capabilities`
    set to the effective derived values. All other agent fields are
    preserved.
    """
    eff = dict(agent)
    core = (defaults.get("core") or {})
    services = list(core.get("services") or [])
    caps = dict(core.get("capabilities") or {})

    role = agent.get("role")
    by_role = ((defaults.get("byRole") or {}).get(role) or {}) if role else {}
    for s in (by_role.get("services") or []):
        if s not in services:
            services.append(s)
    caps.update(by_role.get("capabilities") or {})

    by_int = defaults.get("byIntegration") or {}
    for k, on in (agent.get("integrations") or {}).items():
        if not on:
            continue
        block = by_int.get(k) or {}
        for s in (block.get("services") or []):
            if s not in services:
                services.append(s)
        caps.update(block.get("capabilities") or {})

    # Per-agent overrides win.
    for s in (agent.get("services") or []):
        if s not in services:
            services.append(s)
    caps.update(agent.get("capabilities") or {})

    # Per-agent monitor.json: project resources the agent has installed
    # in their home (~/.local/openclaw/monitor.json). Each resource with
    # enabled=true contributes its services + listeners. Lets agents add
    # side-project monitoring without touching the central registry.
    home = agent.get("home") or f"/home/{agent.get('user')}"
    mpath = Path(home) / ".local" / "openclaw" / "monitor.json"
    if mpath.exists():
        try:
            mdoc = json.loads(mpath.read_text())
            eff_listeners = list(agent.get("listeners") or [])
            seen_listeners = {(L.get("host"), L.get("port")) for L in eff_listeners}
            for r in (mdoc.get("resources") or []):
                if not r.get("enabled"):
                    continue
                for s in (r.get("services") or []):
                    if s not in services:
                        services.append(s)
                for L in (r.get("listeners") or []):
                    key = (L.get("host"), L.get("port"))
                    if key not in seen_listeners:
                        eff_listeners.append(L)
                        seen_listeners.add(key)
            eff["listeners"] = eff_listeners
        except Exception:
            pass

    # Receiver-gating: openclaw-<X>-receiver.service is gated at script
    # startup by integrations.<X> (see webhooks/common.js KNOWN_RECEIVERS).
    # If the gate is off, the script exits 0 and the service stays
    # inactive by design — drop it from the derived list so downstream
    # consumers don't expect a running service that's intentionally idle.
    import re as _re_recv
    _integ = agent.get("integrations") or {}
    _recv_re = _re_recv.compile(r"^openclaw-([a-z0-9-]+)-receiver\.service$")

    has_active_integration = {}
    if all_agents:
        for a in all_agents:
            if a.get("enabled", True) and a.get("role") == "coding":
                for k, v in (a.get("integrations") or {}).items():
                    if v:
                        has_active_integration[k] = True

    def _keep(s):
        m = _recv_re.match(s)
        if not m:
            return True
        gate = m.group(1)
        if not _integ.get(gate):
            return False
        if agent.get("role") == "monitor" and not has_active_integration.get(gate):
            return False
        return True
    services = [s for s in services if _keep(s)]

    eff["services"] = services
    eff["capabilities"] = caps
    return eff


def load_registry(cfg):
    """Read /etc/openclaw/agents.json (or whatever cfg.watch.agents_registry points to)
    and apply derived defaults from /etc/openclaw/agent-defaults.json to each agent.
    Returns (registry_dict_or_None, health_dict). health.ok=False if the file can't be
    read or doesn't parse — callers should still run, but emit a registry-unreadable
    deterministic issue."""
    path = cfg["watch"].get("agents_registry", "/etc/openclaw/agents.json")
    p = Path(path)
    health = {"ok": False, "path": path, "agents_seen": 0}
    if not p.exists():
        health["error"] = "file does not exist"
        return None, health
    try:
        mtime = p.stat().st_mtime
        age_s = int(time.time() - mtime)
        health["mtime"] = int(mtime)
        health["age_s"] = age_s
        registry = json.loads(p.read_text())
        defaults = load_agent_defaults(cfg)
        raw_agents = registry.get("agents") or []
        registry["agents"] = [
            derive_effective_agent(a, defaults, raw_agents)
            for a in raw_agents
        ]
        max_age_h = cfg["watch"].get("agents_registry_max_age_hours")
        if max_age_h:
            health["max_age_hours"] = max_age_h
            if age_s > max_age_h * 3600:
                health["stale"] = True
        agents = [a for a in registry.get("agents", []) if a.get("enabled")]
        health["ok"] = True
        health["agents_seen"] = len(agents)
        return registry, health
    except Exception as e:
        health["error"] = f"{type(e).__name__}: {e}"
        return None, health


def expand_watch_from_registry(cfg, registry):
    """Combine system-level config with per-agent entries from the registry.
    Returns (user_units_spec, listeners_spec) where:
      user_units_spec = list of (user, uid, unit_name)
      listeners_spec = list of dicts {host, port, owner, expected}
    """
    user_units = []
    listeners = list(cfg["watch"].get("system_listeners", []))
    if registry:
        for agent in registry.get("agents", []):
            if not (agent.get("enabled")):
                continue
            user = agent.get("user")
            uid = agent.get("uid")
            if not user or uid is None:
                continue
            for svc in agent.get("services", []) or []:
                user_units.append((user, uid, svc))
            for lst in agent.get("listeners", []) or []:
                if lst.get("port"):
                    listeners.append(
                        {
                            "host": lst.get("host", "127.0.0.1"),
                            "port": lst["port"],
                            "owner": lst.get("owner", f"{user} {svc}"),
                            "expected": lst.get("expected", True),
                        }
                    )
    return user_units, listeners


def gather_probes(cfg):
    registry, registry_health = load_registry(cfg)
    registry = registry or {"agents": []}
    user_units_spec, listeners_spec = expand_watch_from_registry(cfg, registry)

    probes = {
        "ts": int(time.time()),
        "host": socket.gethostname(),
        "integrity_check": probe_integrity_check(cfg),
        "integrity_journal": probe_journal_integrity(cfg),
        "ollama_probe": probe_ollama(cfg),
        "resources": probe_resources(cfg["resources"]["thresholds"]),
        "gateway_memory": probe_gateway_memory(cfg, registry),
        "previous_shutdown": probe_previous_shutdown(cfg),
        "system_units": {
            u: probe_systemd_system(u) for u in cfg["watch"]["system_units"]
        },
        "user_units": {},
        "listeners": {},
        "registry": registry_health,
        "stalled_tasks": probe_stalled_tasks(cfg, registry),
        "agent_queue": probe_agent_queue(cfg, registry),
        "pending_email_tasks": probe_pending_email_tasks(cfg, registry),
        "pending_mentions": probe_pending_mentions(cfg, registry),
        "pm_workflow": probe_pm_workflow(cfg, registry),
        "agent_files": probe_agent_files(cfg, registry),
    }
    for user, uid, unit in user_units_spec:
        key = f"{user}/{unit}"
        state = probe_systemd_user(user, uid, unit)
        state.update({"user": user, "uid": uid, "unit": unit})
        probes["user_units"][key] = state
    for entry in listeners_spec:
        key = f"{entry['host']}:{entry['port']}"
        probes["listeners"][key] = probe_listener(entry["host"], entry["port"])
        probes["listeners"][key]["expected"] = entry.get("expected", True)
        probes["listeners"][key]["owner"] = entry.get("owner", "")
    return probes


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n", 2)[1])
    ap.add_argument("--once", action="store_true", help="(default) one tick")
    ap.add_argument("--dry-run", action="store_true", help="probe + judge but do not alert")
    ap.add_argument("--test-notify", action="store_true", help="send one Telegram test message and exit")
    ap.add_argument("--probe-only", action="store_true", help="dump probe JSON, skip AI")
    ap.add_argument(
        "--observe-only",
        action="store_true",
        help="probe, judge, and log without alerts, nudges, restarts, or state advancement",
    )
    args = ap.parse_args()

    cfg = load_config()
    mode = operating_mode(args.observe_only)

    if args.test_notify:
        registry, _ = load_registry(cfg)
        r = send_telegram(
            cfg, "🧪 ai-monitor — test notification (registry-resolved bot).",
            registry=registry,
        )
        print(json.dumps(r))
        sys.exit(0 if r.get("ok") else 1)

    run_lock = None
    if not args.dry_run and not args.probe_only:
        run_lock = acquire_run_lock()
        if run_lock is None:
            print("healthy=True issues=0 actions=0 model=lock summary=another ai-monitor run is active")
            sys.exit(0)

    state = load_state()
    probes = gather_probes(cfg)

    if args.probe_only:
        print(json.dumps(probes, indent=2, default=str))
        sys.exit(0)

    prev_open = [
        {
            "unit": ev.get("issue", {}).get("unit"),
            "kind": ev.get("issue", {}).get("kind"),
            "severity": ev.get("issue", {}).get("severity"),
            "missed_runs": ev.get("missed_runs", 0),
            "first_seen_ago_s": int(time.time()) - ev.get("first_seen", int(time.time())),
        }
        for ev in state.get("events", {}).values()
    ]

    det_issues = deterministic_issues(probes)
    invoke_ai, ai_reason = needs_ai_interpretation(probes)
    ai_verdict = ai_judge(cfg, probes, prev_open) if invoke_ai else None
    verdict = make_verdict(det_issues, ai_verdict)
    verdict["_ai_invoked"] = bool(invoke_ai)
    verdict["_ai_reason"] = ai_reason
    # gather_probes already loaded the registry; reload here so the
    # dispatcher can resolve the monitor agent (role='monitor') without
    # going through cfg.
    registry, _ = load_registry(cfg)
    if mode == "observe-only":
        actionable = [
            {
                "unit": issue.get("unit"),
                "kind": issue.get("kind"),
                "severity": issue.get("severity"),
            }
            for issue in verdict.get("issues", [])
            if issue.get("severity") in ("warn", "crit")
        ]
        actions = [{
            "type": "observe_only",
            "issue_count": len(actionable),
            "would_intervene": actionable,
        }]
    else:
        actions = dedupe_and_act(cfg, verdict, state, registry=registry, dry_run=args.dry_run)

    record = {
        "ts": probes["ts"],
        "operating_mode": mode,
        "verdict": verdict,
        "actions": actions,
        "probe_summary": {
            "integrity_rc": probes["integrity_check"]["exit_code"],
            "integrity_fails": len(probes["integrity_check"]["fail_lines"]),
            "ollama_ok": probes["ollama_probe"].get("ok"),
            "ollama_latency_s": probes["ollama_probe"].get("latency_s"),
            "load1": probes["resources"].get("load1"),
            "mem_used_pct": probes["resources"].get("mem_used_pct"),
            "temp_max_c": probes["resources"].get("temp_max_c"),
            "threshold_breaches": probes["resources"].get("threshold_breaches", []),
            "gateway_memory_high": [
                user
                for user, state in probes.get("gateway_memory", {}).get(
                    "agents", {}
                ).items()
                if state.get("state") in ("warn", "critical")
            ],
            "previous_shutdown": probes.get(
                "previous_shutdown", {}
            ).get("status"),
            "pending_email_tasks": len(
                probes.get("pending_email_tasks", {}).get("pending", [])
            ),
            "agent_doc_drift": len(
                probes.get("agent_files", {}).get("issues", [])
            ),
            "down_listeners": [
                k for k, v in probes["listeners"].items() if not v.get("open")
            ],
        },
    }
    if not args.dry_run:
        append_jsonl(cfg["log"]["jsonl_path"], record)
        rotate_log(cfg["log"]["jsonl_path"], cfg["log"].get("max_age_days", 14))
        if mode == "active":
            save_state(state)

    if args.dry_run:
        print(
            json.dumps(
                {"verdict": verdict, "actions": actions, "probes": probes},
                indent=2, default=str,
            )
        )
    else:
        print(
            f"mode={mode} healthy={verdict.get('healthy')} "
            f"issues={len(verdict.get('issues', []))} "
            f"actions={len(actions)} "
            f"model={verdict.get('_model')} "
            f"summary={(verdict.get('summary') or '')[:160]}"
        )


if __name__ == "__main__":
    main()
