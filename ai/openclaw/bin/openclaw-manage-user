#!/usr/bin/env bash
#
# openclaw-manage-user — privileged user lifecycle helper for OpenClaw.
# Managed by root, executed by the monitor user (karen) via NOPASSWD sudo.
#
set -euo pipefail

# Environment-configurable paths to support testing/sandboxing
REGISTRY="${OPENCLAW_AGENTS_JSON:-${REGISTRY:-/etc/openclaw/agents.json}}"
SUDOERS_D="${OPENCLAW_SUDOERS_D:-${SUDOERS_D:-/etc/sudoers.d}}"
SHARED_GROUP="${OPENCLAW_SHARED_GROUP:-code-agents}"
SAMBA_SHARED_ROOT="${OPENCLAW_SAMBA_SHARED_ROOT:-${SAMBA_SHARED_ROOT:-/srv/samba/shared}}"
SAMBA_PASSWORD_SYNC_DIR="${OPENCLAW_SAMBA_PASSWORD_SYNC_DIR:-${SAMBA_PASSWORD_SYNC_DIR:-/tmp/samba-password-sync}}"
REPO_ROOT="${OPENCLAW_REPO_ROOT:-${REPO_ROOT:-/srv/Code/environment}}"

VISUDO=$(command -v visudo || command -v /usr/sbin/visudo || command -v /sbin/visudo || echo "/usr/sbin/visudo")

die() {
  printf 'openclaw-manage-user: %s\n' "$*" >&2
  exit 1
}

# Ensure running as root
if [[ $EUID -ne 0 ]]; then
  die "must run as root (via sudo)"
fi

# Validate REPO_ROOT to prevent privilege escalation via environment override
if [[ "$REPO_ROOT" =~ ^/srv/Code/environment(\.worktrees/[a-zA-Z0-9_-]+)?$ ]]; then
  :
elif [[ "${OPENCLAW_SANDBOX_TESTING:-}" = "true" && "$REPO_ROOT" =~ ^/tmp/ ]]; then
  :
else
  echo "Error: REPO_ROOT '$REPO_ROOT' is invalid. Privilege escalation hazard." >&2
  exit 1
fi

# Validate registry JSON integrity if it exists
if [ -f "$REGISTRY" ]; then
  if ! jq empty "$REGISTRY" >/dev/null 2>&1; then
    echo "Error: Registry JSON integrity check failed." >&2
    exit 1
  fi
fi

usage() {
  cat >&2 <<USAGE
Usage:
  openclaw-manage-user add <username> <uid> <role>
  openclaw-manage-user delete <username>
USAGE
  exit 2
}

validate_username() {
  local user="$1"
  [[ "$user" =~ ^[a-z0-9_-]+$ ]] || die "Invalid username format: $user"
  [[ ${#user} -le 32 ]] || die "Username too long (max 32 chars): $user"
  case "$user" in
    root|zeh|karen|system|admin|daemon|bin|sys|nobody)
      die "Protected system user: $user"
      ;;
  esac
}

validate_uid() {
  local uid="$1"
  [[ "$uid" =~ ^[0-9]+$ ]] || die "Invalid UID: $uid"
  [[ "$uid" -ge 1001 ]] || die "UID must be >= 1001: $uid"
}

regenerate_monitor_sudoers() {
  if [[ ! -r "$REGISTRY" ]]; then
    echo "Warning: registry not readable, skipping monitor sudoers regeneration." >&2
    return 0
  fi
  
  local m_user
  m_user=$(jq -r '.agents[] | select(.role == "monitor" and .enabled == true) | .user' "$REGISTRY" | head -1)
  m_user="${m_user:-karen}"
  
  local coding_users
  coding_users=$(jq -r '.agents[] | select(.role == "coding" and .enabled == true) | .user' "$REGISTRY" | paste -sd, -)
  
  local tmp
  tmp=$(mktemp /tmp/openclaw-sudoers.XXXXXX)
  
  cat >"$tmp" <<EOF
# Sudoers for the monitor agent ($m_user). Generated by openclaw-manage-user.
# DO NOT EDIT MANUALLY.
Defaults:$m_user !requiretty

$m_user ALL=(root) NOPASSWD: /usr/local/sbin/openclaw-control *
$m_user ALL=(root) NOPASSWD: /usr/local/sbin/openclaw-manage-user *
$m_user ALL=(root) NOPASSWD: $REPO_ROOT/ai/openclaw/install.sh

# Systemctl and journals
$m_user ALL=(root) NOPASSWD: /usr/bin/systemctl restart ollama.service
$m_user ALL=(root) NOPASSWD: /usr/bin/systemctl restart nginx.service
$m_user ALL=(root) NOPASSWD: /usr/bin/systemctl restart agent-dashboard.service
$m_user ALL=(root) NOPASSWD: /usr/bin/systemctl restart openclaw-typing-keepalive.service
$m_user ALL=(root) NOPASSWD: /usr/bin/systemctl restart ai-monitor.service
$m_user ALL=(root) NOPASSWD: /usr/bin/systemctl status *
$m_user ALL=(root) NOPASSWD: /usr/bin/systemctl is-active *
$m_user ALL=(root) NOPASSWD: /usr/bin/systemctl is-failed *
$m_user ALL=(root) NOPASSWD: /usr/bin/systemctl list-units *
$m_user ALL=(root) NOPASSWD: /usr/bin/systemctl list-unit-files *
$m_user ALL=(root) NOPASSWD: /usr/bin/systemctl show *
$m_user ALL=(root) NOPASSWD: /usr/bin/journalctl *
EOF

  if [[ -n "$coding_users" ]]; then
    cat >>"$tmp" <<EOF
$m_user ALL=($coding_users) NOPASSWD: /usr/bin/systemctl --user *
$m_user ALL=($coding_users) NOPASSWD: /usr/bin/node $REPO_ROOT/ai/openclaw/skills/*
EOF
  fi

  cat >>"$tmp" <<EOF
# Read-only fs inspection
$m_user ALL=(root) NOPASSWD: /usr/bin/stat *
$m_user ALL=(root) NOPASSWD: /usr/bin/ls *
$m_user ALL=(root) NOPASSWD: /usr/bin/cat /etc/openclaw/*, /usr/bin/cat /etc/agent-dashboard/*, /usr/bin/cat /home/*, /usr/bin/cat /var/lib/ai-monitor/*, /usr/bin/cat /var/log/ai-monitor/*
EOF

  if "$VISUDO" -c -f "$tmp" >/dev/null 2>&1; then
    mv -f "$tmp" "$SUDOERS_D/$m_user-openclaw-control"
    chmod 0440 "$SUDOERS_D/$m_user-openclaw-control"
  else
    rm -f "$tmp"
    die "Generated sudoers file failed validation; aborting monitor sudoers update."
  fi
}

cmd="${1:-}"
case "$cmd" in
  add)
    [[ $# -eq 4 ]] || usage
    user="$2"
    uid="$3"
    role="$4"
    
    validate_username "$user"
    validate_uid "$uid"
    
    # 0. Check group and UID conflict
    getent group "$SHARED_GROUP" >/dev/null || groupadd -r "$SHARED_GROUP" || groupadd "$SHARED_GROUP"
    
    if getent passwd "$uid" >/dev/null; then
      existing_user=$(getent passwd "$uid" | cut -d: -f1)
      [[ "$existing_user" == "$user" ]] || die "UID $uid is already taken by user $existing_user"
    fi
    
    # 1. Create Linux group and user
    if getent group "$user" >/dev/null 2>&1; then
      echo "Group $user already exists, skipping groupadd" >&2
    else
      groupadd -g "$uid" "$user"
    fi
    
    if id "$user" >/dev/null 2>&1; then
      echo "User $user already exists, skipping useradd" >&2
    else
      useradd -u "$uid" -g "$user" -m -s /bin/bash -G "$SHARED_GROUP" "$user"
      passwd -l "$user"
    fi
    
    # 2. Home directories
    mkdir -p "/home/$user/workspace" "/home/$user/.openclaw/workspace"
    chown -R "$user:$user" "/home/$user/workspace" "/home/$user/.openclaw"
    
    # 3. Samba folders
    mkdir -p "$SAMBA_SHARED_ROOT/$user"
    chown "$user:$user" "$SAMBA_SHARED_ROOT/$user"
    chmod 0700 "$SAMBA_SHARED_ROOT/$user"
    ln -sf "$SAMBA_SHARED_ROOT/$user" "/home/$user/Shared"
    chown -h "$user:$user" "/home/$user/Shared"
    
    # 4. Password sync queues
    mkdir -p "$SAMBA_PASSWORD_SYNC_DIR"
    chown root:root "$SAMBA_PASSWORD_SYNC_DIR"
    chmod 0711 "$SAMBA_PASSWORD_SYNC_DIR"
    
    mkdir -p "$SAMBA_PASSWORD_SYNC_DIR/$user"
    chown "$user:$user" "$SAMBA_PASSWORD_SYNC_DIR/$user"
    chmod 0700 "$SAMBA_PASSWORD_SYNC_DIR/$user"
    
    # 5. Sudoers rule fragment (self-wake)
    tmp_agent_sudo=$(mktemp /tmp/openclaw-agent-sudo.XXXXXX)
    cat >"$tmp_agent_sudo" <<EOF
# Allow $user to wake themselves
$user ALL=(root) NOPASSWD: /usr/local/sbin/openclaw-control wake-agent $user *
EOF
    if "$VISUDO" -c -f "$tmp_agent_sudo" >/dev/null 2>&1; then
      mv -f "$tmp_agent_sudo" "$SUDOERS_D/openclaw-wake-$user"
      chmod 0440 "$SUDOERS_D/openclaw-wake-$user"
    else
      rm -f "$tmp_agent_sudo"
      echo "Warning: agent sudoers validation failed; skipping $SUDOERS_D/openclaw-wake-$user creation" >&2
    fi
    
    # 5.5 Add user to registry JSON if not present (helps sandboxing and keeps registry in sync)
    if [[ -f "$REGISTRY" ]]; then
      if ! jq --arg u "$user" '.agents[] | select(.user == $u) | .user' "$REGISTRY" 2>/dev/null | grep -q "$user"; then
        new_agent_json=$(jq -n \
          --arg u "$user" \
          --argjson uid "$uid" \
          --arg r "$role" \
          '{user: $u, uid: $uid, enabled: true, role: $r}')
        tmp_reg=$(mktemp /tmp/agents-json.XXXXXX)
        jq --argjson new_agent "$new_agent_json" '.agents += [$new_agent]' "$REGISTRY" > "$tmp_reg"
        mv -f "$tmp_reg" "$REGISTRY"
      fi
    fi

    # 6. Regenerate monitor sudoers
    regenerate_monitor_sudoers
    ;;

  delete)
    [[ $# -eq 2 ]] || usage
    user="$2"
    validate_username "$user"
    
    # Safe deprovisioning boundary check
    if id -u "$user" >/dev/null 2>&1; then
      target_uid=$(id -u "$user")
      if [ "$target_uid" -lt 1001 ]; then
        echo "Error: Cannot delete system user '$user' with UID $target_uid (< 1001)." >&2
        exit 1
      fi
    fi
    
    # 1. Terminate user services and lingering
    loginctl disable-linger "$user" || true
    loginctl terminate-user "$user" || true
    pkill -u "$user" || true
    sleep 1
    
    # 2. Delete Linux user and group
    if id "$user" >/dev/null 2>&1; then
      userdel -r "$user" || true
    fi
    if getent group "$user" >/dev/null 2>&1; then
      groupdel "$user" 2>/dev/null || true
    fi
    
    # 3. Clean directories
    rm -rf "$SAMBA_SHARED_ROOT/$user"
    rm -rf "$SAMBA_PASSWORD_SYNC_DIR/$user"
    
    # 4. Remove agent sudoers rule
    rm -f "$SUDOERS_D/openclaw-wake-$user"
    
    # Remove from registry JSON if present
    if [[ -f "$REGISTRY" ]]; then
      tmp_reg=$(mktemp /tmp/agents-json.XXXXXX)
      jq --arg u "$user" 'del(.agents[] | select(.user == $u))' "$REGISTRY" > "$tmp_reg"
      mv -f "$tmp_reg" "$REGISTRY"
    fi

    # 5. Regenerate monitor sudoers
    regenerate_monitor_sudoers
    ;;

  *)
    usage
    ;;
esac
