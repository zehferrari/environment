#!/usr/bin/env bash

# openclaw-control — manage user-scoped openclaw services and wake agents.
# Allowed users come from the registry (/etc/openclaw/agents.json):
# anyone with `enabled: true` is accepted. The script is agent-agnostic
# — it works in any OpenClaw deployment without code changes.

REGISTRY="${OPENCLAW_AGENTS_JSON:-/etc/openclaw/agents.json}"
RUNUSER="${RUNUSER:-/usr/sbin/runuser}"

usage() {
  cat >&2 <<USAGE
Usage:
  openclaw-control restart-services <user> [reason]
  openclaw-control wake-agent       <user> [--session-key <key>] [text...]
  openclaw-control restart-and-wake <user> [--session-key <key>] [text...]

Allowed users are read from the registry (${REGISTRY}); any agent with
\`enabled: true\` is accepted.

Notes:
  restart-services covers all enabled \`openclaw-*\` user services for
  the target user. \`systemctl restart\` is used uniformly, so inactive
  units are also (re)started — this is the path the monitor agent /
  ai-monitor uses to bring stuck services back up.

  For the monitor agent (registry role='monitor'), restart-and-wake is
  also the recovery path when the agent:main:main heartbeat conversation
  gets blocked on a stale pendingFinalDelivery (no caller waiting to ACK
  the response). ai-monitor clears pendingFinalDelivery automatically;
  this command is the manual escape hatch.
USAGE
  exit 2
}

# Parse the registry once into a space-separated list of allowed users.
# Falls back to the legacy hardcoded set if jq isn't available or the
# registry can't be read — keeps the recovery path working even when
# half the host is broken.
_load_allowed_users() {
  if command -v jq >/dev/null 2>&1 && [ -r "$REGISTRY" ]; then
    jq -r '.agents[] | select(.enabled == true) | .user' "$REGISTRY" 2>/dev/null
  fi
}

is_allowed_user() {
  local target="$1"
  local allowed
  allowed=$(_load_allowed_users)
  if [ -z "$allowed" ]; then
    return 1
  fi
  while IFS= read -r u; do
    [ "$u" = "$target" ] && return 0
  done <<<"$allowed"
  return 1
}

list_managed_user_services() {
  # All `openclaw-*` user services that are currently enabled (persistent
  # or runtime). State filter on list-unit-files lets us catch inactive
  # units that need starting too — `systemctl restart` works identically
  # on active/inactive/failed. Project-specific services should NOT be
  # named `openclaw-*` — drop a config in ~/.config/openclaw/projects/
  # instead (see agent-defaults.json comments.per_project_extensions).
  local user="$1"
  local out=""
  out=$(systemctl --user -M "${user}@" --no-pager --plain --no-legend \
    list-unit-files 'openclaw-*.service' \
    --state=enabled,enabled-runtime 2>/dev/null || true)
  if [ -z "$out" ]; then
    out=$(_user_systemctl "$user" --no-pager --plain --no-legend \
      list-unit-files 'openclaw-*.service' \
      --state=enabled,enabled-runtime 2>/dev/null || true)
  fi
  printf '%s\n' "$out" | awk '{print $1}' | sort -u
}

_user_systemctl() {
  local user="$1"
  shift
  local uid
  uid=$(id -u "$user") || return 1
  sudo -n -u "$user" env \
    HOME="$(_user_home "$user")" \
    XDG_RUNTIME_DIR="/run/user/$uid" \
    DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
    systemctl --user "$@"
}

user_bus_error_needs_manager_restart() {
  local err_file="$1"
  grep -Eq 'Transport endpoint is not connected|Bad message|Failed to connect to bus' "$err_file"
}

restart_user_manager() {
  local user="$1"
  local uid
  uid=$(id -u "$user") || return 1
  echo "openclaw-control: restarting user@${uid}.service for $user after broken user bus" >&2
  systemctl restart "user@${uid}.service"
  sleep 2
}

ensure_user_manager_bus() {
  local user="$1"
  local err_file
  err_file=$(mktemp /tmp/openclaw-control-user-bus.XXXXXX)

  if systemctl --user -M "${user}@" --no-pager is-active default.target >/dev/null 2>"$err_file"; then
    rm -f "$err_file"
    return 0
  fi
  if _user_systemctl "$user" is-active default.target >/dev/null 2>>"$err_file"; then
    rm -f "$err_file"
    return 0
  fi

  if user_bus_error_needs_manager_restart "$err_file"; then
    cat "$err_file" >&2
    restart_user_manager "$user" || {
      cat "$err_file" >&2
      rm -f "$err_file"
      return 1
    }
    rm -f "$err_file"
    return 0
  fi

  rm -f "$err_file"
  return 0
}

daemon_reload_user() {
  local user="$1"
  systemctl --user -M "${user}@" --no-pager daemon-reload >/dev/null 2>&1 \
    || _user_systemctl "$user" daemon-reload >/dev/null 2>&1
}

restart_user_service() {
  local user="$1"
  local svc="$2"
  local err_file
  err_file=$(mktemp /tmp/openclaw-control-restart.XXXXXX)

  if systemctl --user -M "${user}@" --no-pager restart "$svc" 2>"$err_file"; then
    rm -f "$err_file"
    return 0
  fi

  {
    echo "openclaw-control: restart $svc for $user failed; daemon-reload + retry"
    cat "$err_file"
  } >&2

  daemon_reload_user "$user" || true

  if systemctl --user -M "${user}@" --no-pager restart "$svc" 2>"$err_file"; then
    rm -f "$err_file"
    return 0
  fi
  if _user_systemctl "$user" restart "$svc" 2>>"$err_file"; then
    rm -f "$err_file"
    return 0
  fi

  if user_bus_error_needs_manager_restart "$err_file"; then
    restart_user_manager "$user" || true
    daemon_reload_user "$user" || true
    if systemctl --user -M "${user}@" --no-pager restart "$svc" 2>"$err_file"; then
      rm -f "$err_file"
      return 0
    fi
    if _user_systemctl "$user" restart "$svc" 2>>"$err_file"; then
      rm -f "$err_file"
      return 0
    fi
  fi

  cat "$err_file" >&2
  rm -f "$err_file"
  return 1
}

restart_services() {
  local user="$1"
  ensure_user_manager_bus "$user" || true
  daemon_reload_user "$user" || true
  mapfile -t services < <(list_managed_user_services "$user")

  if [ "${#services[@]}" -eq 0 ]; then
    exit 0
  fi

  local rc=0
  for svc in "${services[@]}"; do
    if ! restart_user_service "$user" "$svc"; then
      rc=1
    fi
  done
  return "$rc"
}

# Resolve the user's home from the registry; fall back to /home/<user>.
_user_home() {
  local user="$1"
  local home=""
  if command -v jq >/dev/null 2>&1 && [ -r "$REGISTRY" ]; then
    home=$(jq -r --arg u "$user" '.agents[] | select(.user == $u) | .home // empty' "$REGISTRY" 2>/dev/null)
  fi
  echo "${home:-/home/$user}"
}

session_hygiene() {
  local user="$1"
  local home="$2"
  python3 - "$user" "$home" <<'PY'
import json, os, stat, sys, time
from pathlib import Path

user, home = sys.argv[1:3]
path = Path(home) / ".openclaw" / "agents" / "main" / "sessions" / "sessions.json"
if not path.exists():
    raise SystemExit(0)

try:
    st = path.stat()
    data = json.loads(path.read_text())
except Exception as e:
    print(f"openclaw-control: session hygiene skipped for {user}: {e}", file=sys.stderr)
    raise SystemExit(0)

changed = False
ts = int(time.time())

for key, entry in list(data.items()):
    if not isinstance(entry, dict):
        continue
    if entry.get("pendingFinalDelivery") and entry.get("status") != "running":
        entry["pendingFinalDelivery"] = False
        for field in (
            "pendingFinalDeliveryText",
            "pendingFinalDeliveryCreatedAt",
            "pendingFinalDeliveryLastAttemptAt",
            "pendingFinalDeliveryAttemptCount",
            "pendingFinalDeliveryLastError",
        ):
            entry.pop(field, None)
        changed = True

main = data.get("agent:main:main")
if isinstance(main, dict) and main.get("status") != "running":
    sf = main.get("sessionFile")
    if sf and not Path(sf).exists():
        stale_key = f"agent:main:main:stale:{ts}"
        data[stale_key] = main
        del data["agent:main:main"]
        changed = True

if changed:
    backup = path.with_name(f"{path.name}.openclaw-control-bak-{ts}")
    try:
        backup.write_text(path.read_text())
        os.chown(backup, st.st_uid, st.st_gid)
        os.chmod(backup, stat.S_IMODE(st.st_mode))
    except Exception:
        pass
    tmp = path.with_suffix(path.suffix + ".openclaw-control-tmp")
    tmp.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n")
    os.chown(tmp, st.st_uid, st.st_gid)
    os.chmod(tmp, stat.S_IMODE(st.st_mode))
    os.replace(tmp, path)
PY
}

wake_agent() {
  local user="$1"
  shift || true
  local session_key=""
  if [ "${1:-}" = "--session-key" ]; then
    shift
    session_key="${1:-}"
    shift || true
  fi
  local text="$*"
  local home
  home=$(_user_home "$user")
  local env_file="$home/.config/openclaw/openclaw-secrets.env"

  if [ -z "$text" ]; then
    text="Webhook-triggered OpenClaw wake event"
  fi

  local attempt
  local max_attempts=6
  local last_err=""
  local err_file
  err_file=$(mktemp /tmp/openclaw-control-wake.XXXXXX)

  for attempt in $(seq 1 "$max_attempts"); do
    session_hygiene "$user" "$home"
    if "$RUNUSER" -u "$user" -- env HOME="$home" XDG_RUNTIME_DIR="/run/user/$(id -u "$user")" bash -lc '
      set -a
      if [ -r "$1" ]; then . "$1"; fi
      set +a
      args=(system event --mode now --text "$2" --timeout 30000 --json)
      if [ -n "$3" ]; then
        args+=(--session-key "$3")
      fi
      exec openclaw "${args[@]}"
    ' _ "$env_file" "$text" "$session_key" >/dev/null 2>"$err_file"; then
      rm -f "$err_file"
      return 0
    fi

    last_err=$(cat "$err_file" 2>/dev/null || true)

    if [ "$attempt" -lt "$max_attempts" ]; then
      sleep 2
    fi
  done

  rm -f "$err_file"

  if [ -n "$last_err" ]; then
    echo "$last_err" >&2
  fi

  return 1
}

cmd="${1:-}"
user="${2:-}"

if [ -z "$cmd" ] || [ -z "$user" ]; then
  usage
fi

if ! is_allowed_user "$user"; then
  echo "Unsupported user '$user' (not enabled in $REGISTRY)" >&2
  exit 2
fi

shift 2 || true

case "$cmd" in
  restart-services)
    restart_services "$user"
    ;;
  wake-agent)
    wake_agent "$user" "$@"
    ;;
  restart-and-wake)
    restart_services "$user"
    wake_agent "$user" "$@"
    ;;
  *)
    usage
    ;;
esac
