{
    // Waybar configuration. If connector names shuffle, Hyprland autostart uses launch-waybar.sh.
    "output": "eDP-1",
    "layer": "overlay",
    "position": "top",
    "height": 48,
    "spacing": 2,
    
    "modules-left": [
        "hyprland/workspaces"
    ],
    
    "modules-center": [
        "clock"
    ],
    
    "modules-right": [
        "group/performance",
        "group/hardware"
    ],


    "hyprland/workspaces": {
        "format": "{windows}",
        "workspace-taskbar": {
            "enable": true,
            "update-active-window": true,
            "format": "{icon}",
            "icon-size": 17,
            "orientation": "horizontal",
            // JetBrains menus/popups are transient windows titled win0, win1, etc.
            "ignore-list": [
                "^win[0-9]+$"
            ]
        },
        "sort-by": "number",
        "all-outputs": true,
        "show-special": true,
        "special-visible-only": true,
        "on-scroll-up": "hyprctl dispatch workspace e-1",
        "on-scroll-down": "hyprctl dispatch workspace e+1"
    },


    "group/hardware": {
        "orientation": "horizontal",
        "modules": [
            "custom/displays",
            "bluetooth",
            "pulseaudio",
            "battery",
            "custom/power"
        ]
    },

    "group/performance": {
        "orientation": "horizontal",
        "modules": [
            "cpu",
            "memory",
            "temperature",
            "network"
        ]
    },

    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "bash -c 'XDG_CURRENT_DESKTOP=GNOME gnome-control-center sound'"
    },

    "battery": {
        "format": "{capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "tooltip-format": "Battery: {capacity}%\n{time}"
    },

    // Module configurations
    "clock": {
        "format": "{:%H:%M:%S • %A %d/%m}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "on-click": "bash -c 'ADW_DEBUG_COLOR_SCHEME=prefer-light gnome-calendar'",
        "interval": 1,
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "on-click-right": "mode",
            "format": {
                "months": "<span color='#ffead3'><b>{}</b></span>",
                "days": "<span color='#ecc6d9'><b>{}</b></span>",
                "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
                "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
                "today": "<span color='#ff6699'><b><u>{}</u></b></span>"
            }
        }
    },

    "network": {
        "interval": 1,
        "format-wifi": "",
        "format-ethernet": "",
        "format-disconnected": "",
        "tooltip-format-wifi": "WiFi: {essid} ({signalStrength}%)\n{ipaddr}/{cidr}\n<span color='#89b4fa'>↓</span> {bandwidthDownBytes}    <span color='#f38ba8'>↑</span> {bandwidthUpBytes}",
        "tooltip-format-ethernet": "Ethernet: {ifname}\n{ipaddr}/{cidr}\n<span color='#89b4fa'>↓</span> {bandwidthDownBytes}    <span color='#f38ba8'>↑</span> {bandwidthUpBytes}",
        "tooltip-format-disconnected": "Network Disconnected",
        "on-click": "bash -c 'XDG_CURRENT_DESKTOP=GNOME gnome-control-center wifi'"
    },

    "cpu": {
        "interval": 2,
        "format": " {usage}%",
        "tooltip-format": "CPU: {usage}%",
        "on-click": "gnome-system-monitor"
    },

    "memory": {
        "interval": 2,
        "format": " {percentage}%",
        "tooltip-format": "Memory: {used:0.1f}G / {total:0.1f}G",
        "on-click": "gnome-system-monitor"
    },

    "temperature": {
        "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
        "input-filename": "temp1_input",
        "critical-threshold": 85,
        "format": " {temperatureC}°C",
        "format-critical": " {temperatureC}°C",
        "on-click": "gnome-system-monitor"
    },

    "bluetooth": {
        "format": "",
        "format-disabled": "",
        "format-off": "",
        "format-on": "",
        "format-connected": "",
        "tooltip-format": "Bluetooth: {status}\n{controller_alias}",
        "tooltip-format-connected": "Bluetooth: Connected\n{device_alias}\n{controller_alias}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "tooltip-format-enumerate-connected-battery": "{device_alias} - {device_battery_percentage}%",
        "on-click": "bash -c 'XDG_CURRENT_DESKTOP=GNOME gnome-control-center bluetooth'"
    },

    "custom/displays": {
        "format": "",
        "tooltip-format": "Display Settings",
        "on-click": "wdisplays"
    },

    "custom/power": {
        "format": "",
        "tooltip-format": "Power Menu",
        "on-click": "/home/zeh/.config/waybar/power-menu.sh"
    }
}
