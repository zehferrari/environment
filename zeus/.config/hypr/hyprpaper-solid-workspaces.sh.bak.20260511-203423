#!/usr/bin/env bash
# Set solid distinct colours per workspace, updating when workspaces change.

set -euo pipefail

CACHE_DIR="$HOME/.cache/hyprpaper-solid"
CONF_PATH="$HOME/.config/hypr/hyprpaper.conf"
mkdir -p "$CACHE_DIR"

need() { command -v "$1" >/dev/null 2>&1 || { echo "Missing dependency: $1" >&2; exit 1; }; }
need hyprctl
need jq
need hyprpaper

# prefer ImageMagick v7 `magick`, fallback to `convert`
MAGICK_BIN="$(command -v magick || command -v convert || true)"
if [[ -z "$MAGICK_BIN" ]]; then
  echo "Missing dependency: magick/convert (ImageMagick)" >&2
  exit 1
fi

# Distinct palette (12 colours), deterministic by workspace id.
# This keeps monitors visually different as long as their active workspaces differ.
PALETTE=(
  e6194b  # red
  3cb44b  # green
  4363d8  # blue
  ffe119  # yellow
  f58231  # orange
  911eb4  # purple
  46f0f0  # cyan
  f032e6  # magenta
  bcf60c  # lime
  008080  # teal
  800000  # maroon
  000075  # navy
)

# Return monitor name and active workspace id pairs (sorted for stable comparisons)
monitors_ws() {
  hyprctl monitors -j | jq -r '.[] | "\(.name) \(.activeWorkspace.id)"' | sort
}

# Deterministic colour per workspace id.
hex_for_ws() {
  local ws="$1"
  local n=${#PALETTE[@]}

  if [[ ! "$ws" =~ ^-?[0-9]+$ ]]; then
    ws=1
  fi
  if (( ws <= 0 )); then
    ws=1
  fi

  local idx=$(( (ws - 1) % n ))
  echo "${PALETTE[$idx]}"
}

img_for_ws() {
  local ws="$1"
  local hex
  hex=$(hex_for_ws "$ws")

  # Include the colour in the filename so palette tweaks take effect without manual cache deletion.
  local path="$CACHE_DIR/ws-${ws}-${hex}.png"
  if [[ ! -f "$path" ]]; then
    "$MAGICK_BIN" -size 5120x3200 canvas:"#${hex}" "$path"
  fi
  echo "$path"
}

apply_all() {
  local rc=0
  while read -r mon wsid; do
    img=$(img_for_ws "$wsid")
    hyprctl hyprpaper preload "$img" >/dev/null 2>&1 || true
    if ! hyprctl hyprpaper wallpaper "$mon,$img" >/dev/null 2>&1; then
      rc=1
    fi
  done < <(monitors_ws)
  return "$rc"
}
# Generate config to ensure hyprpaper starts with solid colours
write_conf() {
  local tmp
  tmp="$(mktemp)"
  {
    echo "# Auto-generated by hyprpaper-solid-workspaces.sh"
    echo "splash = false"
    while read -r mon wsid; do
      img=$(img_for_ws "$wsid")
      echo "preload = $img"
      echo "wallpaper = ${mon},$img"
    done < <(monitors_ws)
  } > "$tmp"
  mv "$tmp" "$CONF_PATH"
}

start_hyprpaper() {
  # Prefer the user service if it exists/runs, otherwise spawn directly.
  if systemctl --user status hyprpaper.service >/dev/null 2>&1; then
    systemctl --user restart hyprpaper.service >/dev/null 2>&1 || true
  else
    pkill -x hyprpaper 2>/dev/null || true
    hyprpaper >/dev/null 2>&1 &
  fi
}

wait_for_hyprpaper_ipc() {
  # Wait until hyprpaper IPC responds (otherwise wallpaper requests can fail on startup).
  for _ in $(seq 1 40); do
    if hyprctl hyprpaper listloaded >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.1
  done
  return 1
}

write_conf
start_hyprpaper
wait_for_hyprpaper_ipc || true

# Apply to current workspace (retry briefly in case outputs come up in stages)
for _ in $(seq 1 20); do
  apply_all && break
  sleep 0.2
done

# Keep wallpapers in sync.
# Newer Hyprland builds don't support `hyprctl -s` (subscribe) anymore, so we poll cheaply.
last_state=""
while true; do
  # If Hyprland is restarting/reloading and hyprctl errors briefly, don't exit.
  state=$(monitors_ws 2>/dev/null || true)
  if [[ -n "$state" && "$state" != "$last_state" ]]; then
    write_conf
    for _ in $(seq 1 10); do
      apply_all && break
      sleep 0.2
    done
    last_state="$state"
  fi
  sleep 0.5
done
