server {
    server_name dns.zeh.me;
 
    listen [::]:80;
    listen 80;

    include /etc/nginx/sites-available/modules/443/zeh.me;

    access_log off;
    error_log /var/log/nginx/dns.error;

    charset utf-8;

    root /home/zeh/www/admin;
    index index.php index.html index.htm;

    autoindex on;
    rewrite_log on;
    log_not_found off;

    real_ip_header $http_x_forwarded_for;
    include /etc/nginx/sites-available/loadModules;
}
