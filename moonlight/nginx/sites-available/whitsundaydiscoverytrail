server {
    server_name whitsundaydiscoverytrail.org.au;

    access_log /var/log/nginx/vixiAu.access zehlog;
    error_log /var/log/nginx/vixiAu.error;

    charset utf-8;
    root /home/zeh/www/whitsunday-discovery-trail/dist/standalone/public;
    index index.html;

    autoindex off;
    rewrite_log on;
    log_not_found off;
    include /etc/nginx/sites-available/modules/restrictionsRules;

    # Serve static uploads directly from persistent location
    location /uploads/ {
        alias /home/zeh/www/wdt/public/uploads/;
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Serve thumbnails directly from persistent locations
    location /thumbnails/ {
        alias /home/zeh/www/wdt/public/thumbnails/;
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location /_next/static/ {
        alias /home/zeh/www/whitsunday-discovery-trail/dist/static/;
        expires 1y;
        access_log off;
    }

    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection upgrade;
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        add_header Expires "0";
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/whitsundaydiscoverytrail.org.au/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/whitsundaydiscoverytrail.org.au/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}
server {
    if ($host = whitsundaydiscoverytrail.org.au) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    server_name whitsundaydiscoverytrail.org.au;

    listen 80;
    return 404; # managed by Certbot


}