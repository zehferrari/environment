server {
    server_name osalquimistas.com.br;

    access_log /var/log/nginx/osalquimistas.access zehlog;
    error_log /var/log/nginx/osalquimistas.error;

    charset utf-8;

    root /home/zeh/www/osalquimistas;
    index index.php index.html index.htm;

    autoindex on;
    rewrite_log on;
    log_not_found off;

    real_ip_header $http_x_forwarded_for;
    include /etc/nginx/sites-available/loadModules;

    listen [::]:443 ssl;
    listen 443 ssl;
    
    ssl_certificate /etc/letsencrypt/live/osalquimistas.com.br/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/osalquimistas.com.br/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

}
server {
    server_name osalquimistas.com.br;
    listen [::]:80;
    listen 80;
    include /etc/nginx/sites-available/modules/restrictionsRules;
    return 301 https://$host$request_uri;
}
