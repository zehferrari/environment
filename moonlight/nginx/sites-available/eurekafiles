server {
    server_name eurekafiles.com *.eurekafiles.com;

    include /etc/nginx/sites-available/modules/443/eurekafiles.com;

    access_log /var/log/nginx/eureka.access zehlog;
    error_log /var/log/nginx/eureka.error;

    charset utf-8;

#    root /home/zeh/www/eurekafiles;
    index index.php index.html index.htm;

    autoindex on;
    rewrite_log on;
    log_not_found off;

    real_ip_header $http_x_forwarded_for;
#    include /etc/nginx/sites-available/loadModules;

    location / {
        proxy_pass http://10.0.0.110;
        proxy_set_header Host $host;
        proxy_redirect http:// https://;
        proxy_http_version 1.1;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

server {
    server_name eurekafiles.com *.eurekafiles.com;

    listen [::]:80;
    listen 80;

    return 301 https://$host$request_uri;
}
