upstream mmonit {
    server 127.0.0.1:8080;
}

server {
    server_name monitor.zeh.me;

    access_log /var/log/nginx/host.access;
    error_log /var/log/nginx/host.error;

    include /etc/nginx/sites-available/modules/443/zeh.me;
    include /etc/nginx/sites-available/modules/restrictionsRules;

    location / {
        proxy_pass http://mmonit;
        proxy_set_header Host $host;
        proxy_redirect http:// https://;
        proxy_http_version 1.1;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_redirect https://monitor.zeh.me:8080/ https://monitor.zeh.me/;
    }
}

server {
    server_name monitor.zeh.me;

    listen [::]:80;
    listen 80;

    return 301 https://$host$request_uri;
}

