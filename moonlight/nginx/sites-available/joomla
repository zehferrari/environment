server {
    server_name joomla.zeh.me;

    include /etc/nginx/sites-available/modules/443/zeh.me;

    access_log /var/log/nginx/joomla.access zehlog;
    error_log /var/log/nginx/joomla.error;

    charset utf-8;

    root /home/zeh/www/joomla;
    index index.php index.html index.htm;

    autoindex on;
    rewrite_log on;
    log_not_found off;

    real_ip_header $http_x_forwarded_for;
    include /etc/nginx/sites-available/loadModules;
}

server {
    server_name joomla.zeh.me;

    listen [::]:80;
    listen 80;

    include /etc/nginx/sites-available/modules/restrictionsRules;
    return 301 https://$host$request_uri;
}
