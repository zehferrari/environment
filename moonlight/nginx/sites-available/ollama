upstream ollama {
    server 10.0.0.105:11434 max_fails=2 fail_timeout=10s;
}

server {
    listen 80;
    server_name ollama.local;

    access_log /var/log/nginx/ollama.access zehlog;
    error_log /var/log/nginx/ollama.error;

    location / {
        proxy_pass http://ollama;
        proxy_connect_timeout 2s;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_next_upstream error timeout invalid_header http_502 http_503 http_504;
        proxy_set_header Host $host;
        proxy_redirect http:// https://;
        proxy_http_version 1.1;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

server {
    server_name ollama.zeh.me ollama.zeh;

    listen 80;
    include /etc/nginx/sites-available/modules/443/zeh.me;
    include /etc/nginx/sites-available/modules/restrictionsRules;

    access_log /var/log/nginx/ollama.access zehlog;
    error_log /var/log/nginx/ollama.error;

    location / {
        proxy_pass http://ollama;
        proxy_connect_timeout 2s;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_next_upstream error timeout invalid_header http_502 http_503 http_504;
        proxy_set_header Host $host;
        proxy_redirect http:// https://;
        proxy_http_version 1.1;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
