server {
    server_name dns.zeh.me;

    listen [::]:80;
    listen 80;

    include /etc/nginx/sites-available/modules/443/zeh.me;
    include /etc/nginx/sites-available/modules/restrictionsRules;

    access_log off;
    error_log /var/log/nginx/dns.error;

    charset utf-8;

    autoindex on;
    rewrite_log on;
    log_not_found off;

    location / {
        # Correct scheme and backend address
    	proxy_pass http://127.0.0.1:18789;

	   # Essential headers for Kibana proxying
    	proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Increase timeout (optional, but often helpful)
        proxy_read_timeout 90;

        # Prevent Nginx from rewriting redirects from Kibana
        proxy_redirect off;
    }
}
