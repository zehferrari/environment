server {
    server_name *.vixi.au;

    access_log /var/log/nginx/vixiAu.access zehlog;
    error_log /var/log/nginx/vixiAu.error;

    charset utf-8;
    autoindex off;
    log_not_found off;
    include /etc/nginx/sites-available/modules/restrictionsRules;

#    allow 10.0.0.0/24;
#    allow 161.8.1.4;
#    allow 150.228.141.178;
#    deny all;

    listen [::]:443 ssl;
    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/vixi.au/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/vixi.au/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location / {
        proxy_pass http://10.0.0.105;
        proxy_set_header Host $host;
        proxy_redirect http:// https://;
        proxy_http_version 1.1;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

