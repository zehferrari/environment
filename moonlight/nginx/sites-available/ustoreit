server {
    server_name ustoreit.zeh.me;

    include /etc/nginx/sites-available/modules/443/zeh.me;

    access_log /var/log/nginx/ustoreit.access zehlog;
    error_log /var/log/nginx/ustoreit.error;

    charset utf-8;

    root /home/zeh/www/ustoreit/web;
    index index.php index.html index.htm;

    autoindex on;
    rewrite_log on;
    log_not_found off;

    real_ip_header $http_x_forwarded_for;

    include /etc/nginx/sites-available/loadModules;
    include /etc/nginx/sites-available/modules/sitemapRules/wordpress;
}

server {
    server_name ustoreit.zeh.me;

    listen [::]:80;
    listen 80;

    return 301 https://$host$request_uri;
}
