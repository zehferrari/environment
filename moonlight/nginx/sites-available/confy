server {
    server_name confy.zeh.me;
    error_log /var/log/nginx/confy.error;

    include /etc/nginx/sites-available/modules/443/zeh.me;
    include /etc/nginx/sites-available/modules/restrictionsRules;

    proxy_connect_timeout 300s;
    proxy_send_timeout 300s;
    proxy_read_timeout 300s;
    proxy_buffering off;
    proxy_request_buffering off;

    client_max_body_size 200M;

    # LAN-only access
    allow 10.0.0.0/24;
    allow 161.8.1.4; # local NAT hairpin/WAN IP
    allow 127.0.0.1;
    allow ::1;
    deny all;

    location / {
        proxy_pass http://10.0.0.17:8188;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
